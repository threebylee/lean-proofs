/-- Cardinality four identifies the coordinate sum with the speed-set
sum, so no repetition or separately chosen speed population is counted. -/
theorem card_four_sum_image (v : Fin 4 → ℕ)
    (hcard : (Finset.univ.image v).card=4) :
    (∑i,v i)=(Finset.univ.image v).sum (fun n => n) := by
  have hinj : Function.Injective v := positiveLineSpeeds_card_four_injective hcard
  exact (Finset.sum_image (s := Finset.univ) (g := v)
    (f := fun n : ℕ => n) hinj.injOn).symm

/-- The actual exceptional pair needs only its analytic/core reduction,
which gives target or sum193 without any finite numerical certificate. -/
theorem actual_small_pair_target_or_sum193
    (v : Fin 4 → ℕ) (q : ℕ) (hq : q=1 ∨ q=2)
    (hp : Positive (Finset.univ.image v))
    (hprim : Primitive (Finset.univ.image v))
