    FiniteSource05Conclusion (Finset.univ.image v) ∨ (∑i,v i)≤193 := by
  obtain ⟨c,d,hcp,hcd,hset⟩ := positive_quartet_with_pair_remaining hp hcard h2 h3
    (by omega : 2*q≠3*q)
  have hpLit : Positive (finiteQuartetSpeeds (2*q) (3*q) c d) := by
    simpa only [hset] using hp
  have hprimLit : Primitive (finiteQuartetSpeeds (2*q) (3*q) c d) := by
    simpa only [hset] using hprim
  have hcardLit : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4 := by
    simpa only [hset] using hcard
  have hpairLit : ∀a∈finiteQuartetSpeeds (2*q) (3*q) c d,
      ∀b∈finiteQuartetSpeeds (2*q) (3*q) c d,a≠b → Nat.gcd a b≤2 := by
    simpa only [hset] using hpair
  rcases source05_small_pair_or_bounded hq hpLit hcardLit hprimLit hpairLit hcd
    with htarget|⟨hcpos,hc24,hd161⟩
  · left
    rw [hset]
    exact htarget
  · right
    obtain ⟨hab,hac,had,hbc,hbd,hne⟩ := finite_quartet_four_distinct hcardLit
    have hliteral : (finiteQuartetSpeeds (2*q) (3*q) c d).sum (fun n => n)=
