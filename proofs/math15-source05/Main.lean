        _ =(finiteQuartetSpeeds (2*q) (3*q) c d).sum (fun n => n) := by rw [hset]
        _ =2*q+3*q+c+d := hliteral
    rw [hsum]
    omega

/-- Literal coefficient cases complete the sum444 reduction for the same
