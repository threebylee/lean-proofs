/- Section: TriangleCover -/
section


/-!
Explicit triangle covering for a given Gauss-reduced planar basis.

This section does not assume or prove existence of a reduced basis for an
abstract lattice.
-/

namespace Math15.LonelyRunner.TriangleCover

/-- The polynomial numerator controlling the circumradius of the triangle
with vertices `(0,0)`, `(a,0)`, `(b,h)`. -/
theorem reduced_triangle_radius_numerator
    (a b h : ℝ) (ha : 0 < a) (hb : 0 ≤ b) (hba : b ≤ a / 2)
    (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    (b ^ 2 + h ^ 2) * ((a - b) ^ 2 + h ^ 2) ≤ 2 * (h ^ 2) ^ 2 := by
  have hmid : 0 ≤ a / 2 - b := by linarith
  have hleft : 0 ≤ a / 2 + b := by linarith
  have hab : 0 ≤ a - b := by linarith
  have hprod := mul_nonneg hleft hmid
  have hprod' := mul_nonneg ha.le hmid
  have hlast : 0 ≤ a ^ 2 - a * b - b ^ 2 := by
    nlinarith [sq_nonneg a]
  have hproj : 0 ≤ b * (a - 2 * b) := by
    apply mul_nonneg hb
    linarith
  have hfirst : 0 ≤ h ^ 2 + 2 * a * b - 3 * b ^ 2 := by
    nlinarith [sq_nonneg a]
  have hheight : 0 ≤ h ^ 2 - (a ^ 2 - b ^ 2) := by linarith
  have hp := mul_nonneg hheight hfirst
  have hq : 0 ≤ 2 * b * (a - b) * (a ^ 2 - a * b - b ^ 2) := by
    exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hb) hab) hlast
  have hid :
      2 * (h ^ 2) ^ 2 - (b ^ 2 + h ^ 2) * ((a - b) ^ 2 + h ^ 2) =
        (h ^ 2 - (a ^ 2 - b ^ 2)) * (h ^ 2 + 2 * a * b - 3 * b ^ 2) +
          2 * b * (a - b) * (a ^ 2 - a * b - b ^ 2) := by ring
  linarith

/-- Squared circumradius is at most one half of the squared height. -/
theorem reduced_triangle_circumradius_bound
    (a b h : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hb : 0 ≤ b) (hba : b ≤ a / 2)
    (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    a ^ 2 / 4 + ((b ^ 2 + h ^ 2 - a * b) / (2 * h)) ^ 2 ≤ h ^ 2 / 2 := by
  have hnum := reduced_triangle_radius_numerator a b h ha hb hba hlen
  have hid :
      (4 * h ^ 2) * (a ^ 2 / 4 + ((b ^ 2 + h ^ 2 - a * b) / (2 * h)) ^ 2) =
        (b ^ 2 + h ^ 2) * ((a - b) ^ 2 + h ^ 2) := by
    field_simp [ne_of_gt hh]
    <;> ring
  apply (mul_le_mul_iff_of_pos_left (by positivity : (0 : ℝ) < 4 * h ^ 2)).mp
  rw [hid]
  nlinarith only [hnum]

/-- A barycentric point of a triangle is within its circumradius of at
least one vertex. The circumcenter need not lie inside the triangle. -/
theorem barycentric_point_near_circumcircle_vertex
    (a b h x y ox oy R r s t : ℝ)
    (hr : 0 ≤ r) (hs : 0 ≤ s) (ht : 0 ≤ t)
    (hsum : r + s + t = 1)
    (hx : x = s * a + t * b) (hy : y = t * h)
    (hc0 : ox ^ 2 + oy ^ 2 = R)
    (hc1 : (ox - a) ^ 2 + oy ^ 2 = R)
    (hc2 : (ox - b) ^ 2 + (oy - h) ^ 2 = R) :
    x ^ 2 + y ^ 2 ≤ R ∨
      (x - a) ^ 2 + y ^ 2 ≤ R ∨
      (x - b) ^ 2 + (y - h) ^ 2 ≤ R := by
  have hid :
      r * (x ^ 2 + y ^ 2) + s * ((x - a) ^ 2 + y ^ 2) +
        t * ((x - b) ^ 2 + (y - h) ^ 2) +
        (x - ox) ^ 2 + (y - oy) ^ 2 =
      r * (ox ^ 2 + oy ^ 2) + s * ((ox - a) ^ 2 + oy ^ 2) +
        t * ((ox - b) ^ 2 + (oy - h) ^ 2) := by
    have hr' : r = 1 - s - t := by linarith
    rw [hr', hx, hy]
    ring
  rw [hc0, hc1, hc2] at hid
  have hR : r * R + s * R + t * R = R := by
    calc
      r * R + s * R + t * R = (r + s + t) * R := by ring
      _ = R := by rw [hsum]; ring
  rw [hR] at hid
  have hmean :
      r * (x ^ 2 + y ^ 2) + s * ((x - a) ^ 2 + y ^ 2) +
        t * ((x - b) ^ 2 + (y - h) ^ 2) ≤ R := by
    nlinarith [sq_nonneg (x - ox), sq_nonneg (y - oy)]
  by_contra hn
  push_neg at hn
  rcases hn with ⟨h0, h1, h2⟩
  have hr0 := mul_nonneg hr (sub_nonneg.mpr h0.le)
  have hs0 := mul_nonneg hs (sub_nonneg.mpr h1.le)
  have ht0 := mul_nonneg ht (sub_nonneg.mpr h2.le)
  have hpos : 0 < r ∨ 0 < s ∨ 0 < t := by
    by_contra hnpos
    push_neg at hnpos
    linarith
  rcases hpos with hrp | hsp | htp
  · have hp := mul_pos hrp (sub_pos.mpr h0)
    nlinarith only [hp, hs0, ht0, hmean, hR]
  · have hp := mul_pos hsp (sub_pos.mpr h1)
    nlinarith only [hr0, hp, ht0, hmean, hR]
  · have hp := mul_pos htp (sub_pos.mpr h2)
    nlinarith only [hr0, hs0, hp, hmean, hR]

/-- Actual squared-distance covering of the first reduced-basis triangle. -/
theorem reduced_triangle_point_near_vertex
    (a b h x y r s t : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hb : 0 ≤ b) (hba : b ≤ a / 2)
    (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2)
    (hr : 0 ≤ r) (hs : 0 ≤ s) (ht : 0 ≤ t)
    (hsum : r + s + t = 1)
    (hx : x = s * a + t * b) (hy : y = t * h) :
    x ^ 2 + y ^ 2 ≤ h ^ 2 / 2 ∨
      (x - a) ^ 2 + y ^ 2 ≤ h ^ 2 / 2 ∨
      (x - b) ^ 2 + (y - h) ^ 2 ≤ h ^ 2 / 2 := by
  let q : ℝ := (b ^ 2 + h ^ 2 - a * b) / (2 * h)
  let R : ℝ := a ^ 2 / 4 + q ^ 2
  have hc0 : (a / 2) ^ 2 + q ^ 2 = R := by dsimp [R]; ring
  have hc1 : (a / 2 - a) ^ 2 + q ^ 2 = R := by dsimp [R]; ring
  have hc2 : (a / 2 - b) ^ 2 + (q - h) ^ 2 = R := by
    dsimp [q, R]
    field_simp [ne_of_gt hh]
    <;> ring
  have hR : R ≤ h ^ 2 / 2 := by
    exact reduced_triangle_circumradius_bound a b h ha hh hb hba hlen
  have hnear := barycentric_point_near_circumcircle_vertex
    a b h x y (a / 2) q R r s t hr hs ht hsum hx hy hc0 hc1 hc2
  rcases hnear with h0 | h1 | h2
  · exact Or.inl (h0.trans hR)
  · exact Or.inr (Or.inl (h1.trans hR))
  · exact Or.inr (Or.inr (h2.trans hR))

/-- The two triangles cover an entire basis parallelogram, including the
shared diagonal and all boundary edges. The conclusion supplies an actual
vertex of that same parallelogram. -/
theorem reduced_parallelogram_point_near_vertex
    (a b h s t : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hb : 0 ≤ b) (hba : b ≤ a / 2)
    (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2)
    (hs : 0 ≤ s) (hs1 : s ≤ 1) (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    (s * a + t * b) ^ 2 + (t * h) ^ 2 ≤ h ^ 2 / 2 ∨
      (s * a + t * b - a) ^ 2 + (t * h) ^ 2 ≤ h ^ 2 / 2 ∨
      (s * a + t * b - b) ^ 2 + (t * h - h) ^ 2 ≤ h ^ 2 / 2 ∨
      (s * a + t * b - (a + b)) ^ 2 + (t * h - h) ^ 2 ≤ h ^ 2 / 2 := by
  by_cases hst : s + t ≤ 1
  · have hn := reduced_triangle_point_near_vertex
      a b h (s * a + t * b) (t * h) (1 - s - t) s t
      ha hh hb hba hlen (by linarith) hs ht (by ring) rfl rfl
    rcases hn with h0 | h1 | h2
    · exact Or.inl h0
    · exact Or.inr (Or.inl h1)
    · exact Or.inr (Or.inr (Or.inl h2))
  · have hn := reduced_triangle_point_near_vertex
      a b h ((1 - s) * a + (1 - t) * b) ((1 - t) * h)
      (s + t - 1) (1 - s) (1 - t)
      ha hh hb hba hlen (by linarith) (by linarith) (by linarith)
      (by ring) rfl rfl
    rcases hn with h0 | h1 | h2
    · right; right; right
      nlinarith only [h0]
    · right; right; left
      nlinarith only [h1]
    · right; left
      nlinarith only [h2]







end Math15.LonelyRunner.TriangleCover
end 

/- Section: TrianglePlaneCover -/
section



/-!
Floor reduction of an arbitrary point to a basis parallelogram, followed by
the explicit triangular covering. This proves actual coordinate plane coverage
for a supplied reduced basis. Abstract reduced-basis existence,
projected-lattice construction, and intrinsic torus transfers are not asserted
here.
-/

namespace Math15.LonelyRunner.TriangleCover

/-- Floor coordinates put an arbitrary real point in a translated basis
parallelogram. The boundary convention uses closed unit intervals. -/
theorem exists_integer_parallelogram_coordinates
    (a b h x y : ℝ) (ha : 0 < a) (hh : 0 < h) :
    ∃ (i j : ℤ) (s t : ℝ),
      0 ≤ s ∧ s ≤ 1 ∧ 0 ≤ t ∧ t ≤ 1 ∧
      x = (i : ℝ) * a + (j : ℝ) * b + s * a + t * b ∧
      y = (j : ℝ) * h + t * h := by
  let alpha : ℝ := (x - b * (y / h)) / a
  let beta : ℝ := y / h
  let i : ℤ := Int.floor alpha
  let j : ℤ := Int.floor beta
  let s : ℝ := alpha - (i : ℝ)
  let t : ℝ := beta - (j : ℝ)
  have hi0 : (i : ℝ) ≤ alpha := Int.floor_le _
  have hi1 : alpha < (i : ℝ) + 1 := Int.lt_floor_add_one _
  have hj0 : (j : ℝ) ≤ beta := Int.floor_le _
  have hj1 : beta < (j : ℝ) + 1 := Int.lt_floor_add_one _
  have hxdiv : alpha * a = x - b * beta := by
    dsimp [alpha, beta]
    exact div_mul_cancel₀ _ (ne_of_gt ha)
  have hydiv : beta * h = y := by
    dsimp [beta]
    exact div_mul_cancel₀ _ (ne_of_gt hh)
  refine ⟨i, j, s, t, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [s]; linarith
  · dsimp [s]; linarith
  · dsimp [t]; linarith
  · dsimp [t]; linarith
  · dsimp [s, t]
    nlinarith only [hxdiv]
  · dsimp [t]
    nlinarith only [hydiv]

/-- For the nonnegative horizontal projection convention, the chosen
nearest point is one of the four vertices of the point's basis cell. -/
theorem exists_reduced_triangle_nearest_nonnegative
    (a b h x y : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hb : 0 ≤ b) (hba : b ≤ a / 2)
    (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    ∃ i j : ℤ,
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2 ≤ h ^ 2 / 2 := by
  obtain ⟨i, j, s, t, hs, hs1, ht, ht1, hx, hy⟩ :=
    exists_integer_parallelogram_coordinates a b h x y ha hh
  have hn := reduced_parallelogram_point_near_vertex
    a b h s t ha hh hb hba hlen hs hs1 ht ht1
  rcases hn with h0 | h1 | h2 | h3
  · refine ⟨i, j, ?_⟩
    rw [hx, hy]
    nlinarith only [h0]
  · refine ⟨i + 1, j, ?_⟩
    push_cast
    rw [hx, hy]
    nlinarith only [h1]
  · refine ⟨i, j + 1, ?_⟩
    push_cast
    rw [hx, hy]
    nlinarith only [h2]
  · refine ⟨i + 1, j + 1, ?_⟩
    push_cast
    rw [hx, hy]
    nlinarith only [h3]

/-- Every point of the actual coordinate plane lies within squared
distance `h²/2` of a lattice point, for either sign of the reduced basis's
horizontal projection. -/
theorem exists_reduced_triangle_nearest
    (a b h x y : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    ∃ i j : ℤ,
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2 ≤ h ^ 2 / 2 := by
  have hb := abs_le.mp hproj
  by_cases hb0 : 0 ≤ b
  · exact exists_reduced_triangle_nearest_nonnegative a b h x y
      ha hh hb0 hb.2 hlen
  · have hneg : 0 ≤ -b := by linarith
    have hnegproj : -b ≤ a / 2 := by linarith [hb.1]
    have hneglen : a ^ 2 ≤ (-b) ^ 2 + h ^ 2 := by nlinarith only [hlen]
    obtain ⟨i, j, hij⟩ :=
      exists_reduced_triangle_nearest_nonnegative a (-b) h (-x) y
        ha hh hneg hnegproj hneglen
    refine ⟨-i, j, ?_⟩
    push_cast
    nlinarith only [hij]

/-- A point that misses every lattice point by more than eta produces
the explicit short vertical dual vector, with improved square constant1/2. -/
theorem triangle_vertical_dual_short_of_missed_point
    (a b h x y eta : ℝ) (ha : 0 < a) (hh : 0 < h) (heta : 0 < eta)
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2)
    (hmiss : ∀ i j : ℤ, eta ^ 2 <
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2) :
    (1 / h) ^ 2 < 1 / (2 * eta ^ 2) := by
  obtain ⟨i, j, hij⟩ := exists_reduced_triangle_nearest a b h x y ha hh hproj hlen
  have he : eta ^ 2 < h ^ 2 / 2 := (hmiss i j).trans_le hij
  rw [div_pow, one_pow]
  apply (div_lt_div_iff₀ (by positivity : (0 : ℝ) < h ^ 2)
    (by positivity : (0 : ℝ) < 2 * eta ^ 2)).2
  nlinarith

/-- The exhibited short vector has its actual integer pairings with the
supplied basis, not merely a numerical length bound. -/
theorem exists_short_triangle_dual_of_missed_point
    (a b h x y eta : ℝ) (ha : 0 < a) (hh : 0 < h) (heta : 0 < eta)
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2)
    (hmiss : ∀ i j : ℤ, eta ^ 2 <
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2) :
    ∃ y1 y2 : ℝ,
      y1 * a + y2 * 0 = 0 ∧ y1 * b + y2 * h = 1 ∧
      y1 ^ 2 + y2 ^ 2 < 1 / (2 * eta ^ 2) := by
  refine ⟨0, 1 / h, ?_, ?_, ?_⟩
  · ring
  · field_simp [ne_of_gt hh] <;> ring
  · simpa only [zero_pow (by decide : (2 : ℕ) ≠ 0), zero_add] using
      triangle_vertical_dual_short_of_missed_point
        a b h x y eta ha hh heta hproj hlen hmiss







end Math15.LonelyRunner.TriangleCover
end 

/- Section: GramTriangleTransference -/
section



/-!
Triangular planar covering in actual Gram coordinates. The Cartesian basis is
`(a,0),(b,sqrt(a*c-b^2))`; its squared metric is `a` times the supplied Gram
metric. No rotation theorem or square root of `a` is needed.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem gram_triangle_cartesian_identity (a b c x y : ℝ)
    (hD : 0 ≤ a * c - b ^ 2) :
    (a * x + b * y)^2 + (Real.sqrt (a * c - b ^ 2) * y)^2 =
      a * gramQuadratic a b c x y := by
  rw [mul_pow, Real.sq_sqrt hD]
  exact (gram_completing_square a b c x y).symm

/-- An actual common pair of integer coefficients attains the triangular
Gram error bound. The hypothesis is precisely a Gauss-reduced Gram matrix. -/
theorem exists_gram_triangle_nearest
    (a b c x y : ℝ) (ha : 0 < a) (hD : 0 < a * c - b ^ 2)
    (hlen : a ≤ c) (hproj : |2 * b| ≤ a) :
    ∃ i j : ℤ, gramQuadratic a b c (x - (i : ℝ)) (y - (j : ℝ)) ≤
      (a * c - b ^ 2) / (2 * a) := by
  have hh : 0 < Real.sqrt (a * c - b ^ 2) := Real.sqrt_pos.mpr hD
  have hb : |b| ≤ a / 2 := by
    have hp := abs_le.mp hproj
    apply abs_le.mpr
    constructor <;> linarith [hp.1, hp.2]
  have hcartlen : a ^ 2 ≤ b ^ 2 + (Real.sqrt (a * c - b ^ 2))^2 := by
    rw [Real.sq_sqrt hD.le]
    have hmul := mul_le_mul_of_nonneg_left hlen ha.le
    nlinarith only [hmul]
  obtain ⟨i, j, hij⟩ := TriangleCover.exists_reduced_triangle_nearest
    a b (Real.sqrt (a * c - b ^ 2)) (a*x+b*y)
    (Real.sqrt (a * c - b ^ 2)*y) ha hh hb hcartlen
  have hx : a*x+b*y-((i : ℝ)*a+(j : ℝ)*b) =
      a*(x-(i : ℝ))+b*(y-(j : ℝ)) := by ring
  have hy : Real.sqrt (a*c-b^2)*y-(j : ℝ)*Real.sqrt (a*c-b^2) =
      Real.sqrt (a*c-b^2)*(y-(j : ℝ)) := by ring
  rw [hx, hy, gram_triangle_cartesian_identity a b c
    (x-(i : ℝ)) (y-(j : ℝ)) hD.le, Real.sq_sqrt hD.le] at hij
  refine ⟨i, j, ?_⟩
  apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2*a)).2
  nlinarith only [hij]

/-- Exact replacement for the rectangle constant7/12. The already
exhibited Gram dual with pairings0,1 has squared length `a/(a*c-b^2)`. -/
theorem gram_triangle_dual_short_of_missed_point
    (a b c x y eta : ℝ) (ha : 0 < a) (hD : 0 < a * c - b ^ 2)
    (heta : 0 < eta) (hlen : a ≤ c) (hproj : |2 * b| ≤ a)
    (hmiss : ∀ i j : ℤ, eta ^ 2 <
      gramQuadratic a b c (x - (i : ℝ)) (y - (j : ℝ))) :
    a / (a * c - b ^ 2) < 1 / (2 * eta ^ 2) := by
  obtain ⟨i, j, hij⟩ := exists_gram_triangle_nearest a b c x y ha hD hlen hproj
  have he : eta ^ 2 < (a * c - b ^ 2) / (2*a) :=
    (hmiss i j).trans_le hij
  have heMul := (lt_div_iff₀ (by positivity : (0 : ℝ) < 2*a)).mp he
  apply (div_lt_div_iff₀ hD (by positivity : (0 : ℝ) < 2*eta^2)).2
  nlinarith only [heMul]





end Math15.LonelyRunner
end 
end 

/- Section: NativeTriangleConsumer -/
section



/-!
Native triangle-covering assembly for a primitive integer hyperplane. The
point, projected lattice, reduced basis, whole-kernel integral dual, and
lifted integer relation are the same actual objects throughout. The triangle
covering estimate improves the dual bound to 1/(2 eta^2).
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

theorem native_hyperplane_triangle_short_dual_of_missed_point (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x=0) (eta : ℝ) (heta : 0<eta)
    (hmiss : ∀ z : integerHyperplane4 m, eta^2 <
      dot4 (perpendicularProjection4 (realVec4 (b 0)) x -
        perpendicularProjection4 (realVec4 (b 0)) (realVec4 z))
        (perpendicularProjection4 (realVec4 (b 0)) x -
          perpendicularProjection4 (realVec4 (b 0)) (realVec4 z))) :
    ∃ y : Vec4 ℝ, y≠0 ∧ dot4 y (realVec4 m)=0 ∧
      dot4 y (realVec4 (b 0))=0 ∧
      (∀ z : integerHyperplane4 m, ∃ k : ℤ, dot4 y (realVec4 z)=(k : ℝ)) ∧
      dot4 y y < 1/(2*eta^2) := by
  let N := integerHyperplane4 m
  obtain ⟨p,q,r,s,hdet,ha,hD,hlen,hproj⟩ := native_gauss_projected_basis N b
  let U := changedBasisProjection N b p q
  let W := changedBasisProjection N b r s
  obtain ⟨B,C,hxspan⟩ := primitive_hyperplane_changed_projected_real_span m hm b
    p q r s hdet x hx
  have hcoefficient : ∀ i j : ℤ, eta^2 <
      gramQuadratic (dot4 U U) (dot4 U W) (dot4 W W)
        (B-(i : ℝ)) (C-(j : ℝ)) := by
    intro i j
    obtain ⟨z,hz⟩ := projected_integer_pair N b p q r s i j
    have herr : perpendicularProjection4 (realVec4 (b 0)) x -
        perpendicularProjection4 (realVec4 (b 0)) (realVec4 z) =
        combine4 (B-(i : ℝ)) U (C-(j : ℝ)) W := by
      rw [hxspan,hz]
      funext k
      simp [combine4,U,W,changedBasisProjection,N]
      ring
    have h := hmiss z
    rw [herr,dot4_combine_self] at h
    exact h
  have hshort := gram_triangle_dual_short_of_missed_point
    (dot4 U U) (dot4 U W) (dot4 W W) B C eta ha hD heta hlen hproj hcoefficient
  let y := changedProjectedDual N b p q r s
  obtain ⟨hyv,hyi⟩ := native_changedProjectedDual_integral N b p q r s hdet
  have hnorm : dot4 y y=dot4 U U/gramDet4 U W :=
    gramDual4_normSq U W (ne_of_gt hD)
  have hypair : dot4 y W=1 := (gramDual4_pairings U W (ne_of_gt hD)).2
  have hyne : y≠0 := by
    intro hy
    rw [hy] at hypair
    norm_num [dot4] at hypair
  have hbmem (i : Fin 3) : dot4 (realVec4 (b i)) (realVec4 m)=0 := by
    have hi : intDot m (b i : Vec4 ℤ)=0 := (b i).property
    have hr : realDot (realCast m) (realCast (b i : Vec4 ℤ))=0 := by
      rw [realDot_realCast,hi,Int.cast_zero]
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4,mul_comm] using hr
  have hpr (i : Fin 3) : dot4 (basisProjection N b i) (realVec4 m)=0 := by
    unfold basisProjection
    rw [dot4_symm,perpendicularProjection4_pairing,dot4_symm (realVec4 m),hbmem i,
      dot4_symm (realVec4 m),hbmem 0]
    simp
  have hUm : dot4 U (realVec4 m)=0 := by
    simp [U,changedBasisProjection,dot4_combine,hpr]
  have hWm : dot4 W (realVec4 m)=0 := by
    simp [W,changedBasisProjection,dot4_combine,hpr]
  refine ⟨y,hyne,gramDual4_orthogonal U W _ hUm hWm,hyv,hyi,?_⟩
  rw [hnorm]
  exact hshort

theorem native_primitive_triangle_short_second_relation (m v : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs)=1) (hmv : intDot m v=0)
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x=0) (eta : ℝ) (heta : 0<eta)
    (hmiss : ∀ z : integerHyperplane4 m, eta^2 <
      dot4 (perpendicularProjection4 (realVec4 v) x -
        perpendicularProjection4 (realVec4 v) (realVec4 z))
        (perpendicularProjection4 (realVec4 v) x -
          perpendicularProjection4 (realVec4 v) (realVec4 z))) :
    ∃ c : Vec4 ℤ, intDot c v=0 ∧
      (¬∃ t : ℝ, ∀ i, (c i : ℝ)=t*(m i : ℝ)) ∧
      areaSq4 (realVec4 m) (realVec4 c) <
        dot4 (realVec4 m) (realVec4 m)/(2*eta^2) := by
  obtain ⟨b,hb⟩ := primitive_hyperplane_basis_starts_at_vector m v hm hv hmv
  obtain ⟨y,hyne,hym,hyv,hyi,hshort⟩ := native_hyperplane_triangle_short_dual_of_missed_point
    m hm b x hx eta heta (by simpa only [hb] using hmiss)
  have hdual : ∀ z : Vec4 ℤ, intDot m z=0 →
      ∃ k : ℤ, realDot y (realCast z)=(k : ℝ) := by
    intro z hz
    obtain ⟨k,hk⟩ := hyi ⟨z,hz⟩
    refine ⟨k,?_⟩
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4] using hk
  have hym' : realDot y (realCast m)=0 := by
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4] using hym
  have hyv' : realDot y (realCast v)=0 := by
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4,hb] using hyv
  obtain ⟨c,hcv,hind,harea⟩ := primitive_dual_relation m v hm hmv y hym' hyv' hyne hdual
  have hmpos : 0<dot4 (realVec4 m) (realVec4 m) := primitive_realCast_dot4_positive m hm
  have heq : areaSq4 (realVec4 m) (realVec4 c)=
