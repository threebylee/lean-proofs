/-- The pair2q,3q has an explicit common quarter interval. -/
theorem small_pair_quarter_interval {q : ℕ} (hq : 0<q) {x : ℝ}
    (hlo : 1/(8*(q : ℝ))≤x) (hhi : x≤1/(4*(q : ℝ))) :
    ∀v∈({2*q,3*q} : Finset ℕ),
      (1/4 : ℝ)≤distance (v • (x : Time)) := by
  have hqR : (0 : ℝ)<q := by exact_mod_cast hq
  have hlo' := (div_le_iff₀ (by positivity : (0 : ℝ)<8*(q : ℝ))).mp hlo
  have hhi' := (le_div_iff₀ (by positivity : (0 : ℝ)<4*(q : ℝ))).mp hhi
  intro v hv
  simp only [Finset.mem_insert,Finset.mem_singleton] at hv
  rcases hv with rfl|rfl
  · apply distance_ge_quarter_of_interval (j:=0)
    all_goals norm_num only [Nat.cast_mul,Nat.cast_ofNat,Int.cast_zero]
    all_goals nlinarith
  · apply distance_ge_quarter_of_interval (j:=0)
    all_goals norm_num only [Nat.cast_mul,Nat.cast_ofNat,Int.cast_zero]
    all_goals nlinarith

theorem ML_ge_quarter_small_pair_two_late {q c d : ℕ}
    (hq : 0<q) (hc : 12*q≤c) (hcd : c≤d) :
    (1/4 : ℝ)≤ML (finiteQuartetSpeeds (2*q) (3*q) c d) := by
  have hqR : (0 : ℝ)<q := by exact_mod_cast hq
  have hcR : 12*(q : ℝ)≤c := by exact_mod_cast hc
  have hwidth : (3/2 : ℝ)≤(c : ℝ)*(1/(4*(q : ℝ))-1/(8*(q : ℝ))) := by
    have he : (c : ℝ)*(1/(4*(q : ℝ))-1/(8*(q : ℝ)))=
        (c : ℝ)/(8*(q : ℝ)) := by
      field_simp [ne_of_gt hqR]
      ring
    rw [he]
    apply (le_div_iff₀ (by positivity : (0 : ℝ)<8*(q : ℝ))).mpr
    nlinarith
  have hset : finiteQuartetSpeeds (2*q) (3*q) c d=
      insert c (insert d ({2*q,3*q} : Finset ℕ)) := by
    ext v
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton]
    tauto
  rw [hset]
  exact ML_ge_quarter_of_two_late_speeds (A:=1/(8*(q : ℝ)))
    (B:=1/(4*(q : ℝ))) (by omega) hcd hwidth
    (fun x hlo hhi => small_pair_quarter_interval hq hlo hhi)

/-- Membership of2q and3q rigidly determines a scaled123 core. -/
theorem small_pair_tight_core_forces_third {q c : ℕ} (hq : 0<q)
    (hc2 : c≠2*q) (hc3 : c≠3*q)
    (ht : ∃a : ℕ,0<a ∧ ({2*q,3*q,c} : Finset ℕ)={a,2*a,3*a}) : c=q := by
  obtain ⟨a,ha,hset⟩ := ht
  have h2 : 2*q∈({a,2*a,3*a} : Finset ℕ) := by rw [←hset]; simp
  have h3 : 3*q∈({a,2*a,3*a} : Finset ℕ) := by rw [←hset]; simp
  have hcm : c∈({a,2*a,3*a} : Finset ℕ) := by rw [←hset]; simp
  simp only [Finset.mem_insert,Finset.mem_singleton] at h2 h3 hcm
  have haq : a=q := by omega
  omega

/-- A literal core subset proof with no propositional search over the
surrounding primitive, gcd, cardinality, or tightness hypotheses. -/
theorem finite_quartet_first_three_positive {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d)) :
    Positive ({a,b,c} : Finset ℕ) := by
  intro v hv
  apply hp v
  simp only [Finset.mem_insert,Finset.mem_singleton] at hv
  simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton]
  rcases hv with hv | hv | hv
  · exact Or.inl hv
  · exact Or.inr (Or.inl hv)
  · exact Or.inr (Or.inr (Or.inl hv))

theorem finite_quartet_first_three_card {a b c d : ℕ}
    (hc : (finiteQuartetSpeeds a b c d).card=4) :
    ({a,b,c} : Finset ℕ).card=3 := by
  obtain ⟨hab,hac,had,hbc,hbd,hcd⟩ := finite_quartet_four_distinct hc
  simp [hab,hac,hbc]

/-- Reordering the literal last insertion is independent of every
arithmetic and analytic hypothesis. -/
theorem finite_quartet_insert_last (a b c d : ℕ) :
