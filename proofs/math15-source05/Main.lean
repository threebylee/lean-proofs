  · exact Or.inl htarget
  · have hnorm15 := width_seven_integer_norm_le_fifteen m hwidth hnorm
    have hM : dot4 (realVec4 m) (realVec4 m)≤15 := by
      rw [realVec4_dot4]
      exact_mod_cast hnorm15
    have hA : ((areaSq4 m c : ℤ) : ℝ)<(392/25 : ℝ)*15 := by
