/- Section: RelationWidth -/
section







/-!
Two actual relation inputs for the width-four geometry.

Every integer z equals natAbs(z) plus an even integer. Summing this identity
and using L1=4 proves that the sum of the signed coefficients is even.

For the squared bound, no absolute coefficient can equal four: all others
would be zero, and four would divide the actual coordinate gcd, contradicting
primitivity. Thus all absolute coefficients are at most three. If one is
three, the remaining three sum to one and their squares sum to one, giving the
sharp bound ten. If none is three, n^2 <= 2n for each coefficient, giving the
stronger bound eight. The transfer uses the actual four coefficients and their
Finset.univ gcd; no finite sample or unproved width lemma is used.
-/

noncomputable section
namespace Math15.LonelyRunner

def relationL1 (m : Fin 4 → ℤ) : ℕ := ∑ i, (m i).natAbs

theorem integer_eq_natAbs_add_even (z : ℤ) :
    ∃ q : ℤ, z=(z.natAbs : ℤ)+2*q := by
  rcases Int.natAbs_eq z with h | h
  · exact ⟨0,by simpa using h⟩
  · refine ⟨-(z.natAbs : ℤ),?_⟩
    calc
      z=-(z.natAbs : ℤ) := h
      _=(z.natAbs : ℤ)+2*(-(z.natAbs : ℤ)) := by ring

theorem relation_width_four_sum_even {m : Fin 4 → ℤ}
    (hwidth : relationL1 m=4) : ∃ j : ℤ, (∑ i, m i)=2*j := by
  choose q hq using fun i : Fin 4 => integer_eq_natAbs_add_even (m i)
  have h4 : (∑ i, ((m i).natAbs : ℤ))=4 := by
    unfold relationL1 at hwidth
    exact_mod_cast hwidth
  have he : (∑ i, m i)=(∑ i, ((m i).natAbs : ℤ))+2*(∑ i, q i) := by
    calc
      (∑ i, m i)=(∑ i, (((m i).natAbs : ℤ)+2*q i)) := by
        apply Finset.sum_congr rfl
        intro i hi
        exact hq i
      _ = (∑ i, ((m i).natAbs : ℤ))+2*(∑ i, q i) := by
        rw [Finset.sum_add_distrib,←Finset.mul_sum]
  refine ⟨2+(∑ i, q i),?_⟩
  rw [he,h4]
  ring

theorem nat_square_eq_self_of_le_one {a : ℕ} (h : a≤1) : a^2=a := by
  have ha : a=0 ∨ a=1 := by omega
  rcases ha with rfl | rfl <;> norm_num

theorem nat_three_sum_one_squares {a b c : ℕ} (hsum : a+b+c=1) :
    a^2+b^2+c^2=1 := by
  have ha : a≤1 := by omega
  have hb : b≤1 := by omega
  have hc : c≤1 := by omega
  rw [nat_square_eq_self_of_le_one ha,nat_square_eq_self_of_le_one hb,
    nat_square_eq_self_of_le_one hc]
  exact hsum

theorem nat_square_le_twice_of_le_two {a : ℕ} (ha : a≤2) : a^2≤2*a := by
  have hmul := Nat.mul_le_mul_left a ha
  nlinarith

/-- The primitive condition is the gcd of these actual four coordinates. -/
theorem width_four_nat_squares_le_ten (a b c d : ℕ)
    (hsum : a+b+c+d=4) (hprim : Nat.gcd (Nat.gcd a b) (Nat.gcd c d)=1) :
    a^2+b^2+c^2+d^2≤10 := by
  have ha : a≤3 := by
    by_contra hn
    have ha4 : a=4 := by omega
    have hb0 : b=0 := by omega
    have hc0 : c=0 := by omega
    have hd0 : d=0 := by omega
    norm_num [ha4,hb0,hc0,hd0] at hprim
  have hb : b≤3 := by
    by_contra hn
    have hb4 : b=4 := by omega
    have ha0 : a=0 := by omega
    have hc0 : c=0 := by omega
    have hd0 : d=0 := by omega
    norm_num [ha0,hb4,hc0,hd0] at hprim
  have hc : c≤3 := by
    by_contra hn
    have hc4 : c=4 := by omega
    have ha0 : a=0 := by omega
    have hb0 : b=0 := by omega
    have hd0 : d=0 := by omega
    norm_num [ha0,hb0,hc4,hd0] at hprim
  have hd : d≤3 := by
    by_contra hn
    have hd4 : d=4 := by omega
    have ha0 : a=0 := by omega
    have hb0 : b=0 := by omega
    have hc0 : c=0 := by omega
    norm_num [ha0,hb0,hc0,hd4] at hprim
  by_cases ha3 : a=3
  · have hs : b+c+d=1 := by omega
    have hsq := nat_three_sum_one_squares hs
    nlinarith
  by_cases hb3 : b=3
  · have hs : a+c+d=1 := by omega
    have hsq := nat_three_sum_one_squares hs
    nlinarith
  by_cases hc3 : c=3
  · have hs : a+b+d=1 := by omega
    have hsq := nat_three_sum_one_squares hs
    nlinarith
  by_cases hd3 : d=3
  · have hs : a+b+c=1 := by omega
    have hsq := nat_three_sum_one_squares hs
    nlinarith
  have ha2 : a≤2 := by omega
  have hb2 : b≤2 := by omega
  have hc2 : c≤2 := by omega
  have hd2 : d≤2 := by omega
  have hqa := nat_square_le_twice_of_le_two ha2
  have hqb := nat_square_le_twice_of_le_two hb2
  have hqc := nat_square_le_twice_of_le_two hc2
  have hqd := nat_square_le_twice_of_le_two hd2
  nlinarith

theorem relation_actual_gcd_eq_balanced (m : Fin 4 → ℤ) :
    (Finset.univ.gcd fun i => (m i).natAbs)=
      Nat.gcd (Nat.gcd (m 0).natAbs (m 1).natAbs)
        (Nat.gcd (m 2).natAbs (m 3).natAbs) := by
  have hu : (Finset.univ : Finset (Fin 4))={0,1,2,3} := by decide
  rw [hu]
  simp [Finset.gcd_insert,Finset.gcd_singleton,gcd_eq_nat_gcd,Nat.gcd_assoc]

theorem relation_width_four_natAbs_squares_le_ten {m : Fin 4 → ℤ}
    (hwidth : relationL1 m=4)
    (hprim : (Finset.univ.gcd fun i => (m i).natAbs)=1) :
    (∑ i, (m i).natAbs^2)≤10 := by
  have hs : (m 0).natAbs+(m 1).natAbs+(m 2).natAbs+(m 3).natAbs=4 := by
    simpa only [relationL1,Fin.sum_univ_four] using hwidth
  rw [relation_actual_gcd_eq_balanced] at hprim
  simpa only [Fin.sum_univ_four] using width_four_nat_squares_le_ten
    (m 0).natAbs (m 1).natAbs (m 2).natAbs (m 3).natAbs hs hprim

theorem relation_width_four_integer_squares_le_ten {m : Fin 4 → ℤ}
    (hwidth : relationL1 m=4)
    (hprim : (Finset.univ.gcd fun i => (m i).natAbs)=1) :
    (∑ i, (m i)^2)≤(10 : ℤ) := by
  have hN := relation_width_four_natAbs_squares_le_ten hwidth hprim
  have hZ : (∑ i, (((m i).natAbs : ℤ)^2))≤(10 : ℤ) := by
    exact_mod_cast hN
  simpa only [Int.natAbs_pow_two] using hZ

theorem relation_width_four_real_squares_le_ten {m : Fin 4 → ℤ}
    (hwidth : relationL1 m=4)
    (hprim : (Finset.univ.gcd fun i => (m i).natAbs)=1) :
    (∑ i, (m i : ℝ)^2)≤(10 : ℝ) := by
  exact_mod_cast relation_width_four_integer_squares_le_ten hwidth hprim









end Math15.LonelyRunner
end 
end 

/- Section: NativeSmallWidthReduction -/
section







/-!
Canonical small-relation reduction using one actual lattice basis. No torus
classification, point miss, reduced basis or covolume assertion is left as a
