        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨0,2,3,1,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨0,3,1,2,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨0,3,2,1,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨1,2,0,3,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨1,3,0,2,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inl ⟨2,3,0,1,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inr ⟨1,0,2,3,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inr ⟨2,0,1,3,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inr ⟨3,0,1,2,
        by unfold RelationCoordinateOrder; decide,
        Or.inr ⟨rfl,rfl,rfl,rfl⟩⟩)

/-- Fixed first coefficient 2; default-resource bounded coefficient proof. -/
theorem width_three_first_two (b c d : ℤ) (v : Fin 4 → ℕ)
    (hp : ∀ i, 0<v i)
    (hdot : (2 : ℤ)*(v 0 : ℤ)+b*(v 1 : ℤ)+c*(v 2 : ℤ)+d*(v 3 : ℤ)=0)
    (hwidth : (2 : ℤ).natAbs+b.natAbs+c.natAbs+d.natAbs=3) :
    RelationAdditiveForm (![(2 : ℤ),b,c,d]) ∨ RelationDoubleForm (![(2 : ℤ),b,c,d]) := by
  have hv0 : (0 : ℤ)<v 0 := by exact_mod_cast hp 0
  have hv1 : (0 : ℤ)<v 1 := by exact_mod_cast hp 1
  have hv2 : (0 : ℤ)<v 2 := by exact_mod_cast hp 2
  have hv3 : (0 : ℤ)<v 3 := by exact_mod_cast hp 3
  norm_num at hwidth
  obtain ⟨hbl,hbu⟩ := integer_bounds_of_natAbs_le (show b.natAbs≤1 by omega)
  obtain ⟨hcl,hcu⟩ := integer_bounds_of_natAbs_le (show c.natAbs≤1 by omega)
  obtain ⟨hdl,hdu⟩ := integer_bounds_of_natAbs_le (show d.natAbs≤1 by omega)
  interval_cases b
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases c
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases d
  all_goals norm_num at hwidth
  all_goals norm_num at hdot
  all_goals first
    | omega
    | (exact Or.inr ⟨0,1,2,3,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inr ⟨0,2,1,3,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)
    | (exact Or.inr ⟨0,3,1,2,
        by unfold RelationCoordinateOrder; decide,
        Or.inl ⟨rfl,rfl,rfl,rfl⟩⟩)

/-- Fixed first coefficient 3; default-resource bounded coefficient proof. -/
theorem width_three_first_three (b c d : ℤ) (v : Fin 4 → ℕ)
    (hp : ∀ i, 0<v i)
    (hdot : (3 : ℤ)*(v 0 : ℤ)+b*(v 1 : ℤ)+c*(v 2 : ℤ)+d*(v 3 : ℤ)=0)
    (hwidth : (3 : ℤ).natAbs+b.natAbs+c.natAbs+d.natAbs=3) :
    RelationAdditiveForm (![(3 : ℤ),b,c,d]) ∨ RelationDoubleForm (![(3 : ℤ),b,c,d]) := by
  have hv0 : (0 : ℤ)<v 0 := by exact_mod_cast hp 0
  have hv1 : (0 : ℤ)<v 1 := by exact_mod_cast hp 1
  have hv2 : (0 : ℤ)<v 2 := by exact_mod_cast hp 2
  have hv3 : (0 : ℤ)<v 3 := by exact_mod_cast hp 3
  norm_num at hwidth
  obtain ⟨hbl,hbu⟩ := integer_bounds_of_natAbs_le (show b.natAbs≤0 by omega)
  obtain ⟨hcl,hcu⟩ := integer_bounds_of_natAbs_le (show c.natAbs≤0 by omega)
  obtain ⟨hdl,hdu⟩ := integer_bounds_of_natAbs_le (show d.natAbs≤0 by omega)
  interval_cases b
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases c
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases d
  all_goals norm_num at hwidth
  all_goals norm_num at hdot
  all_goals first
    | omega

/-- Same original export, assembled from the separate first-coordinate proofs. -/
theorem width_three_integer_coefficients_normal_form (a b c d : ℤ) (v : Fin 4 → ℕ)
    (hp : ∀ i, 0<v i)
    (hdot : a*(v 0 : ℤ)+b*(v 1 : ℤ)+c*(v 2 : ℤ)+d*(v 3 : ℤ)=0)
    (hwidth : a.natAbs+b.natAbs+c.natAbs+d.natAbs=3) :
    RelationAdditiveForm (![a,b,c,d]) ∨ RelationDoubleForm (![a,b,c,d]) := by
  obtain ⟨hal,hau⟩ := integer_bounds_of_natAbs_le (show a.natAbs≤3 by omega)
  interval_cases a
  · exact width_three_first_neg_three b c d v hp hdot hwidth
  · exact width_three_first_neg_two b c d v hp hdot hwidth
  · exact width_three_first_neg_one b c d v hp hdot hwidth
  · exact width_three_first_zero b c d v hp hdot hwidth
  · exact width_three_first_one b c d v hp hdot hwidth
  · exact width_three_first_two b c d v hp hdot hwidth
  · exact width_three_first_three b c d v hp hdot hwidth
theorem relation_width_le_two_eq_zero {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : ∀ i, 0<v i) (hinj : Function.Injective v)
    (hdot : naturalRelationDot m v=0) (hwidth : relationL1 m≤2) : m=0 := by
  have hd : (m 0)*(v 0 : ℤ)+(m 1)*(v 1 : ℤ)+
      (m 2)*(v 2 : ℤ)+(m 3)*(v 3 : ℤ)=0 := by
    simpa only [naturalRelationDot,Fin.sum_univ_four] using hdot
  have hw : (m 0).natAbs+(m 1).natAbs+(m 2).natAbs+(m 3).natAbs≤2 := by
    simpa only [relationL1,Fin.sum_univ_four] using hwidth
  obtain ⟨h0,h1,h2,h3⟩ := width_two_integer_coefficients_zero
    (m 0) (m 1) (m 2) (m 3) v hp hinj hd hw
  funext i
  fin_cases i
  · exact h0
  · exact h1
  · exact h2
  · exact h3

theorem relation_width_ge_three_of_nonzero {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : ∀ i, 0<v i) (hinj : Function.Injective v)
    (hdot : naturalRelationDot m v=0) (hm : m≠0) : 3≤relationL1 m := by
  by_contra h
  exact hm (relation_width_le_two_eq_zero hp hinj hdot (by omega))

theorem positiveLineSpeeds_card_four_injective {v : Fin 4 → ℕ}
    (hc : (positiveLineSpeeds v).card=4) : Function.Injective v := by
  have hEq : (Finset.univ.image v).card=(Finset.univ : Finset (Fin 4)).card := by
    simpa only [positiveLineSpeeds,Finset.card_univ,Fintype.card_fin] using hc
  have hinj := Finset.card_image_iff.mp hEq
  intro i j hij
  exact hinj (by simp) (by simp) hij

theorem relation_width_ge_three_of_four_speeds {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : Positive (positiveLineSpeeds v)) (hc : (positiveLineSpeeds v).card=4)
    (hdot : naturalRelationDot m v=0) (hm : m≠0) : 3≤relationL1 m := by
  exact relation_width_ge_three_of_nonzero
    (fun i => hp _ (line_speed_mem v i)) (positiveLineSpeeds_card_four_injective hc)
    hdot hm

theorem relation_width_three_normal_form {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : ∀ i, 0<v i) (hdot : naturalRelationDot m v=0)
    (hwidth : relationL1 m=3) : RelationAdditiveForm m ∨ RelationDoubleForm m := by
  have hd : (m 0)*(v 0 : ℤ)+(m 1)*(v 1 : ℤ)+
      (m 2)*(v 2 : ℤ)+(m 3)*(v 3 : ℤ)=0 := by
    simpa only [naturalRelationDot,Fin.sum_univ_four] using hdot
  have hw : (m 0).natAbs+(m 1).natAbs+(m 2).natAbs+(m 3).natAbs=3 := by
    simpa only [relationL1,Fin.sum_univ_four] using hwidth
  have he : (![m 0,m 1,m 2,m 3] : Fin 4 → ℤ)=m := by
    funext i
    fin_cases i <;> rfl
  simpa only [he] using width_three_integer_coefficients_normal_form
    (m 0) (m 1) (m 2) (m 3) v hp hd hw

theorem relation_coordinate_order_sum {i j k l : Fin 4}
    (horder : RelationCoordinateOrder i j k l) (f : Fin 4 → ℤ) :
    (∑ r, f r)=f i+f j+f k+f l := by
  obtain ⟨hij,hik,hil,hjk,hjl,hkl⟩ := horder
  have hcard : ({i,j,k,l} : Finset (Fin 4)).card=4 :=
    Finset.card_eq_four.mpr ⟨i,j,k,l,hij,hik,hil,hjk,hjl,hkl,rfl⟩
  have hset : ({i,j,k,l} : Finset (Fin 4))=Finset.univ :=
    Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
      (by simpa only [Finset.card_univ,Fintype.card_fin] using hcard.ge)
  have hni : i∉({j,k,l} : Finset (Fin 4)) := by
    simp only [Finset.mem_insert,Finset.mem_singleton,not_or]
    exact ⟨hij,hik,hil⟩
  have hnj : j∉({k,l} : Finset (Fin 4)) := by
    simp only [Finset.mem_insert,Finset.mem_singleton,not_or]
    exact ⟨hjk,hjl⟩
  have hnk : k∉({l} : Finset (Fin 4)) := by
    simpa only [Finset.mem_singleton] using hkl
  rw [←hset]
  simp only [Finset.sum_insert hni,Finset.sum_insert hnj,Finset.sum_insert hnk,
    Finset.sum_singleton,add_assoc]

theorem additive_speeds_of_relation_form {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hform : RelationAdditiveForm m) (hdot : naturalRelationDot m v=0) :
    ∃ i j k : Fin 4, i≠j ∧ i≠k ∧ j≠k ∧ v i+v j=v k := by
  obtain ⟨i,j,k,l,horder,hsigns⟩ := hform
  have hd : m i*(v i : ℤ)+m j*(v j : ℤ)+m k*(v k : ℤ)+m l*(v l : ℤ)=0 := by
    have he := relation_coordinate_order_sum horder (fun r => m r*(v r : ℤ))
    unfold naturalRelationDot at hdot
    rwa [he] at hdot
  have he : (v i : ℤ)+(v j : ℤ)=(v k : ℤ) := by
    rcases hsigns with ⟨hi,hj,hk,hl⟩ | ⟨hi,hj,hk,hl⟩
    · rw [hi,hj,hk,hl] at hd
      nlinarith
    · rw [hi,hj,hk,hl] at hd
      nlinarith
  refine ⟨i,j,k,horder.1,horder.2.1,horder.2.2.2.1,?_⟩
  exact_mod_cast he

theorem double_speeds_of_relation_form {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hform : RelationDoubleForm m) (hdot : naturalRelationDot m v=0) :
    ∃ i j : Fin 4, i≠j ∧ 2*v i=v j := by
  obtain ⟨i,j,k,l,horder,hsigns⟩ := hform
  have hd : m i*(v i : ℤ)+m j*(v j : ℤ)+m k*(v k : ℤ)+m l*(v l : ℤ)=0 := by
    have he := relation_coordinate_order_sum horder (fun r => m r*(v r : ℤ))
    unfold naturalRelationDot at hdot
    rwa [he] at hdot
  have he : 2*(v i : ℤ)=(v j : ℤ) := by
    rcases hsigns with ⟨hi,hj,hk,hl⟩ | ⟨hi,hj,hk,hl⟩
    · rw [hi,hj,hk,hl] at hd
      nlinarith
    · rw [hi,hj,hk,hl] at hd
      nlinarith
  refine ⟨i,j,horder.1,?_⟩
  exact_mod_cast he

theorem double_relation_speed_scale_one_or_two {v : Fin 4 → ℕ} {i j : Fin 4}
    (hp : Positive (positiveLineSpeeds v))
    (hpair : ∀ a∈positiveLineSpeeds v, ∀ b∈positiveLineSpeeds v,
      a≠b → Nat.gcd a b≤2) (hdouble : 2*v i=v j) : v i=1 ∨ v i=2 := by
  have hi := line_speed_mem v i
  have hj := line_speed_mem v j
  have hap : 0<v i := hp _ hi
  have hne : v i≠v j := by omega
  have hle := hpair _ hi _ hj hne
  have hdiv : v i ∣ Nat.gcd (v i) (v j) := by
    apply Nat.dvd_gcd (dvd_refl _)
    rw [←hdouble]
    exact dvd_mul_left (v i) 2
  have ha2 : v i≤2 :=
    (Nat.le_of_dvd (Nat.gcd_pos_of_pos_left (v j) hap) hdiv).trans hle
  omega

theorem source05_of_double_relation_form {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : Positive (positiveLineSpeeds v)) (hc : (positiveLineSpeeds v).card=4)
    (hpair : ∀ a∈positiveLineSpeeds v, ∀ b∈positiveLineSpeeds v,
      a≠b → Nat.gcd a b≤2)
    (hdot : naturalRelationDot m v=0) (hform : RelationDoubleForm m) :
    (1/4 : ℝ)≤ML (positiveLineSpeeds v) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (positiveLineSpeeds v)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨i,j,hij,hdouble⟩ := double_speeds_of_relation_form hform hdot
  have hscale := double_relation_speed_scale_one_or_two hp hpair hdouble
  rcases hscale with hi | hi
  · have h1 : 1∈positiveLineSpeeds v := by simpa only [hi] using line_speed_mem v i
    have hj2 : v j=2 := by omega
    have h2 : 2∈positiveLineSpeeds v := by simpa only [hj2] using line_speed_mem v j
    exact source05_of_one_two hp hc hpair h1 h2
  · have h2 : 2∈positiveLineSpeeds v := by simpa only [hi] using line_speed_mem v i
    have hj4 : v j=4 := by omega
    have h4 : 4∈positiveLineSpeeds v := by simpa only [hj4] using line_speed_mem v j
    exact source05_of_two_four hp hc hpair h2 h4

/-- The additive width-three branch retains the actual additive relation;
the double branch is discharged at the original Source05 conclusion. -/
theorem source05_or_additive_form_of_width_three {m : Fin 4 → ℤ} {v : Fin 4 → ℕ}
    (hp : Positive (positiveLineSpeeds v)) (hc : (positiveLineSpeeds v).card=4)
    (hpair : ∀ a∈positiveLineSpeeds v, ∀ b∈positiveLineSpeeds v,
      a≠b → Nat.gcd a b≤2)
    (hdot : naturalRelationDot m v=0) (hwidth : relationL1 m=3) :
    ((1/4 : ℝ)≤ML (positiveLineSpeeds v) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (positiveLineSpeeds v)=(s : ℝ)/(4*(s : ℝ)+k)) ∨
      RelationAdditiveForm m := by
  have hpv : ∀ i, 0<v i := fun i => hp _ (line_speed_mem v i)
  rcases relation_width_three_normal_form hpv hdot hwidth with ha | hd
  · exact Or.inr ha
  · exact Or.inl (source05_of_double_relation_form hp hc hpair hdot hd)




























