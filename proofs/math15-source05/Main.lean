theorem source05_native_set_target_or_sum444 (V : Finset ℕ)
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀a∈V,∀b∈V,a≠b→Nat.gcd a b≤2) :
    FiniteSource05Conclusion V ∨ V.sum id≤444 := by
  obtain ⟨a,b,c,d,_,_,_,_,hV,_⟩ := positive_quartet_sorted_representation hp hc
  let v : Fin 4 → ℕ := ![a,b,c,d]
