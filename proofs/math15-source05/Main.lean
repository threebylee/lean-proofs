/- Section: SharedInsertion -/
section


/-!
A shared insertion bound, ported from the checked Source06 InsertionBound
argument to Source05's canonical definitions.

If a positive nonempty core W has maximum speed at most B and ML W > 1/4, then
adding a positive speed m with resulting ML < 1/4 forces m < 2*B^2. The
rational pair-grid theorem controls the gap above 1/4. This does not handle
the exact core value ML W = 1/4 and does not settle Target05.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem distance_adjustment (m : ℕ) (hm : 0 < m) (L t : ℝ)
    (hL : 0 ≤ L) (hhalf : L ≤ 1 / 2) :
    ∃ δ : ℝ, |δ| ≤ L / m ∧ L ≤ ‖(((m : ℝ) * (t + δ) : ℝ) : Time)‖ := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hm0 : (m : ℝ) ≠ 0 := ne_of_gt hmR
  by_cases hgood : L ≤ ‖(((m : ℝ) * t : ℝ) : Time)‖
  · exact ⟨0, by simpa using div_nonneg hL hmR.le, by simpa using hgood⟩
  let k : ℤ := round ((m : ℝ) * t)
  let r : ℝ := (m : ℝ) * t - k
  have hr : |r| < L := by
    have hh := lt_of_not_ge hgood
    rw [AddCircle.norm_eq] at hh
    simpa only [r, k, inv_one, one_mul, mul_one] using hh
  have hk : (((k : ℤ) : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨k, by simp⟩
  by_cases hrs : 0 ≤ r
  · let δ : ℝ := (L - r) / m
    have hrL : r ≤ L := (le_abs_self r).trans hr.le
    have hδ : 0 ≤ δ := div_nonneg (sub_nonneg.mpr hrL) hmR.le
    refine ⟨δ, ?_, ?_⟩
    · rw [abs_of_nonneg hδ]
      exact (div_le_div_iff_of_pos_right hmR).mpr (by linarith)
    · have heq : (m : ℝ) * (t + δ) = (k : ℝ) + L := by
        dsimp [δ, r] at *
        field_simp
        nlinarith
      rw [heq, AddCircle.coe_add, hk, zero_add]
      have he : ‖(L : Time)‖ = L := by
        simpa only [abs_of_nonneg hL] using
          (AddCircle.norm_coe_eq_abs_iff (p := (1 : ℝ)) (x := L) (by norm_num)).mpr
            (by simpa [abs_of_nonneg hL] using hhalf)
      exact he.ge
  · let δ : ℝ := (-L - r) / m
    have hrs' : r < 0 := lt_of_not_ge hrs
    have hrL : -L ≤ r := by have := neg_le_abs r; linarith
    have hδ : δ ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) hmR.le
    refine ⟨δ, ?_, ?_⟩
    · rw [abs_of_nonpos hδ]
      dsimp [δ]
      rw [← neg_div]
      apply (div_le_div_iff_of_pos_right hmR).mpr
      linarith
    · have heq : (m : ℝ) * (t + δ) = (k : ℝ) - L := by
        dsimp [δ, r] at *
        field_simp
        nlinarith
      rw [heq, AddCircle.coe_sub, hk, zero_sub, norm_neg]
      have he : ‖(L : Time)‖ = L := by
        simpa only [abs_of_nonneg hL] using
          (AddCircle.norm_coe_eq_abs_iff (p := (1 : ℝ)) (x := L) (by norm_num)).mpr
            (by simpa [abs_of_nonneg hL] using hhalf)
      exact he.ge

theorem slow_distance_loss (v : ℕ) (t δ : ℝ) :
    ‖(((v : ℝ) * t : ℝ) : Time)‖ - (v : ℝ) * |δ| ≤
      ‖(((v : ℝ) * (t + δ) : ℝ) : Time)‖ := by
  have h := norm_sub_norm_le ((((v : ℝ) * t : ℝ) : Time))
    ((((v : ℝ) * (t + δ) : ℝ) : Time))
  have heq : ((((v : ℝ) * t : ℝ) : Time)) -
      ((((v : ℝ) * (t + δ) : ℝ) : Time)) =
      v • (((-δ : ℝ) : Time)) := by
    rw [← AddCircle.coe_sub, ← AddCircle.coe_nsmul]
    congr 1
    simp only [nsmul_eq_mul]
    ring
  rw [heq] at h
  have hnorm : ‖((-δ : ℝ) : Time)‖ ≤ |δ| := by
    rw [AddCircle.norm_eq]
    have hr := round_le (-δ) (0 : ℤ)
    simpa using hr
  have hb := (norm_nsmul_le (n := v) (a := ((-δ : ℝ) : Time))).trans
    (mul_le_mul_of_nonneg_left hnorm (Nat.cast_nonneg v))
  linarith

/-- The insertion form of Kravitz's perturbation bound, without a speed-order hypothesis. -/
theorem insertion_lower_bound (W : Finset ℕ) (hW : W.Nonempty) (m B : ℕ)
    (hm : 0 < m) (hB : ∀ v ∈ W, v ≤ B) :
    (m : ℝ) * ML W / ((m : ℝ) + B) ≤ ML (insert m W) := by
  let μ := ML W
  let L := (m : ℝ) * μ / ((m : ℝ) + B)
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hden : (0 : ℝ) < (m : ℝ) + B := by positivity
  have hμ : 0 ≤ μ := by
    obtain ⟨t, ht⟩ := ML_attained W
    change 0 ≤ ML W
    rw [← ht]
    simp only [score, dif_pos hW]
    exact (Finset.le_inf'_iff _ _).mpr (fun v hv => norm_nonneg _)
  have hL : 0 ≤ L := by dsimp [L]; positivity
  have hLμ : L ≤ μ := by
    dsimp [L]
    rw [div_le_iff₀ hden]
    nlinarith [(Nat.cast_nonneg B : (0 : ℝ) ≤ B)]
  have hhalf : L ≤ 1 / 2 := hLμ.trans (ML_le_half W)
  obtain ⟨t, ht⟩ := ML_attained W
  obtain ⟨x⟩ := t
  obtain ⟨δ, hδ, hfast⟩ := distance_adjustment m hm L x hL hhalf
  apply ML_lower_of_witness (Finset.insert_nonempty m W)
    (((x + δ : ℝ) : Time))
  intro v hv
  rcases Finset.mem_insert.mp hv with rfl | hv
  · simpa only [distance, ← AddCircle.coe_nsmul, nsmul_eq_mul] using hfast
  have hvB : (v : ℝ) ≤ B := by exact_mod_cast hB v hv
  have hslow : μ ≤ ‖(((v : ℝ) * x : ℝ) : Time)‖ := by
    calc
      μ = score W (x : Time) := ht.symm
      _ ≤ distance (v • (x : Time)) := by
        simp only [score, dif_pos hW]
        exact Finset.inf'_le (fun v => distance (v • (x : Time))) hv
      _ = ‖(((v : ℝ) * x : ℝ) : Time)‖ := by
        rw [distance, ← AddCircle.coe_nsmul, nsmul_eq_mul]
  have hloss := slow_distance_loss v x δ
  have hbudget : L + (B : ℝ) * (L / m) = μ := by
    dsimp [L]
    field_simp <;> ring
  have hb := mul_le_mul_of_nonneg_left hδ (Nat.cast_nonneg v)
  have hbb := mul_le_mul_of_nonneg_right hvB (div_nonneg hL hmR.le)
  simp only [distance, ← AddCircle.coe_nsmul, nsmul_eq_mul]
  linarith

/-- A strict quarter-gap after insertion bounds the inserted speed by the
core's strict gap above one quarter. No cardinality or ordering is assumed. -/
theorem quarter_insertion_cutoff (W : Finset ℕ) (hW : W.Nonempty) (m B : ℕ)
    (hm : 0 < m) (hB : ∀ v ∈ W, v ≤ B)
    (hne : ML (insert m W) < (1 / 4 : ℝ)) :
    (m : ℝ) * (4 * ML W - 1) < B := by
  have h := lt_of_le_of_lt (insertion_lower_bound W hW m B hm hB) hne
  have hden : (0 : ℝ) < (m : ℝ) + B := by positivity
  rw [div_lt_iff₀ hden] at h
  nlinarith

/-- The rational pair-sum grid supplies a uniform positive gap above 1/4,
unless the maximum is exactly 1/2. -/
theorem quarter_core_gap (W : Finset ℕ) (hW : W.Nonempty)
    (hp : Positive W) (B : ℕ) (hB : ∀ v ∈ W, v ≤ B)
    (hquarter : (1 / 4 : ℝ) < ML W) (hhalf : ML W < (1 / 2 : ℝ)) :
    1 / (2 * (B : ℝ)) ≤ 4 * ML W - 1 := by
  obtain ⟨u, hu, v, hv, huv, m, k, hk, ht, hμ⟩ :=
    ML_rational_pair_grid hW hp hhalf
  have hDnat : 0 < u + v := by have := hp u hu; omega
  have hD : (0 : ℝ) < ((u + v : ℕ) : ℝ) := by exact_mod_cast hDnat
  have hBnat : 0 < B := by have := hp u hu; have := hB u hu; omega
  have hBR : (0 : ℝ) < B := by exact_mod_cast hBnat
  have hstrict : ((u + v : ℕ) : ℝ) < 4 * (k : ℝ) := by
    rw [hμ] at hquarter
    have h := (lt_div_iff₀ hD).mp hquarter
    nlinarith
  have hstrictN : u + v < 4 * k := by exact_mod_cast hstrict
  have hgapN : u + v + 1 ≤ 4 * k := by omega
  have hgapR : ((u + v : ℕ) : ℝ) + 1 ≤ 4 * (k : ℝ) := by
    exact_mod_cast hgapN
  have hμD : ML W * ((u + v : ℕ) : ℝ) = k := by
    rw [hμ]
    exact div_mul_cancel₀ _ (ne_of_gt hD)
  have hgap : 1 / ((u + v : ℕ) : ℝ) ≤ 4 * ML W - 1 := by
    apply (div_le_iff₀ hD).mpr
    nlinarith
  have hDleN : u + v ≤ 2 * B := by have := hB u hu; have := hB v hv; omega
  have hDle : ((u + v : ℕ) : ℝ) ≤ 2 * (B : ℝ) := by
    exact_mod_cast hDleN
  have hinv : 1 / (2 * (B : ℝ)) ≤ 1 / ((u + v : ℕ) : ℝ) :=
    one_div_le_one_div_of_le hD hDle
  exact hinv.trans hgap

/-- An exactly half-lonely core yields the stronger linear speed cutoff. -/
theorem half_core_insertion_cutoff (W : Finset ℕ) (hW : W.Nonempty) (m B : ℕ)
    (hm : 0 < m) (hB : ∀ v ∈ W, v ≤ B)
    (hhalf : ML W = (1 / 2 : ℝ))
    (hne : ML (insert m W) < (1 / 4 : ℝ)) : m < B := by
  have h := quarter_insertion_cutoff W hW m B hm hB hne
  rw [hhalf] at h
  norm_num at h
  exact_mod_cast h

/-- Uniform finite cutoff for every positive core strictly above 1/4.
The exact quarter core case is intentionally excluded. -/
theorem quarter_core_insertion_speed_bound (W : Finset ℕ) (hW : W.Nonempty)
    (hp : Positive W) (m B : ℕ) (hm : 0 < m) (hB : ∀ v ∈ W, v ≤ B)
    (hquarter : (1 / 4 : ℝ) < ML W)
    (hne : ML (insert m W) < (1 / 4 : ℝ)) : m < 2 * B ^ 2 := by
  obtain ⟨v, hv⟩ := hW
  have hW : W.Nonempty := ⟨v, hv⟩
  have hBnat : 0 < B := by have := hp v hv; have := hB v hv; omega
  have hBR : (0 : ℝ) < B := by exact_mod_cast hBnat
  by_cases hhalf : ML W = (1 / 2 : ℝ)
  · have hmB := half_core_insertion_cutoff W hW m B hm hB hhalf hne
    have hBsq : B ≤ 2 * B ^ 2 := by nlinarith
    omega
  · have hhalf' : ML W < (1 / 2 : ℝ) :=
      lt_of_le_of_ne (ML_le_half W) hhalf
    have hgap := quarter_core_gap W hW hp B hB hquarter hhalf'
    have hcut := quarter_insertion_cutoff W hW m B hm hB hne
    have hmR : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    have hlower := mul_le_mul_of_nonneg_left hgap hmR
    have hfrac : (m : ℝ) / (2 * (B : ℝ)) < B := by
      have hmul : (m : ℝ) * (1 / (2 * (B : ℝ))) =
          (m : ℝ) / (2 * (B : ℝ)) := by ring
      rw [hmul] at hlower
      exact lt_of_le_of_lt hlower hcut
    have hbound : (m : ℝ) < 2 * (B : ℝ) ^ 2 := by
      have h := (div_lt_iff₀ (by positivity : (0 : ℝ) < 2 * (B : ℝ))).mp hfrac
      nlinarith
    exact_mod_cast hbound

end Math15.LonelyRunner
end 
end 

/- Section: SourceSixTransfer -/
section



/-!
Unbounded consequences of the checked shared insertion argument.

Paper proof. A positive three-speed core W outside the scaled {1,2,3} family
has ML(W) >= 2/7, by the exact three-runner isolation theorem. If all its
speeds are at most B, insertion_lower_bound gives ML(insert m W) >= m
ML(W)/(m+B). For m >= 7B the right side is at least m(2/7)/(m+B) >= 1/4.

For W={3,5,8}, the single common time 6/13 gives distances 5/13,4/13, 4/13,
hence score exactly 4/13. For m >= 35, m(4/13)/(m+8) >= 1/4, because 3m >= 105
> 104. This proves a stronger concrete insertion range without assuming any
lower bound on the core maximum as a premise.

These insertion bounds apply to the actual common-time maximum and all
inserted speeds in their stated unbounded ranges; they do not assert Target05
globally.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem ML_ge_two_sevenths_non_tight_three {W : Finset ℕ}
    (hp : Positive W) (hcard : W.card=3)
    (hnt : ¬ ∃ a : ℕ, 0<a ∧ W=({a,2*a,3*a} : Finset ℕ)) :
    (2/7 : ℝ) ≤ ML W := by
  by_contra hlow
  exact hnt (three_speed_isolation hp hcard (lt_of_not_ge hlow))

/-- An actual non-tight three-speed core gives a uniform quarter witness
after every sufficiently fast insertion; its ML is not a premise. -/
theorem ML_ge_quarter_insert_non_tight_three {W : Finset ℕ}
    (hp : Positive W) (hcard : W.card=3)
    (hnt : ¬ ∃ a : ℕ, 0<a ∧ W=({a,2*a,3*a} : Finset ℕ))
    (B m : ℕ) (hB : ∀ v ∈ W, v≤B) (hlarge : 7*B≤m) :
    (1/4 : ℝ) ≤ ML (insert m W) := by
  have hW : W.Nonempty := Finset.card_pos.mp (by omega)
  have hBp : 0<B := by
    obtain ⟨v,hv⟩ := hW
    have hvp := hp v hv
    have hvB := hB v hv
    omega
  have hm : 0<m := by omega
  have hden : (0 : ℝ)<(m : ℝ)+B := by positivity
  have hcore := ML_ge_two_sevenths_non_tight_three hp hcard hnt
  have hlargeR : 7*(B : ℝ)≤(m : ℝ) := by exact_mod_cast hlarge
  have hnum : (m : ℝ)*(2/7 : ℝ)≤(m : ℝ)*ML W :=
    mul_le_mul_of_nonneg_left hcore (Nat.cast_nonneg m)
  apply le_trans ?_ (insertion_lower_bound W hW m B hm hB)
  apply (le_div_iff₀ hden).2
  nlinarith

theorem ML_ge_quarter_insert_ge_seven_sup {W : Finset ℕ}
    (hp : Positive W) (hcard : W.card=3)
    (hnt : ¬ ∃ a : ℕ, 0<a ∧ W=({a,2*a,3*a} : Finset ℕ))
    (m : ℕ) (hlarge : 7*(W.sup id)≤m) :
    (1/4 : ℝ) ≤ ML (insert m W) := by
  exact ML_ge_quarter_insert_non_tight_three hp hcard hnt (W.sup id) m
    (fun v hv => Finset.le_sup (f := id) hv) hlarge

def threeFiveEight : Finset ℕ := {3,5,8}

theorem three_five_eight_common_witness :
    ∀ v ∈ threeFiveEight,
      (4/13 : ℝ) ≤ distance (v • (((6 : ℝ)/(13 : ℝ)) : Time)) := by
  intro v hv
  simp only [threeFiveEight, Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl
  · have h := distance_at_rational 3 6 13
    norm_num at h
    linarith
  · have h := distance_at_rational 5 6 13
    norm_num at h
    linarith
  · have h := distance_at_rational 8 6 13
    norm_num at h
    linarith

theorem three_five_eight_score_exact :
    score threeFiveEight (((6 : ℝ)/(13 : ℝ)) : Time)=(4/13 : ℝ) := by
  have hW : threeFiveEight.Nonempty := ⟨3,by simp [threeFiveEight]⟩
  apply le_antisymm
  · calc
      score threeFiveEight (((6 : ℝ)/(13 : ℝ)) : Time) ≤
          distance (5 • (((6 : ℝ)/(13 : ℝ)) : Time)) :=
        score_le_distance (by simp [threeFiveEight]) _
      _ = (4/13 : ℝ) := by
        have h := distance_at_rational 5 6 13
        norm_num at h
        exact h
  · simp only [score, dif_pos hW]
    exact Finset.le_inf' hW _ three_five_eight_common_witness

theorem ML_ge_four_thirteenths_three_five_eight :
    (4/13 : ℝ)≤ML threeFiveEight := by
  calc
    (4/13 : ℝ)=score threeFiveEight (((6 : ℝ)/(13 : ℝ)) : Time) :=
      three_five_eight_score_exact.symm
    _ ≤ ML threeFiveEight := score_le_ML _ _

/-- The concrete core admits every inserted speed m >= 35. -/
theorem ML_ge_quarter_insert_three_five_eight {m : ℕ} (hm35 : 35≤m) :
    (1/4 : ℝ)≤ML (insert m threeFiveEight) := by
  have hW : threeFiveEight.Nonempty := ⟨3,by simp [threeFiveEight]⟩
  have hB : ∀ v ∈ threeFiveEight, v≤8 := by
    intro v hv
    simp only [threeFiveEight, Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl <;> norm_num
  have hm : 0<m := by omega
  have hmR : (35 : ℝ)≤(m : ℝ) := by exact_mod_cast hm35
  have hden : (0 : ℝ)<(m : ℝ)+8 := by positivity
  have hnum : (m : ℝ)*(4/13 : ℝ)≤(m : ℝ)*ML threeFiveEight :=
    mul_le_mul_of_nonneg_left ML_ge_four_thirteenths_three_five_eight
      (Nat.cast_nonneg m)
  apply le_trans ?_ (insertion_lower_bound threeFiveEight hW m 8 hm hB)
  apply (le_div_iff₀ hden).2
  nlinarith

theorem ML_ge_quarter_three_five_eight_quartet {m : ℕ} (hm35 : 35≤m) :
    (1/4 : ℝ)≤ML ({3,5,8,m} : Finset ℕ) := by
  have hset : ({3,5,8,m} : Finset ℕ)=insert m threeFiveEight := by
    ext v
    simp only [threeFiveEight, Finset.mem_insert, Finset.mem_singleton]
    tauto
  rw [hset]
  exact ML_ge_quarter_insert_three_five_eight hm35










end Math15.LonelyRunner
end 
