/- Section: ComplementaryCovolume4 -/
section



/-!
Explicit four-dimensional complementary lattice transfer.

The algebraic hypothesis det(u,v,z,w)^2=1 is supplied by an integer unimodular
completion of a saturated rank-two lattice basis u,v. The constructed
complementary vectors generate the entire integer orthogonal kernel, not just
a subgroup of finite index.
-/

namespace Math15.LonelyRunner.Covolume4

abbrev Vec4 (R : Type*) := Fin 4 → R

variable {R : Type*} [CommRing R]

def dot4 (u v : Vec4 R) : R :=
  u 0*v 0 + u 1*v 1 + u 2*v 2 + u 3*v 3

def det3 (a b c d e f g h i : R) : R :=
  a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)

/-- Its dot product with x is det[u v w x], with vectors as columns. -/
def cross4 (u v w : Vec4 R) : Vec4 R := ![
  -det3 (u 1) (v 1) (w 1) (u 2) (v 2) (w 2) (u 3) (v 3) (w 3),
  det3 (u 0) (v 0) (w 0) (u 2) (v 2) (w 2) (u 3) (v 3) (w 3),
  -det3 (u 0) (v 0) (w 0) (u 1) (v 1) (w 1) (u 3) (v 3) (w 3),
  det3 (u 0) (v 0) (w 0) (u 1) (v 1) (w 1) (u 2) (v 2) (w 2)]

def det4 (u v z w : Vec4 R) : R := dot4 (cross4 u v z) w

def complementLeft (u v z w : Vec4 R) : Vec4 R :=
  fun i => -cross4 u v w i

def complementRight (u v z w : Vec4 R) : Vec4 R := cross4 u v z

def combine4 (A : R) (u : Vec4 R) (B : R) (v : Vec4 R) : Vec4 R :=
  fun i => A*u i+B*v i

def plucker4 (u v : Vec4 R) : Fin 6 → R := ![
  u 0*v 1-u 1*v 0, u 0*v 2-u 2*v 0, u 0*v 3-u 3*v 0,
  u 1*v 2-u 2*v 1, u 1*v 3-u 3*v 1, u 2*v 3-u 3*v 2]

def star4 (p : Fin 6 → R) : Fin 6 → R :=
  ![p 5, -p 4, p 3, p 2, -p 1, p 0]

def sqnorm6 (p : Fin 6 → R) : R :=
  p 0^2+p 1^2+p 2^2+p 3^2+p 4^2+p 5^2

def areaSq4 (u v : Vec4 R) : R := sqnorm6 (plucker4 u v)

theorem dot4_symm (u v : Vec4 R) : dot4 u v = dot4 v u := by
  simp [dot4]
  ring

theorem dot4_combine (A B : R) (u v x : Vec4 R) :
    dot4 (combine4 A u B v) x = A*dot4 u x+B*dot4 v x := by
  simp [dot4, combine4]
  ring

theorem complement_pairings (u v z w : Vec4 R) :
    dot4 (complementLeft u v z w) u = 0 ∧
    dot4 (complementLeft u v z w) v = 0 ∧
    dot4 (complementLeft u v z w) z = det4 u v z w ∧
    dot4 (complementLeft u v z w) w = 0 ∧
    dot4 (complementRight u v z w) u = 0 ∧
    dot4 (complementRight u v z w) v = 0 ∧
    dot4 (complementRight u v z w) z = 0 ∧
    dot4 (complementRight u v z w) w = det4 u v z w := by
  repeat' constructor
  all_goals simp [complementLeft, complementRight, det4, dot4, cross4, det3]
  all_goals ring

/-- Adjugate reconstruction, stated directly in ordinary coordinates. -/
theorem cofactor_reconstruct (u v z w x : Vec4 R) (i : Fin 4) :
    det4 u v z w * x i =
      dot4 x u * (-cross4 v z w i) +
      dot4 x v * cross4 u z w i +
      dot4 x z * complementLeft u v z w i +
      dot4 x w * complementRight u v z w i := by
  fin_cases i
  all_goals simp [complementLeft, complementRight, det4, dot4, cross4, det3]
  all_goals ring

/-- All six complementary-minor identities in one explicit assertion. -/
theorem complementary_plucker (u v z w : Vec4 R) (i : Fin 6) :
    plucker4 (complementLeft u v z w) (complementRight u v z w) i =
      det4 u v z w * star4 (plucker4 u v) i := by
  fin_cases i
  all_goals simp [plucker4, star4, complementLeft, complementRight,
    det4, dot4, cross4, det3]
  all_goals ring

theorem lagrange_area_identity (u v : Vec4 R) :
    areaSq4 u v = dot4 u u * dot4 v v - (dot4 u v)^2 := by
  simp [areaSq4, sqnorm6, plucker4, dot4]
  ring

theorem areaSq_complementary (u v z w : Vec4 R) :
    areaSq4 (complementLeft u v z w) (complementRight u v z w) =
      (det4 u v z w)^2 * areaSq4 u v := by
  simp only [areaSq4, sqnorm6, complementary_plucker]
  simp [star4]
  ring

/-- Change of two generators multiplies every minor by the 2x2 determinant. -/
theorem plucker_combine (u v : Vec4 R) (a b c d : R) (i : Fin 6) :
    plucker4 (combine4 a u b v) (combine4 c u d v) i =
      (a*d-b*c)*plucker4 u v i := by
  fin_cases i
  all_goals simp [plucker4, combine4]
  all_goals ring

theorem areaSq_combine (u v : Vec4 R) (a b c d : R) :
    areaSq4 (combine4 a u b v) (combine4 c u d v) =
      (a*d-b*c)^2 * areaSq4 u v := by
  simp only [areaSq4, sqnorm6, plucker_combine]
  ring

/-- Unimodularity turns the cofactor identity into an integer decomposition. -/
theorem orthogonal_integer_decomposition (u v z w x : Vec4 ℤ)
    (hdet : (det4 u v z w)^2 = 1)
    (hu : dot4 x u = 0) (hv : dot4 x v = 0) :
    x = combine4 (det4 u v z w * dot4 x z) (complementLeft u v z w)
      (det4 u v z w * dot4 x w) (complementRight u v z w) := by
  funext i
  have h := cofactor_reconstruct u v z w x i
  rw [hu, hv, zero_mul, zero_mul, zero_add, zero_add] at h
  change x i = _
  calc
    x i = det4 u v z w * (det4 u v z w * x i) := by
      rw [← mul_assoc, ← pow_two, hdet, one_mul]
    _ = det4 u v z w * (dot4 x z * complementLeft u v z w i +
        dot4 x w * complementRight u v z w i) := by rw [h]
    _ = _ := by simp [combine4]; ring

/-- Actual equality with the full integer orthogonal kernel. -/
theorem integer_kernel_iff_combination (u v z w x : Vec4 ℤ)
    (hdet : (det4 u v z w)^2 = 1) :
    (dot4 x u = 0 ∧ dot4 x v = 0) ↔
      ∃ A B : ℤ, x = combine4 A (complementLeft u v z w)
        B (complementRight u v z w) := by
  constructor
  · intro hx
    exact ⟨_, _, orthogonal_integer_decomposition u v z w x hdet hx.1 hx.2⟩
  · rintro ⟨A, B, rfl⟩
    obtain ⟨hbu, hbv, _, _, hcu, hcv, _, _⟩ := complement_pairings u v z w
    constructor
    · rw [dot4_combine, hbu, hcu]; ring
    · rw [dot4_combine, hbv, hcv]; ring

/-- Independence of the constructed integer generators; together with the
previous theorem, this is an explicit basis certificate for the kernel. -/
theorem complementary_generators_independent (u v z w : Vec4 ℤ)
    (hdet : (det4 u v z w)^2 = 1) (A B : ℤ)
    (hzero : combine4 A (complementLeft u v z w)
      B (complementRight u v z w) = 0) : A = 0 ∧ B = 0 := by
  have hd : det4 u v z w ≠ 0 := by
    intro hz
    rw [hz] at hdet
    norm_num at hdet
  obtain ⟨_, _, hbz, hbw, _, _, hcz, hcw⟩ := complement_pairings u v z w
  have hz := congrArg (fun x : Vec4 ℤ => dot4 x z) hzero
  have hw := congrArg (fun x : Vec4 ℤ => dot4 x w) hzero
  dsimp only at hz hw
  rw [dot4_combine, hbz, hcz] at hz
  rw [dot4_combine, hbw, hcw] at hw
  simp [dot4] at hz hw
  exact ⟨hz.resolve_right hd, hw.resolve_right hd⟩

theorem unimodular_complementary_areaSq (u v z w : Vec4 ℤ)
    (hdet : (det4 u v z w)^2 = 1) :
    areaSq4 (complementLeft u v z w) (complementRight u v z w) =
      areaSq4 u v := by
  rw [areaSq_complementary, hdet, one_mul]

/-- Two independent integer relations may generate a proper sublattice,
but their squared area still bounds the covolume squared of the saturated
orthogonal lattice. Positivity is the explicit independence hypothesis. -/
theorem integer_kernel_area_bound (u v z w r s : Vec4 ℤ)
    (hdet : (det4 u v z w)^2 = 1)
    (hru : dot4 r u = 0) (hrv : dot4 r v = 0)
    (hsu : dot4 s u = 0) (hsv : dot4 s v = 0)
    (hrs : 0 < areaSq4 r s) : areaSq4 u v ≤ areaSq4 r s := by
  obtain ⟨A, B, hr⟩ :=
    (integer_kernel_iff_combination u v z w r hdet).mp ⟨hru, hrv⟩
  obtain ⟨C, D, hs⟩ :=
    (integer_kernel_iff_combination u v z w s hdet).mp ⟨hsu, hsv⟩
  have he : areaSq4 r s = (A*D-B*C)^2 * areaSq4 u v := by
    rw [hr, hs, areaSq_combine, unimodular_complementary_areaSq u v z w hdet]
  have hn : A*D-B*C ≠ 0 := by
    intro hn
    rw [he, hn] at hrs
    norm_num at hrs
  have hsq : 1 ≤ (A*D-B*C)^2 := by
    have hpos := sq_pos_of_ne_zero hn
    omega
  have harea : 0 ≤ areaSq4 u v := by
    dsimp [areaSq4, sqnorm6]
    positivity
  rw [he]
  nlinarith [mul_nonneg (sub_nonneg.mpr hsq) harea]
















end Math15.LonelyRunner.Covolume4
end 

/- Section: LowMLMiss -/
section



/-!
The actual circle maximum forces a literal Euclidean miss of every integer
translate of the actual speed line. No lattice-covering premise is assumed.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

theorem distance_center_le_line_error (x t : ℝ) (v : ℕ) (z : ℤ) :
    distance (x : Time) ≤ distance (v • (t : Time)) +
      |x - (z : ℝ) - t * (v : ℝ)| := by
  have hz : ((z : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨z, by simp [zsmul_eq_mul]⟩
  have he : (v • (t : Time)) +
      (((x - (z : ℝ) - t * (v : ℝ)) : ℝ) : Time) = (x : Time) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul, ← AddCircle.coe_add]
    have h : (v : ℝ) * t + (x - (z : ℝ) - t * (v : ℝ)) = x - z := by ring
    rw [h, AddCircle.coe_sub, hz, sub_zero]
  have htriangle := norm_add_le (v • (t : Time))
    (((x - (z : ℝ) - t * (v : ℝ)) : ℝ) : Time)
  rw [he] at htriangle
  have hquotient := distance_coe_le_integer (x - (z : ℝ) - t * (v : ℝ)) 0
  simp only [Int.cast_zero, sub_zero] at hquotient
  exact htriangle.trans (add_le_add le_rfl hquotient)

theorem coordinate_sq_le_dot4 (e : Vec4 ℝ) (i : Fin 4) :
    (e i)^2 ≤ dot4 e e := by
  have h0 := sq_nonneg (e 0)
  have h1 := sq_nonneg (e 1)
  have h2 := sq_nonneg (e 2)
  have h3 := sq_nonneg (e 3)
  fin_cases i
  · change (e (0 : Fin 4))^2 ≤ dot4 e e
    dsimp [dot4]
    nlinarith
  · change (e (1 : Fin 4))^2 ≤ dot4 e e
    dsimp [dot4]
    nlinarith
  · change (e (2 : Fin 4))^2 ≤ dot4 e e
    dsimp [dot4]
    nlinarith
  · change (e (3 : Fin 4))^2 ≤ dot4 e e
    dsimp [dot4]
    nlinarith

/-- This uses the canonical ML of the finite set of the actual four speeds.
Duplicates and zero speeds do not create an implicit cardinality premise. -/
theorem low_ML_misses_every_integer_translate
    (v : Fin 4 → ℕ) (x : Vec4 ℝ) (eta : ℝ) (heta : 0 ≤ eta)
    (hlow : ML (Finset.univ.image v) < (1 / 4 : ℝ))
    (hcenter : ∀ i, (1 / 4 : ℝ) + eta ≤ distance (x i : Time)) :
    ∀ z : Vec4 ℤ, ∀ t : ℝ,
      eta^2 < dot4 (fun i => x i - (z i : ℝ) - t * (v i : ℝ))
        (fun i => x i - (z i : ℝ) - t * (v i : ℝ)) := by
  intro z t
  by_contra hmiss
  have hsq := le_of_not_gt hmiss
  have herror (i : Fin 4) : |x i - (z i : ℝ) - t * (v i : ℝ)| ≤ eta :=
    abs_le_of_sq_le_sq ((coordinate_sq_le_dot4 _ i).trans hsq) heta
  have hquarter (i : Fin 4) : (1 / 4 : ℝ) ≤ distance (v i • (t : Time)) := by
    have h := distance_center_le_line_error (x i) t (v i) (z i)
    have hc := hcenter i
    have he := herror i
    linarith
  have hV : (Finset.univ.image v).Nonempty := by
    exact ⟨v 0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, rfl⟩⟩
  have hML : (1 / 4 : ℝ) ≤ ML (Finset.univ.image v) := by
    apply ML_lower_of_witness hV (t : Time)
    intro w hw
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hw
    exact hquarter i
  exact (not_lt_of_ge hML) hlow





end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: ProjectedGram -/
section




/-!
The actual integer Gram numerator for projection perpendicular to v. Its
positivity is deduced from integer linear independence of v,u,w, then
specialized to an actual Fin 3 basis of an integer submodule.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

def projectedCrossGram {R : Type*} [CommRing R] (v u w : Vec4 R) : R :=
  dot4 v v * dot4 u w - dot4 v u * dot4 v w

def projectionForm {R : Type*} [CommRing R]
    (v u w : Vec4 R) (p q : R) : R := areaSq4 v (combine4 p u q w)

theorem projectionForm_expansion {R : Type*} [CommRing R]
    (v u w : Vec4 R) (p q : R) :
    projectionForm v u w p q = areaSq4 v u * p^2 +
      2 * projectedCrossGram v u w * p*q + areaSq4 v w * q^2 := by
  simp [projectionForm, lagrange_area_identity, projectedCrossGram, dot4, combine4]
  ring

theorem integer_areaSq_nonneg (v x : Vec4 ℤ) : 0 ≤ areaSq4 v x := by
  dsimp [areaSq4, sqnorm6]
  positivity

theorem plucker_zero_of_areaSq_zero (v x : Vec4 ℤ)
    (h : areaSq4 v x = 0) (k : Fin 6) : plucker4 v x k = 0 := by
  have h0 := sq_nonneg (plucker4 v x 0)
  have h1 := sq_nonneg (plucker4 v x 1)
  have h2 := sq_nonneg (plucker4 v x 2)
  have h3 := sq_nonneg (plucker4 v x 3)
  have h4 := sq_nonneg (plucker4 v x 4)
  have h5 := sq_nonneg (plucker4 v x 5)
  unfold areaSq4 sqnorm6 at h
  fin_cases k
  · change plucker4 v x 0 = 0; nlinarith
  · change plucker4 v x 1 = 0; nlinarith
  · change plucker4 v x 2 = 0; nlinarith
  · change plucker4 v x 3 = 0; nlinarith
  · change plucker4 v x 4 = 0; nlinarith
  · change plucker4 v x 5 = 0; nlinarith

theorem all_minors_zero_of_areaSq_zero (v x : Vec4 ℤ)
    (h : areaSq4 v x = 0) (i j : Fin 4) : v i*x j-v j*x i = 0 := by
  have h0 := plucker_zero_of_areaSq_zero v x h 0
  have h1 := plucker_zero_of_areaSq_zero v x h 1
  have h2 := plucker_zero_of_areaSq_zero v x h 2
  have h3 := plucker_zero_of_areaSq_zero v x h 3
  have h4 := plucker_zero_of_areaSq_zero v x h 4
  have h5 := plucker_zero_of_areaSq_zero v x h 5
  simp [plucker4] at h0 h1 h2 h3 h4 h5
  fin_cases i <;> fin_cases j
  all_goals first
    | exact h0
    | exact h1
    | exact h2
    | exact h3
    | exact h4
    | exact h5
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h0).symm
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h1).symm
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h2).symm
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h3).symm
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h4).symm
    | exact sub_eq_zero.mpr (sub_eq_zero.mp h5).symm
    | ring

theorem integer_triple_coefficients_zero (v u w : Vec4 ℤ)
    (hli : LinearIndependent ℤ (![v,u,w] : Fin 3 → Vec4 ℤ))
    (a b c : ℤ) (h : ∀ i, a*v i+b*u i+c*w i=0) :
    a=0 ∧ b=0 ∧ c=0 := by
  have hs : ∑ j : Fin 3, (![a,b,c] j) • (![v,u,w] j) = 0 := by
    ext i
    simpa [Fin.sum_univ_succ, add_assoc] using h i
  have hz := (Fintype.linearIndependent_iff.mp hli) (![a,b,c]) hs
  exact ⟨by simpa using hz 0, by simpa using hz 1, by simpa using hz 2⟩

/-- Positivity is integer arithmetic: a zero area creates an integer
dependence after multiplying by one nonzero coordinate of v. -/
theorem projectionForm_positive (v u w : Vec4 ℤ)
    (hli : LinearIndependent ℤ (![v,u,w] : Fin 3 → Vec4 ℤ))
    (p q : ℤ) (hpq : p ≠ 0 ∨ q ≠ 0) : 0 < projectionForm v u w p q := by
  let x := combine4 p u q w
  have hn := integer_areaSq_nonneg v x
  change 0 < areaSq4 v x
  by_contra hpos
  have hz : areaSq4 v x = 0 := by omega
  have hv : v ≠ 0 := by simpa using (LinearIndependent.ne_zero 0 hli)
  obtain ⟨i, hi⟩ : ∃ i : Fin 4, v i ≠ 0 := by
    by_contra h
    push_neg at h
    exact hv (funext h)
  have hrel : ∀ j, (-x i)*v j+(v i*p)*u j+(v i*q)*w j=0 := by
    intro j
    have hm := all_minors_zero_of_areaSq_zero v x hz i j
    dsimp [x, combine4] at hm ⊢
    linear_combination hm
  obtain ⟨_, hp, hq⟩ := integer_triple_coefficients_zero v u w hli
    (-x i) (v i*p) (v i*q) hrel
  have hp0 := (mul_eq_zero.mp hp).resolve_left hi
  have hq0 := (mul_eq_zero.mp hq).resolve_left hi
  rcases hpq with hpq | hpq
  · exact hpq hp0
  · exact hpq hq0

/-- The integral Gram determinant is strictly positive, using the one
integer coefficient pair (-b,a). No scalar-extension theorem is assumed. -/
theorem projected_gram_determinant_positive (v u w : Vec4 ℤ)
    (hli : LinearIndependent ℤ (![v,u,w] : Fin 3 → Vec4 ℤ)) :
    0 < areaSq4 v u * areaSq4 v w - (projectedCrossGram v u w)^2 := by
  have ha : 0 < areaSq4 v u := by
    have h := projectionForm_positive v u w hli 1 0 (Or.inl (by decide))
    simpa [projectionForm_expansion] using h
  have hq := projectionForm_positive v u w hli
    (-projectedCrossGram v u w) (areaSq4 v u) (Or.inr (ne_of_gt ha))
  have he : projectionForm v u w (-projectedCrossGram v u w) (areaSq4 v u) =
      areaSq4 v u * (areaSq4 v u * areaSq4 v w - (projectedCrossGram v u w)^2) := by
    rw [projectionForm_expansion]
    ring
  rw [he] at hq
  rcases mul_pos_iff.mp hq with h | h
  · exact h.2
  · linarith [h.1]

/-- Discharge independence from an actual rank-three integer kernel basis. -/
theorem ambient_three_basis_independent (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    LinearIndependent ℤ
      (![(b 0 : Vec4 ℤ), (b 1 : Vec4 ℤ), (b 2 : Vec4 ℤ)] : Fin 3 → Vec4 ℤ) := by
  have hb := b.linearIndependent.map' N.subtype (Submodule.ker_subtype N)
  have he : (![(b 0 : Vec4 ℤ), (b 1 : Vec4 ℤ), (b 2 : Vec4 ℤ)] : Fin 3 → Vec4 ℤ) =
      N.subtype ∘ b := by
    funext i
    fin_cases i <;> rfl
  rw [he]
  exact hb

theorem basis_projectionForm_positive (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q : ℤ) (hpq : p≠0 ∨ q≠0) :
    0 < projectionForm (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) (b 2 : Vec4 ℤ) p q :=
  projectionForm_positive _ _ _ (ambient_three_basis_independent N b) p q hpq

theorem integer_dot_self_positive (v : Vec4 ℤ) (hv : v ≠ 0) :
    0 < dot4 v v := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 4, v i ≠ 0 := by
    by_contra h
    push_neg at h
    exact hv (funext h)
  have hp : 0 < ∑ j, (v j)^2 :=
    Finset.sum_pos' (fun j _ => sq_nonneg (v j))
      ⟨i, Finset.mem_univ i, sq_pos_of_ne_zero hi⟩
  simpa only [Fin.sum_univ_four, pow_two, dot4] using hp

theorem basis_projection_first_norm_positive (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    0 < dot4 (b 0 : Vec4 ℤ) (b 0 : Vec4 ℤ) := by
  apply integer_dot_self_positive
  simpa using (LinearIndependent.ne_zero 0 (ambient_three_basis_independent N b))

def realVec4 (x : Vec4 ℤ) : Vec4 ℝ := fun i => (x i : ℝ)

theorem realVec4_dot4 (x y : Vec4 ℤ) :
    dot4 (realVec4 x) (realVec4 y) = ((dot4 x y : ℤ) : ℝ) := by
  simp [dot4, realVec4]

def perpendicularProjection4 (v x : Vec4 ℝ) : Vec4 ℝ :=
  fun i => x i - (dot4 v x / dot4 v v) * v i

theorem perpendicularProjection4_mixed_dot (v x y : Vec4 ℝ)
    (hv : dot4 v v ≠ 0) :
    dot4 (perpendicularProjection4 v x) (perpendicularProjection4 v y) =
      (dot4 v v * dot4 x y - dot4 v x * dot4 v y) / dot4 v v := by
  have he : dot4 (perpendicularProjection4 v x) (perpendicularProjection4 v y) =
      dot4 x y - (dot4 v x / dot4 v v) * dot4 v y -
      (dot4 v y / dot4 v v) * dot4 v x +
      (dot4 v x / dot4 v v) * (dot4 v y / dot4 v v) * dot4 v v := by
    simp [perpendicularProjection4, dot4]
    ring
  rw [he]
  field_simp [hv]
  ring

theorem perpendicularProjection4_normSq (v x : Vec4 ℝ)
    (hv : dot4 v v ≠ 0) :
    dot4 (perpendicularProjection4 v x) (perpendicularProjection4 v x) =
      (dot4 v v * dot4 x x - (dot4 v x)^2) / dot4 v v := by
  rw [perpendicularProjection4_mixed_dot v x x hv]
  ring

/-- The integer positive quadratic form is the numerator of the ACTUAL
projected squared Euclidean length with the fixed denominator v dot v. -/
theorem projected_integer_form_normSq (v u w : Vec4 ℤ)
    (hv : dot4 v v ≠ 0) (p q : ℤ) :
    dot4 (perpendicularProjection4 (realVec4 v) (realVec4 (combine4 p u q w)))
      (perpendicularProjection4 (realVec4 v) (realVec4 (combine4 p u q w))) =
        ((projectionForm v u w p q : ℤ) : ℝ) / ((dot4 v v : ℤ) : ℝ) := by
  have hvR : dot4 (realVec4 v) (realVec4 v) ≠ 0 := by
    rw [realVec4_dot4]
    exact_mod_cast hv
  rw [perpendicularProjection4_normSq _ _ hvR]
  simp only [realVec4_dot4, projectionForm, lagrange_area_identity]
  push_cast
  ring

theorem projected_integer_cross_gram (v u w : Vec4 ℤ)
    (hv : dot4 v v ≠ 0) :
    dot4 (perpendicularProjection4 (realVec4 v) (realVec4 u))
      (perpendicularProjection4 (realVec4 v) (realVec4 w)) =
        ((projectedCrossGram v u w : ℤ) : ℝ) / ((dot4 v v : ℤ) : ℝ) := by
  have hvR : dot4 (realVec4 v) (realVec4 v) ≠ 0 := by
    rw [realVec4_dot4]
    exact_mod_cast hv
  rw [perpendicularProjection4_mixed_dot _ _ _ hvR]
  simp only [realVec4_dot4, projectedCrossGram]
  push_cast
  ring


















end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: ProjectionMiss -/
section


/-!
The actual projected distance is one of the full line distances: select t =
dot(v, x-z) / dot(v,v). This algebraic identity and the strict-miss transfer
require neither v != 0 nor a positive lower-bound parameter.
-/

namespace Math15.LonelyRunner.Covolume4

/-- The difference of projections equals the residual at one explicit
real line parameter. The identity is valid even when v = 0. -/
theorem projection_difference_eq_line_residual4 (v x z : Vec4 ℝ) :
    perpendicularProjection4 v x - perpendicularProjection4 v z =
      x-z-(dot4 v (x-z)/dot4 v v) • v := by
  funext k
  simp [perpendicularProjection4, dot4, smul_eq_mul]
  ring

/-- A strict lower bound for every line parameter passes to the exact
projected distance, for any indexed family of real points. -/
theorem projected_miss_of_line_miss4 {ι : Type*} (v x : Vec4 ℝ)
    (points : ι → Vec4 ℝ) (rho : ℝ)
    (hmiss : ∀ j : ι, ∀ t : ℝ,
      rho < dot4 (x-points j-t • v) (x-points j-t • v)) :
    ∀ j : ι, rho <
      dot4 (perpendicularProjection4 v x-perpendicularProjection4 v (points j))
        (perpendicularProjection4 v x-perpendicularProjection4 v (points j)) := by
  intro j
  rw [projection_difference_eq_line_residual4]
  exact hmiss j (dot4 v (x-points j)/dot4 v v)

/-- Native integer-submodule interface. Specialize N to integerHyperplane4 m
for NativeGaussConsumer. No basis, spanning, or positivity premise is needed. -/
theorem native_projected_miss_of_line_miss
    (N : Submodule ℤ (Vec4 ℤ)) (v : Vec4 ℤ) (x : Vec4 ℝ) (eta : ℝ)
    (hmiss : ∀ z : N, ∀ t : ℝ,
      eta^2 < dot4 (x-realVec4 z-t • realVec4 v)
        (x-realVec4 z-t • realVec4 v)) :
    ∀ z : N, eta^2 <
      dot4 (perpendicularProjection4 (realVec4 v) x-
        perpendicularProjection4 (realVec4 v) (realVec4 z))
        (perpendicularProjection4 (realVec4 v) x-
          perpendicularProjection4 (realVec4 v) (realVec4 z)) := by
  exact projected_miss_of_line_miss4 (realVec4 v) x
    (fun z : N => realVec4 z) (eta^2) hmiss





end Math15.LonelyRunner.Covolume4
end 

/- Section: LowMLProjection -/
section



/-!
Canonical low ML supplies the actual projected-distance premise. This is a
direct consumer for arbitrary integer submodules; the center construction is
instantiated separately.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

theorem low_ML_projected_miss
    (N : Submodule ℤ (Vec4 ℤ)) (v : Fin 4 → ℕ) (x : Vec4 ℝ)
    (eta : ℝ) (heta : 0 ≤ eta)
    (hlow : ML (Finset.univ.image v) < (1 / 4 : ℝ))
    (hcenter : ∀ i, (1 / 4 : ℝ) + eta ≤ distance (x i : Time)) :
    ∀ z : N, eta^2 <
      dot4 (perpendicularProjection4 (fun i => (v i : ℝ)) x-
        perpendicularProjection4 (fun i => (v i : ℝ)) (realVec4 z))
        (perpendicularProjection4 (fun i => (v i : ℝ)) x-
          perpendicularProjection4 (fun i => (v i : ℝ)) (realVec4 z)) := by
  have h := native_projected_miss_of_line_miss N (fun i => (v i : ℤ)) x eta
    (fun z t => by
      simpa only [realVec4, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Int.cast_natCast]
        using low_ML_misses_every_integer_translate v x eta heta hlow hcenter z t)
  simpa only [realVec4, Int.cast_natCast] using h



end Math15.LonelyRunner.Covolume4
