/- Section: SmallPairFamily -/
section




/-!
The actual pairs {2,3} and {4,6}: unbounded analytic reduction and exact
finite-certificate semantics, with no assumption about a core maximum.

For q=1 or2, the pair {2q,3q} is quarter-good on [1/(8q),1/(4q)].
TwoLateSpeeds covers ordered remaining speeds c<D when c>=12q. Otherwise
c<=23. A tight three-speed core containing2q,3q must have scale q and c=q, so
a checked one-two or two-four family applies. For every other core,
SourceSixTransfer with B=23 covers D>=161. The only numerical obligations left
are c in1..23 and D in1..160.

The mask below recomputes its literal eligibility from all six pair gcds and
the same quartet's gcd. It does not assume sorted first three speeds, an
externally correct mask, a rational witness, or an unproved core gap. The
subsequent numerical certificate chunks discharge the finite obligations used
by the unbounded consumer.
-/

namespace Math15.LonelyRunner

/-- Finite eligibility for the two *remaining* speeds, allowing the fixed
pair to occur anywhere in the ordering. Duplicate rows are harmless
overapproximations; the semantic consumer retains card=4. -/
def smallPairAllowedMask (q c : ℕ) : ℕ :=
  listBits ((List.range' 1 160).filter fun d =>
    decide (c<d) && finitePairGcdBool (2*q) (3*q) c d)

def smallPairRowCheck (q : ℕ) (row : CompressedCensusRow) : Bool :=
  decide (smallPairAllowedMask q row.c &&&
    (rationalTimesMask 161 row.times ||| listBits row.known) =
      smallPairAllowedMask q row.c) &&
    tripleTimesQuarterBool (2*q) (3*q) row.c row.times &&
    row.known.all (fun d => finiteKnownFamilyBool (2*q) (3*q) row.c d)

def smallPairTableCheck (q : ℕ) (rows : List CompressedCensusRow) : Bool :=
  rows.all (smallPairRowCheck q)

theorem smallPairTableCheck_append (q : ℕ) (xs ys : List CompressedCensusRow)
    (hx : smallPairTableCheck q xs=true) (hy : smallPairTableCheck q ys=true) :
    smallPairTableCheck q (xs++ys)=true := by
  change (xs++ys).all (smallPairRowCheck q)=true
  rw [List.all_append,Bool.and_eq_true]
  exact ⟨hx,hy⟩

theorem smallPairAllowedMask_testBit_iff (q c d : ℕ) :
    Nat.testBit (smallPairAllowedMask q c) d=true ↔
      1≤d ∧ d<161 ∧ c<d ∧ finitePairGcdBool (2*q) (3*q) c d=true := by
  rw [smallPairAllowedMask,listBits_testBit_iff,List.mem_filter]
  constructor
  · rintro ⟨hrange,hbool⟩
    have hr := List.mem_range'_1.mp hrange
    have ht : c<d ∧ finitePairGcdBool (2*q) (3*q) c d=true := by
      simpa only [Bool.and_eq_true,decide_eq_true_eq] using hbool
    exact ⟨hr.1,by omega,ht.1,ht.2⟩
  · rintro ⟨hlo,hhi,hcd,hgcd⟩
    refine ⟨List.mem_range'_1.mpr ⟨hlo,by omega⟩,?_⟩
    simpa only [Bool.and_eq_true,decide_eq_true_eq] using And.intro hcd hgcd

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- Cardinality four forces the six literal speeds to be pairwise distinct,
without imposing an ordering on this representation. -/
theorem finite_quartet_four_distinct {a b c d : ℕ}
    (hc : (finiteQuartetSpeeds a b c d).card=4) :
    a≠b ∧ a≠c ∧ a≠d ∧ b≠c ∧ b≠d ∧ c≠d := by
  have hm : (↑([a,b,c,d] : List ℕ) : Multiset ℕ).toFinset.card=
      (↑([a,b,c,d] : List ℕ) : Multiset ℕ).card := by
    simpa [finiteQuartetSpeeds] using hc
  have hn := Multiset.toFinset_card_eq_card_iff_nodup.mp hm
  change ([a,b,c,d] : List ℕ).Nodup at hn
  simpa only [List.nodup_cons,List.nodup_nil,List.mem_cons,
    List.not_mem_nil,or_false,not_or,not_false_eq_true,and_true,and_assoc] using hn

/-- The actual original arithmetic hypotheses imply the eligibility test
for an arbitrary distinct ordering, not just an increasing quartet. -/
theorem finitePairGcdBool_of_card_four {a b c d : ℕ}
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀u∈finiteQuartetSpeeds a b c d,∀v∈finiteQuartetSpeeds a b c d,
      u≠v → Nat.gcd u v≤2) : finitePairGcdBool a b c d=true := by
  obtain ⟨hab,hac,had,hbc,hbd,hcd⟩ := finite_quartet_four_distinct hc
  have hg : Nat.gcd (Nat.gcd a b) (Nat.gcd c d)=1 := by
    have hg' : Nat.gcd a (Nat.gcd b (Nat.gcd c d))=1 := by
      simpa [Primitive,finiteQuartetSpeeds,Finset.gcd_insert,
        Finset.gcd_singleton] using hprim
    simpa only [Nat.gcd_assoc] using hg'
  simp only [finitePairGcdBool,decide_eq_true_eq]
  exact ⟨hpair a (by simp [finiteQuartetSpeeds]) b
      (by simp [finiteQuartetSpeeds]) hab,
    hpair a (by simp [finiteQuartetSpeeds]) c (by simp [finiteQuartetSpeeds]) hac,
    hpair b (by simp [finiteQuartetSpeeds]) c (by simp [finiteQuartetSpeeds]) hbc,
    hpair a (by simp [finiteQuartetSpeeds]) d (by simp [finiteQuartetSpeeds]) had,
    hpair b (by simp [finiteQuartetSpeeds]) d (by simp [finiteQuartetSpeeds]) hbd,
    hpair c (by simp [finiteQuartetSpeeds]) d (by simp [finiteQuartetSpeeds]) hcd,hg⟩

theorem smallPairAllowedMask_of_admissible {q c d : ℕ}
    (hc : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hpair : ∀u∈finiteQuartetSpeeds (2*q) (3*q) c d,
      ∀v∈finiteQuartetSpeeds (2*q) (3*q) c d,u≠v → Nat.gcd u v≤2)
    (hcd : c<d) (hd : d<161) :
    Nat.testBit (smallPairAllowedMask q c) d=true := by
  apply (smallPairAllowedMask_testBit_iff q c d).mpr
  exact ⟨by omega,hd,hcd,finitePairGcdBool_of_card_four hc hprim hpair⟩

/-- A verified finite row gives one actual common rational time, or one
already checked family, for this same admissible unordered quartet. -/
theorem smallPairRowCheck_sound {q d : ℕ} {row : CompressedCensusRow}
    (hp : Positive (finiteQuartetSpeeds (2*q) (3*q) row.c d))
    (hc : (finiteQuartetSpeeds (2*q) (3*q) row.c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds (2*q) (3*q) row.c d))
    (hpair : ∀u∈finiteQuartetSpeeds (2*q) (3*q) row.c d,
      ∀v∈finiteQuartetSpeeds (2*q) (3*q) row.c d,u≠v → Nat.gcd u v≤2)
    (hcd : row.c<d) (hd : d<161) (hcheck : smallPairRowCheck q row=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds (2*q) (3*q) row.c d) := by
  have hh :
      (smallPairAllowedMask q row.c &&&
        (rationalTimesMask 161 row.times ||| listBits row.known)=
          smallPairAllowedMask q row.c) ∧
      tripleTimesQuarterBool (2*q) (3*q) row.c row.times=true ∧
      row.known.all (fun d => finiteKnownFamilyBool (2*q) (3*q) row.c d)=true := by
    simpa only [smallPairRowCheck,Bool.and_eq_true,decide_eq_true_eq,
      and_assoc] using hcheck
  exact compressed_quartet_certificate_sound hp hc hprim hpair hh.1
    (smallPairAllowedMask_of_admissible hc hprim hpair hcd hd)
    (rationalQuarterBool_of_tripleTimesQuarterBool hh.2.1) hh.2.2

/-- Table coverage and numerical checks are consumed separately. -/
theorem source05_small_pair_table {q c d : ℕ} {rows : List CompressedCensusRow}
    (hp : Positive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hc : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds (2*q) (3*q) c d))
