/- Section: TorusWitness -/
section



/-!
Literal rational quarter-torus discriminator witnesses for the 66 nonempty
members of the selected 72 no-zero Jain planes. Every theorem states the
actual four coordinate inequalities at one common real pair (x,y), using only
rational arithmetic and the circle triangle inequality.

The six empty planes and signed-permutation classification are NOT proved in
this section. These 66 statements cover only the explicitly selected finite
class; they do not prove a global rank-two-torus classification or Target05.

The rational witnesses are given explicitly in the declarations below.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- A shared torus witness uses one actual pair (x,y) for all coordinates. -/
def TorusGood (u v : Fin 4 → ℤ) (L : ℝ) : Prop :=
  ∃ x y : ℝ, ∀ i : Fin 4,
    L ≤ distance ((((u i : ℝ) * x + (v i : ℝ) * y : ℝ)) : Time)

/-- Throughout a translated middle interval, circle distance is at least L.
No positivity assumption on L is required: the two endpoints imply every
inequality needed in the triangle-inequality proof. -/
theorem distance_coe_ge_of_interval {x L : ℝ} {j : ℤ}
    (hl : (j : ℝ) + L ≤ x) (hu : x ≤ (j : ℝ) + 1 - L) :
    L ≤ distance (x : Time) := by
  let y : ℝ := x - (j : ℝ)
  have hylo : L ≤ y := by dsimp [y]; linarith
  have hyhi : y ≤ 1 - L := by dsimp [y]; linarith
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  have he : (y : Time) = (x : Time) := by
    dsimp [y]
    rw [hz, sub_zero]
  have hd : distance (((1 / 2 : ℝ) - y) : Time) ≤ (1 / 2 : ℝ) - L := by
    apply (distance_coe_le_integer ((1 / 2 : ℝ) - y) 0).trans
    simp only [Int.cast_zero, sub_zero]
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have hh : ‖(((1 / 2 : ℝ)) : Time)‖ = (1 / 2 : ℝ) := by
    simpa using AddCircle.norm_half_period_eq (1 : ℝ)
  have ht : (1 / 2 : ℝ) ≤
      distance (y : Time) + distance (((1 / 2 : ℝ) - y) : Time) := by
    have hn := norm_add_le (y : Time) ((((1 / 2 : ℝ) - y) : ℝ) : Time)
    rw [← AddCircle.coe_add] at hn
    have hs : y + ((1 / 2 : ℝ) - y) = 1 / 2 := by ring
    rw [hs, hh] at hn
    exact hn
  have hL : L ≤ distance (y : Time) := by linarith
  rwa [he] at hL

/-- Input plane 01: common rational point (1/14, 5/14). -/
theorem torus72_good_01 :
    TorusGood (![1, 1, 2, 3]) (![1, -1, -2, 3]) (2 / 7) := by
  refine ⟨((1 : ℝ) / (14 : ℝ)), ((5 : ℝ) / (14 : ℝ)), ?_⟩
  intro i
  fin_cases i
  · apply distance_coe_ge_of_interval (j := (0 : ℤ)) <;> norm_num
  · apply distance_coe_ge_of_interval (j := (-1 : ℤ)) <;> norm_num
  · apply distance_coe_ge_of_interval (j := (-1 : ℤ)) <;> norm_num
  · apply distance_coe_ge_of_interval (j := (1 : ℤ)) <;> norm_num

