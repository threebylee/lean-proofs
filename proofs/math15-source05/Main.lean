/-- The actual tight core gives the unrestricted checked pair family. -/
theorem source05_small_pair_tight_core {q c d : ℕ} (hq : q=1 ∨ q=2)
    (hp : Positive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hcard : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4)
