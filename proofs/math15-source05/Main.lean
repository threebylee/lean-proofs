  rcases h with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
  · exact torus_two_zero_123
  · exact torus_two_zero_132
  · exact torus_two_zero_213
  · exact torus_two_zero_231
  · exact torus_two_zero_312
  · exact torus_two_zero_321

theorem torus_two_zero_positive_distinct_sum_six {d e f : ℕ}
    (hd : 0 < d) (he : 0 < e) (hf : 0 < f)
    (hde : d ≠ e) (hdf : d ≠ f) (hef : e ≠ f) (hsum : d + e + f = 6) :
    TorusGood (![1, 1, 0, 0]) (![(d : ℤ), -(d : ℤ), (e : ℤ), (f : ℤ)]) (2 / 7) := by
  apply torus_two_zero_permutation
  unfold TorusTwoZeroPermutation
  omega










