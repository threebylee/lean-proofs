/- Section: SharedPacketChunkComposition -/
section



/-!
Abstract composition for small default-kernel cache chunks. The range
partition is proved structurally from contiguous leaf partitions; no large
range or numerical cache is reevaluated by this helper.
-/

namespace Math15.LonelyRunner

theorem shared_range_partition_append
    {start leftSize rightSize : ℕ} {xs ys : List ℕ}
    (hx : List.range' start leftSize=xs)
    (hy : List.range' (start+leftSize) rightSize=ys) :
    List.range' start (leftSize+rightSize)=xs++ys := by
  rw [←List.range'_append_1,hx,hy]

theorem sharedPacketSupportedCensusCheck_of_checks
    {S bound size width packets oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (hflags : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (hrows : sharedPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    sharedPacketSupportedCensusCheck S bound size width packets pool compat prefixCache
      oddBits goodTimeBits packetUnion=true := by
  simp only [sharedPacketSupportedCensusCheck,Bool.and_eq_true,decide_eq_true_eq]
  exact ⟨⟨⟨⟨⟨hflags,hcache⟩,hcomp⟩,hpref⟩,hodd⟩,hrows⟩




end Math15.LonelyRunner
end 

/- Section: EarlyRangeComposition -/
section



/-!
Structural composition of original-range early-packet census chunks.

Each leaf concerns a contiguous List.range' interval of the actual index. A
join starts its right interval at the left interval's exact endpoint. The tree
span must equal the original c, b or a range length before the corresponding
consumer can be applied. Thus the certificate never assumes that an externally
supplied row list exhausts the original range.

Balanced trees give shallow proof terms. Leaf truths and interval widths are
the only numerical inputs; the generic composition reevaluates no row, speed
mask, packet cache or rational residue. Empty intervals are supported.
-/

namespace Math15.LonelyRunner

inductive SharedEarlyRangeTree where
  | leaf (width : ℕ)
  | join (left right : SharedEarlyRangeTree)

def SharedEarlyRangeTree.span : SharedEarlyRangeTree → ℕ
  | .leaf width => width
  | .join left right => left.span+right.span

/-- The leaf starts and join endpoints identify the actual contiguous
range, independently of any list of supplied quartets. -/
def SharedEarlyRangeTree.Verified (tree : SharedEarlyRangeTree)
    (start : ℕ) (f : ℕ → Bool) : Prop :=
  match tree with
  | .leaf width => (List.range' start width).all f=true
  | .join left right =>
      left.Verified start f ∧ right.Verified (start+left.span) f

/-- Compose two contiguous intervals using the structural partition
helper and List.all_append, with no numerical predicate reduction. -/
theorem shared_range_all_true_append
    {start leftSize rightSize : ℕ} {f : ℕ → Bool}
    (hx : (List.range' start leftSize).all f=true)
    (hy : (List.range' (start+leftSize) rightSize).all f=true) :
    (List.range' start (leftSize+rightSize)).all f=true := by
  have hpartition : List.range' start (leftSize+rightSize)=
      List.range' start leftSize++List.range' (start+leftSize) rightSize :=
    shared_range_partition_append (start:=start) (leftSize:=leftSize)
      (rightSize:=rightSize) rfl rfl
  rw [hpartition,List.all_append,Bool.and_eq_true]
  exact ⟨hx,hy⟩

/-- Individual accepted facts on the entire actual leaf interval can be
used without evaluating the leaf's Boolean predicate again. -/
theorem sharedEarlyRange_leaf_verified_of_each
    {start width : ℕ} {f : ℕ → Bool}
    (h : ∀ i ∈ List.range' start width,f i=true) :
    SharedEarlyRangeTree.Verified (.leaf width) start f := by
  exact List.all_eq_true.mpr h

/-- Induction only composes accepted contiguous leaf facts. A balanced
tree has logarithmic depth without changing the complete interval. -/
theorem sharedEarlyRange_verified_all_true
    {tree : SharedEarlyRangeTree} {start : ℕ} {f : ℕ → Bool}
    (h : tree.Verified start f) :
    (List.range' start tree.span).all f=true := by
  induction tree generalizing start with
  | leaf width => exact h
  | join left right ihLeft ihRight =>
      exact shared_range_all_true_append
        (ihLeft (start:=start) h.1) (ihRight (start:=start+left.span) h.2)

/-- One actual c entry, including the checked pair-gcd exclusion branch. -/
def sharedEarlyCensusCEntry (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a b c : ℕ) : Bool :=
  if Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
    Nat.testBit (compat b) c then
    sharedEarlyPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c
  else true

theorem sharedEarlyPacketCensusAtB_eq_c_range (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a b : ℕ) :
    sharedEarlyPacketCensusAtB S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b=
      (List.range' (b+1) (((S-a-b-1)/2+1)-(b+1))).all
        (sharedEarlyCensusCEntry S bound width packets compat prefixCache oddBits
          goodTimeBits packetUnion a b) := rfl

/-- Bind the c-tree span to the full original c range, rather than to
the number of stored or successful leaf rows. -/
theorem sharedEarlyPacketCensusAtB_of_range_chunks
    {S bound width packets oddBits a b : ℕ} {tree : SharedEarlyRangeTree}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (hspan : tree.span=(((S-a-b-1)/2+1)-(b+1)))
    (hchunks : tree.Verified (b+1)
      (sharedEarlyCensusCEntry S bound width packets compat prefixCache oddBits
        goodTimeBits packetUnion a b)) :
    sharedEarlyPacketCensusAtB S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b=true := by
  rw [sharedEarlyPacketCensusAtB_eq_c_range,←hspan]
  exact sharedEarlyRange_verified_all_true hchunks

/-- Actual complete AtB facts compose into the full original b range. -/
theorem sharedEarlyPacketCensusAtA_of_range_chunks
    {S bound width packets oddBits a : ℕ} {tree : SharedEarlyRangeTree}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (hspan : tree.span=(((S-a-3)/3+1)-(a+1)))
    (hchunks : tree.Verified (a+1)
      (sharedEarlyPacketCensusAtB S bound width packets compat prefixCache oddBits
        goodTimeBits packetUnion a)) :
    sharedEarlyPacketCensusAtA S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a=true := by
  rw [sharedEarlyPacketCensusAtA_eq_inner,←hspan]
  exact sharedEarlyRange_verified_all_true hchunks

/-- Complete AtA facts compose over every original outer index. The
existing early-to-late refinement and exact set consumer apply afterward. -/
theorem sharedEarlyPacketCensusCheck_of_range_chunks
    {S bound width packets oddBits : ℕ} {tree : SharedEarlyRangeTree}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (hspan : tree.span=(S-6)/4)
    (hchunks : tree.Verified 1
      (sharedEarlyPacketCensusAtA S bound width packets compat prefixCache oddBits
        goodTimeBits packetUnion)) :
    sharedEarlyPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true := by
  unfold sharedEarlyPacketCensusCheck
  rw [←hspan]
  exact sharedEarlyRange_verified_all_true hchunks









end Math15.LonelyRunner
end 

