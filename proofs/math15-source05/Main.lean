/- Section: ThreeRunnerBands -/
section


/-!
Pure integer arithmetic behind the three-runner pair-grid lemma.

For n >= 3r and 1 <= j <= n/2, some integer ell in [r,n-r] has ell*j mod n in
[r,n-r]. The modular argument below supplies the arithmetic step used in
three-runner isolation.
-/

namespace Math15.LonelyRunner

theorem band_bad_center {x n r : ℤ} (hn : 0<n) (hr : 1≤r)
    (hbad : ¬(r≤x%n ∧ x%n≤n-r)) :
    ∃ q : ℤ, q*n-r+1≤x ∧ x≤q*n+r-1 := by
  have hrem0 := Int.emod_nonneg x (ne_of_gt hn)
  have hremn := Int.emod_lt_of_pos x hn
  have he := Int.emod_add_ediv_mul x n
  by_cases hlo : x%n<r
  · refine ⟨x/n, ?_, ?_⟩ <;> nlinarith
  · have hhi : n-r<x%n := by omega
    refine ⟨x/n+1, ?_, ?_⟩ <;> nlinarith

/-- If a step cannot jump across the middle band, two consecutive bad
points lie near the same integer multiple of n. -/
theorem band_bad_centers_equal {x n r j q q' : ℤ}
    (hn : 0<n) (hr : 1≤r) (hwidth : 2*r≤n)
    (hj : 0≤j) (hjmax : j≤n-2*r+1)
    (hlo : q*n-r+1≤x) (hhi : x≤q*n+r-1)
    (hlo' : q'*n-r+1≤x+j) (hhi' : x+j≤q'*n+r-1) : q'=q := by
  by_contra hneq
  rcases lt_or_gt_of_ne hneq with hlt | hgt
  · have hq : q'+1≤q := by omega
    have hmul := mul_le_mul_of_nonneg_right hq (le_of_lt hn)
    nlinarith
  · have hq : q+1≤q' := by omega
    have hmul := mul_le_mul_of_nonneg_right hq (le_of_lt hn)
    nlinarith

/-- A progression with enough span and a step too small to skip the
middle band must enter the band. -/
theorem band_hit_small_step {n r j y : ℤ} (N : ℕ)
    (hn : 0<n) (hr : 1≤r) (hwidth : 2*r≤n)
    (hj : 0≤j) (hjmax : j≤n-2*r+1) (hspan : 2*r≤(N : ℤ)*j) :
    ∃ k : ℕ, k≤N ∧ r≤(y+(k : ℤ)*j)%n ∧
      (y+(k : ℤ)*j)%n≤n-r := by
  by_contra h
  have hbad : ∀ k : ℕ, k≤N →
      ¬(r≤(y+(k : ℤ)*j)%n ∧ (y+(k : ℤ)*j)%n≤n-r) := by
    intro k hk hh
    exact h ⟨k,hk,hh⟩
  obtain ⟨q,hqlo,hqhi⟩ := band_bad_center hn hr (by simpa using hbad 0 (by omega))
  have hc : ∀ k : ℕ, k≤N →
      q*n-r+1≤y+(k : ℤ)*j ∧ y+(k : ℤ)*j≤q*n+r-1 := by
    intro k
    induction k with
    | zero => intro _; simpa using And.intro hqlo hqhi
    | succ k ih =>
      intro hk
      have hprev := ih (by omega)
      obtain ⟨q',hlo,hhi⟩ := band_bad_center hn hr (hbad (k+1) hk)
      have he : y+((k+1 : ℕ) : ℤ)*j = (y+(k : ℤ)*j)+j := by
        push_cast
        ring
      rw [he] at hlo hhi
      have heq := band_bad_centers_equal hn hr hwidth hj hjmax
        hprev.1 hprev.2 hlo hhi
      rw [heq] at hlo hhi
      rw [he]
      exact ⟨hlo,hhi⟩
  have hend := hc N le_rfl
  nlinarith

theorem band_mod_add_step (x j n : ℤ) :
    (x+j)%n = (x%n+j)%n := by
  simp only [Int.add_emod, Int.emod_emod]

theorem band_mod_one_wrap {x n : ℤ} (hn : 0<n) (hxlo : n≤x)
    (hxhi : x<2*n) : x%n=x-n := by
  calc
    x%n=((x-n)+n)%n := by congr 1; ring
    _=(x-n)%n := by simp only [Int.add_emod, Int.emod_self, add_zero, Int.emod_emod]
    _=x-n := Int.emod_eq_of_lt (by omega) (by omega)

/-- In the large-step case, a bad low residue whose successor is bad
lies in the substantially shorter interval [n-r-j+1,r-1]. -/
theorem band_large_low_predecessor {x n r j : ℤ}
    (hr : 1≤r) (hthird : 3*r≤n)
    (hjmin : n-2*r+2≤j) (hjhalf : 2*j<n)
    (hxlo : 0≤x) (hxhi : x≤r-1)
    (hnext : ¬(r≤(x+j)%n ∧ (x+j)%n≤n-r)) :
    n-r-j+1≤x := by
  have hslo : 0≤x+j := by omega
  have hshi : x+j<n := by omega
  rw [Int.emod_eq_of_lt hslo hshi] at hnext
  omega

/-- The alternating bad arcs in the large-step case cannot persist.
Every second low residue decreases by n-2j, while all such residues
would have to fit in a shorter ordinary integer interval. -/
theorem band_hit_large_step {n r j : ℤ}
    (hr : 1≤r) (hthird : 3*r≤n)
    (hjmin : n-2*r+2≤j) (hjhalf : 2*j<n) :
    ∃ ell : ℤ, r≤ell ∧ ell≤n-r ∧ r≤(ell*j)%n ∧ (ell*j)%n≤n-r := by
  have hn : 0<n := by omega
  let f : ℤ → ℤ := fun ell => (ell*j)%n
  have hf0 (ell : ℤ) : 0≤f ell := Int.emod_nonneg _ (ne_of_gt hn)
  have hfn (ell : ℤ) : f ell<n := Int.emod_lt_of_pos _ hn
  have hstep (ell : ℤ) : f (ell+1)=(f ell+j)%n := by
    dsimp [f]
    rw [show (ell+1)*j=ell*j+j by ring]
    exact band_mod_add_step _ _ _
  have htwo (ell : ℤ) : f (ell+2)=(f ell+2*j)%n := by
    dsimp [f]
    rw [show (ell+2)*j=ell*j+2*j by ring]
    exact band_mod_add_step _ _ _
  by_contra h
  have hbad (ell : ℤ) (hl : r≤ell) (hu : ell≤n-r) :
      ¬(r≤f ell ∧ f ell≤n-r) := by
    intro hh
    exact h ⟨ell,hl,hu,hh⟩
  have hstart : ∃ ell0 : ℤ, (ell0=r ∨ ell0=r+1) ∧ f ell0≤r-1 := by
    by_cases hlo : f r≤r-1
    · exact ⟨r,Or.inl rfl,hlo⟩
    · have hhigh : n-r+1≤f r := by
        have := hbad r le_rfl (by omega)
        omega
      have hslo : n≤f r+j := by omega
      have hshi : f r+j<2*n := by have := hfn r; omega
      have he := band_mod_one_wrap hn hslo hshi
      have hfail := hbad (r+1) (by omega) (by omega)
      rw [hstep,he] at hfail
      have hfupper : f r+j-n<n-r := by have := hfn r; omega
      have hlow' : f (r+1)≤r-1 := by rw [hstep,he]; omega
      exact ⟨r+1,Or.inr rfl,hlow'⟩
  obtain ⟨ell0,hell0,hstartlow⟩ := hstart
  have hell0lo : r≤ell0 := by omega
  have hell0hi : ell0≤r+1 := by omega
  let N : ℕ := ((n-2*r-2)/2).toNat
  have hN : (N : ℤ)=(n-2*r-2)/2 := by
    dsimp [N]
    exact Int.toNat_of_nonneg (by omega)
  have hNhi : 2*(N : ℤ)≤n-2*r-2 := by omega
  have hNlo : n-2*r-3≤2*(N : ℤ) := by omega
  have hNwide : 2*r+j-n-2<(N : ℤ) := by omega
  have hchain : ∀ k : ℕ, k≤N →
      f (ell0+2*(k : ℤ))=f ell0+(k : ℤ)*(2*j-n) ∧
      n-r-j+1≤f (ell0+2*(k : ℤ)) ∧ f (ell0+2*(k : ℤ))≤r-1 := by
    intro k
    induction k with
    | zero =>
      intro _
      have hnext := hbad (ell0+1) (by omega) (by omega)
      rw [hstep] at hnext
      have hlo := band_large_low_predecessor hr hthird hjmin hjhalf
        (hf0 ell0) hstartlow hnext
      simpa using (show f ell0=f ell0 ∧ n-r-j+1≤f ell0 ∧ f ell0≤r-1
        from ⟨rfl,hlo,hstartlow⟩)
    | succ k ih =>
      intro hk
      have hp := ih (by omega)
      let ell : ℤ := ell0+2*(k : ℤ)
      have hslo : n≤f ell+2*j := by dsimp [ell]; omega
      have hshi : f ell+2*j<2*n := by dsimp [ell]; omega
      have hwrap := band_mod_one_wrap hn hslo hshi
      have he : f (ell+2)=f ell+2*j-n := by rw [htwo,hwrap]
      have hlow : f (ell+2)≤r-1 := by rw [he]; dsimp [ell]; omega
      have hnext := hbad (ell+3) (by dsimp [ell]; omega)
        (by dsimp [ell]; omega)
      have hnext' : ¬(r≤(f (ell+2)+j)%n ∧ (f (ell+2)+j)%n≤n-r) := by
        simpa only [show ell+3=(ell+2)+1 by ring,hstep] using hnext
      have hlo := band_large_low_predecessor hr hthird hjmin hjhalf
        (hf0 (ell+2)) hlow hnext'
      have hell : ell0+2*((k+1 : ℕ) : ℤ)=ell+2 := by
        dsimp [ell]
        push_cast
        ring
      rw [hell]
      refine ⟨?_,hlo,hlow⟩
      rw [he]
      change f (ell0+2*(k : ℤ))+2*j-n = _
      rw [hp.1]
      push_cast
      ring
  have hend := hchain N le_rfl
  have hprod : (N : ℤ)*(2*j-n)≤-(N : ℤ) := by
    have hm := mul_le_mul_of_nonneg_left (show 2*j-n≤-1 by omega)
      (show (0 : ℤ)≤N by exact_mod_cast Nat.zero_le N)
    nlinarith
  nlinarith

/-- Uniform middle-band hitting for any r with 3r<=n. This is the
coprime-pair modular engine, with no hypothesis on gcd(j,n). -/
theorem integer_third_band_hit {n r j : ℤ}
    (hr : 1≤r) (hthird : 3*r≤n) (hj : 1≤j) (hjhalf : 2*j≤n) :
    ∃ ell : ℤ, r≤ell ∧ ell≤n-r ∧ r≤(ell*j)%n ∧ (ell*j)%n≤n-r := by
  have hn : 0<n := by omega
  by_cases hjone : j=1
  · subst j
    refine ⟨r,le_rfl,by omega,?_,?_⟩ <;>
      rw [mul_one,Int.emod_eq_of_lt (by omega) (by omega)] <;> omega
  have hjtwo : 2≤j := by omega
  by_cases hsmall : j≤n-2*r+1
  · let N : ℕ := (n-2*r).toNat
    have hN : (N : ℤ)=n-2*r := by
      dsimp [N]
      exact Int.toNat_of_nonneg (by omega)
    have hspan : 2*r≤(N : ℤ)*j := by rw [hN]; nlinarith
    obtain ⟨k,hk,hl,hu⟩ := band_hit_small_step N hn hr (by omega)
      (by omega) hsmall hspan (y := r*j)
    have he : (r+(k : ℤ))*j=r*j+(k : ℤ)*j := by ring
    refine ⟨r+(k : ℤ),by omega,by omega,?_,?_⟩
    · rw [he]; exact hl
    · rw [he]; exact hu
  by_cases hhalf : 2*j=n
  · have hodd : ∃ ell : ℤ, (ell=r ∨ ell=r+1) ∧ ell%2=1 := by
      have hrem0 := Int.emod_nonneg r (by norm_num : (2 : ℤ)≠0)
      have hrem2 := Int.emod_lt_of_pos r (by norm_num : (0 : ℤ)<2)
      by_cases heven : r%2=0
      · refine ⟨r+1,Or.inr rfl,?_⟩
        rw [Int.add_emod,heven]
        norm_num
      · have hrodd : r%2=1 := by omega
        exact ⟨r,Or.inl rfl,hrodd⟩
    obtain ⟨ell,hell,heodd⟩ := hodd
    have hellrep : ell=2*(ell/2)+1 := by
      have he := Int.emod_add_ediv_mul ell 2
      omega
    have hmod : (ell*j)%n=j := by
      have he : ell*j=(ell/2)*n+j := by
        calc
          ell*j=(2*(ell/2)+1)*j := congrArg (fun q : ℤ => q*j) hellrep
          _=(ell/2)*n+j := by rw [←hhalf]; ring
      rw [he]
      simp only [Int.mul_add_emod_self_right]
      exact Int.emod_eq_of_lt (by omega) (by omega)
    exact ⟨ell,by omega,by omega,by rw [hmod]; omega,by rw [hmod]; omega⟩
  · exact band_hit_large_step hr hthird (by omega) (by omega)










end Math15.LonelyRunner
end 

/- Section: ThreeRunnerIsolation -/
section



/-!
Three-runner isolation: reusable reductions for the implication

  Positive V, card V = 3, ML V < 2/7
    -> exists a > 0, V = {a,2*a,3*a}.

The uniform pair-grid lower bound and final assembly are treated in the
subsequent sections. The pair-grid argument follows Kravitz, arXiv:1912.06034,
Lemma 3.4.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- Integer dilation of every speed preserves the continuous maximum. -/
theorem ML_scale_image (V : Finset ℕ) (hV : V.Nonempty) (g : ℕ)
    (hg : 0 < g) : ML (V.image (fun v => g * v)) = ML V := by
  classical
  have hS : (V.image (fun v => g * v)).Nonempty := hV.image _
  have hgR : (0 : ℝ) < g := by exact_mod_cast hg
  apply le_antisymm
  · obtain ⟨t, ht⟩ := ML_attained (V.image (fun v => g * v))
    apply le_trans ?_ (score_le_ML V (g • t))
    simp only [score, dif_pos hV]
    apply Finset.le_inf' hV
    intro v hv
    have hs := score_le_distance
      (Finset.mem_image.mpr ⟨v, hv, rfl⟩ : g * v ∈ V.image (fun w => g * w)) t
    rw [ht] at hs
    rw [mul_comm g v, mul_nsmul] at hs
    rw [smul_comm g v t] at hs
    exact hs
  · obtain ⟨t, ht⟩ := ML_attained V
    obtain ⟨x⟩ := t
    change score V (x : Time) = ML V at ht
    apply ML_lower_of_witness hS (((x / (g : ℝ) : ℝ)) : Time)
    intro w hw
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hw
    have hs := score_le_distance hv (x : Time)
    rw [ht] at hs
    have he : (g * v) • (((x / (g : ℝ) : ℝ)) : Time) = v • (x : Time) := by
      rw [← AddCircle.coe_nsmul, ← AddCircle.coe_nsmul]
      congr 1
      simp only [nsmul_eq_mul, Nat.cast_mul]
      field_simp
      <;> ring
    simpa only [he] using hs

def normalizedSpeeds (V : Finset ℕ) : Finset ℕ :=
  V.image (fun v => v / V.gcd id)

theorem speed_gcd_pos {V : Finset ℕ} (hV : V.Nonempty) (hp : Positive V) :
    0 < V.gcd id := by
  obtain ⟨v, hv⟩ := hV
  apply Nat.pos_of_ne_zero
  intro hz
  have hd := Finset.gcd_dvd (f := id) hv
  rw [hz] at hd
  have hv0 : v = 0 := by simpa only [id_eq, zero_dvd_iff] using hd
  have := hp v hv
  omega

theorem normalizedSpeeds_nonempty {V : Finset ℕ} (hV : V.Nonempty) :
    (normalizedSpeeds V).Nonempty := hV.image _

theorem normalizedSpeeds_positive {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) : Positive (normalizedSpeeds V) := by
  intro w hw
  obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hw
  have hg := speed_gcd_pos hV hp
  have hvpos := hp v hv
  have hd : V.gcd id ∣ v := Finset.gcd_dvd hv
  have hmul : V.gcd id * (v / V.gcd id) = v := Nat.mul_div_cancel' hd
  change 0 < (v / V.gcd id : ℕ)
  apply Nat.pos_of_ne_zero
  intro hz
  rw [hz] at hmul
  have hvzero : v=0 := by simpa using hmul.symm
  exact (ne_of_gt hvpos) hvzero

theorem normalizedSpeeds_primitive {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) : Primitive (normalizedSpeeds V) := by
  obtain ⟨v, hv⟩ := hV
  unfold Primitive normalizedSpeeds
  rw [Finset.gcd_image]
  simpa only [Function.comp_def, id_eq] using
    (Finset.gcd_div_id_eq_one hv (ne_of_gt (hp v hv)))

theorem normalizedSpeeds_scale {V : Finset ℕ} :
    (normalizedSpeeds V).image (fun v => V.gcd id * v) = V := by
  classical
  ext w
  constructor
  · intro hw
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hw
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    have hd : V.gcd id ∣ v := Finset.gcd_dvd (f := id) hv
    rw [Nat.mul_div_cancel' hd]
    exact hv
  · intro hw
    apply Finset.mem_image.mpr
    refine ⟨w / V.gcd id, Finset.mem_image.mpr ⟨w, hw, rfl⟩, ?_⟩
    exact Nat.mul_div_cancel' (Finset.gcd_dvd (f := id) hw)

theorem normalizedSpeeds_card {V : Finset ℕ} :
    (normalizedSpeeds V).card = V.card := by
  classical
  unfold normalizedSpeeds
  apply Finset.card_image_of_injOn
  intro u hu v hv he
  change u / V.gcd id = v / V.gcd id at he
  have hu' : V.gcd id * (u / V.gcd id) = u :=
    Nat.mul_div_cancel' (Finset.gcd_dvd (f := id) hu)
  have hv' : V.gcd id * (v / V.gcd id) = v :=
    Nat.mul_div_cancel' (Finset.gcd_dvd (f := id) hv)
  rw [← hu', ← hv', he]

theorem normalizedSpeeds_ML {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) : ML (normalizedSpeeds V) = ML V := by
  have hs := ML_scale_image (normalizedSpeeds V)
    (normalizedSpeeds_nonempty hV) (V.gcd id) (speed_gcd_pos hV hp)
  rw [normalizedSpeeds_scale] at hs
  exact hs.symm

/-- Every pair of coprime positive speeds has a common one-third witness.
The chosen residue is floor((a+b)/2); the other speed is its negative. -/
theorem coprime_two_speed_ML_ge_third (a b : ℕ) (ha : 0 < a) (hb : 0 < b)
    (hcop : Nat.Coprime a b) : (1 / 3 : ℝ) ≤ ML ({a,b} : Finset ℕ) := by
  have hn : 0 < a + b := by omega
  have hnR : (0 : ℝ) < ((a + b : ℕ) : ℝ) := by exact_mod_cast hn
  have hcop' : Nat.Coprime a (a + b) := Nat.coprime_self_add_right.mpr hcop
  obtain ⟨m, hm, hmod⟩ := Nat.exists_mul_mod_eq_of_coprime
    ((a+b)/2) hcop' (ne_of_gt hn)
  have hk : (a+b)/2 < a+b := by omega
  rw [Nat.mod_eq_of_lt hk] at hmod
  let t : Time := (((m : ℝ) / ((a+b : ℕ) : ℝ)) : Time)
  have hz : (a+b) • t = 0 := by
    dsimp [t]
    rw [nsmul_rational_time_nat]
    have he : (((a+b)*m : ℕ) : ℝ) / ((a+b : ℕ) : ℝ) = (m : ℝ) := by
      push_cast
      field_simp
    rw [he]
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨m, by simp [zsmul_eq_mul]⟩
  have hbneg : b • t = -(a • t) :=
    eq_neg_of_add_eq_zero_right (by rw [← add_nsmul]; exact hz)
  have haL : (1 / 3 : ℝ) ≤ distance (a • t) := by
    dsimp [t]
    rw [distance_at_rational, hmod]
    have hmin : min ((a+b)/2) (a+b-(a+b)/2) = (a+b)/2 := by omega
    rw [hmin]
    apply (le_div_iff₀ hnR).mpr
    have hnat : a+b ≤ 3*((a+b)/2) := by omega
    have hreal : ((a+b : ℕ) : ℝ) ≤ 3*(((a+b)/2 : ℕ) : ℝ) := by
      exact_mod_cast hnat
    linarith
  apply ML_lower_of_witness (by simp) t
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl
  · exact haL
  · simpa only [hbneg, distance, norm_neg] using haL

/-- No coprimality or distinctness hypothesis is needed for two runners. -/
theorem two_speed_ML_ge_third (a b : ℕ) (ha : 0 < a) (hb : 0 < b) :
    (1 / 3 : ℝ) ≤ ML ({a,b} : Finset ℕ) := by
  let g := Nat.gcd a b
  have hg : 0 < g := Nat.gcd_pos_of_pos_left b ha
  have ha' : 0 < a/g := Nat.div_gcd_pos_of_pos_left b ha
  have hb' : 0 < b/g := by
    simpa only [g, Nat.gcd_comm a b] using Nat.div_gcd_pos_of_pos_left a hb
  have hcop : Nat.Coprime (a/g) (b/g) := Nat.coprime_div_gcd_div_gcd hg
  have hscale := ML_scale_image ({a/g,b/g} : Finset ℕ) (by simp) g hg
  have he : ({a/g,b/g} : Finset ℕ).image (fun v => g*v) = {a,b} := by
    simp only [Finset.image_insert, Finset.image_singleton]
    rw [Nat.mul_div_cancel' (Nat.gcd_dvd_left a b),
      Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)]
  rw [he] at hscale
  rw [hscale]
  exact coprime_two_speed_ML_ge_third (a/g) (b/g) ha' hb' hcop

/-- A nearest point in an equally spaced g-orbit lies within 1/(2g)
of the antipodal point. Integer shifts of the orbit parameter are allowed. -/
theorem exists_prejump_far (g : ℕ) (hg : 0 < g) (x : ℝ) :
    ∃ z : ℤ, (1 / 2 : ℝ) - 1 / (2 * (g : ℝ)) ≤
      distance ((x + (z : ℝ) / (g : ℝ) : ℝ) : Time) := by
  have hgR : (0 : ℝ) < g := by exact_mod_cast hg
  let z : ℤ := round ((g : ℝ) * (1/2 - x))
  have hz := abs_sub_round ((g : ℝ) * (1/2 - x))
  have he : (1/2 : ℝ) - (x + (z : ℝ)/(g : ℝ)) =
      ((g : ℝ)*(1/2-x) - z)/(g : ℝ) := by field_simp; ring
  have hclose : |(1/2 : ℝ) - (x + (z : ℝ)/(g : ℝ))| ≤
      1/(2*(g : ℝ)) := by
    rw [he, abs_div, abs_of_pos hgR]
    apply (div_le_iff₀ hgR).mpr
    dsimp [z] at *
    have he' : 1/(2*(g : ℝ))*(g : ℝ) = (1/2 : ℝ) := by field_simp
    rwa [he']
  have hd : distance (((1/2 : ℝ) - (x+(z : ℝ)/(g : ℝ)) : ℝ) : Time) ≤
      1/(2*(g : ℝ)) := (distance_coe_le_integer
    ((1/2 : ℝ) - (x+(z : ℝ)/(g : ℝ))) 0).trans
      (by simpa only [Int.cast_zero, sub_zero] using hclose)
  have hh : ‖(((1/2 : ℝ)) : Time)‖ = (1/2 : ℝ) := by
    simpa using AddCircle.norm_half_period_eq (1 : ℝ)
  have ht := norm_add_le ((x+(z : ℝ)/(g : ℝ) : ℝ) : Time)
    (((1/2 : ℝ) - (x+(z : ℝ)/(g : ℝ)) : ℝ) : Time)
  rw [← AddCircle.coe_add] at ht
  have hsum : x+(z : ℝ)/(g : ℝ) +
      ((1/2 : ℝ) - (x+(z : ℝ)/(g : ℝ))) = 1/2 := by ring
  rw [hsum, hh] at ht
  exact ⟨z, by change _ ≤ ‖_‖; change ‖_‖ ≤ _ at hd; linarith⟩

/-- A pre-jump by an integer multiple of 1/g fixes any speed divisible by g. -/
theorem prejump_integer_invariant (g a : ℕ) (hg : 0 < g) (hga : g ∣ a)
    (j : ℤ) (x : ℝ) :
    a • (((x + (j : ℝ)/(g : ℝ) : ℝ)) : Time) = a • (x : Time) := by
  obtain ⟨q, rfl⟩ := hga
  have hgR : (0 : ℝ) < g := by exact_mod_cast hg
  have hg0 : (g : ℝ) ≠ 0 := ne_of_gt hgR
  have hz : (((((q : ℤ)*j : ℤ) : ℝ)) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨(q : ℤ)*j, by simp [zsmul_eq_mul]⟩
  rw [← AddCircle.coe_nsmul, ← AddCircle.coe_nsmul]
  simp only [nsmul_eq_mul]
  have he : ((g*q : ℕ) : ℝ)*(x+(j : ℝ)/(g : ℝ)) =
      ((g*q : ℕ) : ℝ)*x + (((q : ℤ)*j : ℤ) : ℝ) := by
    push_cast
    field_simp [hg0]
    <;> ring
  rw [he, AddCircle.coe_add, hz, add_zero]

/-- Coprimality makes a runner's pre-jump orbit traverse all g equally
spaced points. Bézout transfers the nearest-antipode integer parameter to
one actual common time shift. -/
theorem exists_coprime_prejump_far (g c : ℕ) (hg : 0 < g)
    (hcop : Nat.Coprime c g) (x : ℝ) :
    ∃ j : ℤ, (1/2 : ℝ)-1/(2*(g : ℝ)) ≤
      distance (c • (((x+(j : ℝ)/(g : ℝ) : ℝ)) : Time)) := by
  have hgR : (0 : ℝ) < g := by exact_mod_cast hg
  have hg0 : (g : ℝ) ≠ 0 := ne_of_gt hgR
  obtain ⟨z, hz⟩ := exists_prejump_far g hg ((c : ℝ)*x)
  let j : ℤ := Nat.gcdA c g * z
  let k : ℤ := -(Nat.gcdB c g * z)
  have hbez : (1 : ℝ) = (c : ℝ)*(Nat.gcdA c g : ℝ) +
      (g : ℝ)*(Nat.gcdB c g : ℝ) := by
    have h := Nat.gcd_eq_gcd_ab c g
    rw [hcop.gcd_eq_one] at h
    exact_mod_cast h
  have hbz := congrArg (fun q : ℝ => q * (z : ℝ)) hbez
  dsimp only at hbz
  have he : (c : ℝ)*(x+(j : ℝ)/(g : ℝ)) =
      (c : ℝ)*x+(z : ℝ)/(g : ℝ)+(k : ℝ) := by
    dsimp [j, k]
    push_cast
    field_simp [hg0]
    nlinarith
  have hk : (((k : ℤ) : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨k, by simp [zsmul_eq_mul]⟩
  refine ⟨j, ?_⟩
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul, he, AddCircle.coe_add, hk, add_zero]
  exact hz

/-- A pair gcd at least three, coprime to the remaining runner, supplies
one common three-runner one-third witness. -/
theorem three_speed_large_pair_gcd_ge_third (a b c : ℕ)
    (ha : 0<a) (hb : 0<b)
    (hcop : Nat.Coprime c (Nat.gcd a b)) (hg : 3 ≤ Nat.gcd a b) :
    (1/3 : ℝ) ≤ ML ({a,b,c} : Finset ℕ) := by
  let g := Nat.gcd a b
  have hgpos : 0 < g := by dsimp [g]; omega
  have hgR : (3 : ℝ) ≤ g := by exact_mod_cast hg
  have hg0R : (0 : ℝ) < g := by exact_mod_cast hgpos
  obtain ⟨t, ht⟩ := ML_attained ({a,b} : Finset ℕ)
  obtain ⟨x⟩ := t
  change score ({a,b} : Finset ℕ) (x : Time) = ML ({a,b} : Finset ℕ) at ht
  obtain ⟨j, hj⟩ := exists_coprime_prejump_far g c hgpos hcop x
  have hrec : (1 : ℝ)/(2*(g : ℝ)) ≤ (1/6 : ℝ) := by
    apply (div_le_div_iff₀ (by positivity : (0 : ℝ)<2*(g : ℝ))
      (by norm_num : (0 : ℝ)<6)).mpr
    nlinarith
  have hcL : (1/3 : ℝ) ≤ distance
      (c • (((x+(j : ℝ)/(g : ℝ) : ℝ)) : Time)) := by linarith
  have hpL := two_speed_ML_ge_third a b ha hb
  apply ML_lower_of_witness (by simp) (((x+(j : ℝ)/(g : ℝ) : ℝ)) : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with hva | hvb | hvc
  · rw [hva, prejump_integer_invariant g a hgpos (Nat.gcd_dvd_left a b) j x]
    have h := score_le_distance (by simp : a ∈ ({a,b} : Finset ℕ)) (x : Time)
    rw [ht] at h
    exact hpL.trans h
  · rw [hvb, prejump_integer_invariant g b hgpos (Nat.gcd_dvd_right a b) j x]
    have h := score_le_distance (by simp : b ∈ ({a,b} : Finset ℕ)) (x : Time)
    rw [ht] at h
    exact hpL.trans h
  · simpa only [hvc] using hcL

theorem primitive_three_large_pair_gcd_ge_third (a b c : ℕ)
    (ha : 0<a) (hb : 0<b) (hp : Primitive ({a,b,c} : Finset ℕ))
    (hg : 3 ≤ Nat.gcd a b) : (1/3 : ℝ) ≤ ML ({a,b,c} : Finset ℕ) := by
  have hp' : Nat.gcd a (Nat.gcd b c) = 1 := by simpa [Primitive] using hp
  have hcop : Nat.Coprime c (Nat.gcd a b) := by
    change Nat.gcd c (Nat.gcd a b) = 1
    rw [Nat.gcd_comm c (Nat.gcd a b), Nat.gcd_assoc]
    exact hp'
  exact three_speed_large_pair_gcd_ge_third a b c ha hb hcop hg

theorem primitive_three_low_pair_gcd (a b c : ℕ)
    (ha : 0<a) (hb : 0<b) (hc : 0<c)
    (hp : Primitive ({a,b,c} : Finset ℕ))
    (hlow : ML ({a,b,c} : Finset ℕ) < (2/7 : ℝ)) :
    Nat.gcd a b ≤ 2 ∧ Nat.gcd a c ≤ 2 ∧ Nat.gcd b c ≤ 2 := by
  have heac : ({a,c,b} : Finset ℕ) = {a,b,c} := by
    ext x
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
  have hebc : ({b,c,a} : Finset ℕ) = {a,b,c} := by
    ext x
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
  refine ⟨?_, ?_, ?_⟩
  · by_contra h
    have hg : 3 ≤ Nat.gcd a b := by omega
    have hh := primitive_three_large_pair_gcd_ge_third a b c ha hb hp hg
    linarith
  · by_contra h
    have hg : 3 ≤ Nat.gcd a c := by omega
    have hpac : Primitive ({a,c,b} : Finset ℕ) := by rwa [heac]
    have hh := primitive_three_large_pair_gcd_ge_third a c b ha hc hpac hg
    rw [heac] at hh
    linarith
  · by_contra h
    have hg : 3 ≤ Nat.gcd b c := by omega
    have hpbc : Primitive ({b,c,a} : Finset ℕ) := by rwa [hebc]
    have hh := primitive_three_large_pair_gcd_ge_third b c a hb hc hpbc hg
    rw [hebc] at hh
    linarith

/-- Only the integers 4,5,8,11 have floor(n/3)/n < 2/7 when n>=3. -/
theorem third_grid_small_denominators {n : ℕ} (hn : 3 ≤ n)
    (hsmall : (((n/3 : ℕ) : ℝ)/(n : ℝ)) < (2/7 : ℝ)) :
    n = 4 ∨ n = 5 ∨ n = 8 ∨ n = 11 := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast (by omega : 0<n)
  have hr := (div_lt_iff₀ hnR).mp hsmall
  have hint : 7*(n/3) < 2*n := by exact_mod_cast (by linarith :
      7*(((n/3 : ℕ) : ℝ)) < 2*(n : ℝ))
  omega

/-- The two largest small pair sums leave exactly three sorted triples. -/
theorem sorted_three_small_pair_sums {a b c : ℕ} (ha : 0<a)
    (hab : a<b) (hbc : b<c)
    (hac : a+c=4 ∨ a+c=5 ∨ a+c=8 ∨ a+c=11)
    (hbc' : b+c=4 ∨ b+c=5 ∨ b+c=8 ∨ b+c=11) :
    (a=1 ∧ b=2 ∧ c=3) ∨ (a=2 ∧ b=5 ∧ c=6) ∨
      (a=1 ∧ b=4 ∧ c=7) := by omega

theorem three_two_five_six_ge_two_sevenths :
    (2/7 : ℝ) ≤ ML ({2,5,6} : Finset ℕ) := by
  apply ML_lower_of_witness (by simp)
    (((((2 : ℕ) : ℝ)/((7 : ℕ) : ℝ)) : ℝ) : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rw [distance_at_rational]
  rcases hv with rfl | rfl | rfl <;> norm_num

theorem three_one_four_seven_ge_two_sevenths :
    (2/7 : ℝ) ≤ ML ({1,4,7} : Finset ℕ) := by
  apply ML_lower_of_witness (by simp)
    (((((3 : ℕ) : ℝ)/((8 : ℕ) : ℝ)) : ℝ) : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rw [distance_at_rational]
  rcases hv with rfl | rfl | rfl <;> norm_num






















