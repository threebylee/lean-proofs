/- Section: NativeGapCutoff -/
section





/-!
Actual shared torus point to speed-sum bound. The supplied good point and
primitive line live in the same native integer rank-two module. This consumer
does not assume a covering radius or coordinate error bound.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

theorem four_coordinate_sum_sq_le_four_dot (x : Vec4 ℝ) :
    (∑ i,x i)^2 ≤ 4*dot4 x x := by
  have hid : 4*dot4 x x-(∑i,x i)^2=
      (x 0-x 1)^2+(x 0-x 2)^2+(x 0-x 3)^2+
      (x 1-x 2)^2+(x 1-x 3)^2+(x 2-x 3)^2 := by
    simp only [Fin.sum_univ_four,dot4]
    ring
  have hn : 0≤(x 0-x 1)^2+(x 0-x 2)^2+(x 0-x 3)^2+
      (x 1-x 2)^2+(x 1-x 3)^2+(x 2-x 3)^2 := by positivity
  linarith

/-- The exact 784 factor from one common two-sevenths point in this
same actual lattice. The integer error point and real time are constructed. -/
theorem native_low_line_good_point_norm_bound
    (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 2) ℤ N)
    (v : Fin 4 → ℕ) (vN : N) (hvN : (vN : Vec4 ℤ)=fun i => (v i : ℤ))
    (hprim : Primitive (Finset.univ.image v))
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ))
    (hgood : TorusGood (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) (2/7)) :
    dot4 (fun i => (v i : ℝ)) (fun i => (v i : ℝ)) <
      196*((areaSq4 (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) : ℤ) : ℝ) := by
  have hv : Finset.univ.gcd (fun i => ((vN : Vec4 ℤ) i).natAbs)=1 := by
    rw [hvN]
    simpa using primitive_image_coordinate_gcd v hprim
  obtain ⟨x,y,hpoint⟩ := hgood
  let P := combine4 x (realCast (b 0 : Vec4 ℤ)) y (realCast (b 1 : Vec4 ℤ))
  have hcenter : ∀ i,(1/4 : ℝ)+1/28≤distance (P i : Time) := by
    intro i
    have hi := hpoint i
    change (2/7 : ℝ)≤distance (((b 0 : Vec4 ℤ) i : ℝ)*x+
      ((b 1 : Vec4 ℤ) i : ℝ)*y : Time) at hi
    have hPi : P i=((b 0 : Vec4 ℤ) i : ℝ)*x+((b 1 : Vec4 ℤ) i : ℝ)*y := by
      dsimp [P,combine4,realCast]
      ring
    rw [hPi]
    convert hi using 1 <;> norm_num
  obtain ⟨t,z,hnear⟩ := native_rank_two_nearest_primitive_line N b vN hv x y
  have hmiss := low_ML_misses_every_integer_translate v P (1/28)
    (by norm_num) hlow hcenter (z : Vec4 ℤ) t
  have herror : dot4 (fun i => P i-((z : Vec4 ℤ) i : ℝ)-t*(v i : ℝ))
      (fun i => P i-((z : Vec4 ℤ) i : ℝ)-t*(v i : ℝ)) =
      sqDist4 P (combine4 1 (realCast (z : Vec4 ℤ)) t (realCast (vN : Vec4 ℤ))) := by
    simp [sqDist4,dot4,combine4,realCast,hvN]
    ring
  rw [herror] at hmiss
  have hstrict := hmiss.trans_le hnear
  have hpos : 0<4*dot4 (realCast (vN : Vec4 ℤ)) (realCast (vN : Vec4 ℤ)) := by
    exact mul_pos (by norm_num) (primitive_realCast_dot4_positive _ hv)
  have hmul := (lt_div_iff₀ hpos).mp hstrict
  have hnorm : dot4 (realCast (vN : Vec4 ℤ)) (realCast (vN : Vec4 ℤ))=
      dot4 (fun i => (v i : ℝ)) (fun i => (v i : ℝ)) := by
    have hcast : realCast (vN : Vec4 ℤ)=(fun i => (v i : ℝ)) := by
      funext i
      change (((vN : Vec4 ℤ) i : ℤ) : ℝ)=(v i : ℝ)
      have hi := congrFun hvN i
      rw [hi]
      norm_cast
    rw [hcast]
  rw [hnorm] at hmul
  norm_num at hmul
  nlinarith

theorem native_low_line_good_point_sum_bound
    (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 2) ℤ N)
    (v : Fin 4 → ℕ) (vN : N) (hvN : (vN : Vec4 ℤ)=fun i => (v i : ℤ))
    (hprim : Primitive (Finset.univ.image v))
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ))
    (hgood : TorusGood (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) (2/7)) :
    (∑i,(v i : ℝ))^2 < 784*((areaSq4 (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) : ℤ) : ℝ) := by
  have hn := native_low_line_good_point_norm_bound N b v vN hvN hprim hlow hgood
  have hs := four_coordinate_sum_sq_le_four_dot (fun i => (v i : ℝ))
  nlinarith




end Math15.LonelyRunner.Covolume4
