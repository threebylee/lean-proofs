/- Section: SharedPacketCensus -/
section




/-!
Table-free common-time packets for the original finite Source05 census.

The flags at speed v are checked against the actual fixed pool's speed masks.
A packet cache is checked against the union of at most width pool masks
selected by that packet's flags. Intersecting the three base-speed flags
therefore selects a single actual pool index good at all three base speeds. A
fourth-speed cache hit uses that same index and the pool's actual positive
denominator. Padded final-packet indices cannot be selected: every flag
originates in the checked range of actual pool indices.

The numerical census independently traverses all original sorted triples.
Known families use the closed structural mask, with no tuple table. Empty
allowed masks and unrestricted whole-family rows have justified shortcuts.
Neither cache correctness nor finite coverage is assumed without its literal
Boolean check. No numerical certificate or full sum444 fact is asserted here.
-/

namespace Math15.LonelyRunner

/-- One literal flags-cache equality, exposed for small numerical chunks. -/
def sharedGoodTimeBitsCheckAtSpeed (size : ℕ) (pool : ℕ → SharedQuarterMask)
    (goodTimeBits : ℕ → ℕ) (v : ℕ) : Bool :=
  decide (goodTimeBits v=listBits
    ((List.range size).filter fun i => Nat.testBit (pool i).bits v))

def sharedGoodTimeBitsCheck (bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (goodTimeBits : ℕ → ℕ) : Bool :=
  (List.range bound).all (sharedGoodTimeBitsCheckAtSpeed size pool goodTimeBits)

/-- Three speeds' flags are intersected before packet extraction. -/
def sharedCommonTimeBits (goodTimeBits : ℕ → ℕ) (a b c : ℕ) : ℕ :=
  goodTimeBits a &&& goodTimeBits b &&& goodTimeBits c

/-- A width-bit selector for packet p. For width=7 this is at most 127. -/
def sharedPacketSelector (width p commonBits : ℕ) : ℕ :=
  (commonBits >>> (width*p)) &&& (2^width-1)

/-- The exact union against which each literal cache entry is checked. -/
def sharedPacketSelectedMask (width : ℕ) (pool : ℕ → SharedQuarterMask)
    (p f : ℕ) : ℕ :=
  maskUnion (((List.range width).filter fun j => Nat.testBit f j).map
    fun j => (pool (width*p+j)).bits)

/-- One literal packet-cache equality, exposed for numerical chunks. -/
def sharedPacketUnionCheckAtEntry (width : ℕ) (pool : ℕ → SharedQuarterMask)
    (packetUnion : ℕ → ℕ → ℕ) (p f : ℕ) : Bool :=
  decide (packetUnion p f=sharedPacketSelectedMask width pool p f)

def sharedPacketUnionCheckAtPacket (width : ℕ) (pool : ℕ → SharedQuarterMask)
    (packetUnion : ℕ → ℕ → ℕ) (p : ℕ) : Bool :=
  (List.range (2^width)).all (sharedPacketUnionCheckAtEntry width pool packetUnion p)

def sharedPacketUnionCheck (width packets : ℕ) (pool : ℕ → SharedQuarterMask)
    (packetUnion : ℕ → ℕ → ℕ) : Bool :=
  (List.range packets).all (sharedPacketUnionCheckAtPacket width pool packetUnion)

/-- At most packets literal lookups replace every per-triple time list. -/
def sharedPacketCover (width packets : ℕ) (packetUnion : ℕ → ℕ → ℕ)
    (goodTimeBits : ℕ → ℕ) (a b c : ℕ) : ℕ :=
  let commonBits := sharedCommonTimeBits goodTimeBits a b c
  maskUnion ((List.range packets).map fun p =>
    packetUnion p (sharedPacketSelector width p commonBits))

/-- The only per-triple numerical obligation; no row table is supplied. -/
def sharedPacketRowCheck (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a b c : ℕ) : Bool :=
  if closedKnownWholeRowBool a b c=true then true else
    let allowed := sharedAllowedFourthMask S bound compat prefixCache oddBits a b c
    if allowed=0 then true else
      decide (allowed &&&
        (sharedPacketCover width packets packetUnion goodTimeBits a b c |||
          closedKnownFourthMask bound a b c)=allowed)

/-- One outer block of the independently enumerated original triple range. -/
def sharedPacketCensusAtA (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a : ℕ) : Bool :=
  (List.range' (a+1) (((S-a-3)/3+1)-(a+1))).all fun b =>
    (List.range' (b+1) (((S-a-b-1)/2+1)-(b+1))).all fun c =>
      if Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
        Nat.testBit (compat b) c then
        sharedPacketRowCheck S bound width packets compat prefixCache oddBits
          goodTimeBits packetUnion a b c
      else true

def sharedPacketCensusCheck (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) : Bool :=
  (List.range' 1 ((S-6)/4)).all
    (sharedPacketCensusAtA S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion)

/-- Pool support is established separately by checked actual masks or strips. -/
def sharedPacketSupportedCensusCheck (S bound size width packets : ℕ)
    (pool : ℕ → SharedQuarterMask) (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) : Bool :=
  sharedGoodTimeBitsCheck bound size pool goodTimeBits &&
    sharedPacketUnionCheck width packets pool packetUnion &&
    sharedCompatibilityCheck bound compat && sharedPrefixCheck bound prefixCache &&
    decide (oddBits=oddSpeedMask bound) &&
    sharedPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion

theorem sharedGoodTimeBitsCheck_sound {bound size : ℕ}
    {pool : ℕ → SharedQuarterMask} {goodTimeBits : ℕ → ℕ}
    (h : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    {v : ℕ} (hv : v<bound) :
    goodTimeBits v=listBits
      ((List.range size).filter fun i => Nat.testBit (pool i).bits v) := by
  exact decide_eq_true_eq.mp (List.all_eq_true.mp h v (List.mem_range.mpr hv))

/-- Flags have literal speed-mask support and always refer to a valid time. -/
theorem sharedGoodTimeBits_testBit_sound {bound size v i : ℕ}
    {pool : ℕ → SharedQuarterMask} {goodTimeBits : ℕ → ℕ}
    (h : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hv : v<bound) (hi : Nat.testBit (goodTimeBits v) i=true) :
    i<size ∧ Nat.testBit (pool i).bits v=true := by
  rw [sharedGoodTimeBitsCheck_sound h hv] at hi
  have hm := (listBits_testBit_iff _ i).mp hi
  have hh := List.mem_filter.mp hm
  exact ⟨List.mem_range.mp hh.1,hh.2⟩

theorem sharedPacketSelector_lt (width p commonBits : ℕ) :
    sharedPacketSelector width p commonBits<2^width := by
  have hle : sharedPacketSelector width p commonBits≤2^width-1 := Nat.and_le_right
  have hpos : 0<2^width := pow_pos (by decide : 0<2) width
  omega

/-- Extraction translates a selected packet bit to its original pool index. -/
theorem sharedPacketSelector_testBit_iff (width p commonBits j : ℕ) :
    Nat.testBit (sharedPacketSelector width p commonBits) j=true ↔
      Nat.testBit commonBits (width*p+j)=true ∧ j<width := by
  simp only [sharedPacketSelector,Nat.testBit_and,Nat.testBit_shiftRight,
    Nat.testBit_two_pow_sub_one,Bool.and_eq_true,decide_eq_true_eq]

theorem sharedPacketSelectedMask_testBit_iff
    (width : ℕ) (pool : ℕ → SharedQuarterMask) (p f d : ℕ) :
    Nat.testBit (sharedPacketSelectedMask width pool p f) d=true ↔
      ∃ j : ℕ, j<width ∧ Nat.testBit f j=true ∧
        Nat.testBit (pool (width*p+j)).bits d=true := by
  simp only [sharedPacketSelectedMask,maskUnion_map_testBit_iff,
    List.mem_filter,List.mem_range,and_assoc]

theorem sharedPacketUnionCheck_sound {width packets p f : ℕ}
    {pool : ℕ → SharedQuarterMask} {packetUnion : ℕ → ℕ → ℕ}
    (h : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hp : p<packets) (hf : f<2^width) :
    packetUnion p f=sharedPacketSelectedMask width pool p f := by
  have hpCheck := List.all_eq_true.mp h p (List.mem_range.mpr hp)
  have hfCheck := List.all_eq_true.mp hpCheck f (List.mem_range.mpr hf)
  exact decide_eq_true_eq.mp hfCheck

/-- A cache hit recovers ONE valid pool index supporting all four speeds. -/
theorem sharedPacketCover_same_time {bound size width packets a b c d : ℕ}
    {pool : ℕ → SharedQuarterMask} {goodTimeBits : ℕ → ℕ}
    {packetUnion : ℕ → ℕ → ℕ}
    (hflags : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (ha : a<bound) (hb : b<bound) (hc : c<bound)
    (hd : Nat.testBit (sharedPacketCover width packets packetUnion goodTimeBits a b c) d=true) :
    ∃ i : ℕ, i<size ∧ Nat.testBit (pool i).bits a=true ∧
      Nat.testBit (pool i).bits b=true ∧ Nat.testBit (pool i).bits c=true ∧
      Nat.testBit (pool i).bits d=true := by
  obtain ⟨p,hp,hpd⟩ := (maskUnion_map_testBit_iff
    (fun p => packetUnion p (sharedPacketSelector width p
      (sharedCommonTimeBits goodTimeBits a b c))) (List.range packets) d).mp hd
  rw [sharedPacketUnionCheck_sound hcache (List.mem_range.mp hp)
    (sharedPacketSelector_lt width p (sharedCommonTimeBits goodTimeBits a b c))] at hpd
  obtain ⟨j,hj,hf,hid⟩ := (sharedPacketSelectedMask_testBit_iff width pool p _ d).mp hpd
  have hcommon := (sharedPacketSelector_testBit_iff width p
    (sharedCommonTimeBits goodTimeBits a b c) j).mp hf
  have hthree : Nat.testBit (goodTimeBits a) (width*p+j)=true ∧
      Nat.testBit (goodTimeBits b) (width*p+j)=true ∧
      Nat.testBit (goodTimeBits c) (width*p+j)=true := by
    simpa only [sharedCommonTimeBits,Nat.testBit_and,Bool.and_eq_true,and_assoc]
      using hcommon.1
  have haGood := sharedGoodTimeBits_testBit_sound hflags ha hthree.1
  have hbGood := sharedGoodTimeBits_testBit_sound hflags hb hthree.2.1
  have hcGood := sharedGoodTimeBits_testBit_sound hflags hc hthree.2.2
  exact ⟨width*p+j,haGood.1,haGood.2,hbGood.2,hcGood.2,hid⟩

/-- Derivation of the actual row from the actual admissible quartet. -/
theorem sharedPacketCensusCheck_row
    {S bound width packets a b c d oddBits : ℕ}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d)
    (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (hcheck : sharedPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    sharedPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c=true := by
  have haBound : 4*a+6≤S := by omega
  have hbBound : a+3*b+3≤S := by omega
  have hcBound : a+b+2*c+1≤S := by omega
  have haMem : a∈List.range' 1 ((S-6)/4) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hbMem : b∈List.range' (a+1) (((S-a-3)/3+1)-(a+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hcMem : c∈List.range' (b+1) (((S-a-b-1)/2+1)-(b+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have habbit : Nat.testBit (compat a) b=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : a<bound)]
    exact (compatibleSpeedMask_testBit_iff bound a b).mpr
      ⟨by omega,hpair a (by simp [finiteQuartetSpeeds]) b
        (by simp [finiteQuartetSpeeds]) (ne_of_lt hab)⟩
  have hacbit : Nat.testBit (compat a) c=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : a<bound)]
    exact (compatibleSpeedMask_testBit_iff bound a c).mpr
      ⟨by omega,hpair a (by simp [finiteQuartetSpeeds]) c
        (by simp [finiteQuartetSpeeds]) (ne_of_lt (lt_trans hab hbc))⟩
  have hbcbit : Nat.testBit (compat b) c=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : b<bound)]
    exact (compatibleSpeedMask_testBit_iff bound b c).mpr
      ⟨by omega,hpair b (by simp [finiteQuartetSpeeds]) c
        (by simp [finiteQuartetSpeeds]) (ne_of_lt hbc)⟩
  have houter := List.all_eq_true.mp hcheck a haMem
  have hmiddle := List.all_eq_true.mp houter b hbMem
  have hinner := List.all_eq_true.mp hmiddle c hcMem
  simpa [habbit,hacbit,hbcbit] using hinner

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

theorem sharedPacketCover_ML_ge_quarter {bound size width packets a b c d : ℕ}
    {pool : ℕ → SharedQuarterMask} {goodTimeBits : ℕ → ℕ}
    {packetUnion : ℕ → ℕ → ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hflags : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (ha : a<bound) (hb : b<bound) (hc : c<bound)
    (hd : Nat.testBit (sharedPacketCover width packets packetUnion goodTimeBits a b c) d=true) :
    (1/4 : ℝ)≤ML (finiteQuartetSpeeds a b c d) := by
  obtain ⟨i,hi,hia,hib,hic,hid⟩ :=
    sharedPacketCover_same_time hflags hcache ha hb hc hd
  obtain ⟨hn,hgood⟩ := hpool i hi
  apply ML_lower_of_witness ⟨a,by simp [finiteQuartetSpeeds]⟩
    ((((pool i).m : ℝ)/((pool i).n : ℝ)) : Time)
  intro v hv
  simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · exact distance_ge_quarter_of_quarterResidue hn (hgood v hia)
  · exact distance_ge_quarter_of_quarterResidue hn (hgood v hib)
  · exact distance_ge_quarter_of_quarterResidue hn (hgood v hic)
  · exact distance_ge_quarter_of_quarterResidue hn (hgood v hid)

theorem sharedPacketRowCheck_sound
    {S bound size width packets a b c d oddBits : ℕ}
    {pool : ℕ → SharedQuarterMask} {compat prefixCache goodTimeBits : ℕ → ℕ}
    {packetUnion : ℕ → ℕ → ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hflags : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (hab : a<b) (hbc : b<c) (hcd : c<d) (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hrow : sharedPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  by_cases hwhole : closedKnownWholeRowBool a b c=true
  · exact closedKnownWholeRowBool_sound hp hc hpair hwhole
  · have hd := sharedAllowedFourthMask_of_admissible hcomp hpref hodd
      hab hbc hcd hsum hdBound hprim hpair
    have hnonzero : sharedAllowedFourthMask S bound compat prefixCache oddBits a b c≠0 := by
      intro hz
      rw [hz,Nat.zero_testBit] at hd
      exact Bool.false_ne_true hd
    have hcover :
        sharedAllowedFourthMask S bound compat prefixCache oddBits a b c &&&
          (sharedPacketCover width packets packetUnion goodTimeBits a b c |||
            closedKnownFourthMask bound a b c)=
        sharedAllowedFourthMask S bound compat prefixCache oddBits a b c := by
      simpa only [sharedPacketRowCheck,if_neg hwhole,if_neg hnonzero,
        decide_eq_true_eq] using hrow
    have hbit := (mask_coverage_iff _ _).mp hcover d hd
    rcases (mask_union_testBit_iff _ _ d).mp hbit with htime | hknown
    · exact Or.inl (sharedPacketCover_ML_ge_quarter hpool hflags hcache
        (by omega) (by omega) (by omega) htime)
    · exact closedKnownFourthMask_sound hp hc hprim hpair hknown

/-- Complete coverage of actual sorted quartets follows from the literal
census, independently of any externally supplied tuple list. -/
theorem source05_of_sharedPacketCensus
    {S bound size width packets a b c d oddBits : ℕ}
    {pool : ℕ → SharedQuarterMask} {compat prefixCache goodTimeBits : ℕ → ℕ}
    {packetUnion : ℕ → ℕ → ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hflags : sharedGoodTimeBitsCheck bound size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d)
    (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (hrows : sharedPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hp : Positive (finiteQuartetSpeeds a b c d) := by
    intro v hv
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl <;> omega
  have hrow := sharedPacketCensusCheck_row hcomp ha hab hbc hcd hsum hdBound hpair hrows
  exact sharedPacketRowCheck_sound hpool hflags hcache hcomp hpref hodd hp
    (finite_quartet_card hab hbc hcd) hprim hpair hab hbc hcd hsum hdBound hrow

/-- The table-free cache certificate proves the exact original conclusion
for an arbitrary actual speed set through the chosen sum cutoff. -/
theorem source05_of_sharedPacketCensus_set
    {S size width packets oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    {V : Finset ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hflags : sharedGoodTimeBitsCheck (S+1) size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hcomp : sharedCompatibilityCheck (S+1) compat=true)
    (hpref : sharedPrefixCheck (S+1) prefixCache=true) (hodd : oddBits=oddSpeedMask (S+1))
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hrows : sharedPacketCensusCheck S (S+1) width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    FiniteSource05Conclusion V := by
  obtain ⟨a,b,c,d,ha,hab,hbc,hcd,hV,hS⟩ := positive_quartet_sorted_representation hp hc
  have hsum' : a+b+c+d≤S := by omega
  have hprim' : Primitive (finiteQuartetSpeeds a b c d) := by rwa [hV] at hprim
  have hpair' : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2 := by rwa [hV] at hpair
  rw [hV]
  exact source05_of_sharedPacketCensus hpool hflags hcache hcomp hpref hodd
    ha hab hbc hcd hsum' (by omega) hprim' hpair' hrows

/-- Full-check convenience wrapper; the abstract chunk consumer above can
use accepted cache facts directly without reevaluating their numerals. -/
theorem source05_of_sharedPacketSupportedCensus_set
    {S size width packets oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    {V : Finset ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hfull : sharedPacketSupportedCensusCheck S (S+1) size width packets pool
      compat prefixCache oddBits goodTimeBits packetUnion=true) :
    FiniteSource05Conclusion V := by
  have hh : sharedGoodTimeBitsCheck (S+1) size pool goodTimeBits=true ∧
      sharedPacketUnionCheck width packets pool packetUnion=true ∧
      sharedCompatibilityCheck (S+1) compat=true ∧
      sharedPrefixCheck (S+1) prefixCache=true ∧ oddBits=oddSpeedMask (S+1) ∧
      sharedPacketCensusCheck S (S+1) width packets compat prefixCache oddBits
        goodTimeBits packetUnion=true := by
    simpa only [sharedPacketSupportedCensusCheck,Bool.and_eq_true,
      decide_eq_true_eq,and_assoc] using hfull
  exact source05_of_sharedPacketCensus_set hpool hh.1 hh.2.1 hh.2.2.1
    hh.2.2.2.1 hh.2.2.2.2.1 hp hc hprim hpair hsum hh.2.2.2.2.2















