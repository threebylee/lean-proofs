/- Section: RelationWidthThree -/
section



/-!
Small relations for the actual positive four-speed vector.

At width one or two, the only possible nonzero coefficient patterns either
have one nonzero coefficient or have two unit coefficients. The first
contradicts positivity; the second has the same sign (again impossible) or
opposite signs (contradicting distinctness). Thus a nonzero relation has width
at least three.

At width three the possible absolute partitions are 3, 2+1, and 1+1+1.
Positivity excludes a single coefficient and equal-sign coefficients. The
remaining literal signed coordinate orders are either sign of (2,-1,0,0) and
either sign of (1,1,-1,0). The bounded coefficient proof below exhausts these
patterns inside Lean for arbitrary coefficients and arbitrary positive speeds.
Each surviving coefficient pattern is assigned explicit Fin 4 coordinate
witnesses; only the six closed index inequalities are decided. This avoids
expanding four finite existentials into a large disjunction. It does not use a
finite sample of speeds or an external computation.

The double pattern forces two actual speeds t,2t. Pair gcd at most two forces
t=1 or 2, so the already checked 1,2 and 2,4 branches prove Source05.
Consequently only an actual additive coefficient pattern remains outside the
solved branches when a width-three relation is present.
-/

noncomputable section
namespace Math15.LonelyRunner

def naturalRelationDot (m : Fin 4 → ℤ) (v : Fin 4 → ℕ) : ℤ :=
  ∑ i, m i*(v i : ℤ)

def RelationCoordinateOrder (i j k l : Fin 4) : Prop :=
  i≠j ∧ i≠k ∧ i≠l ∧ j≠k ∧ j≠l ∧ k≠l

/-- Either sign of (1,1,-1,0) in one complete order of the four coordinates. -/
def RelationAdditiveForm (m : Fin 4 → ℤ) : Prop :=
  ∃ i j k l : Fin 4, RelationCoordinateOrder i j k l ∧
    ((m i=1 ∧ m j=1 ∧ m k= -1 ∧ m l=0) ∨
     (m i= -1 ∧ m j= -1 ∧ m k=1 ∧ m l=0))

/-- Either sign of (2,-1,0,0) in one complete order of the four coordinates. -/
def RelationDoubleForm (m : Fin 4 → ℤ) : Prop :=
  ∃ i j k l : Fin 4, RelationCoordinateOrder i j k l ∧
    ((m i=2 ∧ m j= -1 ∧ m k=0 ∧ m l=0) ∨
     (m i= -2 ∧ m j=1 ∧ m k=0 ∧ m l=0))

theorem integer_bounds_of_natAbs_le {z : ℤ} {N : ℕ} (h : z.natAbs≤N) :
    -(N : ℤ)≤z ∧ z≤(N : ℤ) := by
  have hc : (z.natAbs : ℤ)≤(N : ℤ) := by exact_mod_cast h
  have habs : |z|≤(N : ℤ) := by simpa only [Int.natCast_natAbs] using hc
  exact abs_le.mp habs

/-- Fixed first coefficient -2; default-resource bounded coefficient proof. -/
theorem width_two_first_neg_two (b c d : ℤ) (v : Fin 4 → ℕ)
    (hp : ∀ i, 0<v i) (hinj : Function.Injective v)
    (hdot : (-2 : ℤ)*(v 0 : ℤ)+b*(v 1 : ℤ)+c*(v 2 : ℤ)+d*(v 3 : ℤ)=0)
    (hwidth : (-2 : ℤ).natAbs+b.natAbs+c.natAbs+d.natAbs≤2) :
    (-2 : ℤ)=0 ∧ b=0 ∧ c=0 ∧ d=0 := by
  have hv0 : (0 : ℤ)<v 0 := by exact_mod_cast hp 0
  have hv1 : (0 : ℤ)<v 1 := by exact_mod_cast hp 1
  have hv2 : (0 : ℤ)<v 2 := by exact_mod_cast hp 2
  have hv3 : (0 : ℤ)<v 3 := by exact_mod_cast hp 3
  have hn01 : v 0≠v 1 := fun h => (by decide : (0 : Fin 4)≠1) (hinj h)
  have hn02 : v 0≠v 2 := fun h => (by decide : (0 : Fin 4)≠2) (hinj h)
  have hn03 : v 0≠v 3 := fun h => (by decide : (0 : Fin 4)≠3) (hinj h)
  have hn12 : v 1≠v 2 := fun h => (by decide : (1 : Fin 4)≠2) (hinj h)
  have hn13 : v 1≠v 3 := fun h => (by decide : (1 : Fin 4)≠3) (hinj h)
  have hn23 : v 2≠v 3 := fun h => (by decide : (2 : Fin 4)≠3) (hinj h)
  norm_num at hwidth
  obtain ⟨hbl,hbu⟩ := integer_bounds_of_natAbs_le (show b.natAbs≤0 by omega)
  obtain ⟨hcl,hcu⟩ := integer_bounds_of_natAbs_le (show c.natAbs≤0 by omega)
  obtain ⟨hdl,hdu⟩ := integer_bounds_of_natAbs_le (show d.natAbs≤0 by omega)
  interval_cases b
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases c
  all_goals norm_num at hwidth
  all_goals try omega
  all_goals interval_cases d
  all_goals norm_num at hwidth
  all_goals norm_num at hdot
  all_goals omega

