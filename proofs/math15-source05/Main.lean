def TorusTwoZeroPermutation (d e f : ℕ) : Prop :=
    (d = 1 ∧ e = 2 ∧ f = 3) ∨ (d = 1 ∧ e = 3 ∧ f = 2) ∨
    (d = 2 ∧ e = 1 ∧ f = 3) ∨ (d = 2 ∧ e = 3 ∧ f = 1) ∨
    (d = 3 ∧ e = 1 ∧ f = 2) ∨ (d = 3 ∧ e = 2 ∧ f = 1)

