/- Section: NonparallelArea -/
section



/-!
Interface from the real nonparallelity returned by the short-relation consumer
to the positive integer area required by the native rank-two kernel/covolume
consumer.
-/

namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

/-- If the first integer vector is nonzero, real nonparallelity makes
the sum of the six squared integer minors strictly positive. -/
theorem integer_areaSq_positive_of_not_parallel
    (m c : Vec4 ℤ) (hm : m ≠ 0)
    (hnot : ¬ ∃ t : ℝ, ∀ i, (c i : ℝ) = t * (m i : ℝ)) :
    0 < areaSq4 m c := by
  have hnonneg := integer_areaSq_nonneg m c
  by_contra hpos
  have hzero : areaSq4 m c = 0 := by omega
  obtain ⟨i, hi⟩ : ∃ i : Fin 4, m i ≠ 0 := by
    by_contra! hn
    exact hm (funext hn)
  have hiR : (m i : ℝ) ≠ 0 := by exact_mod_cast hi
  apply hnot
  refine ⟨(c i : ℝ) / (m i : ℝ), ?_⟩
  intro j
  have hij := all_minors_zero_of_areaSq_zero m c hzero i j
  have hijR : (m i : ℝ) * (c j : ℝ) - (m j : ℝ) * (c i : ℝ) = 0 := by
    exact_mod_cast hij
  field_simp [hiR]
  nlinarith only [hijR]

/-- The ambient gcd-one hypothesis already guarantees the nonzero normal
needed by the preceding interface. -/
theorem primitive_integer_areaSq_positive_of_not_parallel
    (m c : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hnot : ¬ ∃ t : ℝ, ∀ i, (c i : ℝ) = t * (m i : ℝ)) :
    0 < areaSq4 m c := by
  apply integer_areaSq_positive_of_not_parallel m c ?_ hnot
  intro hzero
  obtain ⟨z, hz⟩ := primitive_integer_bezout m hm
  simp [intDot, hzero] at hz




end Math15.LonelyRunner.Covolume4
end 

