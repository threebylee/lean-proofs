/- Section: Rank3Geometry -/
section



/-!
Integer Gram-prefix data for the three-dimensional projection of an actual
ambient integer basis. The potential is a positive integer; no discreteness of
a real optimization problem is assumed.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

def gram3Sq {R : Type*} [CommRing R] (v u w : Vec4 R) : R :=
  dot4 (cross4 v u w) (cross4 v u w)

def basisD1 (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) : ℤ :=
  areaSq4 (b 0) (b 1)

def basisD2 (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) : ℤ :=
  gram3Sq (b 0) (b 1) (b 2)

def basisPotential (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) : ℕ :=
  (basisD1 b*basisD2 b).toNat

theorem gram3Sq_expansion {R : Type*} [CommRing R] (v u w : Vec4 R) :
    gram3Sq v u w = dot4 v v*dot4 u u*dot4 w w+
      2*dot4 v u*dot4 v w*dot4 u w-
      dot4 v v*(dot4 u w)^2-dot4 u u*(dot4 v w)^2-
      dot4 w w*(dot4 v u)^2 := by
  simp [gram3Sq,dot4,cross4,det3]
  ring

theorem gram3Sq_projection_identity {R : Type*} [CommRing R] (v u w : Vec4 R) :
    areaSq4 v u*areaSq4 v w-(projectedCrossGram v u w)^2 =
      dot4 v v*gram3Sq v u w := by
  rw [gram3Sq_expansion]
  simp only [lagrange_area_identity,projectedCrossGram]
  ring

theorem basis_first_three_independent (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    LinearIndependent ℤ (![b 0,b 1,b 2] : Fin 3 → Vec4 ℤ) := by
  have h := b.linearIndependent.comp (fun i : Fin 3 => i.castSucc) (Fin.castSucc_injective 3)
  have he : (fun i : Fin 3 => b i.castSucc)=(![b 0,b 1,b 2] : Fin 3 → Vec4 ℤ) := by
    funext i
    fin_cases i <;> rfl
  simpa only [Function.comp_def,he] using h

theorem basisD1_positive (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    0<basisD1 b := by
  have h := projectionForm_positive (b 0) (b 1) (b 2)
    (basis_first_three_independent b) 1 0 (Or.inl (by decide))
  simpa [basisD1,projectionForm_expansion] using h

theorem basisD2_positive (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    0<basisD2 b := by
  apply integer_dot_self_positive
  intro hzero
  have hd := det4_basis_sq_one b
  change (dot4 (cross4 (b 0) (b 1) (b 2)) (b 3))^2=1 at hd
  rw [hzero] at hd
  norm_num [dot4] at hd

theorem basisPotential_cast (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    (basisPotential b : ℤ)=basisD1 b*basisD2 b := by
  exact Int.toNat_of_nonneg (le_of_lt (mul_pos (basisD1_positive b) (basisD2_positive b)))

theorem basisPotential_positive (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    0<basisPotential b := by
  have h := mul_pos (basisD1_positive b) (basisD2_positive b)
  rw [← basisPotential_cast b] at h
  exact_mod_cast h

theorem gram3Sq_realVec4 (v u w : Vec4 ℤ) :
    gram3Sq (realVec4 v) (realVec4 u) (realVec4 w)=((gram3Sq v u w : ℤ) : ℝ) := by
  simp [gram3Sq,realVec4,dot4,cross4,det3]










end Math15.LonelyRunner.Covolume4
