/- Section: TorusU2LineTransfer -/
section




/-!
Actual integer-line transfer for the two one-zero U2 exception planes.

The first generator may have any integer scale k. On the +3 plane, the
coordinates of a real-span line are (kx+y,kx-y,2y,kx+3y). Set P=z_1, Q=z_2:
these are integers because they are actual coordinates of z, and the four
coordinates are (P+Q,P,Q,P+2Q). On the -3 plane they are (kx+y,kx-y,2y,kx-3y).
Set P=z_3,Q=z_2, giving (P+2Q,P+Q,Q,P). Thus the actual finite set of absolute
speeds is SignedU2Speeds P Q. No integrality assumption is made on x,y, or on
the product kx.

The checked signed U2 theorem applies using positivity and primitivity of that
same absolute-speed set. The final scaled-exception consumer is aligned with
TorusOneZeroScaledU2Pair from the ratio classification.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torusLineSpeeds_eq_four (z : Fin 4 → ℤ) :
    torusLineSpeeds z =
      ({(z 0).natAbs,(z 1).natAbs,(z 2).natAbs,(z 3).natAbs} : Finset ℕ) := by
  have hu : (Finset.univ : Finset (Fin 4))={0,1,2,3} := by decide
  unfold torusLineSpeeds
  rw [hu]
  simp only [Finset.image_insert,Finset.image_singleton]

theorem torusLineSpeeds_signed_U2_of_coordinates {z : Fin 4 → ℤ} {P Q : ℤ}
    (hcoords : (z 0=P+Q ∧ z 1=P ∧ z 2=Q ∧ z 3=P+2*Q) ∨
      (z 0=P+2*Q ∧ z 1=P+Q ∧ z 2=Q ∧ z 3=P)) :
    torusLineSpeeds z=SignedU2Speeds P Q := by
  rw [torusLineSpeeds_eq_four]
  rcases hcoords with ⟨h0,h1,h2,h3⟩ | ⟨h0,h1,h2,h3⟩
  · rw [h0,h1,h2,h3]
    ext n
    simp only [SignedU2Speeds,Finset.mem_insert,Finset.mem_singleton]
    tauto
  · rw [h0,h1,h2,h3]
    ext n
    simp only [SignedU2Speeds,Finset.mem_insert,Finset.mem_singleton]
    tauto

theorem source05_of_signed_line_U2_coordinates {z : Fin 4 → ℤ} {P Q : ℤ}
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z))
    (hcoords : (z 0=P+Q ∧ z 1=P ∧ z 2=Q ∧ z 3=P+2*Q) ∨
      (z 0=P+2*Q ∧ z 1=P+Q ∧ z 2=Q ∧ z 3=P)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) :=
  source05_of_signed_U2_representation hp hprim
    (torusLineSpeeds_signed_U2_of_coordinates hcoords)

/-- The integer parameters are z_1 and z_2, not the real span coefficients. -/
theorem torus_onezero_U2_plus_line_coordinates {z : Fin 4 → ℤ} (k : ℤ)
    (hspan : ∃ x y : ℝ, ∀ i,
      (z i : ℝ)=(torusGeneratorScale k (![1,1,0,1]) i : ℝ)*x+
        ((![1,-1,2,3] : Fin 4 → ℤ) i : ℝ)*y) :
    z 0=z 1+z 2 ∧ z 3=z 1+2*z 2 := by
  obtain ⟨x,y,hz⟩ := hspan
  have h0 := hz 0
  have h1 := hz 1
  have h2 := hz 2
  have h3 := hz 3
  norm_num [torusGeneratorScale,Matrix.cons_val_two,Matrix.cons_val_three,
    Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
  constructor
  · have he : (z 0 : ℝ)=(z 1 : ℝ)+(z 2 : ℝ) := by linarith
    exact_mod_cast he
  · have he : (z 3 : ℝ)=(z 1 : ℝ)+2*(z 2 : ℝ) := by linarith
    exact_mod_cast he

/-- The negative fourth coefficient uses the different actual parameter z_3. -/
theorem torus_onezero_U2_minus_line_coordinates {z : Fin 4 → ℤ} (k : ℤ)
    (hspan : ∃ x y : ℝ, ∀ i,
      (z i : ℝ)=(torusGeneratorScale k (![1,1,0,1]) i : ℝ)*x+
        ((![1,-1,2,-3] : Fin 4 → ℤ) i : ℝ)*y) :
    z 0=z 3+2*z 2 ∧ z 1=z 3+z 2 := by
  obtain ⟨x,y,hz⟩ := hspan
  have h0 := hz 0
  have h1 := hz 1
  have h2 := hz 2
  have h3 := hz 3
  norm_num [torusGeneratorScale,Matrix.cons_val_two,Matrix.cons_val_three,
    Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
  constructor
  · have he : (z 0 : ℝ)=(z 3 : ℝ)+2*(z 2 : ℝ) := by linarith
    exact_mod_cast he
  · have he : (z 1 : ℝ)=(z 3 : ℝ)+(z 2 : ℝ) := by linarith
    exact_mod_cast he

theorem source05_of_torus_onezero_U2_plus_signed_line {z : Fin 4 → ℤ} (k : ℤ)
    (hspan : ∃ x y : ℝ, ∀ i,
      (z i : ℝ)=(torusGeneratorScale k (![1,1,0,1]) i : ℝ)*x+
        ((![1,-1,2,3] : Fin 4 → ℤ) i : ℝ)*y)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨h0,h3⟩ := torus_onezero_U2_plus_line_coordinates k hspan
  exact source05_of_signed_line_U2_coordinates (P:=z 1) (Q:=z 2) hp hprim
    (Or.inl ⟨h0,rfl,rfl,h3⟩)

theorem source05_of_torus_onezero_U2_minus_signed_line {z : Fin 4 → ℤ} (k : ℤ)
    (hspan : ∃ x y : ℝ, ∀ i,
      (z i : ℝ)=(torusGeneratorScale k (![1,1,0,1]) i : ℝ)*x+
        ((![1,-1,2,-3] : Fin 4 → ℤ) i : ℝ)*y)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨h0,h1⟩ := torus_onezero_U2_minus_line_coordinates k hspan
  exact source05_of_signed_line_U2_coordinates (P:=z 3) (Q:=z 2) hp hprim
    (Or.inr ⟨h0,h1,rfl,rfl⟩)

/-- The actual scaled-exception output of the ratio classification now
discharges Source05 for every positive primitive integer line in its real span. -/
theorem source05_of_torus_onezero_scaled_U2_signed_line {u v z : Fin 4 → ℤ}
    (hex : TorusOneZeroScaledU2Pair u v)
    (hspan : ∃ x y : ℝ, ∀ i, (z i : ℝ)=(u i : ℝ)*x+(v i : ℝ)*y)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ,
      1≤k ∧ k≤4 ∧ k≤s ∧ ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨g,hg,hu,hv⟩ := hex
  rw [hu] at hspan
  rcases hv with hv | hv
  · rw [hv] at hspan
    exact source05_of_torus_onezero_U2_minus_signed_line (g : ℤ) hspan hp hprim
  · rw [hv] at hspan
    exact source05_of_torus_onezero_U2_plus_signed_line (g : ℤ) hspan hp hprim










end Math15.LonelyRunner
end 
end 

/- Section: TorusOneZeroAssembly -/
section



/-!
Complete one-zero branch for one actual plane and one actual integer line. The
everywhere-nonzero second collision generator is divided by its own positive
tight-triple scale. The first generator is retained. The low-plane ratio is
derived by the actual change of generators, so the finite ratio classification
has no assumed reduction premise. Integer-line transport keeps the original
set of absolute speeds throughout.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem int_sign_nonzero_cases {z : ℤ} (hz : z≠0) : z.sign=1 ∨ z.sign= -1 := by
  rcases lt_or_gt_of_ne hz with hneg | hpos
  · exact Or.inr (Int.sign_eq_neg_one_of_neg hneg)
  · exact Or.inl (Int.sign_eq_one_of_pos hpos)

theorem torus_onezero_signed_ratio_nat {a c d e f0 : ℕ} {ε : ℤ}
    (hε : ε=1 ∨ ε= -1)
    (hratio : (c : ℤ)*(d : ℤ)=(a : ℤ)*(((e : ℤ)+ε*(f0 : ℤ)).natAbs : ℤ) ∨
      (c : ℤ)*(d : ℤ)=(a : ℤ)*(((e : ℤ)-ε*(f0 : ℤ)).natAbs : ℤ)) :
    TorusOneZeroRatio a c d e f0 := by
  unfold TorusOneZeroRatio
  rcases hε with rfl | rfl
  · simp only [one_mul] at hratio
    have hNat : c*d=a*((e : ℤ)+(f0 : ℤ)).natAbs ∨
        c*d=a*((e : ℤ)-(f0 : ℤ)).natAbs := by exact_mod_cast hratio
    simpa only [mul_comm] using hNat
  · simp only [neg_one_mul,←sub_eq_add_neg,sub_neg_eq_add] at hratio
    have hNat : c*d=a*((e : ℤ)-(f0 : ℤ)).natAbs ∨
        c*d=a*((e : ℤ)+(f0 : ℤ)).natAbs := by exact_mod_cast hratio
    simpa only [mul_comm] using Or.comm.mp hNat

theorem torus_one_zero_positive_source05_signed_line {a c d e : ℕ} {f : ℤ}
    {z : Fin 4 → ℤ} (ha : 0<a) (hc : 0<c) (hd : 0<d) (he : 0<e) (hf : f≠0)
    (hspan : TorusIntegerLineInSpan (![(a : ℤ),(a : ℤ),0,(c : ℤ)])
      (![(d : ℤ),-(d : ℤ),(e : ℤ),f]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    TorusGood (![(a : ℤ),(a : ℤ),0,(c : ℤ)])
      (![(d : ℤ),-(d : ℤ),(e : ℤ),f]) (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  let u : Fin 4 → ℤ := ![(a : ℤ),(a : ℤ),0,(c : ℤ)]
  let v : Fin 4 → ℤ := ![(d : ℤ),-(d : ℤ),(e : ℤ),f]
  have haZ : (0 : ℤ)<a := by exact_mod_cast ha
  have hcZ : (0 : ℤ)<c := by exact_mod_cast hc
  have hdZ : (0 : ℤ)<d := by exact_mod_cast hd
  have heZ : (0 : ℤ)<e := by exact_mod_cast he
  by_cases hpoint : TorusGood u v (2/7)
  · exact Or.inl hpoint
  · have hvn : ∀ i,v i≠0 := by
      intro i
      fin_cases i <;> simp [v,Nat.ne_of_gt hd,Nat.ne_of_gt he,hf,
        Matrix.cons_val_two,Matrix.cons_val_three]
    have habs : (v 0).natAbs=(v 1).natAbs := by simp [v]
    have hbadV : ¬TorusGood v u (2/7) := fun h => hpoint (torus_good_swap_iff.mp h)
    obtain ⟨B,hB,hprofile⟩ := torus_bad_collision_line_is_tight hvn habs hbadV
    let R := torusDivideGenerator B v
    have hR : torusLineSpeeds R=({1,2,3} : Finset ℕ) :=
      torus_tight_profile_division hB hprofile
    have hfactor : torusGeneratorScale (B : ℤ) R=v := torus_tight_profile_factor hprofile
    have hBInt : (0 : ℤ)<B := by exact_mod_cast hB
    have hR0p : 0<R 0 := by
      have hfac := congrFun hfactor 0
      change (B : ℤ)*R 0=(d : ℤ) at hfac
      by_contra hn
      have hnonpos := mul_nonpos_of_nonneg_of_nonpos hBInt.le (le_of_not_gt hn)
      rw [hfac] at hnonpos
      exact (not_le_of_gt hdZ) hnonpos
    have hR2p : 0<R 2 := by
      have hfac := congrFun hfactor 2
      change (B : ℤ)*R 2=(e : ℤ) at hfac
      by_contra hn
      have hnonpos := mul_nonpos_of_nonneg_of_nonpos hBInt.le (le_of_not_gt hn)
      rw [hfac] at hnonpos
      exact (not_le_of_gt heZ) hnonpos
    have hR10 : R 1= -R 0 := by
      have hdiv : (B : ℤ) ∣ (d : ℤ) := by
        simpa [v] using torus_tight_profile_divides hprofile 0
      dsimp [R,torusDivideGenerator,v]
      exact Int.neg_ediv_of_dvd hdiv
    let D : ℕ := (R 0).natAbs
    let E : ℕ := (R 2).natAbs
    let F : ℕ := (R 3).natAbs
    let ε : ℤ := (R 3).sign
    have hD : (D : ℤ)=R 0 := Int.natAbs_of_nonneg hR0p.le
    have hE : (E : ℤ)=R 2 := Int.natAbs_of_nonneg hR2p.le
    have hF : ε*(F : ℤ)=R 3 := Int.sign_mul_natAbs (R 3)
    have hε : ε=1 ∨ ε= -1 := int_sign_nonzero_cases (triple123_line_nonzero hR 3)
    have htriple : ({D,E,F} : Finset ℕ)={1,2,3} := by
      rw [torus_collision_line_speed_image
        (show (R 0).natAbs=(R 1).natAbs by rw [hR10,Int.natAbs_neg])] at hR
      exact hR
    have hDpos : 0<D := by exact_mod_cast (show (0 : ℤ)<D by rwa [hD])
    have hEpos : 0<E := by exact_mod_cast (show (0 : ℤ)<E by rwa [hE])
    let N : Fin 4 → ℤ := ![(D : ℤ),-(D : ℤ),(E : ℤ),ε*(F : ℤ)]
    have hN : N=R := by
      funext i
      fin_cases i <;> simp [N,hD,hE,hF,hR10,
        Matrix.cons_val_two,Matrix.cons_val_three]
    have hNfactor : torusGeneratorScale (B : ℤ) N=v := by rwa [hN]
    have hself : torusGeneratorScale 1 u=u := by funext i; simp [torusGeneratorScale]
    have hgood (L : ℝ) : TorusGood u v L ↔ TorusGood u N L := by
      have h := torus_good_diagonal_scaling_iff (u:=u) (v:=N) (L:=L)
        1 (B : ℤ) (by norm_num) (ne_of_gt hBInt)
      rwa [hself,hNfactor] at h
    have hbadN : ¬TorusGood u N (2/7) := fun h => hpoint ((hgood (2/7)).mpr h)
    have hratioInt := torus_one_zero_low_forces_ratio haZ hcZ
      (show (0 : ℤ)<D by exact_mod_cast hDpos)
      (show (0 : ℤ)<E by exact_mod_cast hEpos) hbadN
    have hratio := torus_onezero_signed_ratio_nat hε hratioInt
    rcases torus24_onezero_ratio_classification ha hc htriple hε hratio with hnormalized | hex
    · exact False.elim (hbadN hnormalized)
    · have hLines : TorusAbsoluteLineTransfer u v u N :=
        torus_absolute_line_transfer_of_factors 1 (B : ℤ) hself hNfactor
      obtain ⟨w,hw,hspanw⟩ := hLines z hspan
      have hpw : Positive (torusLineSpeeds w) := by simpa only [hw] using hp
      have hprimw : Primitive (torusLineSpeeds w) := by simpa only [hw] using hprim
      have hsource := source05_of_torus_onezero_scaled_U2_signed_line hex hspanw hpw hprimw
      exact Or.inr (by simpa only [hw] using hsource)

/-- All signs are actual coordinate and generator operations; the same
signed integer line is transported without changing its absolute speeds. -/
theorem torus_one_zero_signed_normalization {a c d e f : ℤ}
    (ha : a≠0) (hc : c≠0) (hd : d≠0) (he : e≠0) (hf : f≠0) :
    ∃ F : ℤ, F≠0 ∧
      (∀ L : ℝ, TorusGood (![a,a,0,c]) (![d,-d,e,f]) L ↔
        TorusGood (![(a.natAbs : ℤ),(a.natAbs : ℤ),0,(c.natAbs : ℤ)])
          (![(d.natAbs : ℤ),-(d.natAbs : ℤ),(e.natAbs : ℤ),F]) L) ∧
      TorusAbsoluteLineTransfer (![a,a,0,c]) (![d,-d,e,f])
        (![(a.natAbs : ℤ),(a.natAbs : ℤ),0,(c.natAbs : ℤ)])
        (![(d.natAbs : ℤ),-(d.natAbs : ℤ),(e.natAbs : ℤ),F]) := by
  let u : Fin 4 → ℤ := ![a,a,0,c]
  let v : Fin 4 → ℤ := ![d,-d,e,f]
  have hsa := int_sign_nonzero_cases ha
  have hsc := int_sign_nonzero_cases hc
  have hsd := int_sign_nonzero_cases hd
  have hse := int_sign_nonzero_cases he
  let η : ℤ := a.sign*d.sign
  have hη : η=1 ∨ η= -1 := by
    rcases hsa with hA | hA <;> rcases hsd with hD | hD <;> simp [η,hA,hD]
  have hηne : η≠0 := by rcases hη with h | h <;> simp [h]
  have hηsq : η*η=1 := by rcases hη with h | h <;> simp [h]
  have hasq : a.sign*a.sign=1 := by rcases hsa with h | h <;> simp [h]
  have hcsignne : c.sign≠0 := by rcases hsc with h | h <;> simp [h]
  let ε : Fin 4 → ℤ := ![a.sign,a.sign,η*e.sign,c.sign]
  have hε : ∀ i,ε i=1 ∨ ε i= -1 := by
    intro i
    fin_cases i
    · simpa [ε] using hsa
    · simpa [ε] using hsa
    · rcases hη with hη' | hη' <;> rcases hse with hE | hE <;>
        simp [ε,hη',hE,Matrix.cons_val_two,Matrix.cons_val_three]
    · simpa [ε,Matrix.cons_val_two,Matrix.cons_val_three] using hsc
  let S := torusGeneratorScale η v
  let U := torusCoordinateSigns ε u
  let V := torusCoordinateSigns ε S
  let F : ℤ := η*c.sign*f
  have hF : F≠0 := mul_ne_zero (mul_ne_zero hηne hcsignne) hf
  have hv0 : a.sign*(η*d)=(d.natAbs : ℤ) := by
    calc a.sign*(η*d)=(a.sign*a.sign)*(d.sign*d) := by dsimp [η]; ring
         _=(d.natAbs : ℤ) := by rw [hasq,one_mul,Int.sign_mul_self]
  have hv2 : (η*e.sign)*(η*e)=(e.natAbs : ℤ) := by
    calc (η*e.sign)*(η*e)=(η*η)*(e.sign*e) := by ring
         _=(e.natAbs : ℤ) := by rw [hηsq,one_mul,Int.sign_mul_self]
  have hv3 : c.sign*(η*f)=F := by dsimp [F]; ring
  have hU : U=(![(a.natAbs : ℤ),(a.natAbs : ℤ),0,(c.natAbs : ℤ)]) := by
    funext i
    fin_cases i <;> simp [U,torusCoordinateSigns,ε,u,Int.sign_mul_self,
      Matrix.cons_val_two,Matrix.cons_val_three]
  have hV : V=(![(d.natAbs : ℤ),-(d.natAbs : ℤ),(e.natAbs : ℤ),F]) := by
    funext i
    fin_cases i <;> simp [V,torusCoordinateSigns,ε,S,torusGeneratorScale,v,
      hv0,hv2,hv3,mul_neg,Matrix.cons_val_two,Matrix.cons_val_three]
  have hself : torusGeneratorScale 1 u=u := by funext i; simp [torusGeneratorScale]
  have hSfactor : torusGeneratorScale η S=v := by
    funext i
    change η*(η*v i)=v i
    rw [←mul_assoc,hηsq,one_mul]
  have hscale (L : ℝ) : TorusGood u v L ↔ TorusGood u S L := by
    have ht := torus_good_diagonal_scaling_iff (u:=u) (v:=S) (L:=L)
      1 η (by norm_num) hηne
    rwa [hself,hSfactor] at ht
  have hgood (L : ℝ) : TorusGood u v L ↔ TorusGood U V L :=
    (hscale L).trans (torus_good_coordinate_signs_iff (u:=u) (v:=S) ε hε).symm
  have hLinesScale : TorusAbsoluteLineTransfer u v u S :=
    torus_absolute_line_transfer_of_factors 1 η hself hSfactor
  have hLines : TorusAbsoluteLineTransfer u v U V :=
    torus_absolute_line_transfer_trans hLinesScale
      (torus_absolute_line_transfer_signs u S ε hε)
  refine ⟨F,hF,?_,?_⟩
  · intro L
    simpa only [hU,hV] using hgood L
  · simpa only [hU,hV] using hLines

/-- Complete one-zero branch, allowing arbitrary nonzero signed scales. -/
theorem torus_one_zero_source05_signed_line {a c d e f : ℤ} {z : Fin 4 → ℤ}
    (ha : a≠0) (hc : c≠0) (hd : d≠0) (he : e≠0) (hf : f≠0)
    (hspan : TorusIntegerLineInSpan (![a,a,0,c]) (![d,-d,e,f]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    TorusGood (![a,a,0,c]) (![d,-d,e,f]) (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  obtain ⟨F,hF,hgood,hLines⟩ := torus_one_zero_signed_normalization ha hc hd he hf
  obtain ⟨w,hw,hspanw⟩ := hLines z hspan
  have hpw : Positive (torusLineSpeeds w) := by simpa only [hw] using hp
  have hprimw : Primitive (torusLineSpeeds w) := by simpa only [hw] using hprim
  have hresult := torus_one_zero_positive_source05_signed_line
    (Int.natAbs_pos.mpr ha) (Int.natAbs_pos.mpr hc)
    (Int.natAbs_pos.mpr hd) (Int.natAbs_pos.mpr he) hF hspanw hpw hprimw
  rcases hresult with hpoint | hsource
  · exact Or.inl ((hgood (2/7)).mpr hpoint)
  · exact Or.inr (by simpa only [hw] using hsource)







