/- Section: CenterCorrection -/
section


/-!
Explicit middle-cube points for an odd-sum relation. The signed coefficient
input exposes the two finite identities needed to instantiate s_i=sign(m_i)
and p=sum_i |m_i|. These statements prove neither a lattice lift nor a
universal subtorus classification.
-/

noncomputable section
open scoped BigOperators
namespace Math15.LonelyRunner

theorem distance_center_correction_ge_third {s p : ℝ}
    (hp : 3 ≤ p) (hs : |s| ≤ 1) :
    (1 / 3 : ℝ) ≤ distance (((1 / 2 - s / (2 * p) : ℝ)) : Time) := by
  have hden : (0 : ℝ) < 2 * p := by linarith
  have hsb := abs_le.mp hs
  have hfraclo : -(1 / 6 : ℝ) ≤ s / (2 * p) := by
    apply (le_div_iff₀ hden).2
    nlinarith
  have hfrach : s / (2 * p) ≤ (1 / 6 : ℝ) := by
    apply (div_le_iff₀ hden).2
    nlinarith
  apply distance_coe_ge_of_interval (j := 0) <;>
    norm_num <;> linarith

/-- The common coefficient correction satisfies the integer hyperplane
exactly, rather than only modulo a real error. -/
theorem center_correction_integer_hyperplane
    (m s : Fin 4 → ℝ) (p : ℝ) (j : ℤ)
    (hp : p ≠ 0) (hodd : (∑ i, m i) = 2 * (j : ℝ) + 1)
    (hsigned : (∑ i, m i * s i) = p) :
    (∑ i, m i * (1 / 2 - s i / (2 * p))) = (j : ℝ) := by
  calc
    (∑ i, m i * (1 / 2 - s i / (2 * p))) =
        (∑ i, (m i * (1 / 2) - (m i * s i) / (2 * p))) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ =
        (∑ i, m i) * (1 / 2) - (∑ i, m i * s i) / (2 * p) := by
      rw [Finset.sum_sub_distrib, Finset.sum_mul, Finset.sum_div]
    _ = (j : ℝ) := by rw [hodd, hsigned]; field_simp [hp] <;> ring

/-- One explicit vector simultaneously satisfies the modular relation and
the third-distance inequalities in all four coordinates. -/
theorem exists_center_correction_third
    (m s : Fin 4 → ℝ) (p : ℝ) (j : ℤ)
    (hp : 3 ≤ p) (hodd : (∑ i, m i) = 2 * (j : ℝ) + 1)
    (hsigned : (∑ i, m i * s i) = p) (hs : ∀ i, |s i| ≤ 1) :
    ∃ x : Fin 4 → ℝ, (∑ i, m i * x i) = (j : ℝ) ∧
      ∀ i, (1 / 3 : ℝ) ≤ distance (x i : Time) := by
  refine ⟨fun i => 1 / 2 - s i / (2 * p), ?_, ?_⟩
  · exact center_correction_integer_hyperplane m s p j (by linarith) hodd hsigned
  · intro i
    exact distance_center_correction_ge_third hp (hs i)





end Math15.LonelyRunner
end 
end 

/- Section: OddCenterLift -/
section



/-!
The actual sign correction for an odd-width primitive integer relation. The
width is the sum of the actual four coordinate natAbs values. No signed-weight
identity is left as an assumption. The exact circle margin 1/2 - 1/(2p)
survives the common lift into the real zero hyperplane.
-/

noncomputable section
namespace Math15.Source05Review
open Math15.LonelyRunner
open Math15.LonelyRunner.Covolume4

/-- Retain the exact margin instead of weakening it to one third. -/
theorem distance_center_correction_ge_exact {s p : ℝ}
    (hp : 0 < p) (hs : |s| ≤ 1) :
    (1/2-1/(2*p) : ℝ) ≤ distance (((1/2-s/(2*p) : ℝ)) : Time) := by
  have hden : (0 : ℝ) < 2*p := by positivity
  have hslo := (abs_le.mp hs).1
  have hshi := (abs_le.mp hs).2
  have hlo : -(1/(2*p) : ℝ) ≤ s/(2*p) := by
    have h : (-1 : ℝ)/(2*p) ≤ s/(2*p) :=
      (div_le_div_iff_of_pos_right hden).2 hslo
    simpa only [neg_div] using h
  have hhi : s/(2*p) ≤ (1 : ℝ)/(2*p) :=
    (div_le_div_iff_of_pos_right hden).2 hshi
  apply distance_coe_ge_of_interval (j := (0 : ℤ)) <;>
    simp only [Int.cast_zero, zero_add] <;> linarith

theorem real_integer_sign_abs_le_one (n : ℤ) : |(Int.sign n : ℝ)| ≤ 1 := by
  rcases lt_trichotomy n 0 with hn | hn | hn
  · rw [Int.sign_eq_neg_one_of_neg hn]
    norm_num
  · subst n
    norm_num
  · rw [Int.sign_eq_one_of_pos hn]
    norm_num

theorem real_integer_mul_sign (n : ℤ) :
    (n : ℝ)*(Int.sign n : ℝ) = (n.natAbs : ℝ) := by
  have h : n*Int.sign n = (n.natAbs : ℤ) := by
    simpa only [mul_comm] using Int.sign_mul_self n
  have hR := congrArg (fun z : ℤ => (z : ℝ)) h
  simpa only [Int.cast_mul, Int.cast_natCast] using hR

theorem actual_integer_sign_sum (m : Vec4 ℤ) :
    (∑ i, (m i : ℝ)*(Int.sign (m i) : ℝ)) =
      ((∑ i, (m i).natAbs : ℕ) : ℝ) := by
  simp only [real_integer_mul_sign, Nat.cast_sum]

/-- An explicit parity certificate for replacing an integer by its absolute value. -/
theorem integer_natAbs_difference_even (n : ℤ) :
    ∃ k : ℤ, (n.natAbs : ℤ) = n+2*k := by
  rcases le_total 0 n with hn | hn
  · refine ⟨0, ?_⟩
    rw [Int.natCast_natAbs, abs_of_nonneg hn]
    ring
  · refine ⟨-n, ?_⟩
    rw [Int.natCast_natAbs, abs_of_nonpos hn]
    ring

/-- Oddness of the actual natAbs width implies oddness of the coefficient sum. -/
theorem odd_natAbs_sum_coefficient_sum (m : Vec4 ℤ)
    (hodd : Odd (∑ i, (m i).natAbs)) :
    ∃ j : ℤ, (∑ i, m i) = 2*j+1 := by
  classical
  choose k hk using fun i : Fin 4 => integer_natAbs_difference_even (m i)
  have hsum : ((∑ i, (m i).natAbs : ℕ) : ℤ) =
      (∑ i, m i)+2*(∑ i, k i) := by
    rw [Nat.cast_sum]
    calc
      (∑ i, ((m i).natAbs : ℤ)) = ∑ i, (m i+2*k i) := by
        apply Finset.sum_congr rfl
        intro i _
        exact hk i
      _ = (∑ i, m i)+2*(∑ i, k i) := by
        rw [Finset.sum_add_distrib, Finset.mul_sum]
  obtain ⟨j, hj⟩ := hodd
  have hjZ : ((∑ i, (m i).natAbs : ℕ) : ℤ) = 2*(j : ℤ)+1 := by
    exact_mod_cast hj
  refine ⟨(j : ℤ)-(∑ i, k i), ?_⟩
  linarith

/-- Exact common lift when the coefficient-sum parity is supplied explicitly. -/
theorem primitive_odd_sum_center_lift (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hp : 3 ≤ ∑ i, (m i).natAbs)
    (j : ℤ) (hodd : (∑ i, m i) = 2*j+1) :
    ∃ x : Vec4 ℝ, dot4 (realVec4 m) x = 0 ∧
      (∀ i, (1/2-1/(2*((∑ i, (m i).natAbs : ℕ) : ℝ)) : ℝ) ≤
        distance (x i : Time)) := by
  let p : ℝ := ((∑ i, (m i).natAbs : ℕ) : ℝ)
  let s : Vec4 ℝ := fun i => (Int.sign (m i) : ℝ)
  let a : Vec4 ℝ := fun i => 1/2-s i/(2*p)
  have hp3 : (3 : ℝ) ≤ p := by
    dsimp only [p]
    exact_mod_cast hp
  have hp0 : 0 < p := by linarith
  have hoddR : (∑ i, realVec4 m i) = 2*(j : ℝ)+1 := by
    change (∑ i, (m i : ℝ)) = 2*(j : ℝ)+1
    exact_mod_cast hodd
  have hsigned : (∑ i, realVec4 m i*s i) = p := actual_integer_sign_sum m
  have ha : dot4 (realVec4 m) a = (j : ℝ) := by
    have h := center_correction_integer_hyperplane (realVec4 m) s p j
      (ne_of_gt hp0) hoddR hsigned
    simpa only [dot4, Fin.sum_univ_four, a] using h
  refine primitive_modular_center_lift_distance_ge m hm a j ha _ ?_
  intro i
  exact distance_center_correction_ge_exact hp0 (real_integer_sign_abs_le_one (m i))

/-- Final native interface: actual odd width and primitivity supply an
actual point in the real zero hyperplane with the exact uniform margin. -/
theorem primitive_odd_width_center_lift (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hp : 3 ≤ ∑ i, (m i).natAbs)
    (hodd : Odd (∑ i, (m i).natAbs)) :
    ∃ x : Vec4 ℝ, dot4 (realVec4 m) x = 0 ∧
      (∀ i, (1/2-1/(2*((∑ i, (m i).natAbs : ℕ) : ℝ)) : ℝ) ≤
        distance (x i : Time)) := by
  obtain ⟨j, hj⟩ := odd_natAbs_sum_coefficient_sum m hodd
  exact primitive_odd_sum_center_lift m hm hp j hj










end Math15.Source05Review
end 
end 

