/- Section: SmallWidthThreeAssembly -/
section



/-!
The actual width-three branch of the canonical four-speed reduction. A
complete coordinate order supplies an actual permutation. Its image is the
original speed set, and its sum is the original coordinate sum. Thus the
additive geometric consumer applies to exactly the original positive,
primitive, pairwise-gcd-bounded quartet, after moving its additive triple to
coordinates zero, one, and two. The double alternative is already consumed by
the unbounded one-two and two-four proofs.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

/-- The complete relation order is an actual coordinate permutation. -/
theorem relation_coordinate_order_permutation {i j k l : Fin 4}
    (horder : RelationCoordinateOrder i j k l) :
    ∃ σ : Equiv.Perm (Fin 4), σ 0=i ∧ σ 1=j ∧ σ 2=k ∧ σ 3=l := by
  obtain ⟨hij,hik,hil,hjk,hjl,hkl⟩ := horder
  let f : Fin 4 → Fin 4 := ![i,j,k,l]
  have hinj : Function.Injective f := by
    intro r s hrs
    fin_cases r <;> fin_cases s <;>
      simp_all [f,Matrix.cons_val_two,Matrix.cons_val_three]
  let σ : Equiv.Perm (Fin 4) :=
    Equiv.ofBijective f ⟨hinj,Finite.surjective_of_injective hinj⟩
  exact ⟨σ,rfl,rfl,rfl,rfl⟩

/-- Reordering the actual natural vector preserves its entire speed set. -/
theorem small_width_positiveLineSpeeds_permute (v : Fin 4 → ℕ)
    (σ : Equiv.Perm (Fin 4)) :
    positiveLineSpeeds (fun i => v (σ i))=positiveLineSpeeds v := by
  unfold positiveLineSpeeds
  ext n
  constructor
  · intro hn
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp hn
    exact Finset.mem_image.mpr ⟨σ i,Finset.mem_univ _,he⟩
  · intro hn
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp hn
    refine Finset.mem_image.mpr ⟨σ.symm i,Finset.mem_univ _,?_⟩
    simpa only [σ.apply_symm_apply] using he

theorem low_ML_additive_relation_target_or_sum444
    (m : Vec4 ℤ) (v : Fin 4 → ℕ) (hform : RelationAdditiveForm m)
    (hdot : intDot m (fun i => (v i : ℤ))=0)
    (hp : Positive (Finset.univ.image v))
    (hprim : Primitive (Finset.univ.image v))
    (hcard : (Finset.univ.image v).card=4)
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,
      a≠b → Nat.gcd a b≤2)
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ)) :
    FiniteSource05Conclusion (Finset.univ.image v) ∨ (∑i,v i)≤444 := by
  obtain ⟨i,j,k,l,horder,hsigns⟩ := hform
  have hd : m i*(v i : ℤ)+m j*(v j : ℤ)+
      m k*(v k : ℤ)+m l*(v l : ℤ)=0 := by
    have he := relation_coordinate_order_sum horder (fun r => m r*(v r : ℤ))
    unfold intDot at hdot
    rwa [he] at hdot
  have haddZ : (v i : ℤ)+(v j : ℤ)=(v k : ℤ) := by
    rcases hsigns with ⟨hi,hj,hk,hl⟩ | ⟨hi,hj,hk,hl⟩
    · rw [hi,hj,hk,hl] at hd
      nlinarith
    · rw [hi,hj,hk,hl] at hd
      nlinarith
  have hadd : v i+v j=v k := by exact_mod_cast haddZ
  obtain ⟨σ,hσ0,hσ1,hσ2,hσ3⟩ := relation_coordinate_order_permutation horder
  let w : Fin 4 → ℕ := fun r => v (σ r)
  have hspeeds : Finset.univ.image w=Finset.univ.image v :=
    small_width_positiveLineSpeeds_permute v σ
  have hsum : (∑r,w r)=(∑r,v r) := Equiv.sum_comp σ v
  have haddw : w 0+w 1=w 2 := by
    change v (σ 0)+v (σ 1)=v (σ 2)
    rwa [hσ0,hσ1,hσ2]
  have hpw : Positive (Finset.univ.image w) := by simpa only [hspeeds] using hp
  have hprimw : Primitive (Finset.univ.image w) := by simpa only [hspeeds] using hprim
  have hcardw : (Finset.univ.image w).card=4 := by simpa only [hspeeds] using hcard
  have hpairw : ∀a∈Finset.univ.image w,∀b∈Finset.univ.image w,
      a≠b → Nat.gcd a b≤2 := by simpa only [hspeeds] using hpair
  have hloww : ML (Finset.univ.image w)<(1/4 : ℝ) := by
    simpa only [hspeeds] using hlow
  rcases low_ML_additive_target_or_sum444 w haddw hpw hprimw hcardw hpairw hloww with
    htarget | hbound
  · exact Or.inl (by simpa only [hspeeds] using htarget)
  · exact Or.inr (by simpa only [hsum] using hbound)

/-- Primitivity of the width-three relation is unnecessary: positivity
already leaves exactly the additive and double alternatives. -/
theorem low_ML_width_three_target_or_sum444
    (m : Vec4 ℤ) (v : Fin 4 → ℕ) (hw : relationL1 m=3)
    (hmv : intDot m (fun i => (v i : ℤ))=0)
    (hp : Positive (Finset.univ.image v))
    (hprim : Primitive (Finset.univ.image v))
    (hcard : (Finset.univ.image v).card=4)
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,
      a≠b → Nat.gcd a b≤2)
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ)) :
    FiniteSource05Conclusion (Finset.univ.image v) ∨ (∑i,v i)≤444 := by
  have hd : naturalRelationDot m v=0 := hmv
  rcases source05_or_additive_form_of_width_three hp hcard hpair hd hw with
    htarget | hadditive
  · exact Or.inl htarget
  · exact low_ML_additive_relation_target_or_sum444 m v hadditive hmv
      hp hprim hcard hpair hlow

/-- The interface matching the primitive small-relation geometric consumer. -/
theorem low_ML_primitive_width_three_target_or_sum444
    (m : Vec4 ℤ) (v : Fin 4 → ℕ) (hw : relationL1 m=3)
    (_hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hmv : intDot m (fun i => (v i : ℤ))=0)
    (hp : Positive (Finset.univ.image v))
    (hprim : Primitive (Finset.univ.image v))
    (hcard : (Finset.univ.image v).card=4)
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,
      a≠b → Nat.gcd a b≤2)
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ)) :
    FiniteSource05Conclusion (Finset.univ.image v) ∨ (∑i,v i)≤444 :=
  low_ML_width_three_target_or_sum444 m v hw hmv hp hprim hcard hpair hlow







end Math15.LonelyRunner.Covolume4
