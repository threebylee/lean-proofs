/- Section: TorusZeroAssembly -/
section


/-!
All zero patterns of an actual collision pair (a,a,b,c),(d,-d,e,f). Positivity
of the same integer line excludes a coordinate where both generators vanish.
Remaining cases are transported by actual shared coordinate permutations/signs
and, when needed, a generator swap. Every transport retains the original set
of absolute integer speeds.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torus_integer_line_coordinate_support {u v z : Fin 4 → ℤ}
    (hspan : TorusIntegerLineInSpan u v z) (hp : Positive (torusLineSpeeds z)) :
    ∀ i,u i≠0 ∨ v i≠0 := by
  obtain ⟨x,y,hspan⟩ := hspan
  intro i
  by_contra hzero
  push_neg at hzero
  have hz := hspan i
  rw [hzero.1,hzero.2] at hz
  norm_num at hz
  have hzInt : z i=0 := by exact_mod_cast hz
  have hpositive := hp (z i).natAbs (Finset.mem_image.mpr ⟨i,by simp,rfl⟩)
  rw [hzInt] at hpositive
  norm_num at hpositive

theorem torus_integer_line_span_swap {u v z : Fin 4 → ℤ}
    (hspan : TorusIntegerLineInSpan u v z) : TorusIntegerLineInSpan v u z := by
  obtain ⟨x,y,hspan⟩ := hspan
  refine ⟨y,x,?_⟩
  intro i
  rw [add_comm]
  exact hspan i

