/- Section: TorusTransform -/
section


/-!
Actual changes of generators and coordinates for a shared torus witness.

Paper argument. The two new integer generators Au+Bv and Cu+Dv send a
parameter pair (x,y) to (Ax+Cy,Bx+Dy). When AD-BC is nonzero, Cramer's inverse
sends (X,Y) to ((DX-CY)/(AD-BC),(-BX+AY)/(AD-BC)). These are common parameter
pairs for every coordinate. Coordinate signs preserve circle distance, and a
permutation merely reindexes the same four inequalities. Nonzero separate
scalings of the generators are the diagonal matrix case.

At any coordinate pair i,j, the collision generators (v_j-v_i)u+(u_i-u_j)v and
(v_j+v_i)u-(u_i+u_j)v have coordinates (delta,delta) and (delta,-delta),
respectively, with delta=u_i v_j-u_j v_i. Their coefficient determinant is -2
delta. If the original real generators are independent, a nonzero coordinate
minor exists: otherwise a nonzero u_i gives the nontrivial dependence v_i
u-u_i v=0. This is a normalization ingredient, not a universal torus
classification or a claim about the original target.
-/

noncomputable section
namespace Math15.LonelyRunner

def torusIntegerCombination (A B : ℤ) (u v : Fin 4 → ℤ) : Fin 4 → ℤ :=
  fun i => A * u i + B * v i

/-- Every forward parameter change preserves one common point. -/
theorem torus_good_of_integer_combinations {u v : Fin 4 → ℤ} {L : ℝ}
    (A B C D : ℤ)
    (h : TorusGood (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) L) : TorusGood u v L := by
  obtain ⟨x,y,hxy⟩ := h
  refine ⟨(A : ℝ)*x+(C : ℝ)*y, (B : ℝ)*x+(D : ℝ)*y, ?_⟩
  intro i
  have he : (u i : ℝ)*((A : ℝ)*x+(C : ℝ)*y) +
      (v i : ℝ)*((B : ℝ)*x+(D : ℝ)*y) =
      (torusIntegerCombination A B u v i : ℝ)*x +
      (torusIntegerCombination C D u v i : ℝ)*y := by
    simp only [torusIntegerCombination, Int.cast_add, Int.cast_mul]
    ring
  rw [he]
  exact hxy i

/-- The inverse is over the real parameters, so an integer determinant
need only be nonzero; it need not be a unit. -/
theorem torus_good_integer_change_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (A B C D : ℤ) (hdet : A*D-B*C ≠ 0) :
    TorusGood (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) L ↔ TorusGood u v L := by
  constructor
  · exact torus_good_of_integer_combinations A B C D
  · intro h
    obtain ⟨X,Y,hXY⟩ := h
    have hdetR : (A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ) ≠ 0 := by
      exact_mod_cast hdet
    refine ⟨((D : ℝ)*X-(C : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)),
      (-(B : ℝ)*X+(A : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)), ?_⟩
    intro i
    have he : (torusIntegerCombination A B u v i : ℝ)*
          (((D : ℝ)*X-(C : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ))) +
        (torusIntegerCombination C D u v i : ℝ)*
          ((-(B : ℝ)*X+(A : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ))) =
        (u i : ℝ)*X+(v i : ℝ)*Y := by
      simp only [torusIntegerCombination, Int.cast_add, Int.cast_mul]
      field_simp [hdetR] <;> ring
    rw [he]
    exact hXY i

def torusGeneratorScale (c : ℤ) (u : Fin 4 → ℤ) : Fin 4 → ℤ := fun i => c*u i

/-- Separate nonzero generator scalings preserve the plane of real points. -/
theorem torus_good_diagonal_scaling_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (A B : ℤ) (hA : A ≠ 0) (hB : B ≠ 0) :
    TorusGood (torusGeneratorScale A u) (torusGeneratorScale B v) L ↔
      TorusGood u v L := by
  have hdet : A*B-(0 : ℤ)*0 ≠ 0 := by simpa using mul_ne_zero hA hB
  have hleft : torusIntegerCombination A 0 u v = torusGeneratorScale A u := by
    funext i
    simp [torusIntegerCombination, torusGeneratorScale]
  have hright : torusIntegerCombination 0 B u v = torusGeneratorScale B v := by
    funext i
    simp [torusIntegerCombination, torusGeneratorScale]
  have hchange := torus_good_integer_change_iff (u := u) (v := v)
    (L := L) A 0 0 B hdet
  rwa [hleft, hright] at hchange

def torusCoordinateSigns (ε u : Fin 4 → ℤ) : Fin 4 → ℤ := fun i => ε i*u i

theorem torus_sign_distance (e : ℤ) (he : e=1 ∨ e= -1) (a b x y : ℝ) :
    distance ((((e : ℝ)*a*x+(e : ℝ)*b*y : ℝ)) : Time) =
      distance (((a*x+b*y : ℝ)) : Time) := by
  rcases he with rfl | rfl
  · simp
  · have hn : ((-1 : ℤ) : ℝ)*a*x+((-1 : ℤ) : ℝ)*b*y = -(a*x+b*y) := by
      norm_num
      ring
    rw [hn, AddCircle.coe_neg]
    exact norm_neg _

theorem torus_coordinate_sign_distance (ε u v : Fin 4 → ℤ)
    (hε : ∀ i, ε i=1 ∨ ε i= -1) (i : Fin 4) (x y : ℝ) :
    distance ((((torusCoordinateSigns ε u i : ℝ)*x+
      (torusCoordinateSigns ε v i : ℝ)*y : ℝ)) : Time) =
      distance ((((u i : ℝ)*x+(v i : ℝ)*y : ℝ)) : Time) := by
  simpa only [torusCoordinateSigns, Int.cast_mul] using
    torus_sign_distance (ε i) (hε i) (u i : ℝ) (v i : ℝ) x y

theorem torus_good_coordinate_signs_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (ε : Fin 4 → ℤ) (hε : ∀ i, ε i=1 ∨ ε i= -1) :
    TorusGood (torusCoordinateSigns ε u) (torusCoordinateSigns ε v) L ↔
      TorusGood u v L := by
  constructor
  · rintro ⟨x,y,h⟩
    refine ⟨x,y,?_⟩
    intro i
    have hi := h i
    rwa [torus_coordinate_sign_distance ε u v hε i x y] at hi
  · rintro ⟨x,y,h⟩
    refine ⟨x,y,?_⟩
    intro i
    rw [torus_coordinate_sign_distance ε u v hε i x y]
    exact h i

def torusCoordinatePermute (σ : Equiv.Perm (Fin 4)) (u : Fin 4 → ℤ) :
    Fin 4 → ℤ := fun i => u (σ i)

theorem torus_good_coordinate_permutation_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (σ : Equiv.Perm (Fin 4)) :
    TorusGood (torusCoordinatePermute σ u) (torusCoordinatePermute σ v) L ↔
      TorusGood u v L := by
  constructor
  · rintro ⟨x,y,h⟩
    refine ⟨x,y,?_⟩
    intro i
    simpa only [torusCoordinatePermute, Equiv.apply_symm_apply] using h (σ.symm i)
  · rintro ⟨x,y,h⟩
    refine ⟨x,y,?_⟩
    intro i
    exact h (σ i)

theorem torus_good_signed_permutation_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (σ : Equiv.Perm (Fin 4)) (ε : Fin 4 → ℤ)
    (hε : ∀ i, ε i=1 ∨ ε i= -1) :
    TorusGood (torusCoordinateSigns ε (torusCoordinatePermute σ u))
      (torusCoordinateSigns ε (torusCoordinatePermute σ v)) L ↔ TorusGood u v L :=
  (torus_good_coordinate_signs_iff ε hε).trans (torus_good_coordinate_permutation_iff σ)

def torusCoordinateMinor (u v : Fin 4 → ℤ) (i j : Fin 4) : ℤ :=
  u i*v j-u j*v i

def torusCollisionPlus (u v : Fin 4 → ℤ) (i j : Fin 4) : Fin 4 → ℤ :=
  torusIntegerCombination (v j-v i) (u i-u j) u v

def torusCollisionMinus (u v : Fin 4 → ℤ) (i j : Fin 4) : Fin 4 → ℤ :=
  torusIntegerCombination (v j+v i) (-(u i+u j)) u v

theorem torus_collision_coordinate_identities (u v : Fin 4 → ℤ) (i j : Fin 4) :
    torusCollisionPlus u v i j i = torusCoordinateMinor u v i j ∧
    torusCollisionPlus u v i j j = torusCoordinateMinor u v i j ∧
    torusCollisionMinus u v i j i = torusCoordinateMinor u v i j ∧
    torusCollisionMinus u v i j j = -torusCoordinateMinor u v i j := by
  dsimp [torusCollisionPlus, torusCollisionMinus, torusIntegerCombination,
    torusCoordinateMinor]
  constructor
  · ring
  constructor
  · ring
  constructor <;> ring

theorem torus_collision_coefficient_determinant (u v : Fin 4 → ℤ) (i j : Fin 4) :
    (v j-v i)*(-(u i+u j))-(u i-u j)*(v j+v i) =
      -2*torusCoordinateMinor u v i j := by
  dsimp [torusCoordinateMinor]
  ring

theorem torus_good_collision_normal_form_iff {u v : Fin 4 → ℤ} {L : ℝ}
    (i j : Fin 4) (hminor : torusCoordinateMinor u v i j ≠ 0) :
    TorusGood (torusCollisionPlus u v i j) (torusCollisionMinus u v i j) L ↔
      TorusGood u v L := by
  have hdet : (v j-v i)*(-(u i+u j))-(u i-u j)*(v j+v i) ≠ 0 := by
    rw [torus_collision_coefficient_determinant]
    exact mul_ne_zero (by norm_num) hminor
  exact torus_good_integer_change_iff (v j-v i) (u i-u j)
    (v j+v i) (-(u i+u j)) hdet

/-- Independence is over the real parameters used in TorusGood. -/
def TorusRealIndependent (u v : Fin 4 → ℤ) : Prop :=
  ∀ A B : ℝ, (∀ i : Fin 4, A*(u i : ℝ)+B*(v i : ℝ)=0) → A=0 ∧ B=0

theorem torus_independent_has_nonzero_minor {u v : Fin 4 → ℤ}
    (hind : TorusRealIndependent u v) :
    ∃ i j : Fin 4, torusCoordinateMinor u v i j ≠ 0 := by
  by_contra hno
  push_neg at hno
  have hune : ∃ i : Fin 4, u i ≠ 0 := by
    by_contra hu
    push_neg at hu
    have hbad := hind 1 0 (by intro i; simp [hu i])
    norm_num at hbad
  obtain ⟨i,hi⟩ := hune
  have hiR : (u i : ℝ) ≠ 0 := by exact_mod_cast hi
  have hdep : ∀ j : Fin 4, (v i : ℝ)*(u j : ℝ)+(-(u i : ℝ))*(v j : ℝ)=0 := by
    intro j
    have hM : (u i : ℝ)*(v j : ℝ)-(u j : ℝ)*(v i : ℝ)=0 := by
      have hZ := hno i j
      dsimp [torusCoordinateMinor] at hZ
      exact_mod_cast hZ
    linear_combination -hM
  have hzero := (hind (v i : ℝ) (-(u i : ℝ)) hdep).2
  exact hiR (neg_eq_zero.mp hzero)

theorem torus_nonzero_minor_distinct {u v : Fin 4 → ℤ} {i j : Fin 4}
    (h : torusCoordinateMinor u v i j ≠ 0) : i ≠ j := by
  intro he
  subst j
  simp [torusCoordinateMinor] at h

/-- The first two coordinates have the exact collision normal form. -/
theorem torus_collision_first_two (u v : Fin 4 → ℤ) :
    torusCollisionPlus u v 0 1 0 = u 0*v 1-u 1*v 0 ∧
    torusCollisionPlus u v 0 1 1 = u 0*v 1-u 1*v 0 ∧
    torusCollisionMinus u v 0 1 0 = u 0*v 1-u 1*v 0 ∧
    torusCollisionMinus u v 0 1 1 = -(u 0*v 1-u 1*v 0) := by
  exact torus_collision_coordinate_identities u v 0 1














end Math15.LonelyRunner
end 
