    (hcheck : smallPairTableCheck q rows=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds (2*q) (3*q) c d) := by
  obtain ⟨row,hrow,rfl⟩ := List.mem_map.mp hcm
