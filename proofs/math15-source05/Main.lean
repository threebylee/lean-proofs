/-- Four-coordinate Cauchy inequality, by the six squared differences. -/
theorem four_real_sum_sq_le_four_sum_sq (a b c d : ℝ) :
    (a + b + c + d)^2 ≤ 4 * (a^2 + b^2 + c^2 + d^2) := by
  nlinarith [sq_nonneg (a-b), sq_nonneg (a-c), sq_nonneg (a-d),
    sq_nonneg (b-c), sq_nonneg (b-d), sq_nonneg (c-d)]

theorem four_real_abs_sum_sq_le_four_sum_sq (a b c d : ℝ) :
    (|a| + |b| + |c| + |d|)^2 ≤ 4 * (a^2 + b^2 + c^2 + d^2) := by
  simpa only [sq_abs] using
    four_real_sum_sq_le_four_sum_sq |a| |b| |c| |d|

/-- The actual integer normal's squared Euclidean bound implies a bounded
integer coefficient one-norm, without assuming primitivity. -/
theorem integer_four_l1_le_eight_of_normSq_le_sixteen
    (m : Vec4 ℤ) (hm : dot4 m m ≤ 16) :
