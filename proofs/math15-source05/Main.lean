/- Section: CompressedMaskSoundness -/
section



/-!
Semantic consumer of compressed quartet certificate tables. The union's set
bit gives either one actual listed time or one actual listed known family
value. Each listed time is checked on the fixed triple. The fourth speed's
modular inequality comes from the recomputed time mask at that same time.
There are no external mask-correctness assumptions.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- Checking the triple with its last entry repeated gives precisely the
fixed-triple obligations needed by the common-time proof. -/
theorem tripleTimesQuarterBool_of_rationalQuarterBool
    {a b c : ℕ} {times : List (ℕ × ℕ)}
    (h : times.all (fun t => rationalQuarterBool a b c c t.1 t.2) = true) :
    tripleTimesQuarterBool a b c times = true := by
  apply List.all_eq_true.mpr
  intro t ht
  have hh : 0 < t.2 ∧ ∀ v ∈ [a,b,c,c],
      t.2 ≤ 4 * min ((v*t.1)%t.2) (t.2-(v*t.1)%t.2) := by
    simpa only [rationalQuarterBool, Bool.and_eq_true, decide_eq_true_eq,
      List.all_eq_true] using List.all_eq_true.mp h t ht
  apply (@decide_eq_true_eq _ (tripleQuarterDecidable a b c t.1 t.2)).mpr
  exact ⟨hh.1, hh.2 a (by simp), hh.2 b (by simp), hh.2 c (by simp)⟩

/-- Complete generic consumer: actual coverage, time checks, and family
checks establish the original Source05 disjunction for the represented
quartet. A different time may be chosen for each fourth speed, while the
four speeds in each individual quartet use one common time. -/
theorem compressed_quartet_certificate_sound
    {a b c d A bound : ℕ} {times : List (ℕ × ℕ)} {known : List ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hcover : A &&& (rationalTimesMask bound times ||| listBits known) = A)
    (hd : Nat.testBit A d = true)
    (htimes : times.all (fun t => rationalQuarterBool a b c c t.1 t.2) = true)
    (hknown : known.all (fun v => finiteKnownFamilyBool a b c v) = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hbit := (mask_coverage_iff A
    (rationalTimesMask bound times ||| listBits known)).mp hcover d hd
  rcases (mask_union_testBit_iff (rationalTimesMask bound times)
    (listBits known) d).mp hbit with htime | hfamily
  · obtain ⟨t, ht, hlt, hdq⟩ :=
      (rationalTimesMask_testBit_iff bound d times).mp htime
    have htall := tripleTimesQuarterBool_of_rationalQuarterBool htimes
    have hbase : 0 < t.2 ∧ quarterResidue a t.1 t.2 ∧
        quarterResidue b t.1 t.2 ∧ quarterResidue c t.1 t.2 := by
      simpa only [tripleTimesQuarterBool, List.all_eq_true,
        decide_eq_true_eq] using
        (List.all_eq_true.mp htall t ht)
    obtain ⟨hn, haq, hbq, hcq⟩ := hbase
    apply Or.inl
    apply ML_lower_of_witness ⟨a, by simp [finiteQuartetSpeeds]⟩
      (((t.1 : ℝ) / (t.2 : ℝ)) : Time)
    intro v hv
    simp only [finiteQuartetSpeeds, Finset.mem_insert,
      Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_quarterResidue hn haq
    · exact distance_ge_quarter_of_quarterResidue hn hbq
    · exact distance_ge_quarter_of_quarterResidue hn hcq
    · exact distance_ge_quarter_of_quarterResidue hn hdq
  · have hmem := (listBits_testBit_iff known d).mp hfamily
    exact finiteKnownFamilyBool_sound hp hc hprim hpair
      (List.all_eq_true.mp hknown d hmem)




end Math15.LonelyRunner
end 
end 

/- Section: CompressedAllowedMask -/
section


/-!
Reusable masks for fourth-speed eligibility. Compatibility masks depend only
on the fixed speed and the common range bound, so a finite certificate can
reuse them across many triples. Interval and parity masks finish the
fourth-speed filter. Pairwise conditions among the first three speeds are
separate outer-enumeration conditions.

The exact bit semantics are proved from the actual list definitions. Every
sorted primitive quartet with the original pair-gcd bound has its fourth speed
in the allowed mask. In particular, three even fixed speeds force the fourth
speed to be odd, rather than retaining nonprimitive even rows.
-/

namespace Math15.LonelyRunner

def compatibleSpeedMask (bound a : ℕ) : ℕ :=
  listBits ((List.range bound).filter fun d => decide (Nat.gcd a d ≤ 2))

def intervalFourthMask (S bound a b c : ℕ) : ℕ :=
  listBits ((List.range bound).filter fun d => decide (c < d ∧ a+b+c+d ≤ S))

def oddSpeedMask (bound : ℕ) : ℕ :=
  listBits ((List.range bound).filter fun d => decide (d % 2 = 1))

def rangeSpeedMask (bound : ℕ) : ℕ := listBits (List.range bound)

def allowedFourthMask (S bound a b c : ℕ) : ℕ :=
  intervalFourthMask S bound a b c &&&
    compatibleSpeedMask bound a &&& compatibleSpeedMask bound b &&&
    compatibleSpeedMask bound c &&&
    (if a % 2 = 0 ∧ b % 2 = 0 ∧ c % 2 = 0
      then oddSpeedMask bound else rangeSpeedMask bound)

theorem compatibleSpeedMask_testBit_iff (bound a d : ℕ) :
    Nat.testBit (compatibleSpeedMask bound a) d = true ↔
      d < bound ∧ Nat.gcd a d ≤ 2 := by
  simp only [compatibleSpeedMask, listBits_testBit_iff, List.mem_filter,
    List.mem_range, decide_eq_true_eq]

theorem intervalFourthMask_testBit_iff (S bound a b c d : ℕ) :
    Nat.testBit (intervalFourthMask S bound a b c) d = true ↔
      d < bound ∧ c < d ∧ a+b+c+d ≤ S := by
  simp only [intervalFourthMask, listBits_testBit_iff, List.mem_filter,
    List.mem_range, decide_eq_true_eq]

theorem oddSpeedMask_testBit_iff (bound d : ℕ) :
    Nat.testBit (oddSpeedMask bound) d = true ↔ d < bound ∧ d % 2 = 1 := by
  simp only [oddSpeedMask, listBits_testBit_iff, List.mem_filter,
    List.mem_range, decide_eq_true_eq]

theorem rangeSpeedMask_testBit_iff (bound d : ℕ) :
    Nat.testBit (rangeSpeedMask bound) d = true ↔ d < bound := by
  simp only [rangeSpeedMask, listBits_testBit_iff, List.mem_range]

/-- Exact semantics of the computed mask, including the conditional parity
restriction. No externally supplied mask is assumed to have this support. -/
theorem allowedFourthMask_testBit_iff (S bound a b c d : ℕ) :
    Nat.testBit (allowedFourthMask S bound a b c) d = true ↔
      d < bound ∧ c < d ∧ a+b+c+d ≤ S ∧
      Nat.gcd a d ≤ 2 ∧ Nat.gcd b d ≤ 2 ∧ Nat.gcd c d ≤ 2 ∧
      (a % 2 = 0 ∧ b % 2 = 0 ∧ c % 2 = 0 → d % 2 = 1) := by
  by_cases h : a % 2 = 0 ∧ b % 2 = 0 ∧ c % 2 = 0
  · simp only [allowedFourthMask, if_pos h, Nat.testBit_and, Bool.and_eq_true,
      intervalFourthMask_testBit_iff, compatibleSpeedMask_testBit_iff,
      oddSpeedMask_testBit_iff]
    tauto
  · simp only [allowedFourthMask, if_neg h, Nat.testBit_and, Bool.and_eq_true,
      intervalFourthMask_testBit_iff, compatibleSpeedMask_testBit_iff,
      rangeSpeedMask_testBit_iff]
    tauto

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- The parity restriction is forced by actual primitivity of this same
quartet. It is not an extra hypothesis on the admitted fourth speed. -/
theorem primitive_quartet_fourth_odd {a b c d : ℕ}
    (hprim : Primitive ({a, b, c, d} : Finset ℕ))
    (ha : a % 2 = 0) (hb : b % 2 = 0) (hc : c % 2 = 0) : d % 2 = 1 := by
  have hdlt : d % 2 < 2 := Nat.mod_lt d (by norm_num)
  by_contra hodd
  have hd : d % 2 = 0 := by omega
  have hg : Nat.gcd a (Nat.gcd b (Nat.gcd c d)) = 1 := by
    simpa [Primitive, Finset.gcd_insert, Finset.gcd_singleton]
      using hprim
  have htwo : 2 ∣ Nat.gcd a (Nat.gcd b (Nat.gcd c d)) :=
    Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero ha)
      (Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero hb)
        (Nat.dvd_gcd (Nat.dvd_of_mod_eq_zero hc) (Nat.dvd_of_mod_eq_zero hd)))
  rw [hg] at htwo
  norm_num at htwo

/-- Every genuinely admissible sorted quartet survives the precomputed
compatibility masks, interval mask and primitive parity restriction.
Positivity and the pair conditions among a,b,c may be handled by the outer
enumeration; the statement remains valid without assuming them separately. -/
theorem allowedFourthMask_of_admissible {S bound a b c d : ℕ}
    (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ S) (hdBound : d < bound)
    (hprim : Primitive ({a, b, c, d} : Finset ℕ))
    (hpair : ∀ u ∈ ({a, b, c, d} : Finset ℕ),
      ∀ v ∈ ({a, b, c, d} : Finset ℕ), u ≠ v → Nat.gcd u v ≤ 2) :
    Nat.testBit (allowedFourthMask S bound a b c) d = true := by
  have had : a < d := lt_trans hab (lt_trans hbc hcd)
  have hbd : b < d := lt_trans hbc hcd
  have hadGcd : Nat.gcd a d ≤ 2 :=
    hpair a (by simp) d (by simp) (ne_of_lt had)
  have hbdGcd : Nat.gcd b d ≤ 2 :=
    hpair b (by simp) d (by simp) (ne_of_lt hbd)
  have hcdGcd : Nat.gcd c d ≤ 2 :=
    hpair c (by simp) d (by simp) (ne_of_lt hcd)
  apply (allowedFourthMask_testBit_iff S bound a b c d).mpr
  refine ⟨hdBound, hcd, hsum, hadGcd, hbdGcd, hcdGcd, ?_⟩
  rintro ⟨ha, hb, hc⟩
  exact primitive_quartet_fourth_odd hprim ha hb hc









end Math15.LonelyRunner
end 
end 

/- Section: CompressedCensusSoundness -/
section



/-!
Generic soundness of a compressed table for a fixed first pair a,b.

Each row stores its actual third speed, common rational times for the fixed
triple, and fourth speeds covered by checked known families. Its Boolean check
consists only of the computed mask-coverage equation, the fixed-triple time
check, and the known-family check. The generic transfer recovers the Source05
conclusion for every admissible represented quartet. A separate Boolean
coverage check ensures that all required third speeds have rows.

No numerical table is proved here, and no full census or universal cutoff is
asserted.
-/

namespace Math15.LonelyRunner

structure CompressedCensusRow where
  c : ℕ
  times : List (ℕ × ℕ)
  known : List ℕ

def compressedRowCheck (S bound a b : ℕ) (row : CompressedCensusRow) : Bool :=
  decide (allowedFourthMask S bound a b row.c &&&
    (rationalTimesMask bound row.times ||| listBits row.known) =
      allowedFourthMask S bound a b row.c) &&
    tripleTimesQuarterBool a b row.c row.times &&
    row.known.all (fun d => finiteKnownFamilyBool a b row.c d)

def compressedTableCheck (S bound a b : ℕ) (rows : List CompressedCensusRow) : Bool :=
  rows.all (compressedRowCheck S bound a b)

/-- Required third speeds are checked against the actual c-field of rows. -/
def tableCovers (listCs : List ℕ) (rows : List CompressedCensusRow) : Bool :=
  listCs.all fun c => rows.any fun row => row.c == c

theorem tableCovers_iff (listCs : List ℕ) (rows : List CompressedCensusRow) :
    tableCovers listCs rows = true ↔
      ∀ c ∈ listCs, ∃ row ∈ rows, row.c = c := by
  simp only [tableCovers, List.all_eq_true, List.any_eq_true, Nat.beq_eq_true_eq]

theorem tableCovers_map_membership {listCs : List ℕ}
    {rows : List CompressedCensusRow} (hcover : tableCovers listCs rows = true)
    {c : ℕ} (hc : c ∈ listCs) : c ∈ rows.map (fun row => row.c) := by
  obtain ⟨row, hrow, hrc⟩ := (tableCovers_iff listCs rows).mp hcover c hc
  exact List.mem_map.mpr ⟨row, hrow, hrc⟩

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- The fixed-triple Boolean check also supplies the older repeated-last
quartet check used by the established generic time/family consumer. -/
theorem rationalQuarterBool_of_tripleTimesQuarterBool
    {a b c : ℕ} {times : List (ℕ × ℕ)}
    (h : tripleTimesQuarterBool a b c times = true) :
    times.all (fun t => rationalQuarterBool a b c c t.1 t.2) = true := by
  have hall : ∀ t ∈ times, 0 < t.2 ∧ quarterResidue a t.1 t.2 ∧
      quarterResidue b t.1 t.2 ∧ quarterResidue c t.1 t.2 := by
    simpa only [tripleTimesQuarterBool, List.all_eq_true, decide_eq_true_eq] using h
  apply List.all_eq_true.mpr
  intro t ht
  obtain ⟨hn, ha, hb, hc⟩ := hall t ht
  have hh : 0 < t.2 ∧ ∀ v ∈ [a,b,c,c],
      t.2 ≤ 4 * min ((v*t.1)%t.2) (t.2-(v*t.1)%t.2) := by
    refine ⟨hn, ?_⟩
    intro v hv
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact ha
    · exact hb
    · exact hc
    · exact hc
  simpa only [rationalQuarterBool, Bool.and_eq_true, decide_eq_true_eq,
    List.all_eq_true] using hh

/-- A passing row supplies the exact original spectrum conclusion for an
admissible fourth speed in its actual interval. All original hypotheses
refer to the same quartet and the same row's third speed. -/
theorem compressedRowCheck_sound {S bound a b d : ℕ}
    {row : CompressedCensusRow}
    (hp : Positive (finiteQuartetSpeeds a b row.c d))
    (hc : (finiteQuartetSpeeds a b row.c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b row.c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b row.c d,
      ∀ v ∈ finiteQuartetSpeeds a b row.c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hab : a < b) (hbc : b < row.c) (hcd : row.c < d)
    (hsum : a+b+row.c+d ≤ S) (hdBound : d < bound)
    (hcheck : compressedRowCheck S bound a b row = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b row.c d) := by
  have hh :
      (allowedFourthMask S bound a b row.c &&&
        (rationalTimesMask bound row.times ||| listBits row.known) =
          allowedFourthMask S bound a b row.c) ∧
      tripleTimesQuarterBool a b row.c row.times = true ∧
      row.known.all (fun v => finiteKnownFamilyBool a b row.c v) = true := by
    simpa only [compressedRowCheck, Bool.and_eq_true, decide_eq_true_eq,
      and_assoc] using hcheck
  have hd := allowedFourthMask_of_admissible hab hbc hcd hsum hdBound hprim hpair
  exact compressed_quartet_certificate_sound hp hc hprim hpair hh.1 hd
    (rationalQuarterBool_of_tripleTimesQuarterBool hh.2.1) hh.2.2

/-- Actual membership in the table's c-projection locates a passing row;
this theorem does not assume a row exists for every natural third speed. -/
theorem source05_of_compressedTable {S bound a b c d : ℕ}
    {rows : List CompressedCensusRow}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ S) (hdBound : d < bound)
    (hcMem : c ∈ rows.map (fun row => row.c))
    (hcheck : compressedTableCheck S bound a b rows = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  obtain ⟨row, hrow, rfl⟩ := List.mem_map.mp hcMem
  have hrowCheck : compressedRowCheck S bound a b row = true :=
    List.all_eq_true.mp hcheck row hrow
  exact compressedRowCheck_sound hp hc hprim hpair hab hbc hcd hsum hdBound hrowCheck

/-- A separately checked coverage table transfers an actual required c
into the row projection, after which the same semantic consumer applies. -/
theorem source05_of_compressedTableCovers {S bound a b c d : ℕ}
    {listCs : List ℕ} {rows : List CompressedCensusRow}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ S) (hdBound : d < bound)
    (hcRequired : c ∈ listCs)
    (hcover : tableCovers listCs rows = true)
    (hcheck : compressedTableCheck S bound a b rows = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) :=
  source05_of_compressedTable hp hc hprim hpair hab hbc hcd hsum hdBound
    (tableCovers_map_membership hcover hcRequired) hcheck

/-- Sorted-positive convenience interface derives the literal quartet's
positivity and cardinality, without introducing any additional hypothesis. -/
theorem source05_of_compressedTableCovers_sorted {S bound a b c d : ℕ}
    {listCs : List ℕ} {rows : List CompressedCensusRow}
    (ha : 0 < a) (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ S) (hdBound : d < bound)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hcRequired : c ∈ listCs)
    (hcover : tableCovers listCs rows = true)
    (hcheck : compressedTableCheck S bound a b rows = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hp : Positive (finiteQuartetSpeeds a b c d) := by
    intro v hv
    simp only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl <;> omega
  exact source05_of_compressedTableCovers hp (finite_quartet_card hab hbc hcd)
    hprim hpair hab hbc hcd hsum hdBound hcRequired hcover hcheck









end Math15.LonelyRunner
end 
end 

/- Section: FiniteQuartetEnumeration -/
section



/-!
Transfer the sorted census theorem back to arbitrary four-element speed sets.
Sort V increasingly. Its four list entries are strictly increasing because
Finset.sort has no repeats. The list-to-finset identity gives the actual V,
and the finset sum is exactly a+b+c+d. Thus the census soundness theorem has
no residual representation or ordering assumption in this wrapper.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem positive_quartet_sorted_representation {V : Finset ℕ}
    (hp : Positive V) (hc : V.card = 4) :
    ∃ a b c d : ℕ, 0 < a ∧ a < b ∧ b < c ∧ c < d ∧
      V = finiteQuartetSpeeds a b c d ∧ V.sum id = a+b+c+d := by
  have hlen : V.sort.length = 4 := by simpa using hc
  obtain ⟨a,b,c,d,hlist⟩ := List.length_eq_four.mp hlen
  have hsort : (V.sort).Pairwise (· < ·) := (Finset.sortedLT_sort V).pairwise
  rw [hlist] at hsort
  have hab : a < b := (List.pairwise_cons.mp hsort).1 b (by simp)
  have htail := (List.pairwise_cons.mp hsort).2
  have hbc : b < c := (List.pairwise_cons.mp htail).1 c (by simp)
  have htail' := (List.pairwise_cons.mp htail).2
  have hcd : c < d := (List.pairwise_cons.mp htail').1 d (by simp)
  have hset := Finset.sort_toFinset V (· ≤ ·)
  rw [hlist] at hset
  have hV : V = finiteQuartetSpeeds a b c d := by
    simpa [finiteQuartetSpeeds] using hset.symm
  have ha : 0 < a := hp a (by rw [hV]; simp [finiteQuartetSpeeds])
  have hac : a < c := lt_trans hab hbc
  have had : a < d := lt_trans hac hcd
  have hbd : b < d := lt_trans hbc hcd
  refine ⟨a,b,c,d,ha,hab,hbc,hcd,hV,?_⟩
  simp [hV, finiteQuartetSpeeds, ne_of_lt hab, ne_of_lt hac, ne_of_lt had,
    ne_of_lt hbc, ne_of_lt hbd, ne_of_lt hcd, Nat.add_assoc]

/-- Original Source05 hypotheses plus a verified sum range suffice; the
formal conclusion has no extra sorted-representation hypothesis. -/
theorem source05_of_finiteResidueCensus_set {bound : ℕ} {V : Finset ℕ}
    (hp : Positive V) (hc : V.card = 4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (hsum : V.sum id ≤ bound)
    (hcensus : finiteResidueCensusBool bound = true) :
    FiniteSource05Conclusion V := by
  obtain ⟨a,b,c,d,ha,hab,hbc,hcd,hV,hS⟩ :=
    positive_quartet_sorted_representation hp hc
  have hsum' : a+b+c+d ≤ bound := by omega
  have hprim' : Primitive (finiteQuartetSpeeds a b c d) := by rwa [hV] at hprim
  have hpair' : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2 := by
    rwa [hV] at hpair
  rw [hV]
  exact source05_of_finiteResidueCensus ha hab hbc hcd hsum' hprim' hpair' hcensus


















end Math15.LonelyRunner
end 
end 

/- Section: SharedMaskCensus -/
section



/-!
Shared, kernel-checked rational masks and complete triple enumeration.

Unlike a per-row reconstruction of rationalSpeedMask and four range lists,
this certificate checks each global rational mask and each gcd mask once.
Every triple row uses only references to those checked masks, bit tests, bit
unions, and a closed-form interval mask. Prefix masks are likewise checked
once. The row table is a total function of the actual a,b,c; the checker
visits every required ordered triple itself, so missing externally supplied
rows cannot silently remove eligible quartets.

The certificate soundness is for ALL positive, primitive, distinct quartets
with the original pair-gcd bound and sum at most S. The fourth speed is
covered by a bit containment equation rather than an explicit d loop. No
closed full-sum444 certificate is asserted in this reusable source.
-/

namespace Math15.LonelyRunner

structure SharedQuarterMask where
  m : ℕ
  n : ℕ
  bits : ℕ

structure SharedMaskRow where
  indices : List ℕ
  known : List ℕ

def sharedQuarterPoolCheck (bound size : ℕ) (pool : ℕ → SharedQuarterMask) : Bool :=
  (List.range size).all fun i =>
    decide (0<(pool i).n ∧ (pool i).bits=rationalSpeedMask bound (pool i).m (pool i).n)

def sharedCompatibilityCheck (bound : ℕ) (compat : ℕ → ℕ) : Bool :=
  (List.range bound).all fun a => decide (compat a=compatibleSpeedMask bound a)

def sharedPrefixCheck (bound : ℕ) (prefixCache : ℕ → ℕ) : Bool :=
  (List.range (bound+1)).all fun i => decide (prefixCache i=2^i-1)

/-- A contiguous interval uses two already checked prefixCache masks. -/
def sharedIntervalBits (prefixCache : ℕ → ℕ) (lo hi : ℕ) : ℕ :=
  if lo≤hi then prefixCache hi ^^^ prefixCache lo else 0

def sharedAllowedFourthMask (S bound : ℕ) (compat prefixCache : ℕ → ℕ)
    (oddBits a b c : ℕ) : ℕ :=
  sharedIntervalBits prefixCache (c+1) (min bound (S-a-b-c+1)) &&&
    compat a &&& compat b &&& compat c &&&
    (if a%2=0 ∧ b%2=0 ∧ c%2=0 then oddBits else prefixCache bound)

def sharedSelectedMask (pool : ℕ → SharedQuarterMask) (indices : List ℕ) : ℕ :=
  maskUnion (indices.map fun i => (pool i).bits)

def sharedSelectedTripleCheck (size a b c : ℕ) (pool : ℕ → SharedQuarterMask)
    (indices : List ℕ) : Bool :=
  indices.all fun i => decide (i<size) &&
    Nat.testBit (pool i).bits a && Nat.testBit (pool i).bits b &&
    Nat.testBit (pool i).bits c

def sharedMaskRowCheck (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits a b c : ℕ) (row : SharedMaskRow) : Bool :=
  decide (sharedAllowedFourthMask S bound compat prefixCache oddBits a b c &&&
    (sharedSelectedMask pool row.indices ||| listBits row.known)=
      sharedAllowedFourthMask S bound compat prefixCache oddBits a b c) &&
    sharedSelectedTripleCheck size a b c pool row.indices &&
    row.known.all (fun d => finiteKnownFamilyBool a b c d)

/-- The original ranges are traversed independently of row-table content.
Each triple is either excluded by its checked pair masks or checked. -/
def sharedMaskCensusCheck (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow) : Bool :=
  (List.range' 1 ((S-6)/4)).all fun a =>
    (List.range' (a+1) (((S-a-3)/3+1)-(a+1))).all fun b =>
      (List.range' (b+1) (((S-a-b-1)/2+1)-(b+1))).all fun c =>
        if Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
          Nat.testBit (compat b) c then
          sharedMaskRowCheck S bound size pool compat prefixCache oddBits a b c (rows a b c)
        else true

def sharedFullCensusCheck (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow) : Bool :=
  sharedQuarterPoolCheck bound size pool && sharedCompatibilityCheck bound compat &&
    sharedPrefixCheck bound prefixCache && decide (oddBits=oddSpeedMask bound) &&
    sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows

theorem sharedQuarterPoolCheck_sound {bound size : ℕ} {pool : ℕ → SharedQuarterMask}
    (h : sharedQuarterPoolCheck bound size pool=true) {i : ℕ} (hi : i<size) :
    0<(pool i).n ∧ (pool i).bits=rationalSpeedMask bound (pool i).m (pool i).n := by
  have hh := List.all_eq_true.mp h i (List.mem_range.mpr hi)
  exact decide_eq_true_eq.mp hh

theorem sharedCompatibilityCheck_sound {bound : ℕ} {compat : ℕ → ℕ}
    (h : sharedCompatibilityCheck bound compat=true) {a : ℕ} (ha : a<bound) :
    compat a=compatibleSpeedMask bound a := by
  have hh := List.all_eq_true.mp h a (List.mem_range.mpr ha)
  exact decide_eq_true_eq.mp hh

theorem sharedPrefixCheck_sound {bound : ℕ} {prefixCache : ℕ → ℕ}
    (h : sharedPrefixCheck bound prefixCache=true) {i : ℕ} (hi : i≤bound) :
    prefixCache i=2^i-1 := by
  have hh := List.all_eq_true.mp h i (List.mem_range.mpr (by omega))
  exact decide_eq_true_eq.mp hh

/-- Literal bit semantics of the fast interval formula, including an
empty interval and every endpoint. -/
theorem sharedIntervalBits_testBit_iff {bound lo hi d : ℕ} {prefixCache : ℕ → ℕ}
    (hp : sharedPrefixCheck bound prefixCache=true) (hlo : lo≤bound) (hhi : hi≤bound) :
    Nat.testBit (sharedIntervalBits prefixCache lo hi) d=true ↔ lo≤d ∧ d<hi := by
  by_cases horder : lo≤hi
  · rw [sharedIntervalBits,if_pos horder,
      sharedPrefixCheck_sound hp hhi,sharedPrefixCheck_sound hp hlo,
      Nat.testBit_xor,Nat.testBit_two_pow_sub_one,Nat.testBit_two_pow_sub_one]
    by_cases hdhi : d<hi <;> by_cases hdlo : d<lo
    all_goals simp [hdhi,hdlo]
    all_goals omega
  · have hnot : ¬(lo≤d ∧ d<hi) := by
      intro ⟨hld,hdh⟩
      omega
    simp [sharedIntervalBits,horder,hnot]

/-- Every original eligible fourth speed is retained by the cached masks.
The support is derived from the actual quartet's hypotheses. -/
theorem sharedAllowedFourthMask_of_admissible
    {S bound a b c d oddBits : ℕ} {compat prefixCache : ℕ → ℕ}
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (hab : a<b) (hbc : b<c) (hcd : c<d) (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hprim : Primitive ({a,b,c,d} : Finset ℕ))
    (hpair : ∀ u ∈ ({a,b,c,d} : Finset ℕ), ∀ v ∈ ({a,b,c,d} : Finset ℕ),
      u≠v → Nat.gcd u v≤2) :
    Nat.testBit (sharedAllowedFourthMask S bound compat prefixCache oddBits a b c) d=true := by
  have had : a<d := lt_trans hab (lt_trans hbc hcd)
  have hbd : b<d := lt_trans hbc hcd
  have hi : Nat.testBit
      (sharedIntervalBits prefixCache (c+1) (min bound (S-a-b-c+1))) d=true := by
    apply (sharedIntervalBits_testBit_iff hpref (by omega) (min_le_left _ _)).mpr
    refine ⟨by omega,lt_min hdBound (by omega)⟩
  have ha : Nat.testBit (compat a) d=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : a<bound)]
    exact (compatibleSpeedMask_testBit_iff bound a d).mpr
      ⟨hdBound,hpair a (by simp) d (by simp) (ne_of_lt had)⟩
  have hb : Nat.testBit (compat b) d=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : b<bound)]
    exact (compatibleSpeedMask_testBit_iff bound b d).mpr
      ⟨hdBound,hpair b (by simp) d (by simp) (ne_of_lt hbd)⟩
  have hc : Nat.testBit (compat c) d=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : c<bound)]
    exact (compatibleSpeedMask_testBit_iff bound c d).mpr
      ⟨hdBound,hpair c (by simp) d (by simp) (ne_of_lt hcd)⟩
  by_cases heven : a%2=0 ∧ b%2=0 ∧ c%2=0
  · have hdodd := primitive_quartet_fourth_odd hprim heven.1 heven.2.1 heven.2.2
    have ho : Nat.testBit oddBits d=true := by
      rw [hodd]
      exact (oddSpeedMask_testBit_iff bound d).mpr ⟨hdBound,hdodd⟩
    simp only [sharedAllowedFourthMask,if_pos heven,Nat.testBit_and,Bool.and_eq_true]
    exact ⟨⟨⟨⟨hi,ha⟩,hb⟩,hc⟩,ho⟩
  · have hr : Nat.testBit (prefixCache bound) d=true := by
      rw [sharedPrefixCheck_sound hpref le_rfl,Nat.testBit_two_pow_sub_one]
      exact decide_eq_true_eq.mpr hdBound
    simp only [sharedAllowedFourthMask,if_neg heven,Nat.testBit_and,Bool.and_eq_true]
    exact ⟨⟨⟨⟨hi,ha⟩,hb⟩,hc⟩,hr⟩

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

theorem sharedMaskRowCheck_sound
    {S bound size a b c d oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {row : SharedMaskRow}
    (hpool : sharedQuarterPoolCheck bound size pool=true)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u≠v → Nat.gcd u v≤2)
    (hab : a<b) (hbc : b<c) (hcd : c<d) (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hrow : sharedMaskRowCheck S bound size pool compat prefixCache oddBits a b c row=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh :
      (sharedAllowedFourthMask S bound compat prefixCache oddBits a b c &&&
        (sharedSelectedMask pool row.indices ||| listBits row.known)=
        sharedAllowedFourthMask S bound compat prefixCache oddBits a b c) ∧
      sharedSelectedTripleCheck size a b c pool row.indices=true ∧
      row.known.all (fun v => finiteKnownFamilyBool a b c v)=true := by
    simpa only [sharedMaskRowCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hrow
  have hd := sharedAllowedFourthMask_of_admissible hcomp hpref hodd
    hab hbc hcd hsum hdBound hprim hpair
  have hbit := (mask_coverage_iff _ _).mp hh.1 d hd
  rcases (mask_union_testBit_iff _ _ d).mp hbit with htime | hknown
  · obtain ⟨i,hi,hid⟩ :=
      (maskUnion_map_testBit_iff (fun i => (pool i).bits) row.indices d).mp htime
    have htr : i<size ∧ Nat.testBit (pool i).bits a=true ∧
        Nat.testBit (pool i).bits b=true ∧ Nat.testBit (pool i).bits c=true := by
      simpa only [sharedSelectedTripleCheck,List.all_eq_true,Bool.and_eq_true,
        decide_eq_true_eq,and_assoc] using List.all_eq_true.mp hh.2.1 i hi
    obtain ⟨hn,hmask⟩ := sharedQuarterPoolCheck_sound hpool htr.1
    have haq := ((rationalSpeedMask_testBit_iff bound (pool i).m (pool i).n a).mp
      (by rw [←hmask]; exact htr.2.1)).2
    have hbq := ((rationalSpeedMask_testBit_iff bound (pool i).m (pool i).n b).mp
      (by rw [←hmask]; exact htr.2.2.1)).2
    have hcq := ((rationalSpeedMask_testBit_iff bound (pool i).m (pool i).n c).mp
      (by rw [←hmask]; exact htr.2.2.2)).2
    have hdq := ((rationalSpeedMask_testBit_iff bound (pool i).m (pool i).n d).mp
      (by rw [←hmask]; exact hid)).2
    apply Or.inl
    apply ML_lower_of_witness ⟨a,by simp [finiteQuartetSpeeds]⟩
      ((((pool i).m : ℝ)/((pool i).n : ℝ)) : Time)
    intro v hv
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_quarterResidue hn haq
    · exact distance_ge_quarter_of_quarterResidue hn hbq
    · exact distance_ge_quarter_of_quarterResidue hn hcq
    · exact distance_ge_quarter_of_quarterResidue hn hdq
  · have hmem := (listBits_testBit_iff row.known d).mp hknown
    exact finiteKnownFamilyBool_sound hp hc hprim hpair (List.all_eq_true.mp hh.2.2 d hmem)

/-- Coverage of the full original triple ranges follows from the quartet,
independently of how many rows the generated table stores. -/
theorem sharedMaskCensusCheck_row
    {S bound size a b c d oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow}
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d)
    (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u≠v → Nat.gcd u v≤2)
    (hcheck : sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows=true) :
    sharedMaskRowCheck S bound size pool compat prefixCache oddBits a b c (rows a b c)=true := by
  have haBound : 4*a+6≤S := by omega
  have hbBound : a+3*b+3≤S := by omega
  have hcBound : a+b+2*c+1≤S := by omega
  have haMem : a∈List.range' 1 ((S-6)/4) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hbMem : b∈List.range' (a+1) (((S-a-3)/3+1)-(a+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hcMem : c∈List.range' (b+1) (((S-a-b-1)/2+1)-(b+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have habbit : Nat.testBit (compat a) b=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : a<bound)]
    exact (compatibleSpeedMask_testBit_iff bound a b).mpr
      ⟨by omega,hpair a (by simp [finiteQuartetSpeeds]) b
        (by simp [finiteQuartetSpeeds]) (ne_of_lt hab)⟩
  have hacbit : Nat.testBit (compat a) c=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : a<bound)]
    exact (compatibleSpeedMask_testBit_iff bound a c).mpr
      ⟨by omega,hpair a (by simp [finiteQuartetSpeeds]) c
        (by simp [finiteQuartetSpeeds]) (ne_of_lt (lt_trans hab hbc))⟩
  have hbcbit : Nat.testBit (compat b) c=true := by
    rw [sharedCompatibilityCheck_sound hcomp (by omega : b<bound)]
    exact (compatibleSpeedMask_testBit_iff bound b c).mpr
      ⟨by omega,hpair b (by simp [finiteQuartetSpeeds]) c
        (by simp [finiteQuartetSpeeds]) (ne_of_lt hbc)⟩
  unfold sharedMaskCensusCheck at hcheck
  have houter := List.all_eq_true.mp hcheck a haMem
  have hmiddle := List.all_eq_true.mp houter b hbMem
  have hinner := List.all_eq_true.mp hmiddle c hcMem
  simpa [habbit,hacbit,hbcbit] using hinner

/-- All admissible sorted quartets in the sum range, not merely tuples
present in an externally supplied list, follow from the closed checker. -/
theorem source05_of_sharedFullCensus
    {S bound size a b c d oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow}
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d)
    (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u≠v → Nat.gcd u v≤2)
    (hfull : sharedFullCensusCheck S bound size pool compat prefixCache oddBits rows=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : sharedQuarterPoolCheck bound size pool=true ∧
      sharedCompatibilityCheck bound compat=true ∧ sharedPrefixCheck bound prefixCache=true ∧
      oddBits=oddSpeedMask bound ∧
      sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows=true := by
    simpa only [sharedFullCensusCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hfull
  have hp : Positive (finiteQuartetSpeeds a b c d) := by
    intro v hv
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl <;> omega
  have hrow := sharedMaskCensusCheck_row hh.2.1 ha hab hbc hcd hsum hdBound hpair hh.2.2.2.2
  exact sharedMaskRowCheck_sound hh.1 hh.2.1 hh.2.2.1 hh.2.2.2.1 hp
    (finite_quartet_card hab hbc hcd) hprim hpair hab hbc hcd hsum hdBound hrow

/-- Arbitrary actual four-speed sets inherit complete coverage. Taking
the speed-mask bound S+1 discharges the fourth-speed range automatically. -/
theorem source05_of_sharedFullCensus_set
    {S size oddBits : ℕ} {pool : ℕ → SharedQuarterMask} {compat prefixCache : ℕ → ℕ}
    {rows : ℕ → ℕ → ℕ → SharedMaskRow} {V : Finset ℕ}
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hfull : sharedFullCensusCheck S (S+1) size pool compat prefixCache oddBits rows=true) :
    FiniteSource05Conclusion V := by
  obtain ⟨a,b,c,d,ha,hab,hbc,hcd,hV,hS⟩ := positive_quartet_sorted_representation hp hc
  have hsum' : a+b+c+d≤S := by omega
  have hprim' : Primitive (finiteQuartetSpeeds a b c d) := by rwa [hV] at hprim
  have hpair' : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2 := by rwa [hV] at hpair
  rw [hV]
  exact source05_of_sharedFullCensus ha hab hbc hcd hsum' (by omega)
    hprim' hpair' hfull











end Math15.LonelyRunner
end 
