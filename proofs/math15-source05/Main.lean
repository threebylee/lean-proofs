  change (@decide (ThreeSmallNumericalRow 10) (threeSmallNumericalRowDecidable 10))=true
  decide +kernel

theorem three_small_numerical_certificate :
    ∀ a b c : Fin 11, 0<a.val → a.val<b.val → b.val<c.val →
      Nat.gcd a.val b.val≤2 → Nat.gcd a.val c.val≤2 → Nat.gcd b.val c.val≤2 →
      Nat.gcd a.val (Nat.gcd b.val c.val)=1 →
      (a.val=1 ∧ b.val=2 ∧ c.val=3) ∨
        ∃ m n : Fin 21, ThreeNumeratorGood a.val b.val c.val m.val n.val := by
  intro a
  fin_cases a
  · exact three_small_numerical_row_0
  · exact three_small_numerical_row_1
  · exact three_small_numerical_row_2
  · exact three_small_numerical_row_3
  · exact three_small_numerical_row_4
  · exact three_small_numerical_row_5
  · exact three_small_numerical_row_6
  · exact three_small_numerical_row_7
  · exact three_small_numerical_row_8
  · exact three_small_numerical_row_9
  · exact three_small_numerical_row_10

theorem three_numerical_certificate_lower {a b c m n : ℕ}
    (hgood : ThreeNumeratorGood a b c m n) :
    (2/7 : ℝ)≤ML ({a,b,c} : Finset ℕ) := by
  rcases hgood with ⟨hn,ha,hb,hc⟩
  have hnR : (0 : ℝ)<n := by exact_mod_cast hn
  have hnum (v : ℕ) (hv : v∈({a,b,c} : Finset ℕ)) :
      2*n≤7*min ((v*m)%n) (n-(v*m)%n) := by
    simp only [Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with h | h | h
    · simpa only [h] using ha
    · simpa only [h] using hb
    · simpa only [h] using hc
  apply ML_lower_of_witness (by simp) ((((m : ℝ)/(n : ℝ)) : ℝ) : Time)
  intro v hv
  rw [distance_at_rational]
  apply (le_div_iff₀ hnR).mpr
  have h := hnum v hv
  have hr : (2 : ℝ)*(n : ℝ)≤
      7*((min ((v*m)%n) (n-(v*m)%n) : ℕ) : ℝ) := by exact_mod_cast h
  linarith

theorem sorted_primitive_three_isolation_le_ten {a b c : ℕ}
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hc : c≤10)
    (hp : Primitive ({a,b,c} : Finset ℕ))
    (habg : Nat.gcd a b≤2) (hacg : Nat.gcd a c≤2) (hbcg : Nat.gcd b c≤2)
    (hlow : ML ({a,b,c} : Finset ℕ)<(2/7 : ℝ)) : a=1 ∧ b=2 ∧ c=3 := by
  have ha11 : a<11 := by omega
  have hb11 : b<11 := by omega
  have hc11 : c<11 := by omega
  have hp' : Nat.gcd a (Nat.gcd b c)=1 := by simpa [Primitive] using hp
  have hcert := three_small_numerical_certificate
    ⟨a,ha11⟩ ⟨b,hb11⟩ ⟨c,hc11⟩ ha hab hbc habg hacg hbcg hp'
  rcases hcert with hgood | ⟨m,n,hgood⟩
  · exact hgood
  · have hL := three_numerical_certificate_lower hgood
    linarith


















end Math15.LonelyRunner
end 

/- Section: ThreeRunnerPairGrid -/
section



/-!
Actual coprime-pair grid transfer and the primitive three-runner isolation
assembly. A low primitive triple always has a coprime pair involving its
largest speed. Thus the gcd-two grid case is unnecessary for this theorem.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem integer_third_band_hit_full {n r j : ℤ}
    (hr : 1≤r) (hthird : 3*r≤n) (hj : 0<j) (hjn : j<n) :
    ∃ ell : ℤ, r≤ell ∧ ell≤n-r ∧ r≤(ell*j)%n ∧ (ell*j)%n≤n-r := by
  by_cases hhalf : 2*j≤n
  · exact integer_third_band_hit hr hthird (by omega) hhalf
  · obtain ⟨ell,hl,hu,hpl,hpu⟩ := integer_third_band_hit
      hr hthird (j := n-j) (by omega) (by omega)
    have he : ((n-ell)*j)%n=(ell*(n-j))%n := by
      have hid : (n-ell)*j=ell*(n-j)+n*(j-ell) := by ring
      rw [hid,Int.add_mul_emod_self_left]
    refine ⟨n-ell,by omega,by omega,?_,?_⟩ <;> rw [he]
    · exact hpl
    · exact hpu

theorem nat_third_band_hit {n r j : ℕ} (hr : 1≤r)
    (hthird : 3*r≤n) (hj : 0<j) (hjn : j<n) :
    ∃ ell : ℕ, r≤ell ∧ ell≤n-r ∧ r≤(ell*j)%n ∧ (ell*j)%n≤n-r := by
  have hrI : (1 : ℤ)≤r := by exact_mod_cast hr
  have htI : (3 : ℤ)*(r : ℤ)≤n := by exact_mod_cast hthird
  have hjI : (0 : ℤ)<j := by exact_mod_cast hj
  have hjnI : (j : ℤ)<n := by exact_mod_cast hjn
  obtain ⟨ell,hl,hu,hpl,hpu⟩ := integer_third_band_hit_full hrI htI hjI hjnI
  have hell0 : 0≤ell := by omega
  have hell : (ell.toNat : ℤ)=ell := Int.toNat_of_nonneg hell0
  have hrem : (((ell.toNat*j)%n : ℕ) : ℤ)=(ell*(j : ℤ))%(n : ℤ) := by
    rw [Int.natCast_mod,Int.natCast_mul,hell]
  have hnr : (((n-r : ℕ) : ℤ))=(n : ℤ)-(r : ℤ) := by
    exact_mod_cast Nat.cast_sub (show r≤n by omega)
  refine ⟨ell.toNat,?_,?_,?_,?_⟩
  · exact_mod_cast (show (r : ℤ)≤(ell.toNat : ℤ) by rwa [hell])
  · exact_mod_cast (show (ell.toNat : ℤ)≤((n-r : ℕ) : ℤ) by rwa [hell,hnr])
  · rw [←hrem] at hpl
    exact_mod_cast hpl
  · rw [←hrem,←hnr] at hpu
    exact_mod_cast hpu

theorem pair_sum_grid_distances_eq (a b m : ℕ) (hn : 0<a+b) :
    distance (b • ((((m : ℝ)/((a+b : ℕ) : ℝ)) : ℝ) : Time)) =
      distance (a • ((((m : ℝ)/((a+b : ℕ) : ℝ)) : ℝ) : Time)) := by
  have hnR : (0 : ℝ)<((a+b : ℕ) : ℝ) := by exact_mod_cast hn
  let t : Time := ((((m : ℝ)/((a+b : ℕ) : ℝ)) : ℝ) : Time)
  have hz : (a+b) • t=0 := by
    dsimp [t]
    rw [nsmul_rational_time_nat]
    have he : ((((a+b)*m : ℕ) : ℝ)/((a+b : ℕ) : ℝ))=(m : ℝ) := by
      rw [Nat.cast_mul]
      exact mul_div_cancel_left₀ (m : ℝ) (ne_of_gt hnR)
    rw [he]
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
    exact ⟨m,by simp [zsmul_eq_mul]⟩
  have hbneg : b • t=-(a • t) :=
    eq_neg_of_add_eq_zero_right (by rw [←add_nsmul]; exact hz)
  change distance (b • t)=distance (a • t)
  simp only [hbneg,distance,norm_neg]

/-- The exact pair-grid lower witness for any coprime positive pair.
The third speed is constrained only by not vanishing on the entire grid. -/
theorem coprime_three_pair_grid_witness (a b c : ℕ) (ha : 0<a) (hb : 0<b)
    (hcop : Nat.Coprime a b) (hcnot : ¬(a+b)∣c) :
    ∃ m : ℕ, ∀ v∈({a,b,c} : Finset ℕ),
      ((((a+b)/3 : ℕ) : ℝ)/((a+b : ℕ) : ℝ))≤
        distance (v • ((((m : ℝ)/((a+b : ℕ) : ℝ)) : ℝ) : Time)) := by
  let n : ℕ := a+b
  let r : ℕ := n/3
  have hn : 0<n := by dsimp [n]; omega
  have hnR : (0 : ℝ)<n := by exact_mod_cast hn
  by_cases hrzero : r=0
  · refine ⟨0,?_⟩
    intro v hv
    change (r : ℝ)/(n : ℝ)≤distance (v • ((((0 : ℕ) : ℝ)/(n : ℝ)) : Time))
    simp [hrzero,distance]
  have hr : 1≤r := by omega
  have hthird : 3*r≤n := by dsimp [r]; omega
  have hnthree : 3≤n := by dsimp [r] at hr; omega
  have hcopn : Nat.Coprime a n := by
    change Nat.Coprime a (a+b)
    exact Nat.coprime_self_add_right.mpr hcop
  obtain ⟨u,huN,hu⟩ := Nat.exists_mul_mod_eq_of_coprime 1 hcopn (ne_of_gt hn)
  rw [Nat.mod_eq_of_lt (by omega : 1<n)] at hu
  let j : ℕ := (u*c)%n
  have hcmod : c%n≠0 := by
    intro hz
    exact hcnot (Nat.dvd_of_mod_eq_zero hz)
  have hjzero : j≠0 := by
    intro hj
    have h0 : (a*(u*c))%n=0 := by
      rw [Nat.mul_mod]
      change ((a%n)*j)%n=0
      rw [hj,mul_zero,Nat.zero_mod]
    have he : (a*(u*c))%n=c%n := by
      rw [←Nat.mul_assoc,Nat.mul_mod,hu,one_mul,Nat.mod_mod]
    exact hcmod (he.symm.trans h0)
  have hj : 0<j := Nat.pos_of_ne_zero hjzero
  have hjN : j<n := Nat.mod_lt _ hn
  obtain ⟨ell,helL,helU,hcL,hcU⟩ := nat_third_band_hit hr hthird hj hjN
  have hellN : ell<n := by omega
  let m : ℕ := ell*u
  have hA : (a*m)%n=ell := by
    dsimp [m]
    rw [show a*(ell*u)=(a*u)*ell by ring,Nat.mul_mod,hu,one_mul,Nat.mod_mod]
    exact Nat.mod_eq_of_lt hellN
  have hC : (c*m)%n=(ell*j)%n := by
    calc
      _=(ell*(u*c))%n := by dsimp [m]; congr 1; ring
      _=((ell%n)*((u*c)%n))%n := Nat.mul_mod _ _ _
      _=((ell%n)*(j%n))%n := by dsimp [j]; rw [Nat.mod_mod]
      _=(ell*j)%n := (Nat.mul_mod _ _ _).symm
  let t : Time := ((((m : ℝ)/(n : ℝ)) : ℝ) : Time)
  have haL : (r : ℝ)/(n : ℝ)≤distance (a • t) := by
    dsimp [t]
    rw [distance_at_rational,hA]
    apply (div_le_div_iff_of_pos_right hnR).mpr
    exact_mod_cast (show r≤min ell (n-ell) by omega)
  have hbL : (r : ℝ)/(n : ℝ)≤distance (b • t) := by
    have he := pair_sum_grid_distances_eq a b m (by dsimp [n] at hn; exact hn)
    change distance (b • t)=distance (a • t) at he
    rw [he]
    exact haL
  have hcL' : (r : ℝ)/(n : ℝ)≤distance (c • t) := by
    dsimp [t]
    rw [distance_at_rational,hC]
    apply (div_le_div_iff_of_pos_right hnR).mpr
    exact_mod_cast (show r≤min ((ell*j)%n) (n-(ell*j)%n) by omega)
  refine ⟨m,?_⟩
  intro v hv
  change (r : ℝ)/(n : ℝ)≤distance (v • t)
  simp only [Finset.mem_insert,Finset.mem_singleton] at hv
  rcases hv with h | h | h
  · simpa only [h] using haL
  · simpa only [h] using hbL
  · simpa only [h] using hcL'

theorem coprime_three_pair_grid_lower (a b c : ℕ) (ha : 0<a) (hb : 0<b)
    (hcop : Nat.Coprime a b) (hcnot : ¬(a+b)∣c) :
    ((((a+b)/3 : ℕ) : ℝ)/((a+b : ℕ) : ℝ))≤ML ({a,b,c} : Finset ℕ) := by
  obtain ⟨m,hm⟩ := coprime_three_pair_grid_witness a b c ha hb hcop hcnot
  exact ML_lower_of_witness (by simp) (((((m : ℝ)/((a+b : ℕ) : ℝ)) : ℝ) : Time)) hm

/-- A primitive triple with pair gcd at most two has a coprime pair
involving its largest speed. Otherwise two would divide all three speeds. -/
theorem primitive_three_coprime_largest {a b c : ℕ} (ha : 0<a) (hb : 0<b)
    (hp : Primitive ({a,b,c} : Finset ℕ))
    (hacg : Nat.gcd a c≤2) (hbcg : Nat.gcd b c≤2) :
    Nat.Coprime a c ∨ Nat.Coprime b c := by
  by_cases hac : Nat.gcd a c=1
  · exact Or.inl hac
  by_cases hbc : Nat.gcd b c=1
  · exact Or.inr hbc
  have hacpos := Nat.gcd_pos_of_pos_left c ha
  have hbcpos := Nat.gcd_pos_of_pos_left c hb
  have hac2 : Nat.gcd a c=2 := by omega
  have hbc2 : Nat.gcd b c=2 := by omega
  have h2a : 2∣a := by simpa only [hac2] using Nat.gcd_dvd_left a c
  have hp' : Nat.gcd a (Nat.gcd b c)=1 := by simpa [Primitive] using hp
  have hd : 2∣Nat.gcd a (Nat.gcd b c) := Nat.dvd_gcd h2a (by rw [hbc2])
  rw [hp'] at hd
  norm_num at hd

theorem sorted_primitive_three_low_largest_le_ten {a b c : ℕ}
    (ha : 0<a) (hab : a<b) (hbc : b<c)
    (hp : Primitive ({a,b,c} : Finset ℕ))
    (hlow : ML ({a,b,c} : Finset ℕ)<(2/7 : ℝ)) : c≤10 := by
  have hb : 0<b := by omega
  have hc : 0<c := by omega
  obtain ⟨habg,hacg,hbcg⟩ := primitive_three_low_pair_gcd a b c ha hb hc hp hlow
  have heac : ({a,c,b} : Finset ℕ)={a,b,c} := by
    ext x
    simp only [Finset.mem_insert,Finset.mem_singleton]
    tauto
  have hebc : ({b,c,a} : Finset ℕ)={a,b,c} := by
    ext x
    simp only [Finset.mem_insert,Finset.mem_singleton]
    tauto
  rcases primitive_three_coprime_largest ha hb hp hacg hbcg with hac | hbc'
  · have hnot : ¬(a+c)∣b := by
      intro hd
      have := Nat.le_of_dvd hb hd
      omega
    have hL := coprime_three_pair_grid_lower a c b ha hc hac hnot
    rw [heac] at hL
    have hs := third_grid_small_denominators (n := a+c) (by omega)
      (hL.trans_lt hlow)
    omega
  · have hnot : ¬(b+c)∣a := by
      intro hd
      have := Nat.le_of_dvd ha hd
      omega
    have hL := coprime_three_pair_grid_lower b c a hb hc hbc' hnot
    rw [hebc] at hL
    have hs := third_grid_small_denominators (n := b+c) (by omega)
      (hL.trans_lt hlow)
    omega

theorem sorted_primitive_three_isolation {a b c : ℕ}
    (ha : 0<a) (hab : a<b) (hbc : b<c)
    (hp : Primitive ({a,b,c} : Finset ℕ))
    (hlow : ML ({a,b,c} : Finset ℕ)<(2/7 : ℝ)) : a=1 ∧ b=2 ∧ c=3 := by
  have hb : 0<b := by omega
  have hc : 0<c := by omega
  obtain ⟨habg,hacg,hbcg⟩ := primitive_three_low_pair_gcd a b c ha hb hc hp hlow
  exact sorted_primitive_three_isolation_le_ten ha hab hbc
    (sorted_primitive_three_low_largest_le_ten ha hab hbc hp hlow)
    hp habg hacg hbcg hlow










end Math15.LonelyRunner
end 
end 

/- Section: ThreeRunnerIsolationAssembly -/
section


/-!
Exact, unrestricted scaling assembly of three-runner isolation.

Positive V, card V = 3, and ML V < 2/7 imply V = {a,2a,3a} for one positive
natural a.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem card_three_sorted {V : Finset ℕ} (hcard : V.card=3) :
    ∃ a b c : ℕ, a<b ∧ b<c ∧ V={a,b,c} := by
  obtain ⟨x,y,z,hxy,hxz,hyz,hV⟩ := Finset.card_eq_three.mp hcard
  by_cases hxy' : x<y
  · by_cases hyz' : y<z
    · exact ⟨x,y,z,hxy',hyz',hV⟩
    · by_cases hxz' : x<z
      · refine ⟨x,z,y,hxz',by omega,?_⟩
        rw [hV]
        ext w
        simp only [Finset.mem_insert,Finset.mem_singleton]
        tauto
      · refine ⟨z,x,y,by omega,hxy',?_⟩
        rw [hV]
        ext w
        simp only [Finset.mem_insert,Finset.mem_singleton]
        tauto
  · by_cases hxz' : x<z
    · refine ⟨y,x,z,by omega,hxz',?_⟩
      rw [hV]
      ext w
      simp only [Finset.mem_insert,Finset.mem_singleton]
      tauto
    · by_cases hyz' : y<z
      · refine ⟨y,z,x,hyz',by omega,?_⟩
        rw [hV]
        ext w
        simp only [Finset.mem_insert,Finset.mem_singleton]
        tauto
      · refine ⟨z,y,x,by omega,by omega,?_⟩
        rw [hV]
        ext w
        simp only [Finset.mem_insert,Finset.mem_singleton]
        tauto

theorem primitive_three_isolation {V : Finset ℕ} (hp : Positive V)
    (hcard : V.card=3) (hprim : Primitive V) (hlow : ML V<(2/7 : ℝ)) :
    V=({1,2,3} : Finset ℕ) := by
  obtain ⟨a,b,c,hab,hbc,he⟩ := card_three_sorted hcard
  have ha : 0<a := hp a (by rw [he]; simp)
  rw [he] at hprim hlow
  obtain ⟨ha1,hb2,hc3⟩ := sorted_primitive_three_isolation ha hab hbc hprim hlow
  rw [he,ha1,hb2,hc3]

/-- Exact three-speed isolation, without a primitive or pairwise gcd
premise. The single scale factor is the actual gcd of the original set. -/
theorem three_speed_isolation {V : Finset ℕ} (hp : Positive V)
    (hcard : V.card=3) (hlow : ML V<(2/7 : ℝ)) :
    ∃ a : ℕ, 0<a ∧ V=({a,2*a,3*a} : Finset ℕ) := by
  have hV : V.Nonempty := Finset.card_pos.mp (by omega)
  have hN : normalizedSpeeds V=({1,2,3} : Finset ℕ) := by
    apply primitive_three_isolation (normalizedSpeeds_positive hV hp)
      (by rw [normalizedSpeeds_card,hcard]) (normalizedSpeeds_primitive hV hp)
    rwa [normalizedSpeeds_ML hV hp]
  refine ⟨V.gcd id,speed_gcd_pos hV hp,?_⟩
  have hs := normalizedSpeeds_scale (V := V)
  rw [hN] at hs
  simpa only [Finset.image_insert,Finset.image_singleton,Nat.mul_one,
    Nat.mul_comm (V.gcd id) 2,Nat.mul_comm (V.gcd id) 3] using hs.symm





end Math15.LonelyRunner
end 
end 

/- Section: TorusLineIsolation -/
section



/-!
The literal common-witness consumer of three-speed isolation for integer torus
generators. The line y=0 is one actual line in the same torus. Integer
coordinate signs preserve distances. Repeated absolute speeds are coalesced by
one Finset image, so its cardinality is the actual number of distinct absolute
speeds, not the number of coordinates.

The generic line transfer allows zero coefficients. The collision-to-tight
theorem explicitly requires every coefficient on the selected line to be
nonzero; a zero coefficient makes that line's maximum zero, and cannot be
discarded. This section does not claim a universal rank-two torus
classification.
-/

noncomputable section
namespace Math15.LonelyRunner

def torusLineSpeeds (u : Fin 4 → ℤ) : Finset ℕ :=
  Finset.univ.image (fun i => (u i).natAbs)

theorem distance_integer_natAbs (z : ℤ) (x : ℝ) :
    distance ((((z : ℝ)*x : ℝ)) : Time)=
      distance (((((z.natAbs : ℕ) : ℝ)*x : ℝ)) : Time) := by
  have he : ((z.natAbs : ℕ) : ℝ)=|(z : ℝ)| := by
    have h := congrArg (fun q : ℤ => (q : ℝ)) (Int.natCast_natAbs z)
    simpa only [Int.cast_natCast,Int.cast_abs] using h
  rw [he]
  by_cases hz : 0≤(z : ℝ)
  · rw [abs_of_nonneg hz]
  · rw [abs_of_neg (lt_of_not_ge hz),neg_mul,AddCircle.coe_neg]
    simp only [distance,norm_neg]

theorem torusLineSpeeds_nonempty (u : Fin 4 → ℤ) : (torusLineSpeeds u).Nonempty := by
  exact ⟨(u 0).natAbs,Finset.mem_image.mpr ⟨0,by simp,rfl⟩⟩

theorem torusLineSpeeds_positive (u : Fin 4 → ℤ) (hun : ∀ i, u i≠0) :
    Positive (torusLineSpeeds u) := by
  intro a ha
  obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp ha
  exact Nat.pos_of_ne_zero (Int.natAbs_ne_zero.mpr (hun i))

/-- A maximum on the absolute-speed line gives one common parameter
pair (x,0) satisfying all four signed torus coordinates. -/
theorem torus_good_of_line_ML {u v : Fin 4 → ℤ} {L : ℝ}
    (hL : L≤ML (torusLineSpeeds u)) : TorusGood u v L := by
  obtain ⟨t,ht⟩ := ML_attained (torusLineSpeeds u)
  obtain ⟨x⟩ := t
  change score (torusLineSpeeds u) (x : Time)=ML (torusLineSpeeds u) at ht
  refine ⟨x,0,?_⟩
  intro i
  have hi : (u i).natAbs∈torusLineSpeeds u := Finset.mem_image.mpr ⟨i,by simp,rfl⟩
  have hs := score_le_distance hi (x : Time)
  rw [ht] at hs
  have h := hL.trans hs
  rw [mul_zero,add_zero,distance_integer_natAbs]
  simpa only [←AddCircle.coe_nsmul,nsmul_eq_mul] using h

theorem torus_good_line_iff_ML {u : Fin 4 → ℤ} {L : ℝ} :
    TorusGood u (0 : Fin 4 → ℤ) L ↔ L≤ML (torusLineSpeeds u) := by
  constructor
  · rintro ⟨x,y,hxy⟩
    apply ML_lower_of_witness (torusLineSpeeds_nonempty u) (x : Time)
    intro a ha
    obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp ha
    have h := hxy i
    simp only [Pi.zero_apply,Int.cast_zero,zero_mul,add_zero] at h
    rw [distance_integer_natAbs] at h
    simpa only [←AddCircle.coe_nsmul,nsmul_eq_mul] using h
  · exact torus_good_of_line_ML

theorem torus_bad_forces_line_ML_lt {u v : Fin 4 → ℤ} {L : ℝ}
    (hbad : ¬TorusGood u v L) : ML (torusLineSpeeds u)<L := by
  apply lt_of_not_ge
  intro hL
  exact hbad (torus_good_of_line_ML hL)

/-- Coalescing repeated speeds matters: any positive nonempty set with
at most two distinct speeds has a common one-third witness. -/
theorem positive_at_most_two_ML_ge_third {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) (hcard : V.card≤2) : (1/3 : ℝ)≤ML V := by
  have hcpos : 0<V.card := Finset.card_pos.mpr hV
  have hcases : V.card=1 ∨ V.card=2 := by omega
  rcases hcases with hc | hc
  · obtain ⟨a,he⟩ := Finset.card_eq_one.mp hc
    have ha : 0<a := hp a (by rw [he]; simp)
    rw [he]
    simpa using two_speed_ML_ge_third a a ha ha
  · obtain ⟨a,b,hab,he⟩ := Finset.card_eq_two.mp hc
    have ha : 0<a := hp a (by rw [he]; simp)
    have hb : 0<b := hp b (by rw [he]; simp)
    rw [he]
    exact two_speed_ML_ge_third a b ha hb

theorem torus_bad_nonzero_line_card_ge_three {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hbad : ¬TorusGood u v (2/7)) :
    3≤(torusLineSpeeds u).card := by
  by_contra hc
  have hc' : (torusLineSpeeds u).card≤2 := by omega
  have hL := positive_at_most_two_ML_ge_third (torusLineSpeeds_nonempty u)
    (torusLineSpeeds_positive u hun) hc'
  have hsmall := torus_bad_forces_line_ML_lt hbad
  linarith

theorem torus_collision_line_speed_image {u : Fin 4 → ℤ}
    (habs : (u 0).natAbs=(u 1).natAbs) :
    torusLineSpeeds u=({(u 0).natAbs,(u 2).natAbs,(u 3).natAbs} : Finset ℕ) := by
  classical
  ext a
  constructor
  · intro ha
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp ha
    simp only [Finset.mem_insert,Finset.mem_singleton]
    fin_cases i
    · exact Or.inl he.symm
    · change (u 1).natAbs=a at he
      rw [←habs] at he
      exact Or.inl he.symm
    · exact Or.inr (Or.inl he.symm)
    · exact Or.inr (Or.inr he.symm)
  · intro ha
    simp only [Finset.mem_insert,Finset.mem_singleton] at ha
    rcases ha with he | he | he
    · exact Finset.mem_image.mpr ⟨0,by simp,he.symm⟩
    · exact Finset.mem_image.mpr ⟨2,by simp,he.symm⟩
    · exact Finset.mem_image.mpr ⟨3,by simp,he.symm⟩

/-- In a torus with no common 2/7 witness, an everywhere nonzero
collision line has exactly the absolute speed ratios 1:2:3. -/
theorem torus_bad_collision_line_is_tight {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (habs : (u 0).natAbs=(u 1).natAbs)
    (hbad : ¬TorusGood u v (2/7)) :
    ∃ a : ℕ, 0<a ∧ torusLineSpeeds u=({a,2*a,3*a} : Finset ℕ) := by
  have hcardle : (torusLineSpeeds u).card≤3 := by
    rw [torus_collision_line_speed_image habs]
    exact Finset.card_le_three
  have hcardge := torus_bad_nonzero_line_card_ge_three hun hbad
  apply three_speed_isolation (torusLineSpeeds_positive u hun) (by omega)
  exact torus_bad_forces_line_ML_lt hbad

/-- An identically zero coordinate on the selected generator is a real
obstruction to using that line, even if the other generator is nonzero. -/
theorem torus_zero_coordinate_line_ML_eq_zero {u : Fin 4 → ℤ} {i : Fin 4}
    (hzero : u i=0) : ML (torusLineSpeeds u)=0 := by
  have hmem : 0∈torusLineSpeeds u := by
    apply Finset.mem_image.mpr
    exact ⟨i,by simp,by simp [hzero]⟩
  apply le_antisymm
  · apply ML_upper_of_all_times
    intro t
    have h := score_le_distance hmem t
    simpa only [zero_nsmul,distance,norm_zero] using h
  · apply ML_lower_of_witness (torusLineSpeeds_nonempty u) (0 : Time)
    intro a ha
    simp only [nsmul_zero,distance,norm_zero,le_refl]













end Math15.LonelyRunner
end 
