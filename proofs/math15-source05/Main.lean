theorem low_ML_width_four_target_or_sum270
    (m : Vec4 ℤ) (v : Fin 4 → ℕ) (hw : relationL1 m=4)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hmv : intDot m (fun i => (v i : ℤ))=0)
    (hp : Positive (Finset.univ.image v)) (hprim : Primitive (Finset.univ.image v))
