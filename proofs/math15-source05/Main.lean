/- Section: TorusProfileNormalization -/
section



/-!
Unbounded signed-scale normalization of two everywhere nonzero collision
generators. Each tight absolute-speed profile is divided by its own actual
positive scale. One coordinate-sign change makes the first generator positive;
a possible swap of coordinates two and three orders its two remaining entries.
Every operation preserves the same plane of real points.

The final theorem supplies the literal parameter hypotheses consumed by
torus72_normalized_classification. Zero-coordinate branches are excluded by
explicit hypotheses here and remain separate.
-/

noncomputable section
namespace Math15.LonelyRunner

def torusDivideGenerator (a : ℕ) (u : Fin 4 → ℤ) : Fin 4 → ℤ :=
  fun i => u i/(a : ℤ)

theorem torus_tight_profile_divides {u : Fin 4 → ℤ} {a : ℕ}
    (hprofile : torusLineSpeeds u=({a,2*a,3*a} : Finset ℕ)) (i : Fin 4) :
    (a : ℤ)∣u i := by
  have hm : (u i).natAbs∈({a,2*a,3*a} : Finset ℕ) := by
    rw [←hprofile]
    exact Finset.mem_image.mpr ⟨i,by simp,rfl⟩
  have hd : a∣(u i).natAbs := by
    simp only [Finset.mem_insert,Finset.mem_singleton] at hm
    rcases hm with h | h | h
    · simpa only [h] using (dvd_refl a)
    · simpa only [h] using (dvd_mul_left a 2)
    · simpa only [h] using (dvd_mul_left a 3)
  exact Int.natCast_dvd.mpr hd

theorem torus_tight_profile_factor {u : Fin 4 → ℤ} {a : ℕ}
    (hprofile : torusLineSpeeds u=({a,2*a,3*a} : Finset ℕ)) :
    torusGeneratorScale (a : ℤ) (torusDivideGenerator a u)=u := by
  funext i
  exact Int.mul_ediv_cancel' (torus_tight_profile_divides hprofile i)

theorem torus_tight_profile_division {u : Fin 4 → ℤ} {a : ℕ} (ha : 0<a)
    (hprofile : torusLineSpeeds u=({a,2*a,3*a} : Finset ℕ)) :
    torusLineSpeeds (torusDivideGenerator a u)=({1,2,3} : Finset ℕ) := by
  have he : torusLineSpeeds (torusDivideGenerator a u)=
      (torusLineSpeeds u).image (fun b => b/a) := by
    unfold torusLineSpeeds
    rw [Finset.image_image]
    apply Finset.image_congr
    intro i hi
    dsimp [Function.comp_def,torusDivideGenerator]
    simpa only [Int.natAbs_natCast] using
      Int.natAbs_ediv_of_dvd (torus_tight_profile_divides hprofile i)
  rw [he,hprofile]
  simp only [Finset.image_insert,Finset.image_singleton,
    Nat.div_self ha,Nat.mul_div_cancel 2 ha,Nat.mul_div_cancel 3 ha]

theorem torus_good_swap_iff {u v : Fin 4 → ℤ} {L : ℝ} :
    TorusGood v u L ↔ TorusGood u v L := by
  constructor <;> rintro ⟨x,y,hxy⟩ <;> refine ⟨y,x,?_⟩ <;> intro i
  · rw [add_comm]; exact hxy i
  · rw [add_comm]; exact hxy i

theorem torusLineSpeeds_signs (ε u : Fin 4 → ℤ)
    (hε : ∀ i,ε i=1 ∨ ε i= -1) :
    torusLineSpeeds (torusCoordinateSigns ε u)=torusLineSpeeds u := by
  unfold torusLineSpeeds
  apply Finset.image_congr
  intro i hi
  rcases hε i with h | h <;> simp only [torusCoordinateSigns,h,one_mul,
    neg_one_mul,Int.natAbs_neg]

theorem torusLineSpeeds_permute (σ : Equiv.Perm (Fin 4)) (u : Fin 4 → ℤ) :
    torusLineSpeeds (torusCoordinatePermute σ u)=torusLineSpeeds u := by
  classical
  ext a
  constructor
  · intro ha
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp ha
    exact Finset.mem_image.mpr ⟨σ i,by simp,he⟩
  · intro ha
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp ha
    apply Finset.mem_image.mpr
    refine ⟨σ.symm i,by simp,?_⟩
    simpa only [torusCoordinatePermute,Equiv.apply_symm_apply] using he

theorem triple123_line_nonzero {u : Fin 4 → ℤ}
    (hprofile : torusLineSpeeds u=({1,2,3} : Finset ℕ)) : ∀ i,u i≠0 := by
  intro i hz
  have hm : (u i).natAbs∈torusLineSpeeds u := Finset.mem_image.mpr ⟨i,by simp,rfl⟩
  rw [hprofile,hz] at hm
  norm_num at hm

theorem sign_common_positive_ratio {A B p q : ℤ} (hA : 0<A) (hB : 0<B)
    (hp : p≠0) (he : A*p=B*q) : 0<p.sign*q := by
  by_cases hpp : 0<p
  · have hqp : 0<q := by
      by_contra hq
      have hqnp : q≤0 := by omega
      have hm := mul_nonpos_of_nonneg_of_nonpos hB.le hqnp
      have hmp := mul_pos hA hpp
      rw [he] at hmp
      omega
    rw [Int.sign_eq_one_of_pos hpp,one_mul]
    exact hqp
  · have hpn : p<0 := by omega
    have hqn : q<0 := by
      by_contra hq
      have hqnn : 0≤q := by omega
      have hm := mul_nonneg hB.le hqnn
      have hmp := mul_neg_of_pos_of_neg hA hpn
      rw [he] at hmp
      omega
    rw [Int.sign_eq_neg_one_of_neg hpn,neg_one_mul]
    omega

/-- The literal normalized vector parameters, recovered from actual
positive integer coordinates and the two absolute-speed set equalities. -/
theorem torus_ordered_profiles_parameters {U V : Fin 4 → ℤ}
    (hUpos : ∀ i,0<U i) (hU01 : U 0=U 1) (hU23 : U 2<U 3)
    (hU : torusLineSpeeds U=({1,2,3} : Finset ℕ))
    (hVpos : 0<V 0) (hV10 : V 1= -V 0)
    (hV : torusLineSpeeds V=({1,2,3} : Finset ℕ)) :
    ∃ a b c d : ℕ, ∃ e f : ℤ, b<c ∧ ({a,b,c} : Finset ℕ)={1,2,3} ∧
      ({d,e.natAbs,f.natAbs} : Finset ℕ)={1,2,3} ∧
      U=(![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)]) ∧
      V=(![(d : ℤ),-(d : ℤ),e,f]) := by
  let a : ℕ := (U 0).natAbs
  let b : ℕ := (U 2).natAbs
  let c : ℕ := (U 3).natAbs
  let d : ℕ := (V 0).natAbs
  have ha : (a : ℤ)=U 0 := Int.natAbs_of_nonneg (hUpos 0).le
  have hb : (b : ℤ)=U 2 := Int.natAbs_of_nonneg (hUpos 2).le
  have hc : (c : ℤ)=U 3 := Int.natAbs_of_nonneg (hUpos 3).le
  have hd : (d : ℤ)=V 0 := Int.natAbs_of_nonneg hVpos.le
  have hbc : b<c := by exact_mod_cast (show (b : ℤ)<(c : ℤ) by rwa [hb,hc])
  have hUabs : (U 0).natAbs=(U 1).natAbs := by rw [hU01]
  have hVabs : (V 0).natAbs=(V 1).natAbs := by rw [hV10,Int.natAbs_neg]
  rw [torus_collision_line_speed_image hUabs] at hU
  rw [torus_collision_line_speed_image hVabs] at hV
  refine ⟨a,b,c,d,V 2,V 3,hbc,hU,hV,?_,?_⟩
  · funext i
    fin_cases i <;> simp [ha,hb,hc,hU01]
  · funext i
    fin_cases i <;> simp [hd,hV10]

theorem collision_triple123_other_coordinates_distinct {u : Fin 4 → ℤ}
    (h01 : u 0=u 1) (hprofile : torusLineSpeeds u=({1,2,3} : Finset ℕ)) :
    u 2≠u 3 := by
  intro he
  have hc : (torusLineSpeeds u).card=3 := by rw [hprofile]; norm_num
  have hcard : (torusLineSpeeds u).card≤2 := by
    rw [torus_collision_line_speed_image (show (u 0).natAbs=(u 1).natAbs by rw [h01]),he]
    simpa using (show ({(u 0).natAbs,(u 3).natAbs} : Finset ℕ).card≤2 from Finset.card_le_two)
  omega

/-- Every no-zero low collision plane normalizes to the exact parameter
class of the 72-case theorem. Separate generator scales and one shared
signed permutation preserve the original common torus-point question. -/
theorem torus_bad_no_zero_collision_normalizes72 {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hvn : ∀ i,v i≠0)
    (hu01 : u 0=u 1) (hv0 : v 0=u 0) (hv1 : v 1= -u 0)
    (hbad : ¬TorusGood u v (2/7)) :
    ∃ a b c d : ℕ, ∃ e f : ℤ, b<c ∧ ({a,b,c} : Finset ℕ)={1,2,3} ∧
      ({d,e.natAbs,f.natAbs} : Finset ℕ)={1,2,3} ∧
      ∀ L : ℝ, TorusGood u v L ↔
        TorusGood (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
          (![(d : ℤ),-(d : ℤ),e,f]) L := by
  have huabs : (u 0).natAbs=(u 1).natAbs := by rw [hu01]
  have hvabs : (v 0).natAbs=(v 1).natAbs := by rw [hv0,hv1,Int.natAbs_neg]
  obtain ⟨A,hA,hprofileU⟩ := torus_bad_collision_line_is_tight hun huabs hbad
  have hbadV : ¬TorusGood v u (2/7) := fun h => hbad (torus_good_swap_iff.mp h)
  obtain ⟨B,hB,hprofileV⟩ := torus_bad_collision_line_is_tight hvn hvabs hbadV
  let Q := torusDivideGenerator A u
  let R := torusDivideGenerator B v
  have hQ : torusLineSpeeds Q=({1,2,3} : Finset ℕ) := torus_tight_profile_division hA hprofileU
  have hR : torusLineSpeeds R=({1,2,3} : Finset ℕ) := torus_tight_profile_division hB hprofileV
  have hQfactor : torusGeneratorScale (A : ℤ) Q=u := torus_tight_profile_factor hprofileU
  have hRfactor : torusGeneratorScale (B : ℤ) R=v := torus_tight_profile_factor hprofileV
  have hAInt : (0 : ℤ)<A := by exact_mod_cast hA
  have hBInt : (0 : ℤ)<B := by exact_mod_cast hB
  have hQR (L : ℝ) : TorusGood u v L ↔ TorusGood Q R L := by
    have h := torus_good_diagonal_scaling_iff (u := Q) (v := R) (L := L)
      (A : ℤ) (B : ℤ) (ne_of_gt hAInt) (ne_of_gt hBInt)
    rwa [hQfactor,hRfactor] at h
  have hQ01 : Q 0=Q 1 := by dsimp [Q,torusDivideGenerator]; rw [hu01]
  have hR10 : R 1= -R 0 := by
    dsimp [R,torusDivideGenerator]
    rw [hv1,←hv0,Int.neg_ediv_of_dvd (torus_tight_profile_divides hprofileV 0)]
  let ε : Fin 4 → ℤ := fun i => (Q i).sign
  have hε : ∀ i,ε i=1 ∨ ε i= -1 := by
    intro i
    have hne := triple123_line_nonzero hQ i
    dsimp [ε]
    rcases lt_or_gt_of_ne hne with hneg | hpos
    · exact Or.inr (Int.sign_eq_neg_one_of_neg hneg)
    · exact Or.inl (Int.sign_eq_one_of_pos hpos)
  let U := torusCoordinateSigns ε Q
  let V := torusCoordinateSigns ε R
  have hU : torusLineSpeeds U=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε Q hε]
    exact hQ
  have hV : torusLineSpeeds V=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε R hε]
    exact hR
  have hUpos : ∀ i,0<U i := by
    intro i
    have hn := triple123_line_nonzero hQ i
    have hpos : (0 : ℤ)<((Q i).natAbs : ℤ) := by
      exact_mod_cast Nat.pos_of_ne_zero (Int.natAbs_ne_zero.mpr hn)
    simpa only [U,torusCoordinateSigns,ε,Int.sign_mul_self] using hpos
  have hU01 : U 0=U 1 := by simp only [U,torusCoordinateSigns,ε,hQ01]
  have hV10 : V 1= -V 0 := by
    simp only [V,torusCoordinateSigns,ε,hQ01.symm,hR10,mul_neg]
  have hVpos : 0<V 0 := by
    have he : (A : ℤ)*Q 0=(B : ℤ)*R 0 := by
      have hq := congrFun hQfactor 0
      have hr := congrFun hRfactor 0
      dsimp [torusGeneratorScale] at hq hr
      rw [hq,hr,hv0]
    exact sign_common_positive_ratio hAInt hBInt (triple123_line_nonzero hQ 0) he
  have hUV (L : ℝ) : TorusGood u v L ↔ TorusGood U V L :=
    (hQR L).trans (torus_good_coordinate_signs_iff (u := Q) (v := R) ε hε).symm
  have hneq := collision_triple123_other_coordinates_distinct hU01 hU
  by_cases horder : U 2<U 3
  · obtain ⟨a,b,c,d,e,f,hbc,hU',hV',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUpos hU01 horder hU hVpos hV10 hV
    refine ⟨a,b,c,d,e,f,hbc,hU',hV',?_⟩
    intro L
    simpa only [hueq,hveq] using hUV L
  · let σ : Equiv.Perm (Fin 4) := Equiv.swap 2 3
    let U' := torusCoordinatePermute σ U
    let V' := torusCoordinatePermute σ V
    have hU' : torusLineSpeeds U'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ U]
      exact hU
    have hV' : torusLineSpeeds V'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ V]
      exact hV
    have hUp : ∀ i,0<U' i := fun i => hUpos (σ i)
    have hU01' : U' 0=U' 1 := by simpa [U',torusCoordinatePermute,σ] using hU01
    have hU23' : U' 2<U' 3 := by
      have h : U 3<U 2 := by omega
      simpa [U',torusCoordinatePermute,σ] using h
    have hVp : 0<V' 0 := by simpa [V',torusCoordinatePermute,σ] using hVpos
    have hV10' : V' 1= -V' 0 := by simpa [V',torusCoordinatePermute,σ] using hV10
    obtain ⟨a,b,c,d,e,f,hbc,hU'',hV'',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUp hU01' hU23' hU' hVp hV10' hV'
    refine ⟨a,b,c,d,e,f,hbc,hU'',hV'',?_⟩
    intro L
    have ht := (hUV L).trans
      (torus_good_coordinate_permutation_iff (u := U) (v := V) σ).symm
    change TorusGood u v L ↔ TorusGood U' V' L at ht
    simpa only [hueq,hveq] using ht













end Math15.LonelyRunner
end 
end 

/- Section: TorusLineTransport -/
section


/-!
Actual integer lines under the same generator and coordinate operations used
by torus normalization. A line is transported as an integer vector; the shared
coordinate signs and permutations preserve its absolute-speed set, even when
they destroy positivity of its signed coordinates.
-/

noncomputable section
namespace Math15.LonelyRunner

def TorusIntegerLineInSpan (u v z : Fin 4 → ℤ) : Prop :=
  ∃ x y : ℝ, ∀ i, (z i : ℝ)=(u i : ℝ)*x+(v i : ℝ)*y

def TorusAbsoluteLineTransfer (u v U V : Fin 4 → ℤ) : Prop :=
  ∀ z : Fin 4 → ℤ, TorusIntegerLineInSpan u v z →
    ∃ w : Fin 4 → ℤ, torusLineSpeeds w=torusLineSpeeds z ∧
      TorusIntegerLineInSpan U V w

theorem torus_absolute_line_transfer_refl (u v : Fin 4 → ℤ) :
    TorusAbsoluteLineTransfer u v u v :=
  fun z hz => ⟨z,rfl,hz⟩

theorem torus_absolute_line_transfer_trans {u v U V P Q : Fin 4 → ℤ}
    (h1 : TorusAbsoluteLineTransfer u v U V)
    (h2 : TorusAbsoluteLineTransfer U V P Q) :
    TorusAbsoluteLineTransfer u v P Q := by
  intro z hz
  obtain ⟨w,hw,hspanw⟩ := h1 z hz
  obtain ⟨r,hr,hspanr⟩ := h2 w hspanw
  exact ⟨r,hr.trans hw,hspanr⟩

theorem torus_integer_line_span_integer_change_iff {u v z : Fin 4 → ℤ}
    (A B C D : ℤ) (hdet : A*D-B*C≠0) :
    TorusIntegerLineInSpan (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) z ↔ TorusIntegerLineInSpan u v z := by
  constructor
  · rintro ⟨x,y,h⟩
    refine ⟨(A : ℝ)*x+(C : ℝ)*y,(B : ℝ)*x+(D : ℝ)*y,?_⟩
    intro i
    rw [h i]
    simp only [torusIntegerCombination,Int.cast_add,Int.cast_mul]
    ring
  · rintro ⟨X,Y,h⟩
    have hdetR : (A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)≠0 := by exact_mod_cast hdet
    refine ⟨((D : ℝ)*X-(C : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)),
      (-(B : ℝ)*X+(A : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)),?_⟩
    intro i
    rw [h i]
    simp only [torusIntegerCombination,Int.cast_add,Int.cast_mul]
    field_simp [hdetR] <;> ring

theorem torus_absolute_line_transfer_integer_change {u v : Fin 4 → ℤ}
    (A B C D : ℤ) (hdet : A*D-B*C≠0) :
    TorusAbsoluteLineTransfer u v (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) := by
  intro z hz
  exact ⟨z,rfl,(torus_integer_line_span_integer_change_iff A B C D hdet).mpr hz⟩

/-- A factor identity gives the real parameter change without an inverse
or any assumptions on the signed integer line. -/
theorem torus_absolute_line_transfer_of_factors {u v U V : Fin 4 → ℤ}
    (A B : ℤ) (hU : torusGeneratorScale A U=u)
    (hV : torusGeneratorScale B V=v) : TorusAbsoluteLineTransfer u v U V := by
  intro z hz
  obtain ⟨x,y,h⟩ := hz
  refine ⟨z,rfl,(A : ℝ)*x,(B : ℝ)*y,?_⟩
  intro i
  have hu := congrFun hU i
  have hv := congrFun hV i
  rw [h i,←hu,←hv]
  simp only [torusGeneratorScale,Int.cast_mul]
  ring

theorem torus_integer_line_span_signs {u v z : Fin 4 → ℤ}
    (ε : Fin 4 → ℤ) (hz : TorusIntegerLineInSpan u v z) :
    TorusIntegerLineInSpan (torusCoordinateSigns ε u)
      (torusCoordinateSigns ε v) (torusCoordinateSigns ε z) := by
  obtain ⟨x,y,h⟩ := hz
  refine ⟨x,y,?_⟩
  intro i
  simp only [torusCoordinateSigns,Int.cast_mul]
  rw [h i]
  ring

theorem torus_absolute_line_transfer_signs (u v ε : Fin 4 → ℤ)
    (hε : ∀ i,ε i=1 ∨ ε i= -1) :
    TorusAbsoluteLineTransfer u v (torusCoordinateSigns ε u)
      (torusCoordinateSigns ε v) := by
  intro z hz
  exact ⟨torusCoordinateSigns ε z,torusLineSpeeds_signs ε z hε,
    torus_integer_line_span_signs ε hz⟩

theorem torus_integer_line_span_permute {u v z : Fin 4 → ℤ}
    (σ : Equiv.Perm (Fin 4)) (hz : TorusIntegerLineInSpan u v z) :
    TorusIntegerLineInSpan (torusCoordinatePermute σ u)
      (torusCoordinatePermute σ v) (torusCoordinatePermute σ z) := by
  obtain ⟨x,y,h⟩ := hz
  exact ⟨x,y,fun i => h (σ i)⟩

theorem torus_absolute_line_transfer_permute (u v : Fin 4 → ℤ)
    (σ : Equiv.Perm (Fin 4)) :
    TorusAbsoluteLineTransfer u v (torusCoordinatePermute σ u)
      (torusCoordinatePermute σ v) := by
  intro z hz
  exact ⟨torusCoordinatePermute σ z,torusLineSpeeds_permute σ z,
    torus_integer_line_span_permute σ hz⟩

theorem torus_bad_no_zero_collision_normalizes72_with_lines {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hvn : ∀ i,v i≠0)
    (hu01 : u 0=u 1) (hv0 : v 0=u 0) (hv1 : v 1= -u 0)
    (hbad : ¬TorusGood u v (2/7)) :
    ∃ a b c d : ℕ, ∃ e f : ℤ, b<c ∧ ({a,b,c} : Finset ℕ)={1,2,3} ∧
      ({d,e.natAbs,f.natAbs} : Finset ℕ)={1,2,3} ∧
      (∀ L : ℝ, TorusGood u v L ↔
        TorusGood (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
          (![(d : ℤ),-(d : ℤ),e,f]) L) ∧
      TorusAbsoluteLineTransfer u v (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
        (![(d : ℤ),-(d : ℤ),e,f]) := by
  have huabs : (u 0).natAbs=(u 1).natAbs := by rw [hu01]
  have hvabs : (v 0).natAbs=(v 1).natAbs := by rw [hv0,hv1,Int.natAbs_neg]
  obtain ⟨A,hA,hprofileU⟩ := torus_bad_collision_line_is_tight hun huabs hbad
  have hbadV : ¬TorusGood v u (2/7) := fun h => hbad (torus_good_swap_iff.mp h)
  obtain ⟨B,hB,hprofileV⟩ := torus_bad_collision_line_is_tight hvn hvabs hbadV
  let Q := torusDivideGenerator A u
  let R := torusDivideGenerator B v
  have hQ : torusLineSpeeds Q=({1,2,3} : Finset ℕ) := torus_tight_profile_division hA hprofileU
  have hR : torusLineSpeeds R=({1,2,3} : Finset ℕ) := torus_tight_profile_division hB hprofileV
  have hQfactor : torusGeneratorScale (A : ℤ) Q=u := torus_tight_profile_factor hprofileU
  have hRfactor : torusGeneratorScale (B : ℤ) R=v := torus_tight_profile_factor hprofileV
  have hAInt : (0 : ℤ)<A := by exact_mod_cast hA
  have hBInt : (0 : ℤ)<B := by exact_mod_cast hB
  have hQR (L : ℝ) : TorusGood u v L ↔ TorusGood Q R L := by
    have h := torus_good_diagonal_scaling_iff (u := Q) (v := R) (L := L)
      (A : ℤ) (B : ℤ) (ne_of_gt hAInt) (ne_of_gt hBInt)
    rwa [hQfactor,hRfactor] at h
  have hQ01 : Q 0=Q 1 := by dsimp [Q,torusDivideGenerator]; rw [hu01]
  have hR10 : R 1= -R 0 := by
    dsimp [R,torusDivideGenerator]
    rw [hv1,←hv0,Int.neg_ediv_of_dvd (torus_tight_profile_divides hprofileV 0)]
  let ε : Fin 4 → ℤ := fun i => (Q i).sign
  have hε : ∀ i,ε i=1 ∨ ε i= -1 := by
    intro i
    have hne := triple123_line_nonzero hQ i
    dsimp [ε]
    rcases lt_or_gt_of_ne hne with hneg | hpos
    · exact Or.inr (Int.sign_eq_neg_one_of_neg hneg)
    · exact Or.inl (Int.sign_eq_one_of_pos hpos)
  let U := torusCoordinateSigns ε Q
  let V := torusCoordinateSigns ε R
  have hU : torusLineSpeeds U=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε Q hε]
    exact hQ
  have hV : torusLineSpeeds V=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε R hε]
    exact hR
  have hUpos : ∀ i,0<U i := by
    intro i
    have hn := triple123_line_nonzero hQ i
    have hpos : (0 : ℤ)<((Q i).natAbs : ℤ) := by
      exact_mod_cast Nat.pos_of_ne_zero (Int.natAbs_ne_zero.mpr hn)
    simpa only [U,torusCoordinateSigns,ε,Int.sign_mul_self] using hpos
  have hU01 : U 0=U 1 := by simp only [U,torusCoordinateSigns,ε,hQ01]
  have hV10 : V 1= -V 0 := by
    simp only [V,torusCoordinateSigns,ε,hQ01.symm,hR10,mul_neg]
  have hVpos : 0<V 0 := by
    have he : (A : ℤ)*Q 0=(B : ℤ)*R 0 := by
      have hq := congrFun hQfactor 0
      have hr := congrFun hRfactor 0
      dsimp [torusGeneratorScale] at hq hr
      rw [hq,hr,hv0]
    exact sign_common_positive_ratio hAInt hBInt (triple123_line_nonzero hQ 0) he
  have hUV (L : ℝ) : TorusGood u v L ↔ TorusGood U V L :=
    (hQR L).trans (torus_good_coordinate_signs_iff (u := Q) (v := R) ε hε).symm
  have hLinesQR : TorusAbsoluteLineTransfer u v Q R :=
    torus_absolute_line_transfer_of_factors (A : ℤ) (B : ℤ) hQfactor hRfactor
  have hLinesUV : TorusAbsoluteLineTransfer u v U V :=
    torus_absolute_line_transfer_trans hLinesQR (torus_absolute_line_transfer_signs Q R ε hε)
  have hneq := collision_triple123_other_coordinates_distinct hU01 hU
  by_cases horder : U 2<U 3
  · obtain ⟨a,b,c,d,e,f,hbc,hU',hV',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUpos hU01 horder hU hVpos hV10 hV
    refine ⟨a,b,c,d,e,f,hbc,hU',hV',?_,?_⟩
    · intro L
      simpa only [hueq,hveq] using hUV L
    · simpa only [hueq,hveq] using hLinesUV
  · let σ : Equiv.Perm (Fin 4) := Equiv.swap 2 3
    let U' := torusCoordinatePermute σ U
    let V' := torusCoordinatePermute σ V
    have hU' : torusLineSpeeds U'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ U]
      exact hU
    have hV' : torusLineSpeeds V'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ V]
      exact hV
    have hUp : ∀ i,0<U' i := fun i => hUpos (σ i)
    have hU01' : U' 0=U' 1 := by simpa [U',torusCoordinatePermute,σ] using hU01
    have hU23' : U' 2<U' 3 := by
      have h : U 3<U 2 := by omega
      simpa [U',torusCoordinatePermute,σ] using h
    have hVp : 0<V' 0 := by simpa [V',torusCoordinatePermute,σ] using hVpos
    have hV10' : V' 1= -V' 0 := by simpa [V',torusCoordinatePermute,σ] using hV10
    obtain ⟨a,b,c,d,e,f,hbc,hU'',hV'',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUp hU01' hU23' hU' hVp hV10' hV'
    refine ⟨a,b,c,d,e,f,hbc,hU'',hV'',?_,?_⟩
    · intro L
      have ht := (hUV L).trans
        (torus_good_coordinate_permutation_iff (u := U) (v := V) σ).symm
      change TorusGood u v L ↔ TorusGood U' V' L at ht
      simpa only [hueq,hveq] using ht
    · have hLines := torus_absolute_line_transfer_trans hLinesUV
        (torus_absolute_line_transfer_permute U V σ)
      change TorusAbsoluteLineTransfer u v U' V' at hLines
      simpa only [hueq,hveq] using hLines













end Math15.LonelyRunner
end 
end 

/- Section: NativeTorusBasis -/
section



/-!
The actual integer basis supplies the torus independence and line-span
premises without changing the submodule, basis, or speed vector.

Paper argument. The first basis vector is nonzero. If every coordinate minor
of the two ambient basis vectors vanished, a nonzero coordinate of the first
vector would give an integral dependence between the two basis vectors.
Applying the second coordinate of the basis representation map would force
that coordinate to vanish, a contradiction. A nonzero integer minor remains
nonzero over the reals and Cramer's two scalar identities force both real
dependence coefficients to be zero.

For every vector in the supplied integer submodule, b.sum_repr gives its
literal two integral basis coordinates. Casting those coordinates to the reals
gives one shared parameter pair in TorusIntegerLineInSpan. Ambient primitivity
is unnecessary for this span statement, and remains precisely the original
hypothesis of the nearest-line approximation when assembled.
-/

noncomputable section
namespace Math15.Source05Review
open Module
open Math15.LonelyRunner
open Math15.LonelyRunner.Covolume4

/-- Every actual rank-two integer submodule basis has a nonzero ambient
coordinate minor. This is deduced from the native basis, not assumed. -/
theorem native_basis_integer_minor_nonzero
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N) :
    ∃ i j : Fin 4,
      torusCoordinateMinor (b 0).val (b 1).val i j≠0 := by
  by_contra hno
  push_neg at hno
  have hb0 : b 0≠0 := LinearIndependent.ne_zero 0 b.linearIndependent
  have hune : ∃ i : Fin 4, (b 0).val i≠0 := by
    by_contra hu
    push_neg at hu
    apply hb0
    apply Subtype.ext
    funext i
    exact hu i
  obtain ⟨i,hi⟩ := hune
  have hdep : (b 1).val i • b 0 + (-(b 0).val i) • b 1=0 := by
    apply Subtype.ext
    funext j
    change (b 1).val i*(b 0).val j+(-(b 0).val i)*(b 1).val j=0
    have hM := hno i j
    dsimp [torusCoordinateMinor] at hM
    linear_combination -hM
  have hrepr := congrArg (fun w : N => b.repr w 1) hdep
  have hneg : -(b 0).val i=0 := by simpa using hrepr
  exact hi (neg_eq_zero.mp hneg)

/-- A nonzero actual coordinate minor proves independence over the real
parameter field used by the torus witness. -/
theorem torus_real_independent_of_nonzero_minor {u v : Fin 4 → ℤ}
    {i j : Fin 4} (hminor : torusCoordinateMinor u v i j≠0) :
    TorusRealIndependent u v := by
  have hD : (u i : ℝ)*(v j : ℝ)-(u j : ℝ)*(v i : ℝ)≠0 := by
    have hZ : u i*v j-u j*v i≠0 := hminor
    exact_mod_cast hZ
  intro A B hzero
  have hi := hzero i
  have hj := hzero j
  have hA : A*((u i : ℝ)*(v j : ℝ)-(u j : ℝ)*(v i : ℝ))=0 := by
    linear_combination (v j : ℝ)*hi-(v i : ℝ)*hj
  have hB : B*((u i : ℝ)*(v j : ℝ)-(u j : ℝ)*(v i : ℝ))=0 := by
    linear_combination (u i : ℝ)*hj-(u j : ℝ)*hi
  exact ⟨(mul_eq_zero.mp hA).resolve_right hD,
    (mul_eq_zero.mp hB).resolve_right hD⟩

/-- Independence of the two real torus generators follows from the actual
native integer basis alone. -/
theorem native_basis_torus_real_independent
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N) :
    TorusRealIndependent (b 0).val (b 1).val := by
  obtain ⟨i,j,hminor⟩ := native_basis_integer_minor_nonzero N b
  exact torus_real_independent_of_nonzero_minor hminor

/-- Every actual vector of the submodule has one common pair of real
parameters in the same two ambient basis vectors. -/
theorem native_basis_torus_integer_line_in_span
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N) (v : N) :
    TorusIntegerLineInSpan (b 0).val (b 1).val v.val := by
  refine ⟨(b.repr v 0 : ℝ),(b.repr v 1 : ℝ),?_⟩
  intro i
  have hi := congrFun (basis_two_realCast_identity N b v) i
  change (v.val i : ℝ)=
    (b.repr v 0 : ℝ)*((b 0).val i : ℝ)+
    (b.repr v 1 : ℝ)*((b 1).val i : ℝ) at hi
  nlinarith

/-- An actual equation-kernel membership proof supplies the original
integer speed line in this same native basis. -/
theorem native_equation_kernel_torus_line_in_span
    (rows : Fin 2 → Vec4 ℤ)
    (b : Basis (Fin 2) ℤ (integerEquationKernel rows))
    (v : Vec4 ℤ) (hv : v∈integerEquationKernel rows) :
    TorusIntegerLineInSpan (b 0).val (b 1).val v :=
  native_basis_torus_integer_line_in_span (integerEquationKernel rows) b ⟨v,hv⟩

/-- The two original relations construct a basis with all torus algebra
premises and the complementary covolume bound on that very basis. -/
theorem native_relations_torus_basis
    (r s v : Vec4 ℤ) (hrs : 0<areaSq4 r s)
    (hrv : intDot r v=0) (hsv : intDot s v=0) :
    ∃ b : Basis (Fin 2) ℤ (integerEquationKernel ![r,s]),
      TorusRealIndependent (b 0).val (b 1).val ∧
      TorusIntegerLineInSpan (b 0).val (b 1).val v ∧
      areaSq4 (b 0).val (b 1).val≤areaSq4 r s := by
  obtain ⟨b,harea⟩ := native_integer_kernel_covolume_bound r s hrs
  have hmem : v∈integerEquationKernel ![r,s] := by
    intro i
    fin_cases i
    · exact hrv
    · exact hsv
  exact ⟨b,native_basis_torus_real_independent _ b,
    native_equation_kernel_torus_line_in_span ![r,s] b v hmem,harea⟩

/-- Full common-object assembly: the native basis is independent, the
original primitive integer speed vector belongs to its torus, and every
point of that torus has the checked nearest-line approximation for this
same speed vector. No independent/span premise remains. -/
theorem native_relations_primitive_line_torus_approximation
    (r s v : Vec4 ℤ) (hrs : 0<areaSq4 r s)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs)=1)
    (hrv : intDot r v=0) (hsv : intDot s v=0) :
    ∃ b : Basis (Fin 2) ℤ (integerEquationKernel ![r,s]),
      TorusRealIndependent (b 0).val (b 1).val ∧
      TorusIntegerLineInSpan (b 0).val (b 1).val v ∧
      ∀ x y : ℝ, ∃ (t : ℝ) (z : integerEquationKernel ![r,s]),
        sqDist4 (combine4 x (realCast (b 0).val) y (realCast (b 1).val))
          (combine4 1 (realCast z.val) t (realCast v))≤
          ((areaSq4 r s : ℤ) : ℝ)/(4*dot4 (realCast v) (realCast v)) := by
  obtain ⟨b,hnear⟩ := native_relations_primitive_line_approximation r s v hrs hv hrv hsv
  have hmem : v∈integerEquationKernel ![r,s] := by
    intro i
    fin_cases i
    · exact hrv
    · exact hsv
  exact ⟨b,native_basis_torus_real_independent _ b,
    native_equation_kernel_torus_line_in_span ![r,s] b v hmem,hnear⟩









