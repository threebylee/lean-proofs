/- Section: EarlyPacketCensus -/
section


/-!
Early stopping for the same table-free finite packet certificate.

The accumulator begins with the closed known-family mask. A successful
coverage test may stop immediately. Otherwise the next packet is added; zero
selectors skip their cache lookup. An induction proves that success implies
coverage by the initial accumulator together with every remaining packet mask,
even for arbitrary cache data. Thus success refines the exact existing
SharedPacketCensus checker and introduces no semantic premise.

The original triple ranges and pair-mask exclusions are unchanged. Every
numeric row must still succeed; an external tuple list cannot remove rows. No
fixed-pool completeness, numeric cache equality, or sum444 computation is
asserted here. All arithmetic checks remain explicit downstream facts.
-/

namespace Math15.LonelyRunner

/-- List recursion evaluates only packets reached before actual coverage.
A zero selector skips its literal lookup without any correctness premise. -/
def sharedPacketEarlyLoop (allowed width : ℕ) (packetUnion : ℕ → ℕ → ℕ)
    (commonBits : ℕ) : List ℕ → ℕ → Bool
  | [],acc => decide (allowed &&& acc=allowed)
  | p::ps,acc =>
      if allowed &&& acc=allowed then true else
        let f := sharedPacketSelector width p commonBits
        if f=0 then sharedPacketEarlyLoop allowed width packetUnion commonBits ps acc
        else sharedPacketEarlyLoop allowed width packetUnion commonBits ps
          (acc ||| packetUnion p f)

/-- Inserting an additional union term preserves already proved coverage. -/
theorem mask_coverage_union_middle {A acc middle rest : ℕ}
    (h : A &&& (acc ||| rest)=A) :
    A &&& (acc ||| (middle ||| rest))=A := by
  apply (mask_coverage_iff _ _).mpr
  intro i hi
  have hb := (mask_coverage_iff _ _).mp h i hi
  rcases (mask_union_testBit_iff acc rest i).mp hb with ha | hr
  · exact (mask_union_testBit_iff acc (middle ||| rest) i).mpr (Or.inl ha)
  · exact (mask_union_testBit_iff acc (middle ||| rest) i).mpr
      (Or.inr ((mask_union_testBit_iff middle rest i).mpr (Or.inr hr)))

/-- Successful early stopping implies ordinary complete-union coverage.
No correctness assumption on either a selector or a cache is needed here. -/
theorem sharedPacketEarlyLoop_sound (allowed width : ℕ)
    (packetUnion : ℕ → ℕ → ℕ) (commonBits : ℕ) (ps : List ℕ) (acc : ℕ)
    (h : sharedPacketEarlyLoop allowed width packetUnion commonBits ps acc=true) :
    allowed &&& (acc ||| maskUnion (ps.map fun p =>
      packetUnion p (sharedPacketSelector width p commonBits)))=allowed := by
  induction ps generalizing acc with
  | nil =>
      have hh : allowed &&& acc=allowed := by
        simpa only [sharedPacketEarlyLoop,decide_eq_true_eq] using h
      simpa only [List.map_nil,maskUnion,Nat.or_zero] using hh
  | cons p ps ih =>
      by_cases hcovered : allowed &&& acc=allowed
      · apply (mask_coverage_iff _ _).mpr
        intro i hi
        exact (mask_union_testBit_iff _ _ i).mpr
          (Or.inl ((mask_coverage_iff _ _).mp hcovered i hi))
      · by_cases hzero : sharedPacketSelector width p commonBits=0
        · have hnext : sharedPacketEarlyLoop allowed width packetUnion commonBits ps acc=true := by
            simpa only [sharedPacketEarlyLoop,if_neg hcovered,if_pos hzero] using h
          have hh := mask_coverage_union_middle
            (middle:=packetUnion p (sharedPacketSelector width p commonBits)) (ih acc hnext)
          simpa only [List.map_cons,maskUnion] using hh
        · have hnext : sharedPacketEarlyLoop allowed width packetUnion commonBits ps
              (acc ||| packetUnion p (sharedPacketSelector width p commonBits))=true := by
            simpa only [sharedPacketEarlyLoop,if_neg hcovered,if_neg hzero] using h
          have hh := ih (acc ||| packetUnion p (sharedPacketSelector width p commonBits)) hnext
          simpa only [List.map_cons,maskUnion,Nat.or_assoc] using hh

def sharedEarlyPacketRowCheck (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a b c : ℕ) : Bool :=
  if closedKnownWholeRowBool a b c=true then true else
    let allowed := sharedAllowedFourthMask S bound compat prefixCache oddBits a b c
    if allowed=0 then true else
      sharedPacketEarlyLoop allowed width packetUnion
        (sharedCommonTimeBits goodTimeBits a b c) (List.range packets)
        (closedKnownFourthMask bound a b c)

def sharedEarlyPacketCensusAtA (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) (a : ℕ) : Bool :=
  (List.range' (a+1) (((S-a-3)/3+1)-(a+1))).all fun b =>
    (List.range' (b+1) (((S-a-b-1)/2+1)-(b+1))).all fun c =>
      if Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
        Nat.testBit (compat b) c then
        sharedEarlyPacketRowCheck S bound width packets compat prefixCache oddBits
          goodTimeBits packetUnion a b c
      else true

def sharedEarlyPacketCensusCheck (S bound width packets : ℕ)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (goodTimeBits : ℕ → ℕ) (packetUnion : ℕ → ℕ → ℕ) : Bool :=
  (List.range' 1 ((S-6)/4)).all
    (sharedEarlyPacketCensusAtA S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion)

/-- Even arbitrary data cannot make an early success stronger than the
existing full union check. The same two row shortcuts are retained. -/
theorem sharedEarlyPacketRowCheck_sound
    {S bound width packets oddBits a b c : ℕ}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (h : sharedEarlyPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c=true) :
    sharedPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c=true := by
  by_cases hwhole : closedKnownWholeRowBool a b c=true
  · simp only [sharedPacketRowCheck,if_pos hwhole]
  · by_cases hzero : sharedAllowedFourthMask S bound compat prefixCache oddBits a b c=0
    · simp only [sharedPacketRowCheck,if_neg hwhole,if_pos hzero]
    · have hloop : sharedPacketEarlyLoop
          (sharedAllowedFourthMask S bound compat prefixCache oddBits a b c)
          width packetUnion (sharedCommonTimeBits goodTimeBits a b c)
          (List.range packets) (closedKnownFourthMask bound a b c)=true := by
        simpa only [sharedEarlyPacketRowCheck,if_neg hwhole,if_neg hzero] using h
      have hcover := sharedPacketEarlyLoop_sound _ _ _ _ _ _ hloop
      change sharedAllowedFourthMask S bound compat prefixCache oddBits a b c &&&
        (closedKnownFourthMask bound a b c |||
          sharedPacketCover width packets packetUnion goodTimeBits a b c)=
        sharedAllowedFourthMask S bound compat prefixCache oddBits a b c at hcover
      rw [Nat.or_comm (closedKnownFourthMask bound a b c)
        (sharedPacketCover width packets packetUnion goodTimeBits a b c)] at hcover
      simpa only [sharedPacketRowCheck,if_neg hwhole,if_neg hzero,
        decide_eq_true_eq] using hcover

/-- Pointwise row refinement preserves every original required b,c index. -/
theorem sharedEarlyPacketCensusAtA_sound
    {S bound width packets oddBits a : ℕ}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (h : sharedEarlyPacketCensusAtA S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a=true) :
    sharedPacketCensusAtA S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a=true := by
  apply List.all_eq_true.mpr
  intro b hb
  have hmiddle := List.all_eq_true.mp h b hb
  apply List.all_eq_true.mpr
  intro c hc
  have hinner := List.all_eq_true.mp hmiddle c hc
  change (if (Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
      Nat.testBit (compat b) c) = true then
    sharedEarlyPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c else true) = true at hinner
  change (if (Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
      Nat.testBit (compat b) c) = true then
    sharedPacketRowCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion a b c else true) = true
  by_cases hcompatible : (Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
      Nat.testBit (compat b) c) = true
  · rw [if_pos hcompatible] at hinner
    rw [if_pos hcompatible]
    exact sharedEarlyPacketRowCheck_sound hinner
  · rw [if_neg hcompatible]

/-- Full early census implies the existing full census, with the same
independently checked outer range and no stored quartet table. -/
theorem sharedEarlyPacketCensusCheck_sound
    {S bound width packets oddBits : ℕ}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    (h : sharedEarlyPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    sharedPacketCensusCheck S bound width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true := by
  apply List.all_eq_true.mpr
  intro a ha
  exact sharedEarlyPacketCensusAtA_sound (List.all_eq_true.mp h a ha)

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- Reuse the unchanged exact same-time and actual-set semantic consumer.
Every other premise is an explicit pool/cache/arithmetic certificate fact. -/
theorem source05_of_sharedEarlyPacketCensus_set
    {S size width packets oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache goodTimeBits : ℕ → ℕ} {packetUnion : ℕ → ℕ → ℕ}
    {V : Finset ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hflags : sharedGoodTimeBitsCheck (S+1) size pool goodTimeBits=true)
    (hcache : sharedPacketUnionCheck width packets pool packetUnion=true)
    (hcomp : sharedCompatibilityCheck (S+1) compat=true)
    (hpref : sharedPrefixCheck (S+1) prefixCache=true) (hodd : oddBits=oddSpeedMask (S+1))
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hrows : sharedEarlyPacketCensusCheck S (S+1) width packets compat prefixCache oddBits
      goodTimeBits packetUnion=true) :
    FiniteSource05Conclusion V :=
  source05_of_sharedPacketCensus_set hpool hflags hcache hcomp hpref hodd
    hp hc hprim hpair hsum (sharedEarlyPacketCensusCheck_sound hrows)








end Math15.LonelyRunner
