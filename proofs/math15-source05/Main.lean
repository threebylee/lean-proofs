    (m 0 : ℝ) (m 1 : ℝ) (m 2 : ℝ) (m 3 : ℝ)
  have hsum : ((∑ i, (m i).natAbs : ℕ) : ℝ) =
      |(m 0 : ℝ)| + |(m 1 : ℝ)| + |(m 2 : ℝ)| + |(m 3 : ℝ)| := by
    simp [Fin.sum_univ_four, Nat.cast_natAbs, Int.cast_abs]
  by_contra hn
  have hlarge : 9 ≤ ∑ i, (m i).natAbs := by omega
  have hlargeR : (9 : ℝ) ≤ ((∑ i, (m i).natAbs : ℕ) : ℝ) := by
    exact_mod_cast hlarge
  have hprod : 0 ≤
      (((∑ i, (m i).natAbs : ℕ) : ℝ) - 9) *
        (((∑ i, (m i).natAbs : ℕ) : ℝ) + 9) := by
    apply mul_nonneg <;> linarith
