/- Section: CenterLift -/
section



/-!
Lift a modular hyperplane center to the actual real zero hyperplane by
subtracting an explicit integer vector. The subtraction preserves the
coordinate points on R/Z, hence preserves their circle distances.

The two special centers needed by the small-width cases are supplied: the
all-half center for an even-sum primitive relation, and the biased third
center for the additive relation (1,1,-1,0).
-/

noncomputable section
namespace Math15.Source05Review
open Math15.LonelyRunner
open Math15.LonelyRunner.Covolume4

def integerCenterLift (a : Vec4 ℝ) (e : Vec4 ℤ) (j : ℤ) : Vec4 ℝ :=
  fun i => a i - ((j * e i : ℤ) : ℝ)

theorem circle_coe_sub_integer (a : ℝ) (k : ℤ) :
    (((a - (k : ℝ)) : ℝ) : Time) = (a : Time) := by
  have hk : ((k : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨k, by simp [zsmul_eq_mul]⟩
  rw [AddCircle.coe_sub, hk, sub_zero]

/-- The lift preserves every coordinate on the circle, not merely a
numerical lower bound for its distance. -/
theorem integerCenterLift_circle (a : Vec4 ℝ) (e : Vec4 ℤ) (j : ℤ) (i : Fin 4) :
    ((integerCenterLift a e j i) : Time) = (a i : Time) := by
  exact circle_coe_sub_integer (a i) (j * e i)

theorem integerCenterLift_dot (m e : Vec4 ℤ) (a : Vec4 ℝ) (j : ℤ) :
    dot4 (realVec4 m) (integerCenterLift a e j) =
      dot4 (realVec4 m) a - (j : ℝ) * dot4 (realVec4 m) (realVec4 e) := by
  simp [integerCenterLift, dot4, realVec4]
  ring

/-- The integer Bézout vector removes the integral value of the relation
without changing any coordinate modulo one. -/
theorem integerCenterLift_hyperplane (m e : Vec4 ℤ) (a : Vec4 ℝ) (j : ℤ)
    (he : intDot m e = 1) (ha : dot4 (realVec4 m) a = (j : ℝ)) :
    dot4 (realVec4 m) (integerCenterLift a e j) = 0 := by
  have he4 : dot4 m e = 1 := by
    simpa only [intDot, Fin.sum_univ_four, dot4] using he
  have heR : dot4 (realVec4 m) (realVec4 e) = 1 := by
    rw [realVec4_dot4, he4]
    norm_num
  rw [integerCenterLift_dot, ha, heR]
  ring

/-- Actual zero-hyperplane lift of any point satisfying the relation
modulo one. Primitivity supplies the integer Bézout vector. -/
theorem primitive_modular_center_lift (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (a : Vec4 ℝ) (j : ℤ) (ha : dot4 (realVec4 m) a = (j : ℝ)) :
    ∃ x : Vec4 ℝ, dot4 (realVec4 m) x = 0 ∧
      (∀ i, (x i : Time) = (a i : Time)) := by
  obtain ⟨e, he⟩ := primitive_integer_bezout m hm
  exact ⟨integerCenterLift a e j, integerCenterLift_hyperplane m e a j he ha,
    integerCenterLift_circle a e j⟩

/-- Any coordinate-distance margin of the modular center survives the
lift at one common point in the actual zero hyperplane. -/
theorem primitive_modular_center_lift_distance_ge (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (a : Vec4 ℝ) (j : ℤ) (ha : dot4 (realVec4 m) a = (j : ℝ))
    (L : ℝ) (hL : ∀ i, L ≤ distance (a i : Time)) :
    ∃ x : Vec4 ℝ, dot4 (realVec4 m) x = 0 ∧
      (∀ i, L ≤ distance (x i : Time)) := by
  obtain ⟨x, hx, hc⟩ := primitive_modular_center_lift m hm a j ha
  refine ⟨x, hx, ?_⟩
  intro i
  rw [hc i]
  exact hL i

def allHalfCenter : Vec4 ℝ := fun _ => 1 / 2

theorem allHalfCenter_relation (m : Vec4 ℤ) (j : ℤ)
    (heven : (∑ i, m i) = 2 * j) :
    dot4 (realVec4 m) allHalfCenter = (j : ℝ) := by
  have hevenR : (∑ i, (m i : ℝ)) = 2 * (j : ℝ) := by
    exact_mod_cast heven
  calc
    dot4 (realVec4 m) allHalfCenter = (∑ i, (m i : ℝ)) / 2 := by
      simp only [dot4, realVec4, allHalfCenter, Fin.sum_univ_four]
      ring
    _ = (j : ℝ) := by rw [hevenR]; ring

theorem allHalfCenter_distance (i : Fin 4) :
    distance (allHalfCenter i : Time) = (1 / 2 : ℝ) := by
  simpa [distance, allHalfCenter] using AddCircle.norm_half_period_eq (1 : ℝ)

/-- The all-half modular center gives an actual point of the zero
hyperplane whose four circle distances are all exactly one half. -/
theorem primitive_even_center_lift (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (j : ℤ) (heven : (∑ i, m i) = 2 * j) :
    ∃ x : Vec4 ℝ, dot4 (realVec4 m) x = 0 ∧
      (∀ i, distance (x i : Time) = (1 / 2 : ℝ)) := by
  obtain ⟨x, hx, hc⟩ := primitive_modular_center_lift m hm allHalfCenter j
    (allHalfCenter_relation m j heven)
  refine ⟨x, hx, ?_⟩
  intro i
  rw [hc i]
  exact allHalfCenter_distance i

def additiveBiasedCenter : Vec4 ℝ := ![1 / 3, 1 / 3, 2 / 3, 1 / 2]

/-- The biased center already lies in the zero hyperplane of the
normalized additive relation and has the required one-third margin. -/
theorem additive_biased_center :
    dot4 (realVec4 (![1, 1, -1, 0] : Vec4 ℤ)) additiveBiasedCenter = 0 ∧
      (∀ i, (1 / 3 : ℝ) ≤ distance (additiveBiasedCenter i : Time)) := by
  constructor
  · norm_num [dot4, realVec4, additiveBiasedCenter,
      Matrix.cons_val_two, Matrix.cons_val_three]
  · intro i
    fin_cases i <;>
      apply distance_coe_ge_of_interval (j := (0 : ℤ)) <;>
      norm_num [additiveBiasedCenter]












end Math15.Source05Review
end 
end 

/- Section: IntegralGaussBasis -/
section




/-!
Gauss basis existence for a positive integral binary quadratic form.

An actual shortest nonzero integer pair is selected by well-ordering its
positive integer value. If its coordinates had a common factor greater than
one, division by that factor would give a strictly shorter pair. The resulting
primitive pair is completed by integer Bezout coefficients to a
determinant-one basis. Integer quotient rounding shears its second vector
until twice the absolute inner product is at most the first norm. The second
vector remains nonzero and hence at least as long as the first.

No reduced-basis, discrete-lattice, shortest-vector, or basis-completion
existence assumption is used. The positive-form hypothesis is the precise
interface for the projected integral Gram form in the geometric argument.
-/

noncomputable section
namespace Math15.LonelyRunner

def integralQuadratic (A B C p q : ℤ) : ℤ :=
  A * p ^ 2 + 2 * B * p * q + C * q ^ 2

def integralBilinear (A B C p q r s : ℤ) : ℤ :=
  A * p * r + B * (p * s + q * r) + C * q * s

theorem integralQuadratic_scale (A B C k p q : ℤ) :
    integralQuadratic A B C (p * k) (q * k) =
      k ^ 2 * integralQuadratic A B C p q := by
  unfold integralQuadratic
  ring

theorem integralBilinear_shear (A B C p q r s k : ℤ) :
    integralBilinear A B C p q (r - k * p) (s - k * q) =
      integralBilinear A B C p q r s -
        k * integralQuadratic A B C p q := by
  unfold integralBilinear integralQuadratic
  ring

theorem integral_gram_determinant_identity (A B C p q r s : ℤ) :
    integralQuadratic A B C p q * integralQuadratic A B C r s -
      integralBilinear A B C p q r s ^ 2 =
        (A * C - B ^ 2) * (p * s - q * r) ^ 2 := by
  unfold integralQuadratic integralBilinear
  ring

/-- The usual determinant conditions supply the precise positive-form
hypothesis. The main existence theorem can also consume positivity directly. -/
theorem integralQuadratic_positive_of_gram {A B C : ℤ}
    (hA : 0 < A) (hD : 0 < A * C - B ^ 2) :
    ∀ p q : ℤ, p ≠ 0 ∨ q ≠ 0 → 0 < integralQuadratic A B C p q := by
  intro p q hpq
  by_cases hq : q = 0
  · have hp : p ≠ 0 := hpq.elim id (fun hqne => False.elim (hqne hq))
    have hp2 : 0 < p ^ 2 := sq_pos_of_ne_zero hp
    simpa only [integralQuadratic, hq, mul_zero, zero_pow (by decide : 2 ≠ 0),
      add_zero] using mul_pos hA hp2
  · have hq2 : 0 < q ^ 2 := sq_pos_of_ne_zero hq
    have hprod : 0 < (A * C - B ^ 2) * q ^ 2 := mul_pos hD hq2
    have hid : A * integralQuadratic A B C p q =
        (A * p + B * q) ^ 2 + (A * C - B ^ 2) * q ^ 2 := by
      unfold integralQuadratic
      ring
    have hAQ : 0 < A * integralQuadratic A B C p q := by
      rw [hid]
      exact add_pos_of_nonneg_of_pos (sq_nonneg _) hprod
    by_contra h
    have hQ : integralQuadratic A B C p q ≤ 0 := le_of_not_gt h
    have hAQ' := mul_nonpos_of_nonneg_of_nonpos hA.le hQ
    exact (not_le_of_gt hAQ) hAQ'

/-- Positive integer values attain a minimum over all nonzero coefficient
pairs. There is no real coercivity or finite truncation premise. -/
theorem exists_shortest_integral_pair (A B C : ℤ)
    (hpos : ∀ p q : ℤ, p ≠ 0 ∨ q ≠ 0 →
      0 < integralQuadratic A B C p q) :
    ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
      0 < integralQuadratic A B C p q ∧
      ∀ r s : ℤ, r ≠ 0 ∨ s ≠ 0 →
        integralQuadratic A B C p q ≤ integralQuadratic A B C r s := by
  classical
  let P : ℕ → Prop := fun n => ∃ p q : ℤ,
    (p ≠ 0 ∨ q ≠ 0) ∧ (integralQuadratic A B C p q).natAbs = n
  have hP : ∃ n : ℕ, P n :=
    ⟨(integralQuadratic A B C 1 0).natAbs, 1, 0, Or.inl (by decide), rfl⟩
  obtain ⟨p, q, hpq, habs⟩ := (Nat.find_spec hP : P (Nat.find hP))
  have hQ : 0 < integralQuadratic A B C p q := hpos p q hpq
  refine ⟨p, q, hpq, hQ, ?_⟩
  intro r s hrs
  have hn : Nat.find hP ≤ (integralQuadratic A B C r s).natAbs :=
    Nat.find_min' hP ⟨r, s, hrs, rfl⟩
  rw [← habs] at hn
  have hZ : ((integralQuadratic A B C p q).natAbs : ℤ) ≤
      ((integralQuadratic A B C r s).natAbs : ℤ) := by exact_mod_cast hn
  simpa only [Int.natAbs_of_nonneg hQ.le,
    Int.natAbs_of_nonneg (hpos r s hrs).le] using hZ

/-- A shortest nonzero integral pair is primitive: a common integer factor
would divide both coordinates and shorten its positive quadratic value. -/
theorem shortest_integral_pair_primitive {A B C p q : ℤ}
    (hpos : ∀ r s : ℤ, r ≠ 0 ∨ s ≠ 0 →
      0 < integralQuadratic A B C r s)
    (hpq : p ≠ 0 ∨ q ≠ 0)
    (hmin : ∀ r s : ℤ, r ≠ 0 ∨ s ≠ 0 →
      integralQuadratic A B C p q ≤ integralQuadratic A B C r s) :
    Int.gcd p q = 1 := by
  have hgne : Int.gcd p q ≠ 0 := by
    intro hg
    have hz := Int.gcd_eq_zero_iff.mp hg
    exact hpq.elim (fun hp => hp hz.1) (fun hq => hq hz.2)
  have hgpos : 0 < Int.gcd p q := Nat.pos_of_ne_zero hgne
  obtain ⟨p', q', hg', hp, hq⟩ := Int.exists_gcd_one hgpos
  have hpq' : p' ≠ 0 ∨ q' ≠ 0 := by
    by_contra h
    push_neg at h
    have hp0 : p = 0 := by simpa only [h.1, zero_mul] using hp
    have hq0 : q = 0 := by simpa only [h.2, zero_mul] using hq
    exact hpq.elim (fun hpne => hpne hp0) (fun hqne => hqne hq0)
  by_contra hg1
  have hg2 : 2 ≤ Int.gcd p q := by omega
  have hgZ : (2 : ℤ) ≤ (Int.gcd p q : ℤ) := by exact_mod_cast hg2
  have hgSq : 0 < (Int.gcd p q : ℤ) ^ 2 - 1 := by
    nlinarith [sq_nonneg ((Int.gcd p q : ℤ) - 2)]
  have hprod : 0 < ((Int.gcd p q : ℤ) ^ 2 - 1) *
      integralQuadratic A B C p' q' := mul_pos hgSq (hpos p' q' hpq')
  have hscale : integralQuadratic A B C p q =
      (Int.gcd p q : ℤ) ^ 2 * integralQuadratic A B C p' q' := by
    calc
      integralQuadratic A B C p q =
          integralQuadratic A B C (p' * (Int.gcd p q : ℤ)) (q' * (Int.gcd p q : ℤ)) :=
        congrArg₂ (integralQuadratic A B C) hp hq
      _ = (Int.gcd p q : ℤ) ^ 2 * integralQuadratic A B C p' q' :=
        integralQuadratic_scale A B C (Int.gcd p q : ℤ) p' q'
  have hshort := hmin p' q' hpq'
  nlinarith

/-- Integer nearest-multiple rounding, including both equality endpoints.
The quotient is explicit and works for positive and negative x. -/
theorem exists_integer_nearest_multiple (a x : ℤ) (ha : 0 < a) :
    ∃ k : ℤ, |2 * (x - k * a)| ≤ a := by
  let k : ℤ := (2 * x + a) / (2 * a)
  have hd : 0 < 2 * a := by omega
  have he := Int.emod_add_ediv_mul (2 * x + a) (2 * a)
  have hlo := Int.emod_nonneg (2 * x + a) (ne_of_gt hd)
  have hhi := Int.emod_lt_of_pos (2 * x + a) hd
  change (2 * x + a) % (2 * a) + k * (2 * a) = 2 * x + a at he
  refine ⟨k, abs_le.mpr ⟨?_, ?_⟩⟩ <;> nlinarith

/-- Actual Gauss basis existence. The determinant-one coefficients form a
full integer basis; the first vector is globally shortest, and the second
is explicitly sheared to satisfy the Gauss inner-product inequality. -/
theorem exists_integral_gauss_basis (A B C : ℤ)
    (hpos : ∀ p q : ℤ, p ≠ 0 ∨ q ≠ 0 →
      0 < integralQuadratic A B C p q) :
    ∃ p q r s : ℤ,
      p * s - q * r = 1 ∧
      0 < integralQuadratic A B C p q ∧
      integralQuadratic A B C p q ≤ integralQuadratic A B C r s ∧
      |2 * integralBilinear A B C p q r s| ≤ integralQuadratic A B C p q ∧
      ∀ x y : ℤ, x ≠ 0 ∨ y ≠ 0 →
        integralQuadratic A B C p q ≤ integralQuadratic A B C x y := by
  obtain ⟨p, q, hpq, hQ, hmin⟩ := exists_shortest_integral_pair A B C hpos
  have hprim := shortest_integral_pair_primitive hpos hpq hmin
  let r0 : ℤ := -Int.gcdB p q
  let s0 : ℤ := Int.gcdA p q
  have hdet0 : p * s0 - q * r0 = 1 := by
    calc
      p * s0 - q * r0 = p * Int.gcdA p q + q * Int.gcdB p q := by
        dsimp [r0, s0]
        ring
      _ = 1 := by rw [← Int.gcd_eq_gcd_ab, hprim]; rfl
  obtain ⟨k, hk⟩ := exists_integer_nearest_multiple
    (integralQuadratic A B C p q) (integralBilinear A B C p q r0 s0) hQ
  let r : ℤ := r0 - k * p
  let s : ℤ := s0 - k * q
  have hdet : p * s - q * r = 1 := by
    calc
      p * s - q * r = p * s0 - q * r0 := by dsimp [r, s]; ring
      _ = 1 := hdet0
  have hrs : r ≠ 0 ∨ s ≠ 0 := by
    by_contra h
    push_neg at h
    rw [h.1, h.2] at hdet
    norm_num at hdet
  have hinner : integralBilinear A B C p q r s =
      integralBilinear A B C p q r0 s0 - k * integralQuadratic A B C p q := by
    exact integralBilinear_shear A B C p q r0 s0 k
  refine ⟨p, q, r, s, hdet, hQ, hmin r s hrs, ?_, hmin⟩
  rw [hinner]
  exact hk

theorem exists_integral_gauss_basis_of_gram {A B C : ℤ}
    (hA : 0 < A) (hD : 0 < A * C - B ^ 2) :
    ∃ p q r s : ℤ,
      p * s - q * r = 1 ∧
      0 < integralQuadratic A B C p q ∧
      integralQuadratic A B C p q ≤ integralQuadratic A B C r s ∧
      |2 * integralBilinear A B C p q r s| ≤ integralQuadratic A B C p q ∧
      ∀ x y : ℤ, x ≠ 0 ∨ y ≠ 0 →
        integralQuadratic A B C p q ≤ integralQuadratic A B C x y :=
  exists_integral_gauss_basis A B C (integralQuadratic_positive_of_gram hA hD)

/-- Direct real Gram interface: squared lengths are ordered and the
absolute inner product is at most half the shorter squared length. -/
theorem exists_integral_gauss_basis_real (A B C : ℤ)
    (hpos : ∀ p q : ℤ, p ≠ 0 ∨ q ≠ 0 →
      0 < integralQuadratic A B C p q) :
    ∃ p q r s : ℤ,
      p * s - q * r = 1 ∧
      (0 : ℝ) < (integralQuadratic A B C p q : ℝ) ∧
      (integralQuadratic A B C p q : ℝ) ≤ (integralQuadratic A B C r s : ℝ) ∧
      |(integralBilinear A B C p q r s : ℝ)| ≤
        (integralQuadratic A B C p q : ℝ) / 2 := by
  obtain ⟨p, q, r, s, hdet, hQ, hlen, hinner, hmin⟩ :=
    exists_integral_gauss_basis A B C hpos
  have hQR : (0 : ℝ) < (integralQuadratic A B C p q : ℝ) := by exact_mod_cast hQ
  have hlenR : (integralQuadratic A B C p q : ℝ) ≤
      (integralQuadratic A B C r s : ℝ) := by exact_mod_cast hlen
  have hinnerR : |2 * (integralBilinear A B C p q r s : ℝ)| ≤
      (integralQuadratic A B C p q : ℝ) := by exact_mod_cast hinner
  rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)] at hinnerR
  exact ⟨p, q, r, s, hdet, hQR, hlenR, by linarith⟩












end Math15.LonelyRunner
end 
end 

/- Section: GaussRectangle -/
section



/-!
Explicit nearest-lattice rectangle construction for a given planar basis
(a,0),(b,h). The floor choices and squared error bound are proved directly.
The Gauss hypotheses sharpen that bound to 7*h^2/12; a dual candidate is
exhibited by its actual pairings with both basis vectors.

These bounds apply to the supplied reduced basis. Basis existence and the
lattice transfers are provided separately.
-/

namespace Math15.LonelyRunner

/-- Rounding after positive rescaling leaves a real error of at most half
the scale. This includes the equality endpoints. -/
theorem floor_nearest_scaled_error (a x : ℝ) (ha : 0 < a) :
    |x - (Int.floor (x / a + 1 / 2) : ℝ) * a| ≤ a / 2 := by
  let i : ℤ := Int.floor (x / a + 1 / 2)
  have hlo : (i : ℝ) ≤ x / a + 1 / 2 := Int.floor_le _
  have hhi : x / a + 1 / 2 < (i : ℝ) + 1 := Int.lt_floor_add_one _
  have hid : (x / a) * a = x := by field_simp [ne_of_gt ha]
  have hlom := mul_le_mul_of_nonneg_right hlo ha.le
  have hhim := mul_lt_mul_of_pos_right hhi ha
  apply abs_le.mpr
  constructor <;> dsimp [i] at * <;> nlinarith

/-- The actual common pair of integer coefficients is obtained by first
rounding the vertical component, then rounding the horizontal component
on that lattice level. -/
theorem exists_gauss_rectangle_nearest
    (a b h x y : ℝ) (ha : 0 < a) (hh : 0 < h) :
    ∃ i j : ℤ,
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2 ≤ (a ^ 2 + h ^ 2) / 4 := by
  let j : ℤ := Int.floor (y / h + 1 / 2)
  let i : ℤ := Int.floor ((x - (j : ℝ) * b) / a + 1 / 2)
  have hx := floor_nearest_scaled_error a (x - (j : ℝ) * b) ha
  have hy := floor_nearest_scaled_error h y hh
  change |(x - (j : ℝ) * b) - (i : ℝ) * a| ≤ a / 2 at hx
  change |y - (j : ℝ) * h| ≤ h / 2 at hy
  have hex : (x - (j : ℝ) * b) - (i : ℝ) * a =
      x - ((i : ℝ) * a + (j : ℝ) * b) := by ring
  rw [hex] at hx
  have hxb := abs_le.mp hx
  have hyb := abs_le.mp hy
  have hxprod : (0 : ℝ) ≤
      (a / 2 + (x - ((i : ℝ) * a + (j : ℝ) * b))) *
        (a / 2 - (x - ((i : ℝ) * a + (j : ℝ) * b))) := by
    apply mul_nonneg <;> linarith
  have hyprod : (0 : ℝ) ≤
      (h / 2 + (y - (j : ℝ) * h)) *
        (h / 2 - (y - (j : ℝ) * h)) := by
    apply mul_nonneg <;> linarith
  refine ⟨i, j, ?_⟩
  nlinarith

/-- The two Gauss reduction hypotheses bound the shorter basis length in
terms of its perpendicular height. -/
theorem gauss_shorter_square_bound {a b h : ℝ}
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    a ^ 2 ≤ 4 * h ^ 2 / 3 := by
  have hb := abs_le.mp hproj
  have hprod : (0 : ℝ) ≤ (a / 2 + b) * (a / 2 - b) := by
    apply mul_nonneg <;> linarith
  nlinarith

/-- The explicit floor construction in a reduced basis has the uniform
squared error 7*h^2/12 used by the planar transference argument. -/
theorem exists_gauss_reduced_nearest
    (a b h x y : ℝ) (ha : 0 < a) (hh : 0 < h)
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2) :
    ∃ i j : ℤ,
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2 ≤ 7 * h ^ 2 / 12 := by
  obtain ⟨i, j, hij⟩ := exists_gauss_rectangle_nearest a b h x y ha hh
  have hshort := gauss_shorter_square_bound hproj hlen
  refine ⟨i, j, ?_⟩
  nlinarith

/-- This vector actually pairs integrally with the two chosen basis
vectors, with pairings zero and one. -/
theorem gauss_vertical_dual_pairings (a b h : ℝ) (hh : 0 < h) :
    (0 : ℝ) * a + (1 / h) * 0 = 0 ∧
      (0 : ℝ) * b + (1 / h) * h = 1 := by
  constructor
  · ring
  · field_simp [ne_of_gt hh] <;> ring

theorem gauss_vertical_dual_length (h : ℝ) (hh : 0 < h) :
    Real.sqrt ((0 : ℝ) ^ 2 + (1 / h) ^ 2) = 1 / h := by
  rw [show (0 : ℝ) ^ 2 + (1 / h) ^ 2 = (1 / h) ^ 2 by ring,
    Real.sqrt_sq_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < 1 / h)]

/-- If one actual point misses every lattice point by more than eta,
the exhibited vertical dual vector is short. This requires neither a
covering-radius definition nor a shortest-dual-vector existence theorem. -/
theorem gauss_vertical_dual_short_of_missed_point
    (a b h x y eta : ℝ) (ha : 0 < a) (hh : 0 < h) (heta : 0 < eta)
    (hproj : |b| ≤ a / 2) (hlen : a ^ 2 ≤ b ^ 2 + h ^ 2)
    (hmiss : ∀ i j : ℤ, eta ^ 2 <
      (x - ((i : ℝ) * a + (j : ℝ) * b)) ^ 2 +
        (y - (j : ℝ) * h) ^ 2) :
    (1 / h) ^ 2 < 7 / (12 * eta ^ 2) := by
  obtain ⟨i, j, hij⟩ := exists_gauss_reduced_nearest a b h x y ha hh hproj hlen
  have he : eta ^ 2 < 7 * h ^ 2 / 12 := (hmiss i j).trans_le hij
  rw [div_pow, one_pow]
  apply (div_lt_div_iff₀ (by positivity : (0 : ℝ) < h ^ 2)
    (by positivity : (0 : ℝ) < 12 * eta ^ 2)).2
  nlinarith









end Math15.LonelyRunner
end 

/- Section: GramGaussTransference -/
section


/-!
Nearest coefficients and explicit dual transference in Gram coordinates.

For Q(x,y)=a*x^2+2*b*x*y+c*y^2 and D=a*c-b^2, first round y to j, then round
x+(b/a)*(y-j) to i. Completing the square gives

  a*Q(x-i,y-j) = a^2*(x-i+(b/a)*(y-j))^2 + D*(y-j)^2.

Both rounded errors have absolute value at most1/2. Thus Q(error) is at most
(a^2+D)/(4*a). The Gauss conditions c>=a and |2*b|<=a imply a^2<=4*D/3, giving
7*D/(12*a). If one actual point misses every integer pair by more than eta,
this forces a/D<7/(12*eta^2).

The coefficient vector (-b/D,a/D) is also exhibited: its Gram pairings with
the two basis vectors are0 and1 and its Gram square is exactly a/D. No
covering-radius, rotation, shortest-dual, or dual-existence hypothesis occurs
in these scalar statements.
-/

noncomputable section
namespace Math15.LonelyRunner

def gramQuadratic (a b c x y : ℝ) : ℝ :=
  a * x ^ 2 + 2 * b * x * y + c * y ^ 2

theorem gram_completing_square (a b c x y : ℝ) :
    a * gramQuadratic a b c x y =
      (a * x + b * y) ^ 2 + (a * c - b ^ 2) * y ^ 2 := by
  unfold gramQuadratic
  ring

theorem gram_gauss_shorter_bound {a b c : ℝ}
    (ha : 0 < a) (hlen : a ≤ c) (hproj : |2 * b| ≤ a) :
    a ^ 2 ≤ 4 * (a * c - b ^ 2) / 3 := by
  have hb := abs_le.mp hproj
  have hprod : (0 : ℝ) ≤ (a + 2 * b) * (a - 2 * b) := by
    apply mul_nonneg <;> linarith
  have hlenMul := mul_le_mul_of_nonneg_left hlen ha.le
  nlinarith

/-- Explicit rounding coefficients, before using the Gauss reduction
conditions. Nonnegative determinant is enough for this nearest bound. -/
theorem exists_gram_nearest_coefficients
    (a b c x y : ℝ) (ha : 0 < a) (hD : 0 ≤ a * c - b ^ 2) :
    ∃ i j : ℤ, gramQuadratic a b c (x - (i : ℝ)) (y - (j : ℝ)) ≤
      (a ^ 2 + (a * c - b ^ 2)) / (4 * a) := by
  let j : ℤ := Int.floor (y + 1 / 2)
  let z : ℝ := x + (b / a) * (y - (j : ℝ))
  let i : ℤ := Int.floor (z + 1 / 2)
  have hj : |y - (j : ℝ)| ≤ (1 / 2 : ℝ) := by
    simpa only [div_one, mul_one] using
      floor_nearest_scaled_error 1 y (by norm_num)
  have hi : |z - (i : ℝ)| ≤ (1 / 2 : ℝ) := by
    simpa only [div_one, mul_one] using
      floor_nearest_scaled_error 1 z (by norm_num)
  have hjBounds := abs_le.mp hj
  have hiBounds := abs_le.mp hi
  have hjSq : (y - (j : ℝ)) ^ 2 ≤ (1 / 4 : ℝ) := by
    have hh : (0 : ℝ) ≤ (1 / 2 + (y - (j : ℝ))) *
        (1 / 2 - (y - (j : ℝ))) := by
      apply mul_nonneg <;> linarith
    nlinarith
  have hiSq : (z - (i : ℝ)) ^ 2 ≤ (1 / 4 : ℝ) := by
    have hh : (0 : ℝ) ≤ (1 / 2 + (z - (i : ℝ))) *
        (1 / 2 - (z - (i : ℝ))) := by
      apply mul_nonneg <;> linarith
    nlinarith
  have hz : a * (z - (i : ℝ)) =
      a * (x - (i : ℝ)) + b * (y - (j : ℝ)) := by
    dsimp [z]
    field_simp [ne_of_gt ha] <;> ring
  have hsplit := gram_completing_square a b c
    (x - (i : ℝ)) (y - (j : ℝ))
  rw [← hz, mul_pow] at hsplit
  have hiWeight := mul_le_mul_of_nonneg_left hiSq (sq_nonneg a)
  have hjWeight := mul_le_mul_of_nonneg_left hjSq hD
  refine ⟨i, j, ?_⟩
  apply (le_div_iff₀ (by positivity : (0 : ℝ) < 4 * a)).2
  nlinarith

/-- Every actual coefficient point has an integer approximation at the
uniform Gauss bound; the integer pair is produced by the preceding floor
construction, rather than a covering-radius theorem. -/
theorem exists_gram_gauss_nearest
    (a b c x y : ℝ) (ha : 0 < a) (hD : 0 < a * c - b ^ 2)
    (hlen : a ≤ c) (hproj : |2 * b| ≤ a) :
    ∃ i j : ℤ, gramQuadratic a b c (x - (i : ℝ)) (y - (j : ℝ)) ≤
      7 * (a * c - b ^ 2) / (12 * a) := by
  obtain ⟨i, j, hij⟩ := exists_gram_nearest_coefficients a b c x y ha hD.le
  have hshort := gram_gauss_shorter_bound ha hlen hproj
  have hnum : a ^ 2 + (a * c - b ^ 2) ≤
      7 * (a * c - b ^ 2) / 3 := by linarith
  refine ⟨i, j, hij.trans ?_⟩
  calc
    (a ^ 2 + (a * c - b ^ 2)) / (4 * a) ≤
        (7 * (a * c - b ^ 2) / 3) / (4 * a) :=
      (div_le_div_iff_of_pos_right (by positivity : (0 : ℝ) < 4 * a)).2 hnum
    _ = 7 * (a * c - b ^ 2) / (12 * a) := by
      field_simp [ne_of_gt ha] <;> ring

/-- The displayed dual candidate has literal integral Gram pairings0,1
with the two supplied basis vectors. -/
theorem gram_second_dual_pairings (a b c : ℝ)
    (hD : a * c - b ^ 2 ≠ 0) :
    a * (-b / (a * c - b ^ 2)) + b * (a / (a * c - b ^ 2)) = 0 ∧
    b * (-b / (a * c - b ^ 2)) + c * (a / (a * c - b ^ 2)) = 1 := by
  constructor <;> field_simp [hD] <;> ring

/-- This is the actual Gram square of the same dual candidate. -/
theorem gram_second_dual_square (a b c : ℝ)
    (hD : a * c - b ^ 2 ≠ 0) :
    gramQuadratic a b c (-b / (a * c - b ^ 2)) (a / (a * c - b ^ 2)) =
      a / (a * c - b ^ 2) := by
  unfold gramQuadratic
  field_simp [hD] <;> ring

/-- One actual point missing all integer coefficient pairs forces the
explicit second dual to have this short squared length. -/
theorem gram_gauss_dual_short_of_missed_point
    (a b c x y eta : ℝ) (ha : 0 < a) (hD : 0 < a * c - b ^ 2)
    (heta : 0 < eta) (hlen : a ≤ c) (hproj : |2 * b| ≤ a)
    (hmiss : ∀ i j : ℤ, eta ^ 2 <
      gramQuadratic a b c (x - (i : ℝ)) (y - (j : ℝ))) :
    a / (a * c - b ^ 2) < 7 / (12 * eta ^ 2) := by
  obtain ⟨i, j, hij⟩ := exists_gram_gauss_nearest a b c x y ha hD hlen hproj
  have he : eta ^ 2 < 7 * (a * c - b ^ 2) / (12 * a) :=
    (hmiss i j).trans_le hij
  have heMul := (lt_div_iff₀ (by positivity : (0 : ℝ) < 12 * a)).mp he
  apply (div_lt_div_iff₀ hD (by positivity : (0 : ℝ) < 12 * eta ^ 2)).2
  nlinarith









end Math15.LonelyRunner
end 
end 

/- Section: ProjectedGramReduction -/
section


/-!
Native transfer from the integral binary quadratic form of an actual
three-vector integer basis to the Gram entries of its changed projected basis.
In particular, changed Gram nonsingularity is proved, not assumed.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

def binaryQ4 (a b c p q : ℤ) : ℤ := a*p^2+2*b*p*q+c*q^2
def binaryI4 (a b c p q r s : ℤ) : ℤ := a*p*r+b*(p*s+q*r)+c*q*s

def basisGramA (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 3) ℤ N) : ℤ :=
  areaSq4 (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ)
def basisGramB (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 3) ℤ N) : ℤ :=
  projectedCrossGram (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ) (b 2 : Vec4 ℤ)
def basisGramC (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 3) ℤ N) : ℤ :=
  areaSq4 (b 0 : Vec4 ℤ) (b 2 : Vec4 ℤ)
def basisProjectionDenom (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) : ℤ := dot4 (b 0 : Vec4 ℤ) (b 0 : Vec4 ℤ)

def changedBasisProjection (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q : ℤ) : Vec4 ℝ :=
  combine4 (p : ℝ) (basisProjection N b 1) (q : ℝ) (basisProjection N b 2)

theorem basisProjectionDenom_pos (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) : 0 < basisProjectionDenom N b :=
  basis_projection_first_norm_positive N b

theorem basis_binaryQ_positive (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q : ℤ) (hpq : p≠0 ∨ q≠0) :
    0 < binaryQ4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q := by
  have h := basis_projectionForm_positive N b p q hpq
  rw [projectionForm_expansion] at h
  exact h

theorem basis_integer_discriminant_positive (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    0 < basisGramA N b*basisGramC N b-(basisGramB N b)^2 :=
  projected_gram_determinant_positive _ _ _ (ambient_three_basis_independent N b)

theorem basisProjection_gram_entries (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    dot4 (basisProjection N b 1) (basisProjection N b 1) =
      (basisGramA N b : ℝ)/(basisProjectionDenom N b : ℝ) ∧
    dot4 (basisProjection N b 1) (basisProjection N b 2) =
      (basisGramB N b : ℝ)/(basisProjectionDenom N b : ℝ) ∧
    dot4 (basisProjection N b 2) (basisProjection N b 2) =
      (basisGramC N b : ℝ)/(basisProjectionDenom N b : ℝ) := by
  have hv : dot4 (b 0 : Vec4 ℤ) (b 0 : Vec4 ℤ) ≠ 0 :=
    ne_of_gt (basis_projection_first_norm_positive N b)
  have h10 : combine4 (1 : ℤ) (b 1 : Vec4 ℤ) 0 (b 2 : Vec4 ℤ) = b 1 := by
    funext i
    simp [combine4]
  have h01 : combine4 (0 : ℤ) (b 1 : Vec4 ℤ) 1 (b 2 : Vec4 ℤ) = b 2 := by
    funext i
    simp [combine4]
  refine ⟨?_, ?_, ?_⟩
  · have h := projected_integer_form_normSq (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ)
      (b 2 : Vec4 ℤ) hv 1 0
    rw [projectionForm, h10] at h
    exact h
  · exact projected_integer_cross_gram (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ)
      (b 2 : Vec4 ℤ) hv
  · have h := projected_integer_form_normSq (b 0 : Vec4 ℤ) (b 1 : Vec4 ℤ)
      (b 2 : Vec4 ℤ) hv 0 1
    rw [projectionForm, h01] at h
    exact h

theorem dot4_combine_self {R : Type*} [CommRing R]
    (u w : Vec4 R) (p q : R) :
    dot4 (combine4 p u q w) (combine4 p u q w) =
      dot4 u u*p^2+2*dot4 u w*p*q+dot4 w w*q^2 := by
  simp only [dot4_combine, dot4_combine_right, dot4_symm w u]
  ring

theorem dot4_combine_mixed {R : Type*} [CommRing R]
    (u w : Vec4 R) (p q r s : R) :
    dot4 (combine4 p u q w) (combine4 r u s w) =
      dot4 u u*p*r+dot4 u w*(p*s+q*r)+dot4 w w*q*s := by
  simp only [dot4_combine, dot4_combine_right, dot4_symm w u]
  ring

theorem gramDet4_combine (u w : Vec4 ℝ) (p q r s : ℝ) :
    gramDet4 (combine4 p u q w) (combine4 r u s w) =
      (p*s-q*r)^2*gramDet4 u w := by
  simp only [gramDet4, dot4_combine_self, dot4_combine_mixed]
  ring

theorem changedBasisProjection_normSq (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q : ℤ) :
    dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) =
      ((binaryQ4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q : ℤ) : ℝ) /
        (basisProjectionDenom N b : ℝ) := by
  obtain ⟨ha, hb, hc⟩ := basisProjection_gram_entries N b
  rw [changedBasisProjection, dot4_combine_self, ha, hb, hc]
  unfold binaryQ4
  push_cast
  ring

theorem changedBasisProjection_cross (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) :
    dot4 (changedBasisProjection N b p q) (changedBasisProjection N b r s) =
      ((binaryI4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q r s : ℤ) : ℝ) /
        (basisProjectionDenom N b : ℝ) := by
  obtain ⟨ha, hb, hc⟩ := basisProjection_gram_entries N b
  simp only [changedBasisProjection]
  rw [dot4_combine_mixed, ha, hb, hc]
  unfold binaryI4
  push_cast
  ring

theorem basisProjection_gramDet (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    gramDet4 (basisProjection N b 1) (basisProjection N b 2) =
      ((basisGramA N b*basisGramC N b-(basisGramB N b)^2 : ℤ) : ℝ) /
        (basisProjectionDenom N b : ℝ)^2 := by
  obtain ⟨ha, hb, hc⟩ := basisProjection_gram_entries N b
  unfold gramDet4
  rw [ha, hb, hc]
  push_cast
  ring

theorem changedBasisProjection_gramDet (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1) :
    gramDet4 (changedBasisProjection N b p q) (changedBasisProjection N b r s) =
      ((basisGramA N b*basisGramC N b-(basisGramB N b)^2 : ℤ) : ℝ) /
        (basisProjectionDenom N b : ℝ)^2 := by
  have hd : (p : ℝ)*(s : ℝ)-(q : ℝ)*(r : ℝ)=1 := by exact_mod_cast hdet
  simp only [changedBasisProjection]
  rw [gramDet4_combine, hd, one_pow, one_mul, basisProjection_gramDet]

theorem changedBasisProjection_gramDet_pos (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1) :
    0 < gramDet4 (changedBasisProjection N b p q) (changedBasisProjection N b r s) := by
  rw [changedBasisProjection_gramDet N b p q r s hdet]
  have hn : 0 < ((basisGramA N b*basisGramC N b-(basisGramB N b)^2 : ℤ) : ℝ) := by
    exact_mod_cast basis_integer_discriminant_positive N b
  have hv : (0 : ℝ) < (basisProjectionDenom N b : ℝ) := by
    exact_mod_cast basisProjectionDenom_pos N b
  exact div_pos hn (sq_pos_of_pos hv)

/-- The previously exposed nonsingular-Gram premise is now discharged
from the actual integer basis and determinant-one coordinate change. -/
theorem native_changedProjectedDual_integral (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1) :
    dot4 (changedProjectedDual N b p q r s) (realVec4 (b 0))=0 ∧
      ∀ x : N, ∃ n : ℤ, dot4 (changedProjectedDual N b p q r s) (realVec4 x)=(n : ℝ) :=
  changedProjectedDual_integral N b p q r s hdet
    (ne_of_gt (changedBasisProjection_gramDet_pos N b p q r s hdet))

/-- Reduction inequalities of the integer form become the actual Gram
Gauss hypotheses after division by the same positive denominator. -/
theorem native_projected_gauss_conditions (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1)
    (hshort : binaryQ4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q ≤
      binaryQ4 (basisGramA N b) (basisGramB N b) (basisGramC N b) r s)
    (hshear : |2*binaryI4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q r s| ≤
      binaryQ4 (basisGramA N b) (basisGramB N b) (basisGramC N b) p q) :
    0 < dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) ∧
    0 < gramDet4 (changedBasisProjection N b p q) (changedBasisProjection N b r s) ∧
    dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) ≤
      dot4 (changedBasisProjection N b r s) (changedBasisProjection N b r s) ∧
    |2*dot4 (changedBasisProjection N b p q) (changedBasisProjection N b r s)| ≤
      dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) := by
  have hv : (0 : ℝ) < (basisProjectionDenom N b : ℝ) := by
    exact_mod_cast basisProjectionDenom_pos N b
  have hpq : p≠0 ∨ q≠0 := by
    by_contra h
    push_neg at h
    rcases h with ⟨hp, hq⟩
    rw [hp, hq] at hdet
    norm_num at hdet
  refine ⟨?_, changedBasisProjection_gramDet_pos N b p q r s hdet, ?_, ?_⟩
  · rw [changedBasisProjection_normSq]
    apply div_pos _ hv
    exact_mod_cast basis_binaryQ_positive N b p q hpq
  · rw [changedBasisProjection_normSq, changedBasisProjection_normSq]
    apply (div_le_div_iff_of_pos_right hv).2
    exact_mod_cast hshort
  · rw [changedBasisProjection_cross, changedBasisProjection_normSq]
    rw [← mul_div_assoc, abs_div, abs_of_pos hv]
    apply (div_le_div_iff_of_pos_right hv).2
    exact_mod_cast hshear
















end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: PrimitiveHyperplaneBasis -/
section




/-!
Primitive integer hyperplanes in Z^4 have rank three, and an ambient primitive
vector in such a hyperplane is the first member of an actual integral basis of
length three. The two gcd-one hypotheses are kept separate: that of the
relation makes its coordinate map onto Z; that of the speed vector supplies an
integral functional of value one inside the kernel.
-/

noncomputable section
namespace Math15.Source05Review
open Module

/-- A primitive integer row gives a surjective integer coordinate map. -/
theorem primitive_integerDotLinear_surjective (m : Fin 4 → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1) :
    Function.Surjective (integerDotLinear m) := by
  obtain ⟨z, hz⟩ := primitive_integer_bezout m hm
  intro a
  refine ⟨a • z, ?_⟩
  rw [map_smul]
  change a * intDot m z = a
  rw [hz, mul_one]

/-- Rank-nullity over Z gives the actual rank of a primitive hyperplane. -/
theorem primitive_integerDotLinear_kernel_finrank (m : Fin 4 → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1) :
    Module.finrank ℤ (LinearMap.ker (integerDotLinear m)) = 3 := by
  have hr : LinearMap.range (integerDotLinear m) = ⊤ :=
    LinearMap.range_eq_top.mpr (primitive_integerDotLinear_surjective m hm)
  have hn := (LinearMap.ker (integerDotLinear m)).finrank_quotient_add_finrank
  rw [(integerDotLinear m).quotKerEquivRange.finrank_eq, hr,
    finrank_top, Module.finrank_self, Module.finrank_fin_fun] at hn
  omega

/-- The linear-map kernel is exactly the native one-row equation kernel. -/
theorem integerDotLinear_ker_eq_one_row_kernel (m : Fin 4 → ℤ) :
    LinearMap.ker (integerDotLinear m) =
      integerEquationKernel (fun _ : Fin 1 => m) := by
  ext x
  change (intDot m x = 0) ↔ (∀ _ : Fin 1, intDot m x = 0)
  constructor
  · intro h _
    exact h
  · intro h
    exact h 0

theorem primitive_one_row_kernel_finrank (m : Fin 4 → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1) :
    Module.finrank ℤ (integerEquationKernel (fun _ : Fin 1 => m)) = 3 := by
  rw [← integerDotLinear_ker_eq_one_row_kernel]
  exact primitive_integerDotLinear_kernel_finrank m hm

/-- The primitive speed vector starts a length-three basis of the native
integer equation kernel, with its cardinality fully discharged. -/
theorem primitive_one_row_kernel_basis_starts_at_vector
    (m v : Fin 4 → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1)
    (hmv : intDot m v = 0) :
    ∃ b : Basis (Fin 3) ℤ (integerEquationKernel (fun _ : Fin 1 => m)),
      (b 0 : Fin 4 → ℤ) = v := by
  have hmem : v ∈ integerEquationKernel (fun _ : Fin 1 => m) := by
    intro _
    exact hmv
  obtain ⟨k, b, hb⟩ := primitive_vector_starts_kernel_basis
    (fun _ : Fin 1 => m) v hmem hv
  have hk : k = 2 := by
    have hc := Module.finrank_eq_card_basis b
    have hr := primitive_one_row_kernel_finrank m hm
    simp only [Fintype.card_fin, hr] at hc
    omega
  subst k
  exact ⟨b, hb⟩

/-- Actual Fin 3 basis of ker(m dot -), beginning with the primitive
speed vector. This supplies the native projected-Gram construction. -/
theorem primitive_hyperplane_basis_starts_at_vector
    (m v : Fin 4 → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1)
    (hmv : intDot m v = 0) :
    ∃ b : Basis (Fin 3) ℤ (LinearMap.ker (integerDotLinear m)),
      (b 0 : Fin 4 → ℤ) = v := by
  rw [integerDotLinear_ker_eq_one_row_kernel]
  exact primitive_one_row_kernel_basis_starts_at_vector m v hm hv hmv








end Math15.Source05Review
end 
end 

/- Section: GramNearestLine -/
section



/-!
# Nearest primitive integer line for a scalar Gram metric

For Gram entries a,b,c put D=a*c-b^2 and H=a*A^2+2*b*A*B+c*B^2. Assume H>0 and
D>=0. Round the transverse coordinate B*x-A*y to j, leaving |e|<=1/2. The
coefficient displacement

  dx=e*(c*B+b*A)/H,  dy=-e*(b*B+a*A)/H

has transverse coordinate e and Gram square e^2*D/H. The adjusted point lies
on B*X-A*Y=j. Bezout represents this same point as (q*j,-p*j)+(A,B)*t, exactly
as in the ordinary integer-torus metric. Thus its Gram square distance is
<=D/(4H).

For an actual lattice basis, D is squared covolume and H is squared length of
its primitive line vector. Basis existence, saturation, and that geometric
identification are separate transfer obligations.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem scalar_gram_nearest_integer_line (a b c : ℝ) (A B p q : ℤ)
    (hbez : A * p + B * q = 1)
    (hHpos : 0 < a * (A : ℝ) ^ 2 + 2 * b * (A : ℝ) * (B : ℝ) + c * (B : ℝ) ^ 2)
    (hDnonneg : 0 ≤ a * c - b ^ 2) (x y : ℝ) :
    ∃ t : ℝ, ∃ z1 z2 : ℤ,
      a * (x - ((z1 : ℝ) + (A : ℝ) * t)) ^ 2 +
        2 * b * (x - ((z1 : ℝ) + (A : ℝ) * t)) *
          (y - ((z2 : ℝ) + (B : ℝ) * t)) +
        c * (y - ((z2 : ℝ) + (B : ℝ) * t)) ^ 2 ≤
          (a * c - b ^ 2) /
            (4 * (a * (A : ℝ) ^ 2 + 2 * b * (A : ℝ) * (B : ℝ) + c * (B : ℝ) ^ 2)) := by
  have hbezR : (A : ℝ) * (p : ℝ) + (B : ℝ) * (q : ℝ) = 1 := by
    exact_mod_cast hbez
  let H : ℝ := a * (A : ℝ) ^ 2 + 2 * b * (A : ℝ) * (B : ℝ) + c * (B : ℝ) ^ 2
  let D : ℝ := a * c - b ^ 2
  have hHne : H ≠ 0 := ne_of_gt hHpos
  let j : ℤ := Int.floor ((B : ℝ) * x - (A : ℝ) * y + 1 / 2)
  let e : ℝ := (B : ℝ) * x - (A : ℝ) * y - (j : ℝ)
  have hjlo : (j : ℝ) ≤ (B : ℝ) * x - (A : ℝ) * y + 1 / 2 := Int.floor_le _
  have hjhi : (B : ℝ) * x - (A : ℝ) * y + 1 / 2 < (j : ℝ) + 1 :=
    Int.lt_floor_add_one _
  have helo : -(1 / 2 : ℝ) ≤ e := by dsimp [e]; linarith
  have hehi : e ≤ (1 / 2 : ℝ) := by dsimp [e]; linarith
  have heSq : e ^ 2 ≤ (1 / 4 : ℝ) := by
    nlinarith [mul_nonneg (by linarith : 0 ≤ e + 1 / 2)
      (by linarith : 0 ≤ 1 / 2 - e)]
  let dx : ℝ := e * (c * (B : ℝ) + b * (A : ℝ)) / H
  let dy : ℝ := -(e * (b * (B : ℝ) + a * (A : ℝ)) / H)
  let X : ℝ := x - dx
  let Y : ℝ := y - dy
  have hnormal : (B : ℝ) * X - (A : ℝ) * Y = (j : ℝ) := by
    dsimp [X, Y, dx, dy, e]
    field_simp [hHne] <;> (dsimp [H]; ring)
  let z1 : ℤ := q * j
  let z2 : ℤ := -(p * j)
  have hnormalSub : (B : ℝ) * (X - (z1 : ℝ)) -
      (A : ℝ) * (Y - (z2 : ℝ)) = 0 := by
    dsimp [z1, z2]
    push_cast
    linear_combination hnormal - (j : ℝ) * hbezR
  let t : ℝ := (p : ℝ) * (X - (z1 : ℝ)) + (q : ℝ) * (Y - (z2 : ℝ))
  have hXline : X = (z1 : ℝ) + (A : ℝ) * t := by
    dsimp [t]
    linear_combination -(X - (z1 : ℝ)) * hbezR + (q : ℝ) * hnormalSub
  have hYline : Y = (z2 : ℝ) + (B : ℝ) * t := by
    dsimp [t]
    linear_combination -(Y - (z2 : ℝ)) * hbezR - (p : ℝ) * hnormalSub
  have hxerr : x - ((z1 : ℝ) + (A : ℝ) * t) = dx := by
    rw [← hXline]
    dsimp [X]
    ring
  have hyerr : y - ((z2 : ℝ) + (B : ℝ) * t) = dy := by
    rw [← hYline]
    dsimp [Y]
    ring
  have herr : a * dx ^ 2 + 2 * b * dx * dy + c * dy ^ 2 = e ^ 2 * D / H := by
    dsimp [dx, dy]
    field_simp [hHne] <;> (dsimp [H, D]; ring)
  have hscale : e ^ 2 * D ≤ (1 / 4 : ℝ) * D :=
    mul_le_mul_of_nonneg_right heSq hDnonneg
  refine ⟨t, z1, z2, ?_⟩
  rw [hxerr, hyerr, herr]
  change e ^ 2 * D / H ≤ D / (4 * H)
  calc
    e ^ 2 * D / H ≤ ((1 / 4 : ℝ) * D) / H :=
      (div_le_div_iff_of_pos_right hHpos).2 hscale
    _ = D / (4 * H) := by field_simp [hHne] <;> ring



end Math15.LonelyRunner
end 
end 

/- Section: NativeNearestLine -/
section




/-!
Native nearest-line transfer for a supplied rank-two integer submodule basis.
The ambient gcd hypothesis itself supplies Bezout for the basis coordinates.
The metric is the explicit sum of four squared coordinate differences, not the
sup norm on a function space.
-/

noncomputable section
namespace Math15.Source05Review
open Module
open Math15.LonelyRunner
open Math15.LonelyRunner.Covolume4

/-- Ordinary squared Euclidean distance in the four displayed coordinates. -/
def sqDist4 (x y : Vec4 ℝ) : ℝ :=
  (x 0-y 0)^2+(x 1-y 1)^2+(x 2-y 2)^2+(x 3-y 3)^2

theorem basis_two_coordinate_identity
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N)
    (v : N) (i : Fin 4) :
    v.val i = b.repr v 0 * (b 0).val i + b.repr v 1 * (b 1).val i := by
  have hb := b.sum_repr v
  rw [Fin.sum_univ_two] at hb
  have hv := congrArg (fun w : N => w.val i) hb
  exact hv.symm

theorem basis_two_realCast_identity
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N) (v : N) :
    realCast v.val = combine4 (b.repr v 0 : ℝ) (realCast (b 0).val)
      (b.repr v 1 : ℝ) (realCast (b 1).val) := by
  funext i
  have hi := basis_two_coordinate_identity N b v i
  change (v.val i : ℝ) =
    (b.repr v 0 : ℝ) * ((b 0).val i : ℝ) +
      (b.repr v 1 : ℝ) * ((b 1).val i : ℝ)
  exact_mod_cast hi

theorem dot4_self_positive_of_ne_zero (v : Vec4 ℝ) (hv : v ≠ 0) :
    0 < dot4 v v := by
  have hex : ∃ i, v i ≠ 0 := by
    by_contra! hn
    exact hv (funext hn)
  obtain ⟨i, hi⟩ := hex
  have hp : 0 < ∑ j, (v j)^2 :=
    Finset.sum_pos' (fun j _ => sq_nonneg (v j))
      ⟨i, Finset.mem_univ i, sq_pos_of_ne_zero hi⟩
  simpa only [Fin.sum_univ_four, pow_two, dot4] using hp

theorem primitive_realCast_dot4_positive
    (v : Vec4 ℤ) (hprim : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    0 < dot4 (realCast v) (realCast v) := by
  apply dot4_self_positive_of_ne_zero
  intro hz
  have hv : v = 0 := by
    funext i
    have hi : (v i : ℝ) = 0 := by
      simpa [realCast] using congrFun hz i
    exact_mod_cast hi
  obtain ⟨z, hbez⟩ := primitive_integer_bezout v hprim
  simp [intDot, hv] at hbez

theorem dot4_combination_self (u w : Vec4 ℝ) (A B : ℝ) :
    dot4 (combine4 A u B w) (combine4 A u B w) =
      dot4 u u * A ^ 2 + 2 * dot4 u w * A * B + dot4 w w * B ^ 2 := by
  simp [dot4, combine4]
  ring

theorem sqDist4_combination_gram (u w : Vec4 ℝ) (x y X Y : ℝ) :
    sqDist4 (combine4 x u y w) (combine4 X u Y w) =
      dot4 u u * (x-X)^2 + 2 * dot4 u w * (x-X) * (y-Y) +
        dot4 w w * (y-Y)^2 := by
  simp [sqDist4, dot4, combine4]
  ring

theorem areaSq4_realCast (u w : Vec4 ℤ) :
    areaSq4 (realCast u) (realCast w) = ((areaSq4 u w : ℤ) : ℝ) := by
  simp [areaSq4, sqnorm6, plucker4, realCast]

/-- Actual integer-submodule approximation: the integer translate belongs
to the supplied submodule, and primitivity is only the original ambient
coordinate gcd condition. The numerator is the actual integer basis area
squared; the denominator is four times the actual speed length squared. -/
theorem native_rank_two_nearest_primitive_line
    (N : Submodule ℤ (Vec4 ℤ)) (b : Basis (Fin 2) ℤ N)
    (v : N) (hprim : Finset.univ.gcd (fun i => (v.val i).natAbs) = 1)
    (x y : ℝ) :
    ∃ (t : ℝ) (z : N),
      sqDist4 (combine4 x (realCast (b 0).val) y (realCast (b 1).val))
        (combine4 1 (realCast z.val) t (realCast v.val)) ≤
      ((areaSq4 (b 0).val (b 1).val : ℤ) : ℝ) /
        (4 * dot4 (realCast v.val) (realCast v.val)) := by
  classical
  let u : Vec4 ℝ := realCast (b 0).val
  let w : Vec4 ℝ := realCast (b 1).val
  let A : ℤ := b.repr v 0
  let B : ℤ := b.repr v 1
  obtain ⟨p, hp⟩ := primitive_coordinates_have_bezout N b v hprim
  have hbez : A * p 0 + B * p 1 = 1 := by
    simpa [Fin.sum_univ_two, A, B] using hp
  have hv : realCast v.val = combine4 (A : ℝ) u (B : ℝ) w :=
    basis_two_realCast_identity N b v
  have hnorm : dot4 (realCast v.val) (realCast v.val) =
      dot4 u u * (A : ℝ)^2 + 2 * dot4 u w * (A : ℝ) * (B : ℝ) +
        dot4 w w * (B : ℝ)^2 := by
    rw [hv]
    exact dot4_combination_self u w (A : ℝ) (B : ℝ)
  have hH : 0 < dot4 u u * (A : ℝ)^2 +
      2 * dot4 u w * (A : ℝ) * (B : ℝ) + dot4 w w * (B : ℝ)^2 := by
    rw [← hnorm]
    exact primitive_realCast_dot4_positive v.val hprim
  have hD : 0 ≤ dot4 u u * dot4 w w - (dot4 u w)^2 := by
    rw [← lagrange_area_identity]
    dsimp [areaSq4, sqnorm6]
    positivity
  obtain ⟨t, z1, z2, hnear⟩ := scalar_gram_nearest_integer_line
    (dot4 u u) (dot4 u w) (dot4 w w) A B (p 0) (p 1) hbez hH hD x y
  let z : N := z1 • b 0 + z2 • b 1
  have hz : realCast z.val = combine4 (z1 : ℝ) u (z2 : ℝ) w := by
    funext i
    simp [z, realCast, combine4, u, w, smul_eq_mul]
  have hline : combine4 1 (realCast z.val) t (realCast v.val) =
      combine4 ((z1 : ℝ) + (A : ℝ)*t) u
        ((z2 : ℝ) + (B : ℝ)*t) w := by
    rw [hz, hv]
    funext i
    simp [combine4]
    ring
  rw [← hnorm, ← lagrange_area_identity u w] at hnear
  have harea : areaSq4 u w = ((areaSq4 (b 0).val (b 1).val : ℤ) : ℝ) :=
    areaSq4_realCast (b 0).val (b 1).val
  rw [harea] at hnear
  refine ⟨t, z, ?_⟩
  change sqDist4 (combine4 x u y w)
      (combine4 1 (realCast z.val) t (realCast v.val)) ≤ _
  rw [hline, sqDist4_combination_gram]
  exact hnear










end Math15.Source05Review
end 
end 

/- Section: NativeGaussConsumer -/
section







/-!
Lattice assembly: an actual missed point in the projection of a primitive
integer hyperplane produces an actual short integer second relation. The only
geometric premise is the literal distance from every projected integer point.
No basis existence, real spanning, reduction, dual existence, or integral-lift
premise is assumed.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

theorem native_gauss_projected_basis (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) :
    ∃ p q r s : ℤ, p*s-q*r=1 ∧
      0 < dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) ∧
      0 < gramDet4 (changedBasisProjection N b p q) (changedBasisProjection N b r s) ∧
      dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) ≤
        dot4 (changedBasisProjection N b r s) (changedBasisProjection N b r s) ∧
      |2*dot4 (changedBasisProjection N b p q) (changedBasisProjection N b r s)| ≤
        dot4 (changedBasisProjection N b p q) (changedBasisProjection N b p q) := by
  obtain ⟨p,q,r,s,hdet,_,hshort,hshear,_⟩ := exists_integral_gauss_basis
    (basisGramA N b) (basisGramB N b) (basisGramC N b)
    (fun p q hpq => basis_binaryQ_positive N b p q hpq)
  exact ⟨p,q,r,s,hdet,native_projected_gauss_conditions N b p q r s hdet hshort hshear⟩

theorem projected_integer_pair (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s i j : ℤ) :
    ∃ z : N, perpendicularProjection4 (realVec4 (b 0)) (realVec4 z) =
      combine4 (i : ℝ) (changedBasisProjection N b p q)
        (j : ℝ) (changedBasisProjection N b r s) := by
  let z : N := (i*p+j*r) • b 1 + (i*q+j*s) • b 2
  have hz : realVec4 z = combine4 ((i*p+j*r : ℤ) : ℝ) (realVec4 (b 1))
      ((i*q+j*s : ℤ) : ℝ) (realVec4 (b 2)) := by
    funext k
    simp [z,realVec4,combine4]
  refine ⟨z, ?_⟩
  rw [hz, perpendicularProjection4_combine]
  funext k
  simp [combine4,changedBasisProjection,basisProjection]
  ring

theorem native_hyperplane_short_dual_of_missed_point (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x=0) (eta : ℝ) (heta : 0<eta)
    (hmiss : ∀ z : integerHyperplane4 m, eta^2 <
      dot4 (perpendicularProjection4 (realVec4 (b 0)) x -
        perpendicularProjection4 (realVec4 (b 0)) (realVec4 z))
        (perpendicularProjection4 (realVec4 (b 0)) x -
          perpendicularProjection4 (realVec4 (b 0)) (realVec4 z))) :
    ∃ y : Vec4 ℝ, y≠0 ∧ dot4 y (realVec4 m)=0 ∧
      dot4 y (realVec4 (b 0))=0 ∧
      (∀ z : integerHyperplane4 m, ∃ k : ℤ, dot4 y (realVec4 z)=(k : ℝ)) ∧
      dot4 y y < 7/(12*eta^2) := by
  let N := integerHyperplane4 m
  obtain ⟨p,q,r,s,hdet,ha,hD,hlen,hproj⟩ := native_gauss_projected_basis N b
  let U := changedBasisProjection N b p q
  let W := changedBasisProjection N b r s
  obtain ⟨B,C,hxspan⟩ := primitive_hyperplane_changed_projected_real_span m hm b
    p q r s hdet x hx
  have hcoefficient : ∀ i j : ℤ, eta^2 <
      gramQuadratic (dot4 U U) (dot4 U W) (dot4 W W)
        (B-(i : ℝ)) (C-(j : ℝ)) := by
    intro i j
    obtain ⟨z,hz⟩ := projected_integer_pair N b p q r s i j
    have herr : perpendicularProjection4 (realVec4 (b 0)) x -
        perpendicularProjection4 (realVec4 (b 0)) (realVec4 z) =
        combine4 (B-(i : ℝ)) U (C-(j : ℝ)) W := by
      rw [hxspan,hz]
      funext k
      simp [combine4,U,W,changedBasisProjection,N]
      ring
    have h := hmiss z
    rw [herr,dot4_combine_self] at h
    exact h
  have hshort := gram_gauss_dual_short_of_missed_point
    (dot4 U U) (dot4 U W) (dot4 W W) B C eta ha hD heta hlen hproj hcoefficient
  let y := changedProjectedDual N b p q r s
  obtain ⟨hyv,hyi⟩ := native_changedProjectedDual_integral N b p q r s hdet
  have hnorm : dot4 y y=dot4 U U/gramDet4 U W :=
    gramDual4_normSq U W (ne_of_gt hD)
  have hypair : dot4 y W=1 := (gramDual4_pairings U W (ne_of_gt hD)).2
  have hyne : y≠0 := by
    intro hy
    rw [hy] at hypair
    norm_num [dot4] at hypair
  have hbmem (i : Fin 3) : dot4 (realVec4 (b i)) (realVec4 m)=0 := by
    have hi : intDot m (b i : Vec4 ℤ)=0 := (b i).property
    have hr : realDot (realCast m) (realCast (b i : Vec4 ℤ))=0 := by
      rw [realDot_realCast,hi,Int.cast_zero]
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4,mul_comm] using hr
  have hpr (i : Fin 3) : dot4 (basisProjection N b i) (realVec4 m)=0 := by
    unfold basisProjection
    rw [dot4_symm,perpendicularProjection4_pairing,dot4_symm (realVec4 m),hbmem i,
      dot4_symm (realVec4 m),hbmem 0]
    simp
  have hUm : dot4 U (realVec4 m)=0 := by
    simp [U,changedBasisProjection,dot4_combine,hpr]
  have hWm : dot4 W (realVec4 m)=0 := by
    simp [W,changedBasisProjection,dot4_combine,hpr]
  refine ⟨y,hyne,gramDual4_orthogonal U W _ hUm hWm,hyv,hyi,?_⟩
  rw [hnorm]
  exact hshort

theorem native_primitive_short_second_relation (m v : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs)=1) (hmv : intDot m v=0)
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x=0) (eta : ℝ) (heta : 0<eta)
    (hmiss : ∀ z : integerHyperplane4 m, eta^2 <
      dot4 (perpendicularProjection4 (realVec4 v) x -
        perpendicularProjection4 (realVec4 v) (realVec4 z))
        (perpendicularProjection4 (realVec4 v) x -
          perpendicularProjection4 (realVec4 v) (realVec4 z))) :
    ∃ c : Vec4 ℤ, intDot c v=0 ∧
      (¬∃ t : ℝ, ∀ i, (c i : ℝ)=t*(m i : ℝ)) ∧
      areaSq4 (realVec4 m) (realVec4 c) <
        dot4 (realVec4 m) (realVec4 m)*7/(12*eta^2) := by
  obtain ⟨b,hb⟩ := primitive_hyperplane_basis_starts_at_vector m v hm hv hmv
  obtain ⟨y,hyne,hym,hyv,hyi,hshort⟩ := native_hyperplane_short_dual_of_missed_point
    m hm b x hx eta heta (by simpa only [hb] using hmiss)
  have hdual : ∀ z : Vec4 ℤ, intDot m z=0 →
      ∃ k : ℤ, realDot y (realCast z)=(k : ℝ) := by
    intro z hz
    obtain ⟨k,hk⟩ := hyi ⟨z,hz⟩
    refine ⟨k,?_⟩
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4] using hk
  have hym' : realDot y (realCast m)=0 := by
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4] using hym
  have hyv' : realDot y (realCast v)=0 := by
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4,hb] using hyv
  obtain ⟨c,hcv,hind,harea⟩ := primitive_dual_relation m v hm hmv y hym' hyv' hyne hdual
  have hmpos : 0<dot4 (realVec4 m) (realVec4 m) := primitive_realCast_dot4_positive m hm
  have heq : areaSq4 (realVec4 m) (realVec4 c)=
      dot4 (realVec4 m) (realVec4 m)*dot4 y y := by
    rw [lagrange_area_identity]
    simpa only [realDot,realCast,realVec4,Fin.sum_univ_four,dot4,mul_comm] using harea
  refine ⟨c,hcv,hind,?_⟩
  rw [heq]
  have h := mul_lt_mul_of_pos_left hshort hmpos
  convert h using 1 <;> ring





end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: LowMLShortRelation -/
section




/-!
Direct low-loneliness consumers for the additive and even-sum relations. The
centers and all translated-line/projected misses are proved internally.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

theorem primitive_image_coordinate_gcd (v : Fin 4 → ℕ)
    (hv : Primitive (Finset.univ.image v)) : Finset.univ.gcd v=1 := by
  rw [Finset.gcd_eq_gcd_image]
  exact hv

theorem low_ML_short_relation_from_center
    (m : Vec4 ℤ) (v : Fin 4 → ℕ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hv : Primitive (Finset.univ.image v)) (hmv : intDot m (fun i => (v i : ℤ))=0)
    (hlow : ML (Finset.univ.image v)<(1 / 4 : ℝ))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x=0)
    (eta : ℝ) (heta : 0<eta)
    (hcenter : ∀ i, (1 / 4 : ℝ)+eta≤distance (x i : Time)) :
    ∃ c : Vec4 ℤ, intDot c (fun i => (v i : ℤ))=0 ∧
      (¬∃ t : ℝ, ∀ i, (c i : ℝ)=t*(m i : ℝ)) ∧
      areaSq4 (realVec4 m) (realVec4 c) <
        dot4 (realVec4 m) (realVec4 m)*7/(12*eta^2) := by
  have hv' : Finset.univ.gcd (fun i => ((v i : ℤ)).natAbs)=1 := by
    simpa using primitive_image_coordinate_gcd v hv
  apply native_primitive_short_second_relation m (fun i => (v i : ℤ))
    hm hv' hmv x hx eta heta
  simpa only [realVec4, Int.cast_natCast] using
    low_ML_projected_miss (integerHyperplane4 m) v x eta heta.le hlow hcenter

/-- A primitive relation with even coefficient sum uses the all-half
center and gives the exact area constant 28/3 per unit normal squared. -/
theorem low_ML_even_short_second_relation
    (m : Vec4 ℤ) (v : Fin 4 → ℕ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs)=1)
    (hv : Primitive (Finset.univ.image v)) (hmv : intDot m (fun i => (v i : ℤ))=0)
    (hlow : ML (Finset.univ.image v)<(1 / 4 : ℝ))
    (heven : ∃ j : ℤ, (∑ i, m i)=2*j) :
    ∃ c : Vec4 ℤ, intDot c (fun i => (v i : ℤ))=0 ∧
      (¬∃ t : ℝ, ∀ i, (c i : ℝ)=t*(m i : ℝ)) ∧
      areaSq4 (realVec4 m) (realVec4 c) <
        (28 / 3 : ℝ)*dot4 (realVec4 m) (realVec4 m) := by
  obtain ⟨j,hj⟩ := heven
  obtain ⟨x,hx,hcenter⟩ := primitive_even_center_lift m hm j hj
  obtain ⟨c,hcv,hind,harea⟩ := low_ML_short_relation_from_center m v hm hv hmv
    hlow x hx (1 / 4) (by norm_num) (fun i => by rw [hcenter i]; norm_num)
  refine ⟨c,hcv,hind,?_⟩
  convert harea using 1 <;> ring

theorem additive_normal_primitive :
    Finset.univ.gcd (fun i => ((![1,1,-1,0] : Vec4 ℤ) i).natAbs)=1 := by
  apply Nat.dvd_one.mp
  have h := Finset.gcd_dvd (f := fun i => ((![1,1,-1,0] : Vec4 ℤ) i).natAbs)
    (Finset.mem_univ (0 : Fin 4))
  simpa using h

/-- The literal additive relation v0+v1=v2 supplies its own biased
center, with no distance-miss or good-point hypothesis left to discharge. -/
theorem low_ML_additive_short_second_relation
    (v : Fin 4 → ℕ) (hv : Primitive (Finset.univ.image v))
    (hadd : v 0+v 1=v 2)
    (hlow : ML (Finset.univ.image v)<(1 / 4 : ℝ)) :
    ∃ c : Vec4 ℤ, intDot c (fun i => (v i : ℤ))=0 ∧
      (¬∃ t : ℝ, ∀ i, (c i : ℝ)=t*((![1,1,-1,0] : Vec4 ℤ) i : ℝ)) ∧
      areaSq4 (realVec4 (![1,1,-1,0] : Vec4 ℤ)) (realVec4 c)<252 := by
  have hmv : intDot (![1,1,-1,0] : Vec4 ℤ) (fun i => (v i : ℤ))=0 := by
    have h : (v 0 : ℤ)+(v 1 : ℤ)=(v 2 : ℤ) := by exact_mod_cast hadd
    norm_num [intDot, Fin.sum_univ_four, Matrix.cons_val_two, Matrix.cons_val_three]
    omega
  obtain ⟨c,hcv,hind,harea⟩ := low_ML_short_relation_from_center _ v
    additive_normal_primitive hv hmv hlow additiveBiasedCenter additive_biased_center.1
    (1 / 12) (by norm_num) (fun i => by
      have h := additive_biased_center.2 i
      linarith)
  refine ⟨c,hcv,hind,?_⟩
  norm_num [dot4,realVec4,Matrix.cons_val_two,Matrix.cons_val_three] at harea
  exact harea







end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: IntegerKernelRank -/
section





/-!
The actual simultaneous kernel of two independent integer equations in Z^4 has
an integral basis of length two. Independence is exposed by a nonzero 2-by-2
coordinate minor. The proof uses rank-nullity over the domain Z, not a
surjectivity assumption for the equation map over Z.
-/

noncomputable section
namespace Math15.Source05Review
open Module

/-- The integer linear map with the specified rows. -/
def integerEquationMap (rows : Fin 2 → Fin 4 → ℤ) :
    (Fin 4 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ) where
  toFun x r := ∑ i, rows r i * x i
  map_add' x y := by
    ext r
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' a x := by
    ext r
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring

theorem integerEquationMap_ker (rows : Fin 2 → Fin 4 → ℤ) :
    LinearMap.ker (integerEquationMap rows) = integerEquationKernel rows := by
  ext x
  change (fun r => ∑ i, rows r i * x i) = 0 ↔ _
  exact funext_iff

/-- Insert two integer coefficients in two chosen coordinate positions.
The definition also makes sense when the positions agree. -/
def twoCoordinateMap (i j : Fin 4) : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 4 → ℤ) where
  toFun x k := (if k = i then x 0 else 0) + (if k = j then x 1 else 0)
  map_add' x y := by
    ext k
    simp only [Pi.add_apply]
    split_ifs <;> ring
  map_smul' a x := by
    ext k
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs <;> ring

theorem integerEquationMap_twoCoordinateMap
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4) (x : Fin 2 → ℤ) (r : Fin 2) :
    integerEquationMap rows (twoCoordinateMap i j x) r =
      rows r i * x 0 + rows r j * x 1 := by
  change (∑ k, rows r k *
    ((if k = i then x 0 else 0) + (if k = j then x 1 else 0))) = _
  simp [mul_add, Finset.sum_add_distrib, mul_ite]

/-- A nonzero minor injects Z^2 into the actual integral image of the
equation map.  It need not make that image the whole of Z^2. -/
theorem two_columns_injective_into_range
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4)
    (hdet : rows 0 i * rows 1 j - rows 0 j * rows 1 i ≠ 0) :
    Function.Injective
      ((integerEquationMap rows).rangeRestrict.comp (twoCoordinateMap i j)) := by
  intro x y hxy
  have h0 := congrArg (fun z : LinearMap.range (integerEquationMap rows) =>
    (z : Fin 2 → ℤ) 0) hxy
  have h1 := congrArg (fun z : LinearMap.range (integerEquationMap rows) =>
    (z : Fin 2 → ℤ) 1) hxy
  change integerEquationMap rows (twoCoordinateMap i j x) 0 =
    integerEquationMap rows (twoCoordinateMap i j y) 0 at h0
  change integerEquationMap rows (twoCoordinateMap i j x) 1 =
    integerEquationMap rows (twoCoordinateMap i j y) 1 at h1
  rw [integerEquationMap_twoCoordinateMap, integerEquationMap_twoCoordinateMap] at h0 h1
  have hx0 : (rows 0 i * rows 1 j - rows 0 j * rows 1 i) * (x 0 - y 0) = 0 := by
    linear_combination rows 1 j * h0 - rows 0 j * h1
  have hx1 : (rows 0 i * rows 1 j - rows 0 j * rows 1 i) * (x 1 - y 1) = 0 := by
    linear_combination rows 0 i * h1 - rows 1 i * h0
  have he0 := sub_eq_zero.mp ((mul_eq_zero.mp hx0).resolve_left hdet)
  have he1 := sub_eq_zero.mp ((mul_eq_zero.mp hx1).resolve_left hdet)
  ext k
  fin_cases k
  · exact he0
  · exact he1

theorem integerEquationMap_range_finrank_two
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4)
    (hdet : rows 0 i * rows 1 j - rows 0 j * rows 1 i ≠ 0) :
    Module.finrank ℤ (LinearMap.range (integerEquationMap rows)) = 2 := by
  have hlow := LinearMap.finrank_le_finrank_of_injective
    (two_columns_injective_into_range rows i j hdet)
  have hupp := LinearMap.finrank_le_finrank_of_injective
    (LinearMap.range (integerEquationMap rows)).injective_subtype
  simp only [Module.finrank_fin_fun] at hlow hupp
  omega

/-- The native integer kernel has rank two, including when the equation
map has a proper finite-index image in Z^2. -/
theorem integerEquationKernel_finrank_two
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4)
    (hdet : rows 0 i * rows 1 j - rows 0 j * rows 1 i ≠ 0) :
    Module.finrank ℤ (integerEquationKernel rows) = 2 := by
  let F := integerEquationMap rows
  have hn := (LinearMap.ker F).finrank_quotient_add_finrank
  rw [F.quotKerEquivRange.finrank_eq] at hn
  have hr := integerEquationMap_range_finrank_two rows i j hdet
  change Module.finrank ℤ (LinearMap.range F) = 2 at hr
  rw [hr, Module.finrank_fin_fun] at hn
  have hk : Module.finrank ℤ (LinearMap.ker F) = 2 := by omega
  change Module.finrank ℤ (LinearMap.ker (integerEquationMap rows)) = 2 at hk
  rw [integerEquationMap_ker rows] at hk
  exact hk

/-- An actual basis of the native rank-two kernel extends to an ambient
integer basis.  This supplies the basis hypotheses needed by the
complementary-covolume argument. -/
theorem integerEquationKernel_rank_two_basis_extends
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4)
    (hdet : rows 0 i * rows 1 j - rows 0 j * rows 1 i ≠ 0) :
    ∃ (bM : Basis (Fin 4) ℤ (Fin 4 → ℤ))
      (bK : Basis (Fin 2) ℤ (integerEquationKernel rows))
      (f : Fin 2 ↪ Fin 4), ∀ k, (bK k : Fin 4 → ℤ) = bM (f k) := by
  obtain ⟨k, bM, bK, f, hf⟩ := integerEquationKernel_basis_extends rows
  have hk : k = 2 := by
    have hb := Module.finrank_eq_card_basis bK
    have hr := integerEquationKernel_finrank_two rows i j hdet
    simpa only [Fintype.card_fin, hr] using hb.symm
  subst k
  exact ⟨bM, bK, f, hf⟩

theorem integerEquationKernel_rank_two_basis
    (rows : Fin 2 → Fin 4 → ℤ) (i j : Fin 4)
    (hdet : rows 0 i * rows 1 j - rows 0 j * rows 1 i ≠ 0) :
    Nonempty (Basis (Fin 2) ℤ (integerEquationKernel rows)) := by
  obtain ⟨_, bK, _, _⟩ := integerEquationKernel_rank_two_basis_extends rows i j hdet
  exact ⟨bK⟩

/-- Positive squared exterior area provides the concrete independence
witness used above. -/
theorem positive_area_has_nonzero_coordinate_minor (r s : Fin 4 → ℤ)
    (hrs : 0 < Math15.LonelyRunner.Covolume4.areaSq4 r s) :
    ∃ i j : Fin 4, r i * s j - r j * s i ≠ 0 := by
  classical
  by_contra! h
  have hz : Math15.LonelyRunner.Covolume4.areaSq4 r s = 0 := by
    simp [Math15.LonelyRunner.Covolume4.areaSq4,
      Math15.LonelyRunner.Covolume4.sqnorm6,
      Math15.LonelyRunner.Covolume4.plucker4, h]
  omega

/-- A native two-relation kernel, with independence stated in precisely
the squared-area language of the covolume consumer. -/
theorem integerOrthogonalKernel_basis_of_positive_area (r s : Fin 4 → ℤ)
    (hrs : 0 < Math15.LonelyRunner.Covolume4.areaSq4 r s) :
    ∃ (bM : Basis (Fin 4) ℤ (Fin 4 → ℤ))
      (bK : Basis (Fin 2) ℤ (integerEquationKernel ![r, s]))
      (f : Fin 2 ↪ Fin 4), ∀ k, (bK k : Fin 4 → ℤ) = bM (f k) := by
  obtain ⟨i, j, hij⟩ := positive_area_has_nonzero_coordinate_minor r s hrs
  exact integerEquationKernel_rank_two_basis_extends ![r, s] i j hij











end Math15.Source05Review
end 
end 

/- Section: CovolumeMatrixBridge -/
section




/-!
Connect the explicit four-coordinate determinant and complementary-area
transfer to an actual integer Basis.
-/

namespace Math15.LonelyRunner.Covolume4

variable {R : Type*} [CommRing R]

/-- The actual four-by-four matrix, with the supplied vectors as columns. -/
def columns4 (u v z w : Vec4 R) : Matrix (Fin 4) (Fin 4) R :=
  fun i j => (![u, v, z, w] j) i

/-- The cross-product convention agrees with the ordinary determinant. -/
theorem det4_eq_columns_det (u v z w : Vec4 R) :
    det4 u v z w = Matrix.det (columns4 u v z w) := by
  rw [Matrix.det_succ_column (columns4 u v z w) (3 : Fin 4)]
  simp only [Fin.sum_univ_four, Matrix.det_fin_three, Matrix.submatrix_apply]
  norm_num [columns4, Fin.succAbove, Fin.lt_def, Fin.le_def,
    det4, dot4, cross4, det3] <;> simp <;> ring

/-- Standard coordinates of a basis are precisely this column matrix. -/
theorem columns4_eq_basis_toMatrix
    (b : Module.Basis (Fin 4) R (Vec4 R)) :
    columns4 (b 0) (b 1) (b 2) (b 3) =
      (Pi.basisFun R (Fin 4)).toMatrix b := by
  ext i j
  fin_cases j <;> rfl

/-- Any Z-basis of Z^4 supplies the exact unimodular hypothesis consumed
by the complementary-kernel and complementary-area theorems. -/
theorem det4_basis_sq_one
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    (det4 (b 0) (b 1) (b 2) (b 3))^2 = 1 := by
  have hunit : IsUnit (det4 (b 0) (b 1) (b 2) (b 3)) := by
    rw [det4_eq_columns_det, columns4_eq_basis_toMatrix]
    simpa only [Module.Basis.det_apply] using
      (Pi.basisFun ℤ (Fin 4)).isUnit_det b
  rcases Int.isUnit_eq_one_or hunit with h | h
  · rw [h]
    norm_num
  · rw [h]
    norm_num

/-- An actual ambient basis now feeds the complete complementary-area
bound directly; no determinant hypothesis is left to the consumer. -/
theorem basis_integer_kernel_area_bound
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) (r s : Vec4 ℤ)
    (hr0 : dot4 r (b 0) = 0) (hr1 : dot4 r (b 1) = 0)
    (hs0 : dot4 s (b 0) = 0) (hs1 : dot4 s (b 1) = 0)
    (hrs : 0 < areaSq4 r s) : areaSq4 (b 0) (b 1) ≤ areaSq4 r s := by
  exact integer_kernel_area_bound (b 0) (b 1) (b 2) (b 3) r s
    (det4_basis_sq_one b) hr0 hr1 hs0 hs1 hrs






end Math15.LonelyRunner.Covolume4
end 

/- Section: NativeCovolumeBound -/
section





/-!
Native complementary-covolume bound for two independent integer relations. The
ambient unimodular completion is constructed from the actual saturated
equation kernel. No basis-completion hypothesis remains in the conclusion.
-/

noncomputable section
namespace Math15.Source05Review
open Module
open Math15.LonelyRunner.Covolume4

/-- Any two embeddings of the same finite set in one finite ambient set
are related by a permutation of that ambient set. -/
theorem embeddings_related_by_permutation
    {α β : Type*} [Fintype α] [Finite β] (f g : α ↪ β) :
    ∃ e : Equiv.Perm β, ∀ a, e (f a) = g a := by
  classical
  let E : Set.range f ≃ Set.range g := f.toEquivRange.symm.trans g.toEquivRange
  refine ⟨E.extendSubtype, ?_⟩
  intro a
  rw [E.extendSubtype_apply_of_mem (f a) (Set.mem_range_self a)]
  simp [E]

/-- Reindex an embedded integral subbasis into the first two positions,
without changing either of its two vectors. -/
theorem embedded_basis_in_first_two
    (N : Submodule ℤ (Fin 4 → ℤ))
    (bM : Basis (Fin 4) ℤ (Fin 4 → ℤ))
    (bK : Basis (Fin 2) ℤ N) (f : Fin 2 ↪ Fin 4)
    (hf : ∀ k, (bK k : Fin 4 → ℤ) = bM (f k)) :
    ∃ b : Basis (Fin 4) ℤ (Fin 4 → ℤ),
      b 0 = (bK 0 : Fin 4 → ℤ) ∧ b 1 = (bK 1 : Fin 4 → ℤ) := by
  obtain ⟨e, he⟩ := embeddings_related_by_permutation (Fin.castAddEmb 2) f
  have h0 := he (0 : Fin 2)
  have h1 := he (1 : Fin 2)
  change e 0 = f 0 at h0
  change e 1 = f 1 at h1
  refine ⟨bM.reindex e.symm, ?_, ?_⟩
  · simpa only [Basis.reindex_apply, Equiv.symm_symm, h0] using (hf 0).symm
  · simpa only [Basis.reindex_apply, Equiv.symm_symm, h1] using (hf 1).symm

/-- The native sum equations are exactly the explicit four-coordinate
dot-product equations used by the complementary-area argument. -/
theorem integerOrthogonalKernel_dot4 (r s : Fin 4 → ℤ)
    (x : integerEquationKernel ![r, s]) :
    dot4 r (x : Fin 4 → ℤ) = 0 ∧ dot4 s (x : Fin 4 → ℤ) = 0 := by
  have hr := x.property (0 : Fin 2)
  have hs := x.property (1 : Fin 2)
  change (∑ i, r i * (x : Fin 4 → ℤ) i) = 0 at hr
  change (∑ i, s i * (x : Fin 4 → ℤ) i) = 0 at hs
  constructor
  · simpa [dot4, Fin.sum_univ_succ, add_assoc] using hr
  · simpa [dot4, Fin.sum_univ_succ, add_assoc] using hs

/-- A positive-area pair of integer relations supplies a completed basis
of its actual integer orthogonal kernel with no larger squared area.
All rank, saturation, and unimodular-completion premises are discharged. -/
theorem native_integer_kernel_completed_covolume_bound
    (r s : Fin 4 → ℤ) (hrs : 0 < areaSq4 r s) :
    ∃ (bK : Basis (Fin 2) ℤ (integerEquationKernel ![r, s]))
      (bM : Basis (Fin 4) ℤ (Fin 4 → ℤ)),
      bM 0 = (bK 0 : Fin 4 → ℤ) ∧
      bM 1 = (bK 1 : Fin 4 → ℤ) ∧
      areaSq4 (bK 0 : Fin 4 → ℤ) (bK 1 : Fin 4 → ℤ) ≤ areaSq4 r s := by
  obtain ⟨bM, bK, f, hf⟩ := integerOrthogonalKernel_basis_of_positive_area r s hrs
  obtain ⟨b, hb0, hb1⟩ := embedded_basis_in_first_two
    (integerEquationKernel ![r, s]) bM bK f hf
  obtain ⟨hr0, hs0⟩ := integerOrthogonalKernel_dot4 r s (bK 0)
  obtain ⟨hr1, hs1⟩ := integerOrthogonalKernel_dot4 r s (bK 1)
  have harea := basis_integer_kernel_area_bound b r s
    (by simpa only [hb0] using hr0) (by simpa only [hb1] using hr1)
    (by simpa only [hb0] using hs0) (by simpa only [hb1] using hs1) hrs
  exact ⟨bK, b, hb0, hb1, by simpa only [hb0, hb1] using harea⟩

/-- The native basis form consumed by the quantitative torus approximation. -/
theorem native_integer_kernel_covolume_bound
    (r s : Fin 4 → ℤ) (hrs : 0 < areaSq4 r s) :
    ∃ bK : Basis (Fin 2) ℤ (integerEquationKernel ![r, s]),
      areaSq4 (bK 0 : Fin 4 → ℤ) (bK 1 : Fin 4 → ℤ) ≤ areaSq4 r s := by
  obtain ⟨bK, _, _, _, harea⟩ := native_integer_kernel_completed_covolume_bound r s hrs
  exact ⟨bK, harea⟩







end Math15.Source05Review
end 
end 

/- Section: NativeLatticeAssembly -/
section



/-!
The native common-object consumer of the lattice foundations. The two
relations determine the actual integer kernel, a basis is constructed, and
every real point parameterized by this basis is approximated by the SAME
primitive speed line with error controlled by the two original relations.
-/

noncomputable section
namespace Math15.Source05Review
open Module
open Math15.LonelyRunner.Covolume4

theorem native_relations_primitive_line_approximation
    (r s v : Vec4 ℤ) (hrs : 0 < areaSq4 r s)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1)
    (hrv : intDot r v = 0) (hsv : intDot s v = 0) :
    ∃ b : Basis (Fin 2) ℤ (integerEquationKernel ![r, s]),
      ∀ x y : ℝ, ∃ (t : ℝ) (z : integerEquationKernel ![r, s]),
        sqDist4 (combine4 x (realCast (b 0).val) y (realCast (b 1).val))
          (combine4 1 (realCast z.val) t (realCast v)) ≤
            ((areaSq4 r s : ℤ) : ℝ) /
              (4 * dot4 (realCast v) (realCast v)) := by
  obtain ⟨b, hb⟩ := native_integer_kernel_covolume_bound r s hrs
  have hmem : v ∈ integerEquationKernel ![r, s] := by
    intro i
    fin_cases i
    · exact hrv
    · exact hsv
  let vN : integerEquationKernel ![r, s] := ⟨v, hmem⟩
  refine ⟨b, ?_⟩
  intro x y
  obtain ⟨t, z, hnear⟩ := native_rank_two_nearest_primitive_line
    (integerEquationKernel ![r, s]) b vN hv x y
  refine ⟨t, z, hnear.trans ?_⟩
  have hden : 0 < 4 * dot4 (realCast v) (realCast v) :=
    mul_pos (by norm_num) (primitive_realCast_dot4_positive v hv)
  apply (div_le_div_iff_of_pos_right hden).2
  exact_mod_cast hb



end Math15.Source05Review
end 
