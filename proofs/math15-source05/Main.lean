/-- Exact full zero-pattern collision branch; no properness assumption or
reduction premise replaces positivity of the same actual integer line. -/
theorem torus_zero_collision_source05_signed_line {a b c d e f : ℤ}
    {z : Fin 4 → ℤ} (ha : a≠0) (hd : d≠0)
    (hzero : b=0 ∨ c=0 ∨ e=0 ∨ f=0)
    (hspan : TorusIntegerLineInSpan (![a,a,b,c]) (![d,-d,e,f]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    TorusGood (![a,a,b,c]) (![d,-d,e,f]) (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  have hsupport := torus_integer_line_coordinate_support hspan hp
  have hs2 : b≠0 ∨ e≠0 := hsupport 2
  have hs3 : c≠0 ∨ f≠0 := hsupport 3
  by_cases hb : b=0
  · subst b
    have he : e≠0 := hs2.resolve_left (by simp)
    by_cases hc : c=0
    · subst c
      have hf : f≠0 := hs3.resolve_left (by simp)
      exact Or.inl (torus_two_zero_same_generator_good ha hd he hf)
    · by_cases hf : f=0
      · subst f
        exact torus_cross_two_zero_source05_signed_line ha hc hd he hspan hp hprim
      · exact torus_one_zero_source05_signed_line ha hc hd he hf hspan hp hprim
  · by_cases hc : c=0
    · subst c
      have hf : f≠0 := hs3.resolve_left (by simp)
      by_cases he : e=0
      · subst e
        exact torus_cross_two_zero_other_source05_signed_line ha hb hd hf hspan hp hprim
      · exact torus_one_zero_last_first_source05_signed_line ha hb hd he hf hspan hp hprim
    · by_cases he : e=0
      · subst e
        by_cases hf : f=0
        · subst f
          exact Or.inl (torus_two_zero_second_generator_good ha hb hc hd)
        · exact torus_one_zero_third_second_source05_signed_line ha hb hc hd hf hspan hp hprim
      · have hf : f=0 := by
          rcases hzero with hz | hz | hz | hz
          · exact False.elim (hb hz)
          · exact False.elim (hc hz)
          · exact False.elim (he hz)
          · exact hz
        subst f
        exact torus_one_zero_last_second_source05_signed_line ha hb hc hd he hspan hp hprim








end Math15.LonelyRunner
