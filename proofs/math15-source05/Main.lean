/- Section: SoundStripMask -/
section


/-!
Sound-subset certificates for a rational quarter mask.

Paper argument. For a strip lo <= v < hi, multiplication by the positive
integer m carries its endpoints into the good part of one n-period:

  (4j+1)n <= 4m*lo,       4m*(hi-1) <= (4j+3)n.

The same inequalities therefore hold with v in place of the endpoint. They
imply j*n <= v*m < (j+1)*n, hence (v*m)/n=j. Subtracting j*n leaves a residue
r with n <= 4r and n <= 4(n-r), precisely quarterResidue v m n.

A union of prefix-XOR interval masks supplies one such strip for every set
bit. Its soundness is sufficient: the certificate need not contain all
quarter-good speeds. Independently checked census coverage must still cover
every original admissible fourth speed. No coverage is assumed here. The
mask's one fixed m/n is used for every covered speed.
-/

namespace Math15.LonelyRunner

structure QuarterIntervalStrip where
  lo : ℕ
  hi : ℕ
  j : ℕ

/-- All endpoint tests are integer arithmetic; hi is the excluded endpoint. -/
def soundQuarterStripCheck (bound m n : ℕ) (strip : QuarterIntervalStrip) : Bool :=
  decide (strip.lo<strip.hi ∧ strip.hi≤bound ∧
    (4*strip.j+1)*n≤4*m*strip.lo ∧
    4*m*(strip.hi-1)≤(4*strip.j+3)*n)

def soundStripUnion (prefixCache : ℕ → ℕ) (strips : List QuarterIntervalStrip) : ℕ :=
  maskUnion (strips.map fun strip => sharedIntervalBits prefixCache strip.lo strip.hi)

/-- The literal supplied bit mask is checked against exactly its strip union. -/
def soundStripMaskCheck (bound m n bits : ℕ) (prefixCache : ℕ → ℕ)
    (strips : List QuarterIntervalStrip) : Bool :=
  decide (0<m ∧ 0<n) && strips.all (soundQuarterStripCheck bound m n) &&
    decide (bits=soundStripUnion prefixCache strips)

theorem quarterResidue_of_integer_strip_endpoints
    {m n lo hi j v : ℕ} (hn : 0<n)
    (hlower : (4*j+1)*n≤4*m*lo)
    (hupper : 4*m*(hi-1)≤(4*j+3)*n)
    (hvlo : lo≤v) (hvhi : v<hi) : quarterResidue v m n := by
  have hvlast : v≤hi-1 := by omega
  have hmulLo := Nat.mul_le_mul_left (4*m) hvlo
  have hmulHi := Nat.mul_le_mul_left (4*m) hvlast
  have hL : (4*j+1)*n≤4*(v*m) := by nlinarith
  have hU : 4*(v*m)≤(4*j+3)*n := by nlinarith
  have hbase : j*n≤v*m := by nlinarith
  have hnext : v*m<(j+1)*n := by nlinarith
  have hdiv : (v*m)/n=j := Nat.div_eq_of_lt_le hbase hnext
  have hrep := Nat.mod_add_div (v*m) n
  rw [hdiv] at hrep
  have hmod : (v*m)%n<n := Nat.mod_lt (v*m) hn
  have hsub : n-(v*m)%n+(v*m)%n=n := Nat.sub_add_cancel hmod.le
  have hquarterLo : n≤4*((v*m)%n) := by nlinarith
  have hquarterHi : n≤4*(n-(v*m)%n) := by nlinarith
  unfold quarterResidue
  rw [←Nat.mul_min_mul_left]
  exact le_min hquarterLo hquarterHi

theorem soundQuarterStripCheck_sound
    {bound m n : ℕ} {strip : QuarterIntervalStrip}
    (hcheck : soundQuarterStripCheck bound m n strip=true) :
    strip.lo<strip.hi ∧ strip.hi≤bound ∧
      (4*strip.j+1)*n≤4*m*strip.lo ∧
      4*m*(strip.hi-1)≤(4*strip.j+3)*n :=
  decide_eq_true_eq.mp hcheck

/-- Every set bit has its actual speed bound and modular quarter condition,
proved from endpoints at this mask's single fixed rational time. -/
theorem soundStripMaskCheck_sound
    {bound m n bits : ℕ} {prefixCache : ℕ → ℕ} {strips : List QuarterIntervalStrip}
    (hpref : sharedPrefixCheck bound prefixCache=true)
    (hcheck : soundStripMaskCheck bound m n bits prefixCache strips=true) :
    0<m ∧ 0<n ∧ ∀ v : ℕ, Nat.testBit bits v=true →
      v<bound ∧ quarterResidue v m n := by
  have hh : (0<m ∧ 0<n) ∧ strips.all (soundQuarterStripCheck bound m n)=true ∧
      bits=soundStripUnion prefixCache strips := by
    simpa only [soundStripMaskCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hcheck
  refine ⟨hh.1.1,hh.1.2,?_⟩
  intro v hv
  rw [hh.2.2] at hv
  obtain ⟨strip,hmem,hbit⟩ :=
    (maskUnion_map_testBit_iff
      (fun strip : QuarterIntervalStrip => sharedIntervalBits prefixCache strip.lo strip.hi)
      strips v).mp hv
  obtain ⟨hlohi,hhi,hlower,hupper⟩ := soundQuarterStripCheck_sound
    (List.all_eq_true.mp hh.2.1 strip hmem)
  have hrange := (sharedIntervalBits_testBit_iff hpref
    (show strip.lo≤bound by omega) hhi).mp hbit
  exact ⟨hrange.2.trans_le hhi,
    quarterResidue_of_integer_strip_endpoints hh.1.2 hlower hupper hrange.1 hrange.2⟩

/-- This subset identity is obtained by a generic proof, without recomputing
the full rational mask numerically for each strip-certified cache entry. -/
theorem soundStripMask_subset_rationalSpeedMask
    {bound m n bits : ℕ} {prefixCache : ℕ → ℕ} {strips : List QuarterIntervalStrip}
    (hpref : sharedPrefixCheck bound prefixCache=true)
    (hcheck : soundStripMaskCheck bound m n bits prefixCache strips=true) :
    bits &&& rationalSpeedMask bound m n=bits := by
  apply (mask_coverage_iff bits (rationalSpeedMask bound m n)).mpr
  intro v hv
  exact (rationalSpeedMask_testBit_iff bound m n v).mpr
    ((soundStripMaskCheck_sound hpref hcheck).2.2 v hv)

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

theorem soundStripMask_distance_ge_quarter
    {bound m n bits v : ℕ} {prefixCache : ℕ → ℕ} {strips : List QuarterIntervalStrip}
    (hpref : sharedPrefixCheck bound prefixCache=true)
    (hcheck : soundStripMaskCheck bound m n bits prefixCache strips=true)
    (hv : Nat.testBit bits v=true) :
    (1/4 : ℝ)≤distance (v • (((m : ℝ)/(n : ℝ)) : Time)) := by
  have hs := soundStripMaskCheck_sound hpref hcheck
  exact distance_ge_quarter_of_quarterResidue hs.2.1 (hs.2.2 v hv).2







end Math15.LonelyRunner
end 
end 

/- Section: SharedSupportedCensus -/
section



/-!
The full shared census with sound-subset rational masks.

Paper argument. The row's coverage identity gives either a checked known
family or one shared mask index i covering all four actual speeds. The triple
tests and fourth-speed coverage refer to this same i. A positive denominator
and soundness of every set bit therefore give four quarter inequalities at the
single actual time (pool i).m / (pool i).n. Completeness of a rational mask is
unnecessary; the independently traversed original triple ranges and row
containment still supply full quartet coverage.

Endpoint-certified strips provide the set-bit soundness by the generic
SoundStripMask theorem. No numerical rational-mask reconstruction is used in
that wrapper. The existing equality-based foundation is unchanged.
-/

namespace Math15.LonelyRunner

/-- Each cache entry certifies one fixed rational time for all its set bits. -/
def SharedQuarterPoolSupported (size : ℕ) (pool : ℕ → SharedQuarterMask) : Prop :=
  ∀ i : ℕ, i<size → 0<(pool i).n ∧
    ∀ v : ℕ, Nat.testBit (pool i).bits v=true →
      quarterResidue v (pool i).m (pool i).n

/-- The full original row enumeration is the same checker as before. -/
def sharedSupportedCensusCheck (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow) : Bool :=
  sharedCompatibilityCheck bound compat && sharedPrefixCheck bound prefixCache &&
    decide (oddBits=oddSpeedMask bound) &&
    sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows

/-- Only literal strip endpoints and their supplied union are checked. -/
def sharedStripQuarterPoolCheck (bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (prefixCache : ℕ → ℕ) (strips : ℕ → List QuarterIntervalStrip) : Bool :=
  (List.range size).all fun i =>
    soundStripMaskCheck bound (pool i).m (pool i).n (pool i).bits prefixCache (strips i)

def sharedStripFullCensusCheck (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow)
    (strips : ℕ → List QuarterIntervalStrip) : Bool :=
  sharedStripQuarterPoolCheck bound size pool prefixCache strips &&
    sharedSupportedCensusCheck S bound size pool compat prefixCache oddBits rows

/-- The old complete-mask certificate is one way to obtain support. -/
theorem sharedQuarterPoolSupported_of_checked_masks
    {bound size : ℕ} {pool : ℕ → SharedQuarterMask}
    (hpool : sharedQuarterPoolCheck bound size pool=true) :
    SharedQuarterPoolSupported size pool := by
  intro i hi
  obtain ⟨hn,hmask⟩ := sharedQuarterPoolCheck_sound hpool hi
  refine ⟨hn,?_⟩
  intro v hv
  rw [hmask] at hv
  exact ((rationalSpeedMask_testBit_iff bound (pool i).m (pool i).n v).mp hv).2

/-- Generic endpoint soundness establishes each cache entry's support. -/
theorem sharedQuarterPoolSupported_of_strip_checks
    {bound size : ℕ} {pool : ℕ → SharedQuarterMask}
    {prefixCache : ℕ → ℕ} {strips : ℕ → List QuarterIntervalStrip}
    (hpref : sharedPrefixCheck bound prefixCache=true)
    (hpool : sharedStripQuarterPoolCheck bound size pool prefixCache strips=true) :
    SharedQuarterPoolSupported size pool := by
  intro i hi
  have hiCheck :
      soundStripMaskCheck bound (pool i).m (pool i).n (pool i).bits
        prefixCache (strips i)=true :=
    List.all_eq_true.mp hpool i (List.mem_range.mpr hi)
  have hs := soundStripMaskCheck_sound hpref hiCheck
  exact ⟨hs.2.1,fun v hv => (hs.2.2 v hv).2⟩

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- Coverage and the three fixed-bit tests use the same actual mask index,
so all four distances are bounded at one actual rational time. -/
theorem sharedMaskRowCheck_sound_of_support
    {S bound size a b c d oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {row : SharedMaskRow}
    (hpool : SharedQuarterPoolSupported size pool)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true) (hodd : oddBits=oddSpeedMask bound)
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u≠v → Nat.gcd u v≤2)
    (hab : a<b) (hbc : b<c) (hcd : c<d) (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hrow : sharedMaskRowCheck S bound size pool compat prefixCache oddBits a b c row=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh :
      (sharedAllowedFourthMask S bound compat prefixCache oddBits a b c &&&
        (sharedSelectedMask pool row.indices ||| listBits row.known)=
        sharedAllowedFourthMask S bound compat prefixCache oddBits a b c) ∧
      sharedSelectedTripleCheck size a b c pool row.indices=true ∧
      row.known.all (fun v => finiteKnownFamilyBool a b c v)=true := by
    simpa only [sharedMaskRowCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hrow
  have hd := sharedAllowedFourthMask_of_admissible hcomp hpref hodd
    hab hbc hcd hsum hdBound hprim hpair
  have hbit := (mask_coverage_iff _ _).mp hh.1 d hd
  rcases (mask_union_testBit_iff _ _ d).mp hbit with htime | hknown
  · obtain ⟨i,hi,hid⟩ :=
      (maskUnion_map_testBit_iff (fun i => (pool i).bits) row.indices d).mp htime
    have htr : i<size ∧ Nat.testBit (pool i).bits a=true ∧
        Nat.testBit (pool i).bits b=true ∧ Nat.testBit (pool i).bits c=true := by
      simpa only [sharedSelectedTripleCheck,List.all_eq_true,Bool.and_eq_true,
        decide_eq_true_eq,and_assoc] using List.all_eq_true.mp hh.2.1 i hi
    obtain ⟨hn,hgood⟩ := hpool i htr.1
    have haq := hgood a htr.2.1
    have hbq := hgood b htr.2.2.1
    have hcq := hgood c htr.2.2.2
    have hdq := hgood d hid
    apply Or.inl
    apply ML_lower_of_witness ⟨a,by simp [finiteQuartetSpeeds]⟩
      ((((pool i).m : ℝ)/((pool i).n : ℝ)) : Time)
    intro v hv
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_quarterResidue hn haq
    · exact distance_ge_quarter_of_quarterResidue hn hbq
    · exact distance_ge_quarter_of_quarterResidue hn hcq
    · exact distance_ge_quarter_of_quarterResidue hn hdq
  · have hmem := (listBits_testBit_iff row.known d).mp hknown
    exact finiteKnownFamilyBool_sound hp hc hprim hpair (List.all_eq_true.mp hh.2.2 d hmem)

/-- Every original eligible sorted quartet in the sum range is covered by
the unchanged exhaustive triple checker, with sound-subset pool entries. -/
theorem source05_of_sharedSupportedCensus
    {S bound size a b c d oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow}
    (hpool : SharedQuarterPoolSupported size pool)
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d)
    (hsum : a+b+c+d≤S) (hdBound : d<bound)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u≠v → Nat.gcd u v≤2)
    (hfull : sharedSupportedCensusCheck S bound size pool compat prefixCache oddBits rows=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : sharedCompatibilityCheck bound compat=true ∧
      sharedPrefixCheck bound prefixCache=true ∧ oddBits=oddSpeedMask bound ∧
      sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows=true := by
    simpa only [sharedSupportedCensusCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hfull
  have hp : Positive (finiteQuartetSpeeds a b c d) := by
    intro v hv
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl <;> omega
  have hrow := sharedMaskCensusCheck_row hh.1 ha hab hbc hcd hsum hdBound hpair hh.2.2.2
  exact sharedMaskRowCheck_sound_of_support hpool hh.1 hh.2.1 hh.2.2.1 hp
    (finite_quartet_card hab hbc hcd) hprim hpair hab hbc hcd hsum hdBound hrow

/-- Transfer to the same arbitrary actual speed set, preserving all
original positivity, cardinality, primitive and pair-gcd hypotheses. -/
theorem source05_of_sharedSupportedCensus_set
    {S size oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow} {V : Finset ℕ}
    (hpool : SharedQuarterPoolSupported size pool)
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hfull : sharedSupportedCensusCheck S (S+1) size pool compat prefixCache oddBits rows=true) :
    FiniteSource05Conclusion V := by
  obtain ⟨a,b,c,d,ha,hab,hbc,hcd,hV,hS⟩ := positive_quartet_sorted_representation hp hc
  have hsum' : a+b+c+d≤S := by omega
  have hprim' : Primitive (finiteQuartetSpeeds a b c d) := by rwa [hV] at hprim
  have hpair' : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2 := by rwa [hV] at hpair
  rw [hV]
  exact source05_of_sharedSupportedCensus hpool ha hab hbc hcd hsum' (by omega)
    hprim' hpair' hfull

/-- A finite endpoint certificate and unchanged complete row coverage give
the exact original finite-sum conclusion for an arbitrary actual set. -/
theorem source05_of_sharedStripFullCensus_set
    {S size oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow}
    {strips : ℕ → List QuarterIntervalStrip} {V : Finset ℕ}
    (hp : Positive V) (hc : V.card=4) (hprim : Primitive V)
    (hpair : ∀ u ∈ V,∀ v ∈ V,u≠v → Nat.gcd u v≤2) (hsum : V.sum id≤S)
    (hfull : sharedStripFullCensusCheck S (S+1) size pool compat prefixCache oddBits rows strips=true) :
    FiniteSource05Conclusion V := by
  have hh : sharedStripQuarterPoolCheck (S+1) size pool prefixCache strips=true ∧
      sharedSupportedCensusCheck S (S+1) size pool compat prefixCache oddBits rows=true := by
    simpa only [sharedStripFullCensusCheck,Bool.and_eq_true] using hfull
  have hcache : sharedCompatibilityCheck (S+1) compat=true ∧
      sharedPrefixCheck (S+1) prefixCache=true ∧ oddBits=oddSpeedMask (S+1) ∧
      sharedMaskCensusCheck S (S+1) size pool compat prefixCache oddBits rows=true := by
    simpa only [sharedSupportedCensusCheck,Bool.and_eq_true,decide_eq_true_eq,and_assoc] using hh.2
  exact source05_of_sharedSupportedCensus_set
    (sharedQuarterPoolSupported_of_strip_checks hcache.2.1 hh.1)
    hp hc hprim hpair hsum hh.2








end Math15.LonelyRunner
end 
