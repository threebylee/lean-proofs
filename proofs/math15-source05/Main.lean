/-!
Direct canonical low-ML consumer of the actual reduced ambient basis,
rounding, and primitive cofactor. No hollow-body or lattice-volume theorem is
a premise.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

theorem low_ML_has_primitive_relation_norm_sixteen
    (v : Fin 4 → ℕ) (hv : Primitive (Finset.univ.image v))
    (hlow : ML (Finset.univ.image v)<(1 / 4 : ℝ)) :
    ∃ m : Vec4 ℤ, Finset.univ.gcd (fun i => (m i).natAbs)=1 ∧
      intDot m (fun i => (v i : ℤ))=0 ∧
      0<dot4 m m ∧ dot4 m m≤16 ∧ (∑ i, (m i).natAbs)≤8 := by
  have hvcoord : Finset.univ.gcd v=1 := by
    rw [Finset.gcd_eq_gcd_image]
    exact hv
  have hvZ : Finset.univ.gcd (fun i => ((v i : ℤ)).natAbs)=1 := by
    simpa using hvcoord
  obtain ⟨b,hb,_,_,_,h12,h23⟩ := primitive_rank3_reduced_basis
    (fun i => (v i : ℤ)) hvZ
  have h12b : 3*(basisD1 b)^2≤4*dot4 (b 0) (b 0)*basisD2 b := by
    simpa only [hb] using h12
  obtain ⟨z,hcover⟩ := ambient_basis_reduced_projection_cover b h12b h23
    (fun _ => (1 / 2 : ℝ))
  have hcenter (i : Fin 4) : (1 / 4 : ℝ)+1/4≤distance ((1/2 : ℝ) : Time) := by
    have h : distance ((1/2 : ℝ) : Time)=(1/2 : ℝ) := by
      simpa [distance] using AddCircle.norm_half_period_eq (1 : ℝ)
    rw [h]
    norm_num
  have hmiss := low_ML_projected_miss (⊤ : Submodule ℤ (Vec4 ℤ)) v
    (fun _ => (1 / 2 : ℝ)) (1 / 4) (by norm_num) hlow hcenter
    ⟨z, by trivial⟩
  have hstrict : (1 / 16 : ℝ)<37/(36*(basisD2 b : ℝ)) := by
    rw [hb] at hcover
    have h := lt_of_lt_of_le hmiss (by
      simpa only [realVec4,Int.cast_natCast] using hcover)
    norm_num at h ⊢
    exact h
  have hTpos : (0 : ℝ)<(basisD2 b : ℝ) := by
    exact_mod_cast basisD2_positive b
  have hTreal : (basisD2 b : ℝ)<148/9 := by
    have h := (lt_div_iff₀ (by positivity : (0 : ℝ)<36*(basisD2 b : ℝ))).mp hstrict
    nlinarith
  have hTbound : basisD2 b≤16 :=
    integer_below_148_over_nine_le_sixteen (basisD2 b) hTreal
  let m := basisCofactorNormal b
  have hmnorm : dot4 m m=basisD2 b := basisCofactorNormal_normSq b
  have hmbound : dot4 m m≤16 := hmnorm.trans_le hTbound
  refine ⟨m,basisCofactorNormal_primitive b,?_,?_,hmbound,?_⟩
  · simpa only [hb] using basisCofactorNormal_first_intDot_zero b
  · rw [hmnorm]
    exact basisD2_positive b
  · exact integer_four_l1_le_eight_of_normSq_le_sixteen m hmbound



end Math15.LonelyRunner.Covolume4
end 
