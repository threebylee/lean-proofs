/- Section: QuarterWitness -/
section


noncomputable section
namespace Math15.LonelyRunner

theorem score_le_ML (V : Finset ℕ) (t : Time) : score V t ≤ ML V := by
  exact le_csSup (isCompact_range (score_continuous V)).bddAbove ⟨t, rfl⟩

theorem ML_lower_of_witness {V : Finset ℕ} (hV : V.Nonempty)
    {L : ℝ} (t : Time) (ht : ∀ v ∈ V, L ≤ distance (v • t)) : L ≤ ML V := by
  apply le_trans _ (score_le_ML V t)
  simp only [score, dif_pos hV]
  exact Finset.le_inf' hV (fun v => distance (v • t)) ht

theorem distance_at_rational (v m n : ℕ) :
    distance (v • (((m : ℝ) / (n : ℝ)) : Time)) =
      (min ((v * m) % n) (n - (v * m) % n) : ℕ) / (n : ℝ) := by
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  unfold distance
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  convert AddCircle.norm_div_natCast (p := (1 : ℝ)) (m := v * m) (n := n) using 1 <;>
    simp [div_eq_mul_inv, Nat.cast_mul, mul_assoc]

/-- A common rational witness handles every speed avoiding the chosen modulus. -/
theorem ML_ge_inv_of_nonzero_mod {V : Finset ℕ} (hV : V.Nonempty)
    {n : ℕ} (hn : 0 < n) (hmod : ∀ v ∈ V, v % n ≠ 0) :
    (1 / (n : ℝ)) ≤ ML V := by
  apply ML_lower_of_witness hV (((1 : ℝ) / (n : ℝ)) : Time)
  intro v hv
  have hd := distance_at_rational v 1 n
  simp only [Nat.cast_one, Nat.mul_one] at hd
  rw [hd]
  have hlt := Nat.mod_lt v hn
  have hne := hmod v hv
  have hm : 1 ≤ min (v % n) (n - v % n) := by omega
  have hr : (1 : ℝ) ≤ (min (v % n) (n - v % n) : ℕ) := by exact_mod_cast hm
  exact (div_le_div_iff_of_pos_right (by exact_mod_cast hn : (0 : ℝ) < n)).2 hr

theorem distance_quarter (v : ℕ) :
    distance (v • ((1 / 4 : ℝ) : Time)) =
      (min (v % 4) (4 - v % 4) : ℕ) / (4 : ℝ) := by
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  unfold distance
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  convert AddCircle.norm_div_natCast (p := (1 : ℝ)) (m := v) (n := 4) using 1 <;>
    simp [div_eq_mul_inv]

/-- Every nonempty set with no multiple of four has loneliness at least 1/4. -/
theorem ML_ge_quarter_of_no_four {V : Finset ℕ} (hV : V.Nonempty)
    (hmod : ∀ v ∈ V, v % 4 ≠ 0) : (1 / 4 : ℝ) ≤ ML V := by
  apply ML_lower_of_witness hV ((1 / 4 : ℝ) : Time)
  intro v hv
  rw [distance_quarter]
  have hlt := Nat.mod_lt v (by norm_num : 0 < 4)
  have hne := hmod v hv
  have hm : 1 ≤ min (v % 4) (4 - v % 4) := by omega
  have hr : (1 : ℝ) ≤ (min (v % 4) (4 - v % 4) : ℕ) := by exact_mod_cast hm
  linarith

/-- Under Target05's pairwise gcd condition there is at most one multiple of four. -/
theorem eq_of_four_dvd {V : Finset ℕ}
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    {u v : ℕ} (hu : u ∈ V) (hv : v ∈ V) (h4u : 4 ∣ u) (h4v : 4 ∣ v) : u = v := by
  by_contra hne
  have hd : 4 ∣ Nat.gcd u v := Nat.dvd_gcd h4u h4v
  have hpos : 0 < Nat.gcd u v := by
    by_contra hn
    have hz : Nat.gcd u v = 0 := by omega
    have hu0 : u = 0 := (Nat.gcd_eq_zero_iff.mp hz).1
    have hv0 : v = 0 := (Nat.gcd_eq_zero_iff.mp hz).2
    exact hne (hu0.trans hv0.symm)
  have hge := Nat.le_of_dvd hpos hd
  have hle := hpair u hu v hv hne
  omega

/-- Any counterexample to Target05 has exactly one speed divisible by four. -/
theorem unique_four_dvd_of_ML_lt_quarter {V : Finset ℕ} (hV : V.Nonempty)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (hlow : ML V < (1 / 4 : ℝ)) : ∃! v, v ∈ V ∧ 4 ∣ v := by
  have hex : ∃ v ∈ V, 4 ∣ v := by
    by_contra hn
    have hmod : ∀ v ∈ V, v % 4 ≠ 0 := by
      intro v hv hz
      exact hn ⟨v, hv, Nat.dvd_of_mod_eq_zero hz⟩
    exact (not_le_of_gt hlow) (ML_ge_quarter_of_no_four hV hmod)
  obtain ⟨v, hv, h4v⟩ := hex
  refine ⟨v, ⟨hv, h4v⟩, ?_⟩
  intro w hw
  exact eq_of_four_dvd hpair hw.1 hv hw.2 h4v












end Math15.LonelyRunner
