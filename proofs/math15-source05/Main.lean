  let V : Vec4 ℤ := fun i => (v i : ℤ)
  obtain ⟨b,hind,hspan,harea⟩ := native_relations_torus_basis r s V hrs hrv hsv
  have hspeeds : torusLineSpeeds V=Finset.univ.image v := torusLineSpeeds_natCast v
  have hpn : Positive (torusLineSpeeds V) := by simpa only [hspeeds] using hp
  have hprimn : Primitive (torusLineSpeeds V) := by simpa only [hspeeds] using hprim
  have hcardn : (torusLineSpeeds V).card=4 := by simpa only [hspeeds] using hcard
  have hpairn : ∀a∈torusLineSpeeds V,∀b∈torusLineSpeeds V,a≠b→Nat.gcd a b≤2 := by
    simpa only [hspeeds] using hpair
