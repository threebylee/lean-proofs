/- Section: TwoLateSpeeds -/
section


/-!
Two-speed interval insertion at one common time.

Paper proof. For a positive speed c, let j=ceil(c A-1/4). Its translated
middle-half time interval is L=(j+1/4)/c, U=(j+3/4)/c. The ceiling
inequalities give A<=L and c U<c A+3/2. Hence c(B-A)>=3/2 puts [L,U] inside
[A,B]. Throughout this smaller interval, c has circle distance at least one
quarter, and its length is exactly 1/(2c). A speed d>=c therefore traverses at
least half a circle across [L,U]; the checked interval hitting lemma supplies
one point at which d also has quarter distance. Both inequalities concern this
same point.

The speeds 3 and 5 have quarter distance throughout [1/12,3/20], of length
1/15. Consequently all c,d with 23<=c<=d extend them to an actual four-speed
maximum at least one quarter, with no gcd or primitive premise.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- A sufficiently long interval contains a full translated middle half
for one positive speed. The scaled width is exactly one half. -/
theorem exists_quarter_subinterval {A B : ℝ} {c : ℕ}
    (hc : 0<c) (hwidth : (3/2 : ℝ)≤(c : ℝ)*(B-A)) :
    ∃ L U : ℝ, A≤L ∧ U≤B ∧ (c : ℝ)*(U-L)=1/2 ∧
      ∀ x : ℝ, L≤x → x≤U →
        (1/4 : ℝ)≤distance (c • (x : Time)) := by
  have hcR : (0 : ℝ)<c := by exact_mod_cast hc
  let j : ℤ := Int.ceil ((c : ℝ)*A-1/4)
  have hjlo : (c : ℝ)*A-1/4≤(j : ℝ) :=
    Int.le_ceil ((c : ℝ)*A-1/4)
  have hjhi : (j : ℝ)<(c : ℝ)*A-1/4+1 :=
    Int.ceil_lt_add_one ((c : ℝ)*A-1/4)
  let L : ℝ := ((j : ℝ)+1/4)/(c : ℝ)
  let U : ℝ := ((j : ℝ)+3/4)/(c : ℝ)
  have hL : (c : ℝ)*L=(j : ℝ)+1/4 := by
    dsimp [L]
    field_simp [ne_of_gt hcR]
  have hU : (c : ℝ)*U=(j : ℝ)+3/4 := by
    dsimp [U]
    field_simp [ne_of_gt hcR]
  have hAL : A≤L := by
    apply (le_div_iff₀ hcR).2
    nlinarith
  have hUB : U≤B := by
    apply (div_le_iff₀ hcR).2
    nlinarith
  refine ⟨L,U,hAL,hUB,by nlinarith,?_⟩
  intro x hxL hxU
  apply distance_ge_quarter_of_interval (j := j)
  · have hmul := mul_le_mul_of_nonneg_left hxL (le_of_lt hcR)
    linarith
  · have hmul := mul_le_mul_of_nonneg_left hxU (le_of_lt hcR)
    linarith

/-- Two ordered positive speeds attain quarter distance at one common
point of every interval whose c-scaled width is at least three halves. -/
theorem exists_two_quarter_witness_in_interval {A B : ℝ} {c d : ℕ}
    (hc : 0<c) (hcd : c≤d)
    (hwidth : (3/2 : ℝ)≤(c : ℝ)*(B-A)) :
    ∃ x : ℝ, A≤x ∧ x≤B ∧
      (1/4 : ℝ)≤distance (c • (x : Time)) ∧
      (1/4 : ℝ)≤distance (d • (x : Time)) := by
  obtain ⟨L,U,hAL,hUB,hsmall,hcgood⟩ := exists_quarter_subinterval hc hwidth
  have hcR : (0 : ℝ)<c := by exact_mod_cast hc
  have hcdR : (c : ℝ)≤d := by exact_mod_cast hcd
  have hUL : 0≤U-L := by nlinarith
  have hdwidth : (1/2 : ℝ)≤(d : ℝ)*(U-L) := by
    have hmul := mul_le_mul_of_nonneg_right hcdR hUL
    linarith
  obtain ⟨x,hLx,hxU,hdgood⟩ :=
    exists_quarter_witness_in_interval (d := d) (by omega) hdwidth
  exact ⟨x,hAL.trans hLx,hxU.trans hUB,hcgood x hLx hxU,hdgood⟩

/-- A base set with a common quarter interval admits any two ordered
speeds meeting the width condition. -/
theorem ML_ge_quarter_of_two_late_speeds {V : Finset ℕ} {A B : ℝ} {c d : ℕ}
    (hc : 0<c) (hcd : c≤d)
    (hwidth : (3/2 : ℝ)≤(c : ℝ)*(B-A))
    (hbase : ∀ x : ℝ, A≤x → x≤B →
      ∀ v ∈ V, (1/4 : ℝ)≤distance (v • (x : Time))) :
    (1/4 : ℝ)≤ML (insert c (insert d V)) := by
  obtain ⟨x,hAx,hxB,hcx,hdx⟩ := exists_two_quarter_witness_in_interval hc hcd hwidth
  apply ML_lower_of_witness (by simp) (x : Time)
  intro v hv
  rcases Finset.mem_insert.mp hv with rfl | hv
  · exact hcx
  · rcases Finset.mem_insert.mp hv with rfl | hv
    · exact hdx
    · exact hbase x hAx hxB v hv

theorem three_five_quarter_interval {x : ℝ}
    (hlo : (1/12 : ℝ)≤x) (hhi : x≤(3/20 : ℝ)) :
    ∀ v ∈ ({3,5} : Finset ℕ),
      (1/4 : ℝ)≤distance (v • (x : Time)) := by
  intro v hv
  simp only [Finset.mem_insert,Finset.mem_singleton] at hv
  rcases hv with rfl | rfl
  · apply distance_ge_quarter_of_interval (j := 0) <;> norm_num <;> linarith
  · apply distance_ge_quarter_of_interval (j := 0) <;> norm_num <;> linarith

/-- An unbounded actual quartet family, independent of all arithmetic
eligibility hypotheses of Source05. -/
theorem ML_ge_quarter_three_five_two_late {c d : ℕ}
    (hc : 23≤c) (hcd : c≤d) :
    (1/4 : ℝ)≤ML ({3,5,c,d} : Finset ℕ) := by
  have hcR : (23 : ℝ)≤c := by exact_mod_cast hc
  have hwidth : (3/2 : ℝ)≤(c : ℝ)*((3/20 : ℝ)-(1/12 : ℝ)) := by
    nlinarith
  have hset : ({3,5,c,d} : Finset ℕ)=insert c (insert d ({3,5} : Finset ℕ)) := by
    ext v
    simp only [Finset.mem_insert,Finset.mem_singleton]
    tauto
  rw [hset]
  exact ML_ge_quarter_of_two_late_speeds (A := 1/12) (B := 3/20)
    (by omega) hcd hwidth (fun x hxlo hxhi => three_five_quarter_interval hxlo hxhi)







