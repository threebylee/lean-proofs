/- Section: TorusTwoZeroAssembly -/
section




/-!
Unbounded two-zero branches, with the actual integer line retained. In the
cross case cd=ae permits an invertible integer scaling to the common pair
(a,a,0,c),(a,-a,c,0); its second reduction forces c=a or2a. If both zeros are
on one generator, the other generator has an actual tight three-speed profile
and the six checked witnesses give two-sevenths.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torus_cross_two_zero_scale_normalization {a c d e : ℤ}
    (ha : a≠0) (hd : d≠0) (hrel : c*d=a*e) :
    (∀ L : ℝ, TorusGood (![a,a,0,c]) (![d,-d,e,0]) L ↔
      TorusGood (![a,a,0,c]) (![a,-a,c,0]) L) ∧
    TorusAbsoluteLineTransfer (![a,a,0,c]) (![d,-d,e,0])
      (![a,a,0,c]) (![a,-a,c,0]) := by
  let u : Fin 4 → ℤ := ![a,a,0,c]
  let v : Fin 4 → ℤ := ![d,-d,e,0]
  let W : Fin 4 → ℤ := ![a,-a,c,0]
  have hscaled : torusGeneratorScale a v=torusGeneratorScale d W := by
    funext i
    fin_cases i <;> simp [torusGeneratorScale,v,W,Matrix.cons_val_two,Matrix.cons_val_three]
    all_goals nlinarith [hrel]
  constructor
  · intro L
    have hOriginal := torus_good_diagonal_scaling_iff (u:=u) (v:=v) (L:=L) d a hd ha
    have hCanonical := torus_good_diagonal_scaling_iff (u:=u) (v:=W) (L:=L) d d hd hd
    rw [←hscaled] at hCanonical
    exact hOriginal.symm.trans hCanonical
  · have hdet : d*a-(0 : ℤ)*0≠0 := by simpa using mul_ne_zero hd ha
    have hleft : torusIntegerCombination d 0 u v=torusGeneratorScale d u := by
      funext i
      simp [torusIntegerCombination,torusGeneratorScale]
    have hright : torusIntegerCombination 0 a u v=torusGeneratorScale a v := by
      funext i
      simp [torusIntegerCombination,torusGeneratorScale]
    have hLinesScaled := torus_absolute_line_transfer_integer_change (u:=u) (v:=v)
      d 0 0 a hdet
    rw [hleft,hright] at hLinesScaled
    exact torus_absolute_line_transfer_trans hLinesScaled
      (torus_absolute_line_transfer_of_factors d d rfl hscaled.symm)

theorem torus_cross_two_zero_positive_source05_signed_line {a c d e : ℤ}
    {z : Fin 4 → ℤ} (ha : 0<a) (hc : 0<c) (hd : 0<d) (he : 0<e)
    (hspan : TorusIntegerLineInSpan (![a,a,0,c]) (![d,-d,e,0]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    TorusGood (![a,a,0,c]) (![d,-d,e,0]) (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  by_cases hpoint : TorusGood (![a,a,0,c]) (![d,-d,e,0]) (2/7)
  · exact Or.inl hpoint
  · have hrel := torus_cross_two_zero_low_first_relation ha hc hd he hpoint
    obtain ⟨hgood,hLines⟩ := torus_cross_two_zero_scale_normalization
      (ne_of_gt ha) (ne_of_gt hd) hrel
    have hbadCanonical : ¬TorusGood (![a,a,0,c]) (![a,-a,c,0]) (2/7) :=
      fun h => hpoint ((hgood (2/7)).mpr h)
    obtain ⟨w,hw,hspanw⟩ := hLines z hspan
    have hpw : Positive (torusLineSpeeds w) := by simpa only [hw] using hp
    have hprimw : Primitive (torusLineSpeeds w) := by simpa only [hw] using hprim
    have hsource := torus_cross_two_zero_low_source05_signed_line
      ha hc hbadCanonical hspanw hpw hprimw
    exact Or.inr (by simpa only [hw] using hsource)

theorem torus_two_zero_same_generator_good {a d e f : ℤ}
    (ha : a≠0) (hd : d≠0) (he : e≠0) (hf : f≠0) :
    TorusGood (![a,a,0,0]) (![d,-d,e,f]) (2/7) := by
  let u : Fin 4 → ℤ := ![a,a,0,0]
  let v : Fin 4 → ℤ := ![d,-d,e,f]
  by_contra hbad
  have hvn : ∀ i,v i≠0 := by
    intro i
    fin_cases i <;> simp [v,hd,he,hf,Matrix.cons_val_two,Matrix.cons_val_three]
  have habs : (v 0).natAbs=(v 1).natAbs := by simp [v]
  have hbadV : ¬TorusGood v u (2/7) := fun h => hbad (torus_good_swap_iff.mp h)
  obtain ⟨B,hB,hprofile⟩ := torus_bad_collision_line_is_tight hvn habs hbadV
  let R := torusDivideGenerator B v
  have hR : torusLineSpeeds R=({1,2,3} : Finset ℕ) := torus_tight_profile_division hB hprofile
  have hfactor : torusGeneratorScale (B : ℤ) R=v := torus_tight_profile_factor hprofile
  have hR10 : R 1= -R 0 := by
    have hdiv : (B : ℤ) ∣ d := by
      simpa [v] using torus_tight_profile_divides hprofile 0
    dsimp [R,torusDivideGenerator,v]
    exact Int.neg_ediv_of_dvd hdiv
  let D : ℕ := (R 0).natAbs
  let E : ℕ := (R 2).natAbs
  let F : ℕ := (R 3).natAbs
  have htriple : ({D,E,F} : Finset ℕ)={1,2,3} := by
    rw [torus_collision_line_speed_image
      (show (R 0).natAbs=(R 1).natAbs by rw [hR10,Int.natAbs_neg])] at hR
    exact hR
  have hsign (i : Fin 4) : (R i).sign=1 ∨ (R i).sign= -1 :=
    int_sign_nonzero_cases (triple123_line_nonzero
      (torus_tight_profile_division hB hprofile) i)
  let ε : Fin 4 → ℤ := ![(R 0).sign,(R 0).sign,(R 2).sign,(R 3).sign]
  have hε : ∀ i,ε i=1 ∨ ε i= -1 := by
    intro i
    fin_cases i
    · simpa [ε] using hsign 0
    · simpa [ε] using hsign 0
    · simpa [ε,Matrix.cons_val_two,Matrix.cons_val_three] using hsign 2
    · simpa [ε,Matrix.cons_val_two,Matrix.cons_val_three] using hsign 3
  let C : ℤ := (R 0).sign*a
  have hsign0ne : (R 0).sign≠0 := by rcases hsign 0 with h | h <;> simp [h]
  have hC : C≠0 := mul_ne_zero hsign0ne ha
  have hU : torusCoordinateSigns ε u=torusGeneratorScale C (![1,1,0,0]) := by
    funext i
    fin_cases i <;> simp [torusCoordinateSigns,torusGeneratorScale,C,ε,u,
      Matrix.cons_val_two,Matrix.cons_val_three]
  let N : Fin 4 → ℤ := ![(D : ℤ),-(D : ℤ),(E : ℤ),(F : ℤ)]
  have hN : torusCoordinateSigns ε R=N := by
    funext i
    fin_cases i <;> simp [torusCoordinateSigns,ε,N,D,E,F,hR10,Int.sign_mul_self,
      mul_neg,Matrix.cons_val_two,Matrix.cons_val_three]
  have hperm : TorusTwoZeroPermutation D E F := by
    exact triple123_parameter_cases htriple
  have hunit := torus_two_zero_permutation hperm
  have hscale1 : torusGeneratorScale 1 N=N := by funext i; simp [torusGeneratorScale]
  have hsignGood : TorusGood (torusCoordinateSigns ε u) (torusCoordinateSigns ε R) (2/7) := by
    have hscaled := (torus_good_diagonal_scaling_iff (u:=(![1,1,0,0])) (v:=N)
      (L:=(2/7)) C 1 hC (by norm_num)).mpr hunit
    rwa [hscale1,←hU,←hN] at hscaled
  have hUR := (torus_good_coordinate_signs_iff ε hε).mp hsignGood
  have hBInt : (B : ℤ)≠0 := by exact_mod_cast (ne_of_gt hB)
  have hself : torusGeneratorScale 1 u=u := by funext i; simp [torusGeneratorScale]
  have horiginal := (torus_good_diagonal_scaling_iff (u:=u) (v:=R) (L:=(2/7))
    1 (B : ℤ) (by norm_num) hBInt).mpr hUR
  rw [hself,hfactor] at horiginal
  exact hbad horiginal

