/- Section: ThreeRunnerFinite -/
section


/-!
The finite end of three-runner isolation. This kernel computation covers
sorted positive primitive triples whose largest speed is at most ten. It
returns one common rational witness for all three speeds, except 1,2,3.

The full certificate is split into eleven fixed-first-speed rows, each checked
by ordinary kernel reduction at default resource limits. Decision procedures
are named computable definitions rather than registered module instances. Each
row reduces a closed Boolean expression using the named procedure; its kernel
proof has no local instance.

The unbounded transfer belongs to the separate ThreeRunnerPairGrid module.
-/

namespace Math15.LonelyRunner

def ThreeNumeratorGood (a b c m n : ℕ) : Prop :=
  0<n ∧ 2*n≤7*min ((a*m)%n) (n-(a*m)%n) ∧
    2*n≤7*min ((b*m)%n) (n-(b*m)%n) ∧
    2*n≤7*min ((c*m)%n) (n-(c*m)%n)

def threeNumeratorGoodDecidable (a b c m n : ℕ) :
    Decidable (ThreeNumeratorGood a b c m n) := by
  unfold ThreeNumeratorGood
  infer_instance

/-- The same finite statement with the first speed fixed. -/
def ThreeSmallNumericalRow (a : ℕ) : Prop :=
  ∀ b c : Fin 11, 0<a → a<b.val → b.val<c.val →
    Nat.gcd a b.val≤2 → Nat.gcd a c.val≤2 → Nat.gcd b.val c.val≤2 →
    Nat.gcd a (Nat.gcd b.val c.val)=1 →
    (a=1 ∧ b.val=2 ∧ c.val=3) ∨
      ∃ m n : Fin 21, ThreeNumeratorGood a b.val c.val m.val n.val

/-- A computable decision term, used explicitly rather than registered globally. -/
def threeSmallNumericalRowDecidable (a : ℕ) : Decidable (ThreeSmallNumericalRow a) := by
  letI : ∀ a b c m n : ℕ, Decidable (ThreeNumeratorGood a b c m n) :=
    threeNumeratorGoodDecidable
  unfold ThreeSmallNumericalRow
  infer_instance

theorem three_small_numerical_row_0 : ThreeSmallNumericalRow 0 := by
  apply @of_decide_eq_true (ThreeSmallNumericalRow 0) (threeSmallNumericalRowDecidable 0)
  change (@decide (ThreeSmallNumericalRow 0) (threeSmallNumericalRowDecidable 0))=true
  decide +kernel

theorem three_small_numerical_row_1 : ThreeSmallNumericalRow 1 := by
  apply @of_decide_eq_true (ThreeSmallNumericalRow 1) (threeSmallNumericalRowDecidable 1)
  change (@decide (ThreeSmallNumericalRow 1) (threeSmallNumericalRowDecidable 1))=true
  decide +kernel

theorem three_small_numerical_row_2 : ThreeSmallNumericalRow 2 := by
  apply @of_decide_eq_true (ThreeSmallNumericalRow 2) (threeSmallNumericalRowDecidable 2)
  change (@decide (ThreeSmallNumericalRow 2) (threeSmallNumericalRowDecidable 2))=true
  decide +kernel

theorem three_small_numerical_row_3 : ThreeSmallNumericalRow 3 := by
  apply @of_decide_eq_true (ThreeSmallNumericalRow 3) (threeSmallNumericalRowDecidable 3)
