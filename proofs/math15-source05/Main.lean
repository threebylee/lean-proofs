/- Section: TorusAxis -/
section



/-!
Actual coordinate-axis vectors in the real generator plane. All parameter
changes use one shared real point. The one-zero plane has no axis already
under the four nonzero hypotheses on a,c,d,e; no hypothesis on f is needed, so
the same proof includes the cross two-zero plane.
-/

noncomputable section
namespace Math15.LonelyRunner

def torusRealPoint (u v : Fin 4 → ℤ) (x y : ℝ) (i : Fin 4) : ℝ :=
  (u i : ℝ)*x+(v i : ℝ)*y

def TorusHasAxis (u v : Fin 4 → ℤ) : Prop :=
  ∃ k : Fin 4, ∃ x y : ℝ, torusRealPoint u v x y k≠0 ∧
    ∀ i, i≠k → torusRealPoint u v x y i=0

def TorusNoAxis (u v : Fin 4 → ℤ) : Prop := ¬TorusHasAxis u v

theorem torus_real_point_integer_change (u v : Fin 4 → ℤ)
    (A B C D : ℤ) (x y : ℝ) (i : Fin 4) :
    torusRealPoint (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) x y i=
    torusRealPoint u v ((A : ℝ)*x+(C : ℝ)*y)
      ((B : ℝ)*x+(D : ℝ)*y) i := by
  simp only [torusRealPoint,torusIntegerCombination,Int.cast_add,Int.cast_mul]
  ring

theorem torus_has_axis_integer_change_iff {u v : Fin 4 → ℤ}
    (A B C D : ℤ) (hdet : A*D-B*C≠0) :
    TorusHasAxis (torusIntegerCombination A B u v)
      (torusIntegerCombination C D u v) ↔ TorusHasAxis u v := by
  constructor
  · rintro ⟨k,x,y,hk,hzero⟩
    refine ⟨k,(A : ℝ)*x+(C : ℝ)*y,(B : ℝ)*x+(D : ℝ)*y,?_,?_⟩
    · simpa only [torus_real_point_integer_change] using hk
    · intro i hi
      simpa only [torus_real_point_integer_change] using hzero i hi
  · rintro ⟨k,X,Y,hk,hzero⟩
    have hdetR : (A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ)≠0 := by exact_mod_cast hdet
    let x := ((D : ℝ)*X-(C : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ))
    let y := (-(B : ℝ)*X+(A : ℝ)*Y)/((A : ℝ)*(D : ℝ)-(B : ℝ)*(C : ℝ))
    have he (i : Fin 4) : torusRealPoint (torusIntegerCombination A B u v)
        (torusIntegerCombination C D u v) x y i=torusRealPoint u v X Y i := by
      dsimp [torusRealPoint,torusIntegerCombination,x,y]
      push_cast
      field_simp [hdetR] <;> ring
    exact ⟨k,x,y,by rwa [he],fun i hi => by rw [he]; exact hzero i hi⟩

theorem torus_has_axis_diagonal_scaling_iff {u v : Fin 4 → ℤ}
    (A B : ℤ) (hA : A≠0) (hB : B≠0) :
    TorusHasAxis (torusGeneratorScale A u) (torusGeneratorScale B v) ↔
      TorusHasAxis u v := by
  have hdet : A*B-(0 : ℤ)*0≠0 := by simpa using mul_ne_zero hA hB
  have hleft : torusIntegerCombination A 0 u v=torusGeneratorScale A u := by
    funext i
    simp [torusIntegerCombination,torusGeneratorScale]
  have hright : torusIntegerCombination 0 B u v=torusGeneratorScale B v := by
    funext i
    simp [torusIntegerCombination,torusGeneratorScale]
  have he := torus_has_axis_integer_change_iff (u:=u) (v:=v) A 0 0 B hdet
  rwa [hleft,hright] at he

theorem torus_real_point_signs (u v ε : Fin 4 → ℤ) (x y : ℝ) (i : Fin 4) :
    torusRealPoint (torusCoordinateSigns ε u) (torusCoordinateSigns ε v) x y i=
      (ε i : ℝ)*torusRealPoint u v x y i := by
  simp only [torusRealPoint,torusCoordinateSigns,Int.cast_mul]
  ring

/-- Axis invariance needs only nonzero signs, and holds more generally
for any nonzero diagonal integer coordinate changes. -/
theorem torus_has_axis_coordinate_signs_iff {u v : Fin 4 → ℤ}
    (ε : Fin 4 → ℤ) (hε : ∀ i,ε i≠0) :
    TorusHasAxis (torusCoordinateSigns ε u) (torusCoordinateSigns ε v) ↔
      TorusHasAxis u v := by
  have hεR (i : Fin 4) : (ε i : ℝ)≠0 := by exact_mod_cast hε i
  constructor
  · rintro ⟨k,x,y,hk,hzero⟩
    rw [torus_real_point_signs] at hk
    refine ⟨k,x,y,(mul_ne_zero_iff.mp hk).2,?_⟩
    intro i hi
    have hz := hzero i hi
    rw [torus_real_point_signs] at hz
    exact (mul_eq_zero.mp hz).resolve_left (hεR i)
  · rintro ⟨k,x,y,hk,hzero⟩
    refine ⟨k,x,y,?_,?_⟩
    · rw [torus_real_point_signs]
      exact mul_ne_zero (hεR k) hk
    · intro i hi
      rw [torus_real_point_signs,hzero i hi,mul_zero]

theorem torus_has_axis_coordinate_permutation_iff {u v : Fin 4 → ℤ}
    (σ : Equiv.Perm (Fin 4)) :
    TorusHasAxis (torusCoordinatePermute σ u) (torusCoordinatePermute σ v) ↔
      TorusHasAxis u v := by
  constructor
  · rintro ⟨k,x,y,hk,hzero⟩
    refine ⟨σ k,x,y,hk,?_⟩
    intro i hi
    have hne : σ.symm i≠k := by
      intro he
      apply hi
      simpa only [he] using (σ.apply_symm_apply i).symm
    simpa only [torusRealPoint,torusCoordinatePermute,Equiv.apply_symm_apply] using
      hzero (σ.symm i) hne
  · rintro ⟨k,x,y,hk,hzero⟩
    refine ⟨σ.symm k,x,y,?_,?_⟩
    · simpa only [torusRealPoint,torusCoordinatePermute,Equiv.apply_symm_apply] using hk
    · intro i hi
      have hne : σ i≠k := by
        intro he
        exact hi (σ.injective (he.trans (σ.apply_symm_apply k).symm))
      exact hzero (σ i) hne

theorem torus72_exceptional_has_axis {u v : Fin 4 → ℤ}
    (he : Torus72ExceptionalPair u v) : TorusHasAxis u v := by
  rcases he with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ |
    ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · refine ⟨0,1,1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *
  · refine ⟨1,1,-1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *
  · refine ⟨0,1,1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *
  · refine ⟨1,1,-1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *
  · refine ⟨0,1,1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *
  · refine ⟨1,1,-1,by norm_num [torusRealPoint],?_⟩
    intro i hi
    fin_cases i <;> norm_num [torusRealPoint] at *

/-- The two first coordinates and the nonzero third/fourth coefficients
exclude every coordinate axis, uniformly for arbitrary f. -/
theorem torus_one_zero_no_axis {a c d e f : ℤ}
    (ha : a≠0) (hc : c≠0) (hd : d≠0) (he : e≠0) :
    TorusNoAxis (![a,a,0,c]) (![d,-d,e,f]) := by
  have haR : (a : ℝ)≠0 := by exact_mod_cast ha
  have hcR : (c : ℝ)≠0 := by exact_mod_cast hc
  have hdR : (d : ℝ)≠0 := by exact_mod_cast hd
  have heR : (e : ℝ)≠0 := by exact_mod_cast he
  rintro ⟨k,x,y,hk,hzero⟩
  fin_cases k
  · have h2 := hzero 2 (by decide)
    have h3 := hzero 3 (by decide)
    norm_num only [torusRealPoint,Matrix.cons_val_two,Matrix.cons_val_three,
      Matrix.vecHead,Matrix.vecTail,Matrix.cons_val_zero,Matrix.cons_val_one,
      Function.comp_apply,Fin.succ_zero_eq_one,Int.cast_zero,zero_mul,zero_add] at h2
    change (c : ℝ)*x+(f : ℝ)*y=0 at h3
    change (a : ℝ)*x+(d : ℝ)*y≠0 at hk
    have hy : y=0 := (mul_eq_zero.mp h2).resolve_left heR
    rw [hy] at h3 hk
    simp only [mul_zero,add_zero] at h3 hk
    have hx : x=0 := (mul_eq_zero.mp h3).resolve_left hcR
    exact hk (by rw [hx,mul_zero])
  · have h2 := hzero 2 (by decide)
    have h3 := hzero 3 (by decide)
    norm_num only [torusRealPoint,Matrix.cons_val_two,Matrix.cons_val_three,
      Matrix.vecHead,Matrix.vecTail,Matrix.cons_val_zero,Matrix.cons_val_one,
      Function.comp_apply,Fin.succ_zero_eq_one,Int.cast_zero,zero_mul,zero_add] at h2
    change (c : ℝ)*x+(f : ℝ)*y=0 at h3
    change (a : ℝ)*x+((-d : ℤ) : ℝ)*y≠0 at hk
    have hy : y=0 := (mul_eq_zero.mp h2).resolve_left heR
    rw [hy] at h3 hk
    simp only [mul_zero,add_zero] at h3 hk
    have hx : x=0 := (mul_eq_zero.mp h3).resolve_left hcR
    exact hk (by rw [hx,mul_zero])
  · have h0 := hzero 0 (by decide)
    have h1 := hzero 1 (by decide)
    norm_num [torusRealPoint] at h0 h1 hk
    have hax : (a : ℝ)*x=0 := by linarith
    have hdy : (d : ℝ)*y=0 := by linarith
    have hx : x=0 := (mul_eq_zero.mp hax).resolve_left haR
    have hy : y=0 := (mul_eq_zero.mp hdy).resolve_left hdR
    exact hk.2 hy
  · have h0 := hzero 0 (by decide)
    have h1 := hzero 1 (by decide)
    norm_num [torusRealPoint] at h0 h1 hk
    have hax : (a : ℝ)*x=0 := by linarith
    have hdy : (d : ℝ)*y=0 := by linarith
    have hx : x=0 := (mul_eq_zero.mp hax).resolve_left haR
    have hy : y=0 := (mul_eq_zero.mp hdy).resolve_left hdR
    exact hk (by rw [hx,hy]; simp)

theorem torus_cross_two_zero_no_axis {a c d e : ℤ}
    (ha : a≠0) (hc : c≠0) (hd : d≠0) (he : e≠0) :
    TorusNoAxis (![a,a,0,c]) (![d,-d,e,0]) := torus_one_zero_no_axis ha hc hd he

theorem torus_bad_no_zero_collision_normalizes72_with_lines_and_axis {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hvn : ∀ i,v i≠0)
    (hu01 : u 0=u 1) (hv0 : v 0=u 0) (hv1 : v 1= -u 0)
    (hbad : ¬TorusGood u v (2/7)) :
    ∃ a b c d : ℕ, ∃ e f : ℤ, b<c ∧ ({a,b,c} : Finset ℕ)={1,2,3} ∧
      ({d,e.natAbs,f.natAbs} : Finset ℕ)={1,2,3} ∧
      (∀ L : ℝ, TorusGood u v L ↔
        TorusGood (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
          (![(d : ℤ),-(d : ℤ),e,f]) L) ∧
      TorusAbsoluteLineTransfer u v (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
        (![(d : ℤ),-(d : ℤ),e,f]) ∧
      (TorusHasAxis u v ↔ TorusHasAxis (![(a : ℤ),(a : ℤ),(b : ℤ),(c : ℤ)])
        (![(d : ℤ),-(d : ℤ),e,f])) := by
  have huabs : (u 0).natAbs=(u 1).natAbs := by rw [hu01]
  have hvabs : (v 0).natAbs=(v 1).natAbs := by rw [hv0,hv1,Int.natAbs_neg]
  obtain ⟨A,hA,hprofileU⟩ := torus_bad_collision_line_is_tight hun huabs hbad
  have hbadV : ¬TorusGood v u (2/7) := fun h => hbad (torus_good_swap_iff.mp h)
  obtain ⟨B,hB,hprofileV⟩ := torus_bad_collision_line_is_tight hvn hvabs hbadV
  let Q := torusDivideGenerator A u
  let R := torusDivideGenerator B v
  have hQ : torusLineSpeeds Q=({1,2,3} : Finset ℕ) := torus_tight_profile_division hA hprofileU
  have hR : torusLineSpeeds R=({1,2,3} : Finset ℕ) := torus_tight_profile_division hB hprofileV
  have hQfactor : torusGeneratorScale (A : ℤ) Q=u := torus_tight_profile_factor hprofileU
  have hRfactor : torusGeneratorScale (B : ℤ) R=v := torus_tight_profile_factor hprofileV
  have hAInt : (0 : ℤ)<A := by exact_mod_cast hA
  have hBInt : (0 : ℤ)<B := by exact_mod_cast hB
  have hQR (L : ℝ) : TorusGood u v L ↔ TorusGood Q R L := by
    have h := torus_good_diagonal_scaling_iff (u := Q) (v := R) (L := L)
      (A : ℤ) (B : ℤ) (ne_of_gt hAInt) (ne_of_gt hBInt)
    rwa [hQfactor,hRfactor] at h
  have hQ01 : Q 0=Q 1 := by dsimp [Q,torusDivideGenerator]; rw [hu01]
  have hR10 : R 1= -R 0 := by
    dsimp [R,torusDivideGenerator]
    rw [hv1,←hv0,Int.neg_ediv_of_dvd (torus_tight_profile_divides hprofileV 0)]
  let ε : Fin 4 → ℤ := fun i => (Q i).sign
  have hε : ∀ i,ε i=1 ∨ ε i= -1 := by
    intro i
    have hne := triple123_line_nonzero hQ i
    dsimp [ε]
    rcases lt_or_gt_of_ne hne with hneg | hpos
    · exact Or.inr (Int.sign_eq_neg_one_of_neg hneg)
    · exact Or.inl (Int.sign_eq_one_of_pos hpos)
  let U := torusCoordinateSigns ε Q
  let V := torusCoordinateSigns ε R
  have hU : torusLineSpeeds U=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε Q hε]
    exact hQ
  have hV : torusLineSpeeds V=({1,2,3} : Finset ℕ) := by
    rw [torusLineSpeeds_signs ε R hε]
    exact hR
  have hUpos : ∀ i,0<U i := by
    intro i
    have hn := triple123_line_nonzero hQ i
    have hpos : (0 : ℤ)<((Q i).natAbs : ℤ) := by
      exact_mod_cast Nat.pos_of_ne_zero (Int.natAbs_ne_zero.mpr hn)
    simpa only [U,torusCoordinateSigns,ε,Int.sign_mul_self] using hpos
  have hU01 : U 0=U 1 := by simp only [U,torusCoordinateSigns,ε,hQ01]
  have hV10 : V 1= -V 0 := by
    simp only [V,torusCoordinateSigns,ε,hQ01.symm,hR10,mul_neg]
  have hVpos : 0<V 0 := by
    have he : (A : ℤ)*Q 0=(B : ℤ)*R 0 := by
      have hq := congrFun hQfactor 0
      have hr := congrFun hRfactor 0
      dsimp [torusGeneratorScale] at hq hr
      rw [hq,hr,hv0]
    exact sign_common_positive_ratio hAInt hBInt (triple123_line_nonzero hQ 0) he
  have hUV (L : ℝ) : TorusGood u v L ↔ TorusGood U V L :=
    (hQR L).trans (torus_good_coordinate_signs_iff (u := Q) (v := R) ε hε).symm
  have hLinesQR : TorusAbsoluteLineTransfer u v Q R :=
    torus_absolute_line_transfer_of_factors (A : ℤ) (B : ℤ) hQfactor hRfactor
  have hLinesUV : TorusAbsoluteLineTransfer u v U V :=
    torus_absolute_line_transfer_trans hLinesQR (torus_absolute_line_transfer_signs Q R ε hε)
  have hAxisQR : TorusHasAxis u v ↔ TorusHasAxis Q R := by
    have ht := torus_has_axis_diagonal_scaling_iff (u:=Q) (v:=R)
      (A : ℤ) (B : ℤ) (ne_of_gt hAInt) (ne_of_gt hBInt)
    rwa [hQfactor,hRfactor] at ht
  have hεne : ∀ i,ε i≠0 := by
    intro i
    rcases hε i with he | he <;> simp [he]
  have hAxisUV : TorusHasAxis u v ↔ TorusHasAxis U V :=
    hAxisQR.trans (torus_has_axis_coordinate_signs_iff (u:=Q) (v:=R) ε hεne).symm
  have hneq := collision_triple123_other_coordinates_distinct hU01 hU
  by_cases horder : U 2<U 3
  · obtain ⟨a,b,c,d,e,f,hbc,hU',hV',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUpos hU01 horder hU hVpos hV10 hV
    refine ⟨a,b,c,d,e,f,hbc,hU',hV',?_,?_,?_⟩
    · intro L
      simpa only [hueq,hveq] using hUV L
    · simpa only [hueq,hveq] using hLinesUV
    · simpa only [hueq,hveq] using hAxisUV
  · let σ : Equiv.Perm (Fin 4) := Equiv.swap 2 3
    let U' := torusCoordinatePermute σ U
    let V' := torusCoordinatePermute σ V
    have hU' : torusLineSpeeds U'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ U]
      exact hU
    have hV' : torusLineSpeeds V'=({1,2,3} : Finset ℕ) := by
      rw [torusLineSpeeds_permute σ V]
      exact hV
    have hUp : ∀ i,0<U' i := fun i => hUpos (σ i)
    have hU01' : U' 0=U' 1 := by simpa [U',torusCoordinatePermute,σ] using hU01
    have hU23' : U' 2<U' 3 := by
      have h : U 3<U 2 := by omega
      simpa [U',torusCoordinatePermute,σ] using h
    have hVp : 0<V' 0 := by simpa [V',torusCoordinatePermute,σ] using hVpos
    have hV10' : V' 1= -V' 0 := by simpa [V',torusCoordinatePermute,σ] using hV10
    obtain ⟨a,b,c,d,e,f,hbc,hU'',hV'',hueq,hveq⟩ :=
      torus_ordered_profiles_parameters hUp hU01' hU23' hU' hVp hV10' hV'
    refine ⟨a,b,c,d,e,f,hbc,hU'',hV'',?_,?_,?_⟩
    · intro L
      have ht := (hUV L).trans
        (torus_good_coordinate_permutation_iff (u := U) (v := V) σ).symm
      change TorusGood u v L ↔ TorusGood U' V' L at ht
      simpa only [hueq,hveq] using ht
    · have hLines := torus_absolute_line_transfer_trans hLinesUV
        (torus_absolute_line_transfer_permute U V σ)
      change TorusAbsoluteLineTransfer u v U' V' at hLines
      simpa only [hueq,hveq] using hLines
    · have ht := hAxisUV.trans
        (torus_has_axis_coordinate_permutation_iff (u:=U) (v:=V) σ).symm
      change TorusHasAxis u v ↔ TorusHasAxis U' V' at ht
      simpa only [hueq,hveq] using ht













