section


/-!
The normalized no-zero collision generators have exactly 72 parameter cases.
The first absolute triple is {1,2,3}, with its last two entries in increasing
order; the second absolute triple is a permutation of {1,2,3}, with two
independent signs. The proof below derives these alternatives from the actual
finite-set equalities, then uses the 66 checked common-point witnesses. Each
remaining case is identified with one of six literal pairs.

This proves parameter exhaustion for this normalized class. A general integer
plane still requires the normalization and exceptional-family transfer;
neither is assumed as a classification conclusion here.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem triple123_parameter_cases {a b c : ℕ}
    (h : ({a,b,c} : Finset ℕ) = {1,2,3}) :
    (a=1 ∧ b=2 ∧ c=3) ∨ (a=1 ∧ b=3 ∧ c=2) ∨
    (a=2 ∧ b=1 ∧ c=3) ∨ (a=2 ∧ b=3 ∧ c=1) ∨
    (a=3 ∧ b=1 ∧ c=2) ∨ (a=3 ∧ b=2 ∧ c=1) := by
  have ha : a=1 ∨ a=2 ∨ a=3 := by
    have hm : a ∈ ({a,b,c} : Finset ℕ) := by simp
    rw [h] at hm
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  have hb : b=1 ∨ b=2 ∨ b=3 := by
    have hm : b ∈ ({a,b,c} : Finset ℕ) := by simp
    rw [h] at hm
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  have hc : c=1 ∨ c=2 ∨ c=3 := by
    have hm : c ∈ ({a,b,c} : Finset ℕ) := by simp
    rw [h] at hm
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  have h1 : 1=a ∨ 1=b ∨ 1=c := by
    have hm : 1 ∈ ({a,b,c} : Finset ℕ) := by rw [h]; simp
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  have h2 : 2=a ∨ 2=b ∨ 2=c := by
    have hm : 2 ∈ ({a,b,c} : Finset ℕ) := by rw [h]; simp
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  have h3 : 3=a ∨ 3=b ∨ 3=c := by
    have hm : 3 ∈ ({a,b,c} : Finset ℕ) := by rw [h]; simp
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  rcases ha with rfl | rfl | rfl
  all_goals rcases hb with rfl | rfl | rfl
  all_goals rcases hc with rfl | rfl | rfl
  all_goals omega

theorem triple123_sorted_parameter_cases {a b c : ℕ}
    (hbc : b<c) (h : ({a,b,c} : Finset ℕ) = {1,2,3}) :
    (a=1 ∧ b=2 ∧ c=3) ∨ (a=2 ∧ b=1 ∧ c=3) ∨
    (a=3 ∧ b=1 ∧ c=2) := by
  rcases triple123_parameter_cases h with ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ |
    ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩
  all_goals omega

/-- The six remaining profiles are actual equalities of both generators. -/
def Torus72ExceptionalPair (u v : Fin 4 → ℤ) : Prop :=
  (u = (![1, 1, 2, 3]) ∧ v = (![1, -1, -2, -3])) ∨
  (u = (![1, 1, 2, 3]) ∧ v = (![1, -1, 2, 3])) ∨
  (u = (![2, 2, 1, 3]) ∧ v = (![2, -2, -1, -3])) ∨
  (u = (![2, 2, 1, 3]) ∧ v = (![2, -2, 1, 3])) ∨
  (u = (![3, 3, 1, 2]) ∧ v = (![3, -3, -1, -2])) ∨
  (u = (![3, 3, 1, 2]) ∧ v = (![3, -3, 1, 2]))

/-- Positivity is already forced by the two absolute-triple equalities.
The theorem derives all 72 cases from these exact parameter hypotheses. -/
