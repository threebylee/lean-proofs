/- Section: Rank3CoefficientCases -/
section



/-!
Exact coefficient cases needed by the rank-three fallback.

The width-five certificate checks all 6^4 unsigned vectors in the Lean kernel.
Its unrestricted consumer bounds each coordinate by the supplied sum, so the
certificate covers every permitted natural vector. The width-seven refinement
follows from parity and requires no finite enumeration. No native evaluator or
custom axiom is used.
-/

namespace Math15.LonelyRunner.Covolume4

theorem width_five_fin6_certificate :
    ∀ a : Fin 4 → Fin 6,
      (∑ i, (a i).val) = 5 → (∑ i, (a i).val ^ 2) ≤ 16 →
      (∑ i, (a i).val ^ 2) ≤ 11 ∨
        ∃ i j : Fin 4, i ≠ j ∧ (a i).val = 3 ∧ (a j).val = 2 ∧
          ∀ k, k ≠ i → k ≠ j → (a k).val = 0 := by
  decide +kernel

/-- Every natural vector in the stated width and norm range has either
small squared norm or exactly the unsigned shape (3,2,0,0). -/
theorem width_five_nat_shape (a : Fin 4 → ℕ)
    (hsum : (∑ i, a i) = 5) (hnorm : (∑ i, (a i)^2) ≤ 16) :
    (∑ i, (a i)^2) ≤ 11 ∨
      ∃ i j : Fin 4, i ≠ j ∧ a i = 3 ∧ a j = 2 ∧
        ∀ k, k ≠ i → k ≠ j → a k = 0 := by
  have ha : ∀ i, a i < 6 := by
    intro i
    have hle : a i ≤ ∑ j, a j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (a j)) (Finset.mem_univ i)
    omega
  let af : Fin 4 → Fin 6 := fun i => ⟨a i, ha i⟩
  have hcert := width_five_fin6_certificate af hsum hnorm
  simpa only [af] using hcert

/-- Squaring removes signs, with the integer/natural coercion made
explicit for the native squared Euclidean norm. -/
theorem integer_abs_square_sum (m : Vec4 ℤ) :
    ((∑ i, (m i).natAbs ^ 2 : ℕ) : ℤ) = dot4 m m := by
  simp only [Nat.cast_sum, Nat.cast_pow, Int.natCast_natAbs, sq_abs]
  simp only [Fin.sum_univ_four, dot4, pow_two]

/-- Integer wrapper of the exact unsigned shape certificate. The two
nonzero magnitudes remain unsigned; determining their relative signs
from a positive annihilated speed vector is a separate consumer. -/
theorem width_five_integer_shape (m : Vec4 ℤ)
    (hsum : (∑ i, (m i).natAbs) = 5) (hnorm : dot4 m m ≤ 16) :
    dot4 m m ≤ 11 ∨
      ∃ i j : Fin 4, i ≠ j ∧ (m i).natAbs = 3 ∧ (m j).natAbs = 2 ∧
        ∀ k, k ≠ i → k ≠ j → m k = 0 := by
  have hn : (∑ i, (m i).natAbs ^ 2) ≤ 16 := by
    have hz : ((∑ i, (m i).natAbs ^ 2 : ℕ) : ℤ) ≤ 16 := by
      rw [integer_abs_square_sum]
      exact hnorm
    exact_mod_cast hz
  rcases width_five_nat_shape (fun i => (m i).natAbs) hsum hn with hsmall | hshape
  · left
    rw [← integer_abs_square_sum]
    exact_mod_cast hsmall
  · right
    obtain ⟨i, j, hij, hi, hj, hzero⟩ := hshape
    refine ⟨i, j, hij, hi, hj, ?_⟩
    intro k hki hkj
    exact Int.natAbs_eq_zero.mp (hzero k hki hkj)

theorem nat_square_mod_two (n : ℕ) : n^2 % 2 = n % 2 := by
  rw [Nat.pow_mod]
  rcases Nat.mod_two_eq_zero_or_one n with h | h <;> simp [h]

theorem four_square_sum_mod_two (a : Fin 4 → ℕ) :
    (∑ i, (a i)^2) % 2 = (∑ i, a i) % 2 := by
  simp only [Fin.sum_univ_four]
  have h0 := nat_square_mod_two (a 0)
  have h1 := nat_square_mod_two (a 1)
  have h2 := nat_square_mod_two (a 2)
  have h3 := nat_square_mod_two (a 3)
  omega

/-- Odd width seven forces an odd squared norm, so an upper bound of
sixteen improves to fifteen. -/
theorem width_seven_nat_norm_le_fifteen (a : Fin 4 → ℕ)
    (hsum : (∑ i, a i) = 7) (hnorm : (∑ i, (a i)^2) ≤ 16) :
    (∑ i, (a i)^2) ≤ 15 := by
  have hparity := four_square_sum_mod_two a
  rw [hsum] at hparity
  omega

theorem width_seven_integer_norm_le_fifteen (m : Vec4 ℤ)
    (hsum : (∑ i, (m i).natAbs) = 7) (hnorm : dot4 m m ≤ 16) :
    dot4 m m ≤ 15 := by
  have hn : (∑ i, (m i).natAbs ^ 2) ≤ 16 := by
    have hz : ((∑ i, (m i).natAbs ^ 2 : ℕ) : ℤ) ≤ 16 := by
      rw [integer_abs_square_sum]
      exact hnorm
    exact_mod_cast hz
  have hsmall := width_seven_nat_norm_le_fifteen (fun i => (m i).natAbs) hsum hn
  rw [← integer_abs_square_sum]
  exact_mod_cast hsmall










end Math15.LonelyRunner.Covolume4
end 

/- Section: RelationSmallNorm -/
section





/-!
Actual signed-relation consumers for the small-norm fallback. The norm13
exceptional magnitude profile (3,2,0,0) is kept as an actual coordinate order,
rather than an enumerated speed sample. Positivity forces opposite signs, and
the literal dot relation gives speeds 2q and 3q in those same coordinates.
Their pairwise gcd bound forces q=1 or q=2.

The small parity helpers apply to arbitrary integer vectors. Unsigned bounded
coefficient enumeration belongs to Rank3CoefficientCases and is not duplicated
here.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

theorem integer_square_eq_self_add_even (z : ℤ) :
    ∃ q : ℤ, z^2=z+2*q := by
  obtain ⟨q,hq⟩ := Int.even_mul_pred_self z
  exact ⟨q,by nlinarith [hq]⟩

theorem relation_normSq_eq_signed_sum_add_even (m : Vec4 ℤ) :
    ∃ q : ℤ, dot4 m m=(∑i,m i)+2*q := by
  choose q hq using fun i : Fin 4 => integer_square_eq_self_add_even (m i)
  refine ⟨∑i,q i,?_⟩
  simp only [dot4,Fin.sum_univ_four]
  nlinarith [hq 0,hq 1,hq 2,hq 3]

theorem relation_signed_sum_eq_l1_add_even (m : Vec4 ℤ) :
    ∃ q : ℤ, (∑i,m i)=(relationL1 m : ℤ)+2*q := by
  choose q hq using fun i : Fin 4 => integer_eq_natAbs_add_even (m i)
  refine ⟨∑i,q i,?_⟩
  simp only [relationL1,Fin.sum_univ_four,Nat.cast_add]
  nlinarith [hq 0,hq 1,hq 2,hq 3]

theorem relation_normSq_parity (m : Vec4 ℤ) :
    (dot4 m m)%2=(∑i,m i)%2 ∧
      (dot4 m m)%2=(relationL1 m : ℤ)%2 := by
  obtain ⟨q,hq⟩ := relation_normSq_eq_signed_sum_add_even m
  obtain ⟨r,hr⟩ := relation_signed_sum_eq_l1_add_even m
  constructor <;> omega

theorem odd_relation_normSq_and_signed_sum (m : Vec4 ℤ)
    (hodd : Odd (relationL1 m)) :
    Odd (dot4 m m) ∧ Odd (∑i,m i) ∧ (1 : ℤ)≤(∑i,m i)^2 := by
  have hoddZ : Odd (relationL1 m : ℤ) := by exact_mod_cast hodd
  have hmod := Int.odd_iff.mp hoddZ
  obtain ⟨hns,hnl⟩ := relation_normSq_parity m
  have hnmod : (dot4 m m)%2=1 := hnl.trans hmod
  have hsmod : (∑i,m i)%2=1 := hns.symm.trans hnmod
  have hsne : (∑i,m i)≠0 := by omega
  have hsrange : (∑i,m i)≤ -1 ∨ 1≤(∑i,m i) := by omega
  refine ⟨Int.odd_iff.mpr hnmod,Int.odd_iff.mpr hsmod,?_⟩
  rcases hsrange with hs | hs <;>
    nlinarith [sq_nonneg ((∑i,m i)+1),sq_nonneg ((∑i,m i)-1)]

theorem odd_relation_normSq_le_fifteen (m : Vec4 ℤ)
    (hodd : Odd (relationL1 m)) (hnorm : dot4 m m≤16) : dot4 m m≤15 := by
  have hmod := Int.odd_iff.mp (odd_relation_normSq_and_signed_sum m hodd).1
  omega

theorem even_relation_signed_sum_certificate (m : Vec4 ℤ)
    (heven : Even (relationL1 m)) : ∃ j : ℤ, (∑i,m i)=2*j := by
  obtain ⟨k,hk⟩ := heven
  obtain ⟨r,hr⟩ := relation_signed_sum_eq_l1_add_even m
  have hkZ : (relationL1 m : ℤ)=(k : ℤ)+(k : ℤ) := by exact_mod_cast hk
  exact ⟨(k : ℤ)+r,by linarith⟩

theorem actual_small_relation_odd_width_cases {m : Vec4 ℤ} {v : Fin 4 → ℕ}
    (hp : Positive (positiveLineSpeeds v)) (hc : (positiveLineSpeeds v).card=4)
    (hdot : naturalRelationDot m v=0) (hpos : 0<dot4 m m)
    (hwidth : relationL1 m≤8) (hodd : Odd (relationL1 m)) :
    relationL1 m=3 ∨ relationL1 m=5 ∨ relationL1 m=7 := by
  have hm : m≠0 := by
    intro hz
    rw [hz] at hpos
    norm_num [dot4] at hpos
  have hlower := relation_width_ge_three_of_four_speeds hp hc hdot hm
  obtain ⟨k,hk⟩ := hodd
  omega

/-- Actual coordinates carrying the exceptional norm13 magnitude profile. -/
def RelationThreeTwoMagnitude (m : Vec4 ℤ) : Prop :=
  ∃ i j k l : Fin 4, RelationCoordinateOrder i j k l ∧
    (m i).natAbs=3 ∧ (m j).natAbs=2 ∧ m k=0 ∧ m l=0

theorem fin4_complete_distinct_pair {i j : Fin 4} (hij : i≠j) :
    ∃ k l : Fin 4, RelationCoordinateOrder i j k l := by
  fin_cases i <;> fin_cases j
  · exact False.elim (hij rfl)
  · exact ⟨2,3,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨1,3,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨1,2,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨2,3,by unfold RelationCoordinateOrder; decide⟩
  · exact False.elim (hij rfl)
  · exact ⟨0,3,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨0,2,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨1,3,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨0,3,by unfold RelationCoordinateOrder; decide⟩
  · exact False.elim (hij rfl)
  · exact ⟨0,1,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨1,2,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨0,2,by unfold RelationCoordinateOrder; decide⟩
  · exact ⟨0,1,by unfold RelationCoordinateOrder; decide⟩
  · exact False.elim (hij rfl)

theorem relation_three_two_magnitude_of_sparse_shape {m : Vec4 ℤ}
    {i j : Fin 4} (hij : i≠j)
    (hi : (m i).natAbs=3) (hj : (m j).natAbs=2)
    (hzero : ∀ k,k≠i → k≠j → m k=0) : RelationThreeTwoMagnitude m := by
  obtain ⟨k,l,horder⟩ := fin4_complete_distinct_pair hij
  obtain ⟨hij,hik,hil,hjk,hjl,hkl⟩ := horder
  exact ⟨i,j,k,l,⟨hij,hik,hil,hjk,hjl,hkl⟩,hi,hj,
    hzero k hik.symm hjk.symm,hzero l hil.symm hjl.symm⟩

theorem relation_three_two_magnitude_of_natAbs_order {m : Vec4 ℤ}
    {i j k l : Fin 4} (horder : RelationCoordinateOrder i j k l)
    (hi : (m i).natAbs=3) (hj : (m j).natAbs=2)
    (hk : (m k).natAbs=0) (hl : (m l).natAbs=0) :
    RelationThreeTwoMagnitude m :=
  ⟨i,j,k,l,horder,hi,hj,Int.natAbs_eq_zero.mp hk,Int.natAbs_eq_zero.mp hl⟩

theorem relation_three_two_magnitude_normSq {m : Vec4 ℤ}
    (hshape : RelationThreeTwoMagnitude m) : dot4 m m=13 := by
  obtain ⟨i,j,k,l,horder,hi,hj,hk,hl⟩ := hshape
  have hiSq : (m i)^2=9 := by
    have h := Int.natAbs_pow_two (m i)
    rw [hi] at h
    norm_num at h
    exact h.symm
  have hjSq : (m j)^2=4 := by
    have h := Int.natAbs_pow_two (m j)
    rw [hj] at h
    norm_num at h
    exact h.symm
  have hnorm : dot4 m m=∑r,(m r)^2 := by
    simp only [dot4,Fin.sum_univ_four,pow_two]
  rw [hnorm,relation_coordinate_order_sum horder (fun r => (m r)^2),
    hiSq,hjSq,hk,hl]
  norm_num

theorem width_five_relation_normSq_le_thirteen (m : Vec4 ℤ)
    (hwidth : relationL1 m=5) (hnorm : dot4 m m≤16) : dot4 m m≤13 := by
  rcases width_five_integer_shape m hwidth hnorm with hsmall | ⟨i,j,hij,hi,hj,hzero⟩
  · omega
  · have heq := relation_three_two_magnitude_normSq
      (relation_three_two_magnitude_of_sparse_shape hij hi hj hzero)
    omega

theorem width_five_relation_normSq_le_eleven_of_not_three_two (m : Vec4 ℤ)
    (hwidth : relationL1 m=5) (hnorm : dot4 m m≤16)
    (hnot : ¬RelationThreeTwoMagnitude m) : dot4 m m≤11 := by
  rcases width_five_integer_shape m hwidth hnorm with hsmall | ⟨i,j,hij,hi,hj,hzero⟩
  · exact hsmall
  · exact False.elim (hnot (relation_three_two_magnitude_of_sparse_shape hij hi hj hzero))

theorem positive_three_two_diophantine {a b : ℕ}
    (ha : 0<a) (heq : 3*a=2*b) :
    ∃ q : ℕ, 0<q ∧ a=2*q ∧ b=3*q := by
  refine ⟨a/2,?_,?_,?_⟩ <;> omega

/-- The exceptional magnitude profile forces an actual pair of speeds,
with the original indices and no independently chosen speed sample. -/
theorem relation_three_two_magnitude_actual_speed_pair
    {m : Vec4 ℤ} {v : Fin 4 → ℕ}
    (hshape : RelationThreeTwoMagnitude m)
    (hdot : naturalRelationDot m v=0)
    (hp : Positive (positiveLineSpeeds v))
    (hpair : ∀a∈positiveLineSpeeds v,∀b∈positiveLineSpeeds v,
      a≠b → Nat.gcd a b≤2) :
    ∃ i j : Fin 4, ∃ q : ℕ, i≠j ∧ 0<q ∧ (q=1 ∨ q=2) ∧
      v i=2*q ∧ v j=3*q := by
  obtain ⟨i,j,k,l,horder,hi,hj,hk,hl⟩ := hshape
  have hd : m i*(v i : ℤ)+m j*(v j : ℤ)+
      m k*(v k : ℤ)+m l*(v l : ℤ)=0 := by
    have he := relation_coordinate_order_sum horder (fun r => m r*(v r : ℤ))
    unfold naturalRelationDot at hdot
    rwa [he] at hdot
  have hvi := hp _ (line_speed_mem v i)
  have hvj := hp _ (line_speed_mem v j)
  have hviZ : (0 : ℤ)<v i := by exact_mod_cast hvi
  have hvjZ : (0 : ℤ)<v j := by exact_mod_cast hvj
  have hiSigns : m i=3 ∨ m i= -3 := by simpa [hi] using Int.natAbs_eq (m i)
  have hjSigns : m j=2 ∨ m j= -2 := by simpa [hj] using Int.natAbs_eq (m j)
  have heqZ : (3 : ℤ)*(v i : ℤ)=2*(v j : ℤ) := by
    rcases hiSigns with hI | hI <;> rcases hjSigns with hJ | hJ <;>
      rw [hI,hJ,hk,hl] at hd <;> nlinarith
  have heq : 3*v i=2*v j := by exact_mod_cast heqZ
  obtain ⟨q,hq,hviq,hvjq⟩ := positive_three_two_diophantine hvi heq
  have hne : v i≠v j := by omega
  have hbound := hpair _ (line_speed_mem v i) _ (line_speed_mem v j) hne
  have hdivi : q∣v i := by
    rw [hviq]
    exact dvd_mul_left q 2
  have hdivj : q∣v j := by
    rw [hvjq]
    exact dvd_mul_left q 3
  have hqle : q≤2 :=
    (Nat.le_of_dvd (Nat.gcd_pos_of_pos_left (v j) hvi)
      (Nat.dvd_gcd hdivi hdivj)).trans hbound
  exact ⟨i,j,q,horder.1,hq,by omega,hviq,hvjq⟩

theorem relation_three_two_magnitude_pair_mem
    {m : Vec4 ℤ} {v : Fin 4 → ℕ}
    (hshape : RelationThreeTwoMagnitude m)
    (hdot : naturalRelationDot m v=0)
    (hp : Positive (positiveLineSpeeds v))
    (hpair : ∀a∈positiveLineSpeeds v,∀b∈positiveLineSpeeds v,
      a≠b → Nat.gcd a b≤2) :
    ∃ q : ℕ, 0<q ∧ (q=1 ∨ q=2) ∧
      2*q∈positiveLineSpeeds v ∧ 3*q∈positiveLineSpeeds v := by
  obtain ⟨i,j,q,hij,hq,hqcase,hvi,hvj⟩ :=
    relation_three_two_magnitude_actual_speed_pair hshape hdot hp hpair
  refine ⟨q,hq,hqcase,?_,?_⟩
  · rw [←hvi]
    exact line_speed_mem v i
  · rw [←hvj]
    exact line_speed_mem v j

/-- Interface matching the sparse unsigned norm13 certificate exactly. -/
theorem relation_sparse_three_two_speed_pair_mem
    {m : Vec4 ℤ} {v : Fin 4 → ℕ} {i j : Fin 4}
    (hij : i≠j) (hi : (m i).natAbs=3) (hj : (m j).natAbs=2)
    (hzero : ∀ k,k≠i → k≠j → m k=0)
    (hdot : naturalRelationDot m v=0)
    (hp : Positive (Finset.univ.image v))
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,
      a≠b → Nat.gcd a b≤2) :
    ∃ q : ℕ, (q=1 ∨ q=2) ∧
      2*q∈Finset.univ.image v ∧ 3*q∈Finset.univ.image v := by
  obtain ⟨q,hq,hqcase,h2,h3⟩ := relation_three_two_magnitude_pair_mem
    (relation_three_two_magnitude_of_sparse_shape hij hi hj hzero) hdot hp hpair
  exact ⟨q,hqcase,h2,h3⟩

theorem width_five_relation_small_norm_or_actual_pair
    (m : Vec4 ℤ) (v : Fin 4 → ℕ)
    (hwidth : relationL1 m=5) (hnorm : dot4 m m≤16)
    (hdot : naturalRelationDot m v=0)
    (hp : Positive (Finset.univ.image v))
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,
      a≠b → Nat.gcd a b≤2) :
    dot4 m m≤11 ∨ ∃ q : ℕ, (q=1 ∨ q=2) ∧
      2*q∈Finset.univ.image v ∧ 3*q∈Finset.univ.image v := by
  rcases width_five_integer_shape m hwidth hnorm with hsmall | ⟨i,j,hij,hi,hj,hzero⟩
  · exact Or.inl hsmall
  · exact Or.inr (relation_sparse_three_two_speed_pair_mem hij hi hj hzero hdot hp hpair)





















end Math15.LonelyRunner.Covolume4
end 
