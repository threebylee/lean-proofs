/- Section: U2ParityGrid -/
section





/-!
# Exact U2 maximum on the 2(A+B) grid

Put C=A+B. Even grid numerators make the C runner integral. For odd numerators
the C runner is at one half and the D=A+2B runner is the negative of A, so the
score is min(||A*t||,||B*t||). The two distances complement to one half when
one is represented in [0,1/2].

For the upper bound, quarter coverage and grid integrality give the answer
when C is odd or C=2 mod 4. If C=0 mod 4, coprimality forces A and B odd.
Every possible active runner other than C then has an odd grid norm numerator;
C itself has norm one half. Consequently the active numerator is at most
C/2-1.

For attainment choose an odd u among A and B. It is coprime to 2C. Use its
modular inverse to send u*m to r=2*floor(C/4)+1 modulo 2C. Both u and r are
odd, so m is odd. The same time gives the score min(r,C-r)/(2C), exactly
U2PairGap C in all four residue classes.

No final critical-time assembly or universal Target05 claim is asserted here.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem U2_coprime_not_both_even {A B : ℕ} (hcop : Nat.Coprime A B) :
    ¬ (A % 2 = 0 ∧ B % 2 = 0) := by
  rintro ⟨ha, hb⟩
  have hg : 2 ∣ Nat.gcd A B := Nat.dvd_gcd
    (Nat.dvd_of_mod_eq_zero ha) (Nat.dvd_of_mod_eq_zero hb)
  have hc : Nat.gcd A B = 1 := hcop
  rw [hc] at hg
  norm_num at hg

theorem U2_odd_unit {A B : ℕ} (hcop : Nat.Coprime A B) :
    ∃ u : ℕ, (u = A ∨ u = B) ∧ u % 2 = 1 ∧ Nat.Coprime u (2 * (A + B)) := by
  have hnot := U2_coprime_not_both_even hcop
  by_cases ha : A % 2 = 1
  · have hu2 : Nat.Coprime A 2 := Nat.coprime_two_right.mpr (Nat.odd_iff.mpr ha)
    have huC : Nat.Coprime A (A + B) := Nat.coprime_self_add_right.mpr hcop
    exact ⟨A, Or.inl rfl, ha, Nat.coprime_mul_iff_right.mpr ⟨hu2, huC⟩⟩
  · have hb : B % 2 = 1 := by omega
    have hu2 : Nat.Coprime B 2 := Nat.coprime_two_right.mpr (Nat.odd_iff.mpr hb)
    have huC : Nat.Coprime B (A + B) := Nat.coprime_add_self_right.mpr hcop.symm
    exact ⟨B, Or.inr rfl, hb, Nat.coprime_mul_iff_right.mpr ⟨hu2, huC⟩⟩

theorem U2_integer_circle_zero (k : ℕ) : (((k : ℝ) : ℝ) : Time) = 0 := by
  apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
  exact ⟨(k : ℤ), by simp [zsmul_eq_mul]⟩

/-- A modular numerator identity gives equality of actual circle points. -/
theorem rational_time_eq_of_mul_mod {u m n r : ℕ} (hn : 0 < n)
    (hmod : (u * m) % n = r) :
    u • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time) =
      ((((r : ℝ) / (n : ℝ)) : ℝ) : Time) := by
  rw [nsmul_rational_time_nat]
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hn)
  have hnum : u * m = r + n * ((u * m) / n) := by
    simpa only [hmod] using (Nat.mod_add_div (u * m) n).symm
  have hnumR : ((u * m : ℕ) : ℝ) = (r : ℝ) + (n : ℝ) * ((u * m) / n : ℕ) := by
    exact_mod_cast hnum
  have hdiv : (((u * m : ℕ) : ℝ) / (n : ℝ)) =
      (r : ℝ) / (n : ℝ) + ((u * m) / n : ℕ) := by
    rw [hnumR]
    field_simp
  rw [hdiv, AddCircle.coe_add, U2_integer_circle_zero, add_zero]

theorem U2_C_grid_residue (C m : ℕ) :
    (C * m) % (2 * C) = C * (m % 2) := by
  rw [Nat.mul_comm 2 C, Nat.mul_mod_mul_left]

theorem U2_distance_coe_of_nonnegative_le_half {x : ℝ}
    (hx0 : 0 ≤ x) (hxhalf : x ≤ 1 / 2) : distance (x : Time) = x := by
  unfold distance
  rw [(AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
    (by rw [abs_of_nonneg hx0, abs_one]; exact hxhalf)]
  exact abs_of_nonneg hx0

theorem U2_C_position_of_odd_grid {C m : ℕ} (hC : 0 < C) (hm : m % 2 = 1) :
    C • ((((m : ℝ) / (2 * C : ℕ)) : ℝ) : Time) = ((1 / 2 : ℝ) : Time) := by
  have hmod : (C * m) % (2 * C) = C := by rw [U2_C_grid_residue, hm, mul_one]
  rw [rational_time_eq_of_mul_mod (by omega : 0 < 2 * C) hmod]
  have hCR : (C : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hC)
  congr 1
  push_cast
  field_simp

theorem U2_parity_score_of_half (A B : ℕ) (t : Time)
    (hzero : (2 * (A + B)) • t = 0)
    (hhalf : (A + B) • t = ((1 / 2 : ℝ) : Time)) :
    score (U2Speeds A B) t = min (distance (A • t)) (distance (B • t)) := by
  have hsum : A • t + (A + 2 * B) • t = 0 := by
    have hn : A + (A + 2 * B) = 2 * (A + B) := by omega
    rw [← add_nsmul, hn]
    exact hzero
  have hD : (A + 2 * B) • t = -(A • t) := by
    apply add_left_cancel (a := A • t)
    simpa only [add_neg_cancel] using hsum
  have hCdist : distance ((A + B) • t) = 1 / 2 := by
    rw [hhalf]
    exact U2_distance_coe_of_nonnegative_le_half (by norm_num) le_rfl
  have hAhalf : distance (A • t) ≤ 1 / 2 := by
    simpa [distance] using AddCircle.norm_le_half_period (1 : ℝ) (by norm_num)
      (x := A • t)
  rw [U2_score_eq_min, hD, distance_neg_eq, hCdist, min_eq_right hAhalf]
  rw [min_comm (distance (B • t)) (distance (A • t)), U2_min_left_repeat]

/-- Every norm in this identity concerns the one displayed time. -/
theorem U2_parity_score_of_odd_residue {A B m r : ℕ}
    (hC : 0 < A + B) (hm : m % 2 = 1) (hr : r ≤ A + B)
    (hhit : (A * m) % (2 * (A + B)) = r ∨
      (B * m) % (2 * (A + B)) = r) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time) =
      ((min r (A + B - r) : ℕ) : ℝ) / (2 * (A + B) : ℕ) := by
  let t : Time := ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time)
  let x : ℝ := (r : ℝ) / (2 * (A + B) : ℕ)
  have hn : 0 < 2 * (A + B) := by omega
  have hnR : (0 : ℝ) < (2 * (A + B) : ℕ) := by exact_mod_cast hn
  have hx0 : 0 ≤ x := by dsimp [x]; positivity
  have hrR : (r : ℝ) ≤ (A + B : ℕ) := by exact_mod_cast hr
  push_cast at hrR
  have hxhalf : x ≤ 1 / 2 := by
    apply (div_le_iff₀ hnR).2
    push_cast
    nlinarith [hrR]
  have hhalf : (A + B) • t = ((1 / 2 : ℝ) : Time) :=
    U2_C_position_of_odd_grid hC hm
  have hzero : (2 * (A + B)) • t = 0 := rational_time_annihilated m _ hn
  have hbase := U2_parity_score_of_half A B t hzero hhalf
  have hcomp : 1 / 2 - x = ((A + B - r : ℕ) : ℝ) / (2 * (A + B) : ℕ) := by
    dsimp [x]
    rw [Nat.cast_sub hr]
    push_cast
    have hCR : (A : ℝ) + (B : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hC)
    field_simp [hCR]
  have hnorm : distance (x : Time) = x :=
    U2_distance_coe_of_nonnegative_le_half hx0 hxhalf
  have hnormComp : distance ((1 / 2 - x : ℝ) : Time) = 1 / 2 - x :=
    U2_distance_coe_of_nonnegative_le_half (by linarith) (by linarith)
  have hs : score (U2Speeds A B) t = min x (1 / 2 - x) := by
    rw [hbase]
    rcases hhit with ha | hb
    · have haPos : A • t = (x : Time) := rational_time_eq_of_mul_mod hn ha
      have hbPos : B • t = ((1 / 2 - x : ℝ) : Time) := by
        calc
          B • t = (A + B) • t - A • t := by rw [add_nsmul]; abel
          _ = ((1 / 2 - x : ℝ) : Time) := by rw [hhalf, haPos, AddCircle.coe_sub]
      rw [haPos, hbPos, hnorm, hnormComp]
    · have hbPos : B • t = (x : Time) := rational_time_eq_of_mul_mod hn hb
      have haPos : A • t = ((1 / 2 - x : ℝ) : Time) := by
        calc
          A • t = (A + B) • t - B • t := by rw [add_nsmul]; abel
          _ = ((1 / 2 - x : ℝ) : Time) := by rw [hhalf, hbPos, AddCircle.coe_sub]
      rw [haPos, hbPos, hnorm, hnormComp, min_comm]
  rw [hs, hcomp]
  dsimp [x]
  rw [min_div_div_right hnR.le, Nat.cast_min]

theorem U2PairGap_nonnegative (C : ℕ) : 0 ≤ U2PairGap C := by
  unfold U2PairGap
  split_ifs <;> positivity

theorem U2_parity_odd_norm_numerator {v m C : ℕ} (hC : 0 < C)
    (hv : v % 2 = 1) (hm : m % 2 = 1) :
    (min ((v * m) % (2 * C)) (2 * C - (v * m) % (2 * C))) % 2 = 1 := by
  have hd : 2 ∣ 2 * C := dvd_mul_right 2 C
  have hres : ((v * m) % (2 * C)) % 2 = 1 := by
    rw [Nat.mod_mod_of_dvd _ hd, Nat.mul_mod, hv, hm]
  by_cases hle : (v * m) % (2 * C) ≤ 2 * C - (v * m) % (2 * C)
  · rw [min_eq_left hle]
    exact hres
  · rw [min_eq_right (by omega)]
    have hlt : (v * m) % (2 * C) < 2 * C := Nat.mod_lt _ (by omega)
    omega

theorem U2_parity_grid_upper {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) (m : ℕ) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time) ≤
      U2PairGap (A + B) := by
  let C : ℕ := A + B
  let n : ℕ := 2 * C
  let t : Time := ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)
  have hC : 0 < C := by dsimp [C]; omega
  have hn : 0 < n := by dsimp [n]; omega
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have h4R : (0 : ℝ) < 4 * (C : ℝ) := by positivity
  have hq : score (U2Speeds A B) t ≤ 1 / 4 := U2_score_le_quarter A B t
  change score (U2Speeds A B) t ≤ U2PairGap C
  by_cases hc2 : C % 4 = 2
  · rw [U2PairGap, if_pos hc2]
    exact hq
  by_cases hc0 : C % 4 = 0
  · rw [U2PairGap, if_neg hc2, if_pos hc0]
    by_cases hm0 : m % 2 = 0
    · have hmod : (C * m) % n = 0 := by
        dsimp [n]
        rw [U2_C_grid_residue, hm0, mul_zero]
      have hdist : distance (C • t) = 0 := by
        dsimp [t]
        rw [distance_at_rational, hmod]
        simp
      have hmem : C ∈ U2Speeds A B := by simp [C, U2Speeds]
      have hz := score_le_distance hmem t
      rw [hdist] at hz
      exact hz.trans (by positivity)
    have hm : m % 2 = 1 := by omega
    have hnot := U2_coprime_not_both_even hcop
    have haOdd : A % 2 = 1 := by dsimp [C] at hc0; omega
    have hbOdd : B % 2 = 1 := by dsimp [C] at hc0; omega
    obtain ⟨v, hv, he⟩ := Finset.exists_mem_eq_inf' (U2Speeds_nonempty A B)
      (fun v => distance (v • t))
    have heScore : score (U2Speeds A B) t = distance (v • t) := by
      simpa only [score, dif_pos (U2Speeds_nonempty A B)] using he
    let k : ℕ := min ((v * m) % n) (n - (v * m) % n)
    have hk : score (U2Speeds A B) t = (k : ℝ) / (n : ℝ) := by
      rw [heScore]
      exact distance_at_rational v m n
    have hkR : (k : ℝ) ≤ (1 / 4 : ℝ) * (n : ℝ) :=
      (div_le_iff₀ hnR).mp (by rwa [hk] at hq)
    have h2k : 2 * k ≤ C := by
      have hreal : (2 : ℝ) * (k : ℝ) ≤ (C : ℝ) := by
        dsimp [n] at hkR
        push_cast at hkR
        nlinarith
      exact_mod_cast hreal
    have hvCase : v = A ∨ v = B ∨ v = C ∨ v = A + 2 * B := by
      simpa only [U2Speeds, Finset.mem_insert, Finset.mem_singleton, C] using hv
    have hvOdd : v % 2 = 1 := by
      rcases hvCase with rfl | rfl | hvc | rfl
      · exact haOdd
      · exact hbOdd
      · have hmod : (C * m) % n = C := by
          dsimp [n]
          rw [U2_C_grid_residue, hm, mul_one]
        have hkC : k = C := by
          dsimp [k]
          rw [hvc, hmod]
          have hs : n - C = C := by dsimp [n]; omega
          rw [hs, min_self]
        omega
      · omega
    have hkOdd : k % 2 = 1 := U2_parity_odd_norm_numerator hC hvOdd hm
    have hkSmall : 2 * k ≤ C - 2 := by omega
    have hkSmallR : (2 : ℝ) * (k : ℝ) ≤ ((C - 2 : ℕ) : ℝ) := by
      exact_mod_cast hkSmall
    rw [hk]
    apply (div_le_div_iff₀ hnR h4R).2
    dsimp [n]
    push_cast
    nlinarith [mul_le_mul_of_nonneg_right hkSmallR (Nat.cast_nonneg C)]
  · rw [U2PairGap, if_neg hc2, if_neg hc0]
    obtain ⟨k, hk⟩ := rational_score_integer_multiple (U2Speeds A B)
      (U2Speeds_nonempty A B) m n
    have hkR : (k : ℝ) ≤ (1 / 4 : ℝ) * (n : ℝ) :=
      (div_le_iff₀ hnR).mp (by rwa [hk] at hq)
    have h2k : 2 * k ≤ C := by
      have hreal : (2 : ℝ) * (k : ℝ) ≤ (C : ℝ) := by
        dsimp [n] at hkR
        push_cast at hkR
        nlinarith
      exact_mod_cast hreal
    have hkSmall : 2 * k ≤ C - 1 := by omega
    have hkSmallR : (2 : ℝ) * (k : ℝ) ≤ ((C - 1 : ℕ) : ℝ) := by
      exact_mod_cast hkSmall
    rw [hk]
    apply (div_le_div_iff₀ hnR h4R).2
    dsimp [n]
    push_cast
    nlinarith [mul_le_mul_of_nonneg_right hkSmallR (Nat.cast_nonneg C)]

def U2ParityResidue (C : ℕ) : ℕ := 2 * (C / 4) + 1

theorem U2ParityResidue_bounds {C : ℕ} (hC : 2 ≤ C) :
    U2ParityResidue C % 2 = 1 ∧ U2ParityResidue C ≤ C ∧ U2ParityResidue C < 2 * C := by
  unfold U2ParityResidue
  omega

theorem U2ParityResidue_value {C : ℕ} (hC : 2 ≤ C) :
    ((min (U2ParityResidue C) (C - U2ParityResidue C) : ℕ) : ℝ) / (2 * C : ℕ) =
      U2PairGap C := by
  let k : ℕ := min (U2ParityResidue C) (C - U2ParityResidue C)
  have hCpos : (0 : ℝ) < C := by exact_mod_cast (show 0 < C by omega)
  have hnat : 2 * k = if C % 4 = 2 then C else if C % 4 = 0 then C - 2 else C - 1 := by
    dsimp [k, U2ParityResidue]
    split_ifs <;> simp only [Nat.min_def] <;> split_ifs <;> omega
  change (k : ℝ) / (2 * C : ℕ) = U2PairGap C
  unfold U2PairGap
  split_ifs with h2 h0
  · rw [if_pos h2] at hnat
    have hkR : (2 : ℝ) * (k : ℝ) = (C : ℝ) := by exact_mod_cast hnat
    push_cast
    apply (div_eq_iff (by positivity : (2 : ℝ) * C ≠ 0)).2
    nlinarith
  · rw [if_neg h2, if_pos h0] at hnat
    have hkR : (k : ℝ) = ((C - 2 : ℕ) : ℝ) / 2 := by
      have hh : (2 : ℝ) * (k : ℝ) = ((C - 2 : ℕ) : ℝ) := by exact_mod_cast hnat
      linarith
    rw [hkR]
    push_cast
    field_simp
    ring
  · rw [if_neg h2, if_neg h0] at hnat
    have hkR : (k : ℝ) = ((C - 1 : ℕ) : ℝ) / 2 := by
      have hh : (2 : ℝ) * (k : ℝ) = ((C - 1 : ℕ) : ℝ) := by exact_mod_cast hnat
      linarith
    rw [hkR]
    push_cast
    field_simp
    ring

theorem U2_parity_grid_attained {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) :
    ∃ m : ℕ, m < 2 * (A + B) ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time) =
        U2PairGap (A + B) := by
  let C : ℕ := A + B
  let r : ℕ := U2ParityResidue C
  have hC : 2 ≤ C := by dsimp [C]; omega
  have hn : 0 < 2 * C := by omega
  obtain ⟨hrOdd, hrC, hrlt⟩ := U2ParityResidue_bounds hC
  obtain ⟨u, hu, huOdd, huCop⟩ := U2_odd_unit hcop
  obtain ⟨m, hm, hmod⟩ := Nat.exists_mul_mod_eq_of_coprime r huCop (Nat.ne_of_gt hn)
  have hmod' : (u * m) % (2 * C) = r := hmod.trans (Nat.mod_eq_of_lt hrlt)
  have hd : 2 ∣ 2 * C := dvd_mul_right 2 C
  have h2 : Nat.ModEq 2 (u * m) r :=
    (show Nat.ModEq (2 * C) (u * m) r from hmod).of_dvd hd
  have hmOdd : m % 2 = 1 := by
    have h2' : m % 2 = r % 2 := by
      simpa only [Nat.ModEq, Nat.mul_mod, huOdd, one_mul, Nat.mod_mod] using h2
    exact h2'.trans hrOdd
  have hhit : (A * m) % (2 * (A + B)) = r ∨ (B * m) % (2 * (A + B)) = r := by
    rcases hu with rfl | rfl
    · exact Or.inl hmod'
    · exact Or.inr hmod'
  refine ⟨m, hm, ?_⟩
  exact (U2_parity_score_of_odd_residue (by omega : 0 < A + B) hmOdd hrC hhit).trans
    (U2ParityResidue_value hC)

theorem U2_parity_grid_maximum {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) :
    (∀ m : ℕ, score (U2Speeds A B) ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time) ≤
      U2PairGap (A + B)) ∧
    ∃ m : ℕ, m < 2 * (A + B) ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * (A + B) : ℕ)) : ℝ) : Time) =
        U2PairGap (A + B) := by
  exact ⟨U2_parity_grid_upper hA hB hcop, U2_parity_grid_attained hA hB hcop⟩










end Math15.LonelyRunner
end 
end 

/- Section: U2Assembly -/
section



/-!
# Exact U2 maximum and its amended spectrum

For four speeds A,B,C=A+B,D=A+2B, the six possible sums of two distinct speeds
are C,D,Q=2A+B,2C,S=A+3B,R=2A+3B. On the C and D grids an actual runner has
integral position, hence score zero. The other four exact grid maxima are
supplied by U2TripleClasses and U2ParityGrid. Critical-time attainment
therefore gives the upper formula, while the four common-time witnesses give
its lower formula.

The numerical arithmetic theorem then puts that exact maximum at one quarter
or s/(4s+k) with k in {1,2} and k<=s. This is the entire positive coprime U2
family, not the unrestricted four-speed target.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem U2ArithmeticValue_component_bounds (A B : ℕ) :
    U2GridGap (2 * A + B) ≤ U2ArithmeticValue A B ∧
      U2GridGap (2 * A + 3 * B) ≤ U2ArithmeticValue A B ∧
      U2GridGap (A + 3 * B) ≤ U2ArithmeticValue A B ∧
      U2PairGap (A + B) ≤ U2ArithmeticValue A B := by
  unfold U2ArithmeticValue
  exact ⟨(le_max_left _ _).trans (le_max_left _ _),
    (le_max_right _ _).trans (le_max_left _ _),
    (le_max_left _ _).trans (le_max_right _ _),
    (le_max_right _ _).trans (le_max_right _ _)⟩

theorem U2ArithmeticValue_nonnegative (A B : ℕ) : 0 ≤ U2ArithmeticValue A B := by
  exact (U2PairGap_nonnegative (A + B)).trans
    (U2ArithmeticValue_component_bounds A B).2.2.2

/-- The six classes enumerate pairs of actual distinct speeds, even when
the four defining expressions themselves have a repeated value. -/
theorem U2_pair_sum_classes {A B u v : ℕ}
    (hu : u ∈ U2Speeds A B) (hv : v ∈ U2Speeds A B) (huv : u ≠ v) :
    u + v = A + B ∨ u + v = A + 2 * B ∨ u + v = 2 * A + B ∨
      u + v = 2 * (A + B) ∨ u + v = A + 3 * B ∨ u + v = 2 * A + 3 * B := by
  have hu' : u = A ∨ u = B ∨ u = A + B ∨ u = A + 2 * B := by
    simpa only [U2Speeds, Finset.mem_insert, Finset.mem_singleton] using hu
  have hv' : v = A ∨ v = B ∨ v = A + B ∨ v = A + 2 * B := by
    simpa only [U2Speeds, Finset.mem_insert, Finset.mem_singleton] using hv
  rcases hu' with rfl | rfl | rfl | rfl <;>
    rcases hv' with rfl | rfl | rfl | rfl <;> omega

theorem score_grid_le_zero_of_denominator_mem {V : Finset ℕ} {n : ℕ}
    (hmem : n ∈ V) (hn : 0 < n) (m : ℕ) :
    score V ((((m : ℝ) / (n : ℝ)) : ℝ) : Time) ≤ 0 := by
  have h := score_le_distance hmem ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)
  rw [rational_time_annihilated m n hn] at h
  simpa only [distance, norm_zero] using h

/-- Every possible attaining pair grid has score bounded by the same F. -/
theorem U2_pair_grid_upper {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) {u v : ℕ}
    (hu : u ∈ U2Speeds A B) (hv : v ∈ U2Speeds A B) (huv : u ≠ v) (m : ℕ) :
    score (U2Speeds A B) ((((m : ℝ) / (u + v : ℕ)) : ℝ) : Time) ≤
      U2ArithmeticValue A B := by
  obtain ⟨hQ, hR, hS, hC⟩ := U2ArithmeticValue_component_bounds A B
  rcases U2_pair_sum_classes hu hv huv with hn | hn | hn | hn | hn | hn
  · rw [hn]
    exact (score_grid_le_zero_of_denominator_mem
      (V := U2Speeds A B) (n := A + B)
      (by simp [U2Speeds]) (by omega : 0 < A + B) m).trans
      (U2ArithmeticValue_nonnegative A B)
  · rw [hn]
    exact (score_grid_le_zero_of_denominator_mem
      (V := U2Speeds A B) (n := A + 2 * B)
      (by simp [U2Speeds]) (by omega : 0 < A + 2 * B) m).trans
      (U2ArithmeticValue_nonnegative A B)
  · rw [hn]
    exact (U2_Q_grid_upper A B m (by omega)).trans hQ
  · rw [hn]
    exact (U2_parity_grid_upper hA hB hcop m).trans hC
  · rw [hn]
    exact (U2_S_grid_upper A B m (by omega)).trans hS
  · rw [hn]
    exact (U2_R_grid_upper A B m (by omega)).trans hR

theorem U2_ML_le_formula {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) : ML (U2Speeds A B) ≤ U2ArithmeticValue A B := by
  obtain ⟨u, hu, v, hv, huv, m, k, hk, hm, he⟩ := ML_rational_pair_grid
    (U2Speeds_nonempty A B) (U2Speeds_positive hA hB) (U2_ML_lt_half A B)
  rw [← hm]
  exact U2_pair_grid_upper hA hB hcop hu hv huv m

theorem U2_formula_le_ML {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) : U2ArithmeticValue A B ≤ ML (U2Speeds A B) := by
  obtain ⟨hQcop, hRcop, hScop⟩ := U2_triple_class_coprime hcop
  have hQ : U2GridGap (2 * A + B) ≤ ML (U2Speeds A B) := by
    obtain ⟨m, hm, he⟩ := U2_Q_grid_attained A B (by omega) hQcop
    rw [U2GridGap, ← he]
    exact score_le_ML (U2Speeds A B) _
  have hR : U2GridGap (2 * A + 3 * B) ≤ ML (U2Speeds A B) := by
    obtain ⟨m, hm, he⟩ := U2_R_grid_attained A B (by omega) hRcop
    rw [U2GridGap, ← he]
    exact score_le_ML (U2Speeds A B) _
  have hS : U2GridGap (A + 3 * B) ≤ ML (U2Speeds A B) := by
    obtain ⟨m, hm, he⟩ := U2_S_grid_attained A B (by omega) hScop
    rw [U2GridGap, ← he]
    exact score_le_ML (U2Speeds A B) _
  have hC : U2PairGap (A + B) ≤ ML (U2Speeds A B) := by
    obtain ⟨m, hm, he⟩ := U2_parity_grid_attained hA hB hcop
    rw [← he]
    exact score_le_ML (U2Speeds A B) _
  exact max_le (max_le hQ hR) (max_le hS hC)

/-- The full exact U2 formula, with unconditional same-time upper coverage
and a separate attaining numerator for each candidate maximum. -/
theorem U2_ML_formula {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) : ML (U2Speeds A B) = U2ArithmeticValue A B := by
  exact le_antisymm (U2_ML_le_formula hA hB hcop) (U2_formula_le_ML hA hB hcop)

theorem U2_ML_amended_spectrum {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) : U2DiscreteAtMostTwo (ML (U2Speeds A B)) := by
  rw [U2_ML_formula hA hB hcop]
  exact U2ArithmeticValue_spectrum hA hB hcop

/-- Exact Target05 conclusion on every positive coprime U2 family. -/
theorem source05_of_U2 {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) :
    (1 / 4 : ℝ) ≤ ML (U2Speeds A B) ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML (U2Speeds A B) = (s : ℝ) / (4 * (s : ℝ) + k) := by
  rcases U2_ML_amended_spectrum hA hB hcop with he | ⟨s, k, hk1, hk2, hks, he⟩
  · exact Or.inl (by rw [he])
  · exact Or.inr ⟨s, k, hk1, by omega, hks, he⟩

theorem source05_of_U2_representation {V : Finset ℕ} {A B : ℕ}
    (hA : 0 < A) (hB : 0 < B) (hcop : Nat.Coprime A B) (hV : V = U2Speeds A B) :
    (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML V = (s : ℝ) / (4 * (s : ℝ) + k) := by
  rw [hV]
  exact source05_of_U2 hA hB hcop

/-- Primitivity of the actual four-speed set supplies the unit condition
needed by all four exact grid computations. -/
theorem U2_primitive_implies_coprime {A B : ℕ}
    (hprim : Primitive (U2Speeds A B)) : Nat.Coprime A B := by
  have hgA : Nat.gcd A B ∣ A := Nat.gcd_dvd_left A B
  have hgB : Nat.gcd A B ∣ B := Nat.gcd_dvd_right A B
  have hg : Nat.gcd A B ∣ (U2Speeds A B).gcd id := by
    apply Finset.dvd_gcd
    intro v hv
    have hv' : v = A ∨ v = B ∨ v = A + B ∨ v = A + 2 * B := by
      simpa only [U2Speeds, Finset.mem_insert, Finset.mem_singleton] using hv
    rcases hv' with rfl | rfl | rfl | rfl
    · exact hgA
    · exact hgB
    · exact dvd_add hgA hgB
    · exact dvd_add hgA (dvd_mul_of_dvd_right hgB 2)
  have hEq : (U2Speeds A B).gcd id = 1 := hprim
  rw [hEq] at hg
  exact Nat.dvd_one.mp hg

/-- Original positivity and primitivity hypotheses suffice on the U2
representation branch; no separately assumed coprimality is retained. -/
theorem source05_of_primitive_U2_representation {V : Finset ℕ} {A B : ℕ}
    (hp : Positive V) (hprim : Primitive V) (hV : V = U2Speeds A B) :
    (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML V = (s : ℝ) / (4 * (s : ℝ) + k) := by
  have hA : 0 < A := hp A (by rw [hV]; simp [U2Speeds])
  have hB : 0 < B := hp B (by rw [hV]; simp [U2Speeds])
  have hprimU2 : Primitive (U2Speeds A B) := by rwa [hV] at hprim
  exact source05_of_U2_representation hA hB (U2_primitive_implies_coprime hprimU2) hV












end Math15.LonelyRunner
end 
end 

/- Section: ExceptionalFourteen -/
section


/-!
Paper proof: the time 7/17 attains distance 4/17 simultaneously as a minimum
for speeds {1,3,4,14}. The following nine successive closed bad intervals
cover [0,1], giving the matching upper bound. Their speed/integer centers are
(1,0),(4,1),(3,1),(14,6),(4,2),(14,8),(3,2),(4,3),(1,1), with successive right
endpoints 4/17,21/68,7/17,53/119,19/34,10/17,38/51,55/68,1. This certifies one
admissible exception to the stronger two-family speed classification, while
its value remains in the conjectured spectrum.
-/

noncomputable section
namespace Math15.LonelyRunner

def exceptionalFourteen : Finset ℕ := {1, 3, 4, 14}

theorem exceptionalFourteen_lower : (4 / 17 : ℝ) ≤ ML exceptionalFourteen := by
  apply ML_lower_of_witness (by simp [exceptionalFourteen]) (((7 : ℝ) / (17 : ℝ)) : Time)
  intro v hv
  have hd := distance_at_rational v 7 17
  simp only [Nat.cast_ofNat] at hd
  rw [hd]
  simp only [exceptionalFourteen, Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl <;> norm_num

theorem exceptionalFourteen_upper : ML exceptionalFourteen ≤ (4 / 17 : ℝ) := by
  apply ML_upper_of_all_times
  intro t
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  obtain ⟨x, hx, rfl⟩ := AddCircle.eq_coe_Ico t
  have h0 : 0 ≤ x := hx.1
  have h1 : x ≤ 1 := le_of_lt hx.2
  have cover (v : ℕ) (j : ℤ) (hv : v ∈ exceptionalFourteen)
      (hl : (j : ℝ) - 4 / 17 ≤ (v : ℝ) * x)
      (hu : (v : ℝ) * x ≤ (j : ℝ) + 4 / 17) :
      score exceptionalFourteen (x : Time) ≤ 4 / 17 :=
    (score_le_distance hv (x : Time)).trans (distance_le_of_interval hl hu)
  by_cases h2 : x ≤ 4 / 17
  · exact cover 1 0 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h3 : x ≤ 21 / 68
  · exact cover 4 1 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h4 : x ≤ 7 / 17
  · exact cover 3 1 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h5 : x ≤ 53 / 119
  · exact cover 14 6 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h6 : x ≤ 19 / 34
  · exact cover 4 2 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h7 : x ≤ 10 / 17
  · exact cover 14 8 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h8 : x ≤ 38 / 51
  · exact cover 3 2 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  by_cases h9 : x ≤ 55 / 68
  · exact cover 4 3 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)
  exact cover 1 1 (by simp [exceptionalFourteen]) (by norm_num; linarith) (by norm_num; linarith)

theorem exceptionalFourteen_exact : ML exceptionalFourteen = (4 / 17 : ℝ) :=
  le_antisymm exceptionalFourteen_upper exceptionalFourteen_lower

theorem exceptionalFourteen_admissible :
    Positive exceptionalFourteen ∧ exceptionalFourteen.card = 4 ∧
    Primitive exceptionalFourteen ∧
    (∀ u ∈ exceptionalFourteen, ∀ v ∈ exceptionalFourteen,
      u ≠ v → Nat.gcd u v ≤ 2) := by
  norm_num [Positive, Primitive, exceptionalFourteen, Finset.gcd_insert,
    Finset.gcd_singleton, Nat.gcd_comm]

theorem exceptionalFourteen_discrete :
    ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML exceptionalFourteen = (s : ℝ) / (4 * (s : ℝ) + k) := by
  refine ⟨4, 1, by norm_num, by norm_num, by norm_num, ?_⟩
  convert exceptionalFourteen_exact using 1 <;> norm_num

theorem exceptionalFourteen_no_tight_triple :
    ¬ ∃ a : ℕ, a ∈ exceptionalFourteen ∧ 2 * a ∈ exceptionalFourteen ∧
      3 * a ∈ exceptionalFourteen := by
  rintro ⟨a, ha, h2, _⟩
  simp only [exceptionalFourteen, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> norm_num [exceptionalFourteen] at h2

theorem exceptionalFourteen_not_U2 :
    ¬ ∃ A B : ℕ, exceptionalFourteen = {A, B, A + B, A + 2 * B} := by
  rintro ⟨A, B, hset⟩
  have ha : A ∈ exceptionalFourteen := by rw [hset]; simp
  have hb : B ∈ exceptionalFourteen := by rw [hset]; simp
  have hab : A + B ∈ exceptionalFourteen := by rw [hset]; simp
  have ha2b : A + 2 * B ∈ exceptionalFourteen := by rw [hset]; simp
  simp only [exceptionalFourteen, Finset.mem_insert, Finset.mem_singleton] at ha hb
  rcases ha with rfl | rfl | rfl | rfl <;>
    rcases hb with rfl | rfl | rfl | rfl <;>
    (solve | norm_num [exceptionalFourteen] at hab | norm_num [exceptionalFourteen] at ha2b)









end Math15.LonelyRunner
end 
end 

/- Section: FiniteResidueSoundness -/
section






/-!
Soundness and coverage for the exact finite residue census.

Paper argument. A rational certificate uses the same time m/n for all four
speeds. Its inequalities n <= 4 min(vm mod n,n-vm mod n), after division by
the positive denominator, prove ML >= 1/4. The other certificates invoke the
checked 1,2 and 2,4 branches, the positive U2 family, or {1,3,4,14}. For the
U2 certificate, its four positive distinct members form a subset of the
quartet of cardinality four; hence they are exactly that quartet.

Every sorted positive quartet of sum at most bound is in the nested ranges:
4a+6 <= bound, a+3b+3 <= bound, and a+b+2c+1 <= bound give the three outer
range bounds, and the sum bound gives the final range bound. The pair-gcd
hypotheses prevent the early skip, and primitivity supplies the last gcd
condition. Thus a true census proves the exact original spectrum disjunction
throughout its stated range.
-/

noncomputable section
namespace Math15.LonelyRunner

abbrev finiteQuartetSpeeds (a b c d : ℕ) : Finset ℕ := {a, b, c, d}

abbrev FiniteSource05Conclusion (V : Finset ℕ) : Prop :=
  (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
    ML V = (s : ℝ) / (4 * (s : ℝ) + k)

theorem finite_quartet_card {a b c d : ℕ}
    (hab : a < b) (hbc : b < c) (hcd : c < d) :
    (finiteQuartetSpeeds a b c d).card = 4 := by
  have hac : a < c := lt_trans hab hbc
  have had : a < d := lt_trans hac hcd
  have hbd : b < d := lt_trans hbc hcd
  simp [finiteQuartetSpeeds, ne_of_lt hab, ne_of_lt hac, ne_of_lt had,
    ne_of_lt hbc, ne_of_lt hbd, ne_of_lt hcd]

/-- The certificate gives one common rational witness for all four speeds. -/
theorem rationalQuarterBool_sound {a b c d m n : ℕ}
    (hcert : rationalQuarterBool a b c d m n = true) :
    (1 / 4 : ℝ) ≤ ML (finiteQuartetSpeeds a b c d) := by
  have hh : 0 < n ∧ ∀ v ∈ [a,b,c,d],
      n ≤ 4 * min ((v*m)%n) (n-(v*m)%n) := by
    simpa only [rationalQuarterBool, Bool.and_eq_true, decide_eq_true_eq,
      List.all_eq_true] using hcert
  have hnR : (0 : ℝ) < n := by exact_mod_cast hh.1
  apply ML_lower_of_witness ⟨a, by simp [finiteQuartetSpeeds]⟩
    (((m : ℝ) / (n : ℝ)) : Time)
  intro v hv
  have hvL : v ∈ [a,b,c,d] := by
    simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
      List.mem_cons, List.not_mem_nil, or_false] using hv
  have hN := hh.2 v hvL
  have hR : (n : ℝ) ≤ 4 * (min ((v*m)%n) (n-(v*m)%n) : ℕ) := by
    exact_mod_cast hN
  rw [distance_at_rational]
  apply (le_div_iff₀ hnR).2
  nlinarith

/-- Containing all four positive U2 expressions is enough: no separate
representation hypothesis or coprimality assumption is added. -/
theorem positiveU2Bool_sound {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hcert : positiveU2Bool a b c d = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : ∃ A ∈ [a,b,c,d], ∃ B ∈ [a,b,c,d],
      A ≠ B ∧ A+B ∈ [a,b,c,d] ∧ A+2*B ∈ [a,b,c,d] := by
    simpa only [positiveU2Bool, List.any_eq_true, Bool.and_eq_true,
      decide_eq_true_eq, List.contains_iff_mem, and_assoc] using hcert
  obtain ⟨A, hAL, B, hBL, hAB, hCL, hDL⟩ := hh
  have hA : A ∈ finiteQuartetSpeeds a b c d := by
    simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
      List.mem_cons, List.not_mem_nil, or_false] using hAL
  have hB : B ∈ finiteQuartetSpeeds a b c d := by
    simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
      List.mem_cons, List.not_mem_nil, or_false] using hBL
  have hC : A+B ∈ finiteQuartetSpeeds a b c d := by
    simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
      List.mem_cons, List.not_mem_nil, or_false] using hCL
  have hD : A+2*B ∈ finiteQuartetSpeeds a b c d := by
    simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
      List.mem_cons, List.not_mem_nil, or_false] using hDL
  have hAp : 0 < A := hp A hA
  have hBp : 0 < B := hp B hB
  have hAC : A ≠ A+B := by omega
  have hAD : A ≠ A+2*B := by omega
  have hBC : B ≠ A+B := by omega
  have hBD : B ≠ A+2*B := by omega
  have hCD : A+B ≠ A+2*B := by omega
  have hAmem : A ∉ ({B, A+B, A+2*B} : Finset ℕ) := by
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨hAB, hAC, hAD⟩
  have hBmem : B ∉ ({A+B, A+2*B} : Finset ℕ) := by
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
    exact ⟨hBC, hBD⟩
  have hCmem : A+B ∉ ({A+2*B} : Finset ℕ) := by
    simpa only [Finset.mem_singleton] using hCD
  have hcardU : (U2Speeds A B).card = 4 := by
    norm_num only [U2Speeds, Finset.card_insert_of_notMem hAmem,
      Finset.card_insert_of_notMem hBmem, Finset.card_insert_of_notMem hCmem,
      Finset.card_singleton]
  have hsub : U2Speeds A B ⊆ finiteQuartetSpeeds a b c d := by
    intro v hv
    simp only [U2Speeds, Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact hA
    · exact hB
    · exact hC
    · exact hD
  have hEq := Finset.eq_of_subset_of_card_le hsub (by omega)
  exact source05_of_primitive_U2_representation hp hprim hEq.symm

theorem finiteKnownFamilyBool_sound {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hcert : finiteKnownFamilyBool a b c d = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : (1 ∈ [a,b,c,d] ∧ 2 ∈ [a,b,c,d]) ∨
      (2 ∈ [a,b,c,d] ∧ 4 ∈ [a,b,c,d]) ∨
      positiveU2Bool a b c d = true ∨ (a=1 ∧ b=3 ∧ c=4 ∧ d=14) := by
    simpa only [finiteKnownFamilyBool, Bool.or_eq_true, Bool.and_eq_true,
      List.contains_iff_mem, decide_eq_true_eq, or_assoc] using hcert
  rcases hh with ⟨h1L,h2L⟩ | ⟨h2L,h4L⟩ | hU | ⟨rfl,rfl,rfl,rfl⟩
  · apply source05_of_one_two hp hc hpair
    · simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
        List.mem_cons, List.not_mem_nil, or_false] using h1L
    · simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
        List.mem_cons, List.not_mem_nil, or_false] using h2L
  · apply source05_of_two_four hp hc hpair
    · simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
        List.mem_cons, List.not_mem_nil, or_false] using h2L
    · simpa only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton,
        List.mem_cons, List.not_mem_nil, or_false] using h4L
  · exact positiveU2Bool_sound hp hc hprim hU
  · exact Or.inr exceptionalFourteen_discrete

theorem finiteQuartetCertificateBool_sound {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card = 4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hcert : finiteQuartetCertificateBool a b c d = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : rationalQuarterBool a b c d 1 4 = true ∨
      finiteKnownFamilyBool a b c d = true ∨
      ∃ n ∈ [a+b,a+c,a+d,b+c,b+d,c+d],
        ∃ m ∈ List.range (n/2+1), rationalQuarterBool a b c d m n = true := by
    simpa only [finiteQuartetCertificateBool, Bool.or_eq_true,
      List.any_eq_true, or_assoc] using hcert
  rcases hh with hQ | hF | ⟨n, _, m, _, hQ⟩
  · exact Or.inl (rationalQuarterBool_sound hQ)
  · exact finiteKnownFamilyBool_sound hp hc hprim hpair hF
  · exact Or.inl (rationalQuarterBool_sound hQ)

/-- Actual admissibility hypotheses imply the Boolean eligibility test. -/
theorem finitePairGcdBool_of_admissible {a b c d : ℕ}
    (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2) :
    finitePairGcdBool a b c d = true := by
  have ha : a ∈ finiteQuartetSpeeds a b c d := by simp [finiteQuartetSpeeds]
  have hb : b ∈ finiteQuartetSpeeds a b c d := by simp [finiteQuartetSpeeds]
  have hc : c ∈ finiteQuartetSpeeds a b c d := by simp [finiteQuartetSpeeds]
  have hd : d ∈ finiteQuartetSpeeds a b c d := by simp [finiteQuartetSpeeds]
  have hg : Nat.gcd (Nat.gcd a b) (Nat.gcd c d) = 1 := by
    have hg' : Nat.gcd a (Nat.gcd b (Nat.gcd c d)) = 1 := by
      simpa [Primitive, finiteQuartetSpeeds, Finset.gcd_insert,
        Finset.gcd_singleton] using hprim
    simpa only [Nat.gcd_assoc] using hg'
  simp only [finitePairGcdBool, decide_eq_true_eq]
  exact ⟨hpair a ha b hb (by omega), hpair a ha c hc (by omega),
    hpair b hb c hc (by omega), hpair a ha d hd (by omega),
    hpair b hb d hd (by omega), hpair c hc d hd (by omega), hg⟩

/-- Coverage of the nested ranges includes their truncation and division
endpoints, rather than relying on the finite computation alone. -/
theorem finiteResidueCensusBool_certificate {bound a b c d : ℕ}
    (ha : 0 < a) (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ bound)
    (helig : finitePairGcdBool a b c d = true)
    (hcensus : finiteResidueCensusBool bound = true) :
    finiteQuartetCertificateBool a b c d = true := by
  have haBound : 4*a+6 ≤ bound := by omega
  have hbBound : a+3*b+3 ≤ bound := by omega
  have hcBound : a+b+2*c+1 ≤ bound := by omega
  have haMem : a ∈ List.range' 1 ((bound-6)/4) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hbMem : b ∈ List.range' (a+1) (((bound-a-3)/3+1)-(a+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hcMem : c ∈ List.range' (b+1) (((bound-a-b-1)/2+1)-(b+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hdMem : d ∈ List.range' (c+1) ((bound-a-b-c+1)-(c+1)) := by
    apply List.mem_range'_1.mpr
    constructor <;> omega
  have hg : Nat.gcd a b ≤ 2 ∧ Nat.gcd a c ≤ 2 ∧ Nat.gcd b c ≤ 2 ∧
      Nat.gcd a d ≤ 2 ∧ Nat.gcd b d ≤ 2 ∧ Nat.gcd c d ≤ 2 ∧
      Nat.gcd (Nat.gcd a b) (Nat.gcd c d) = 1 := by
    simpa only [finitePairGcdBool, decide_eq_true_eq] using helig
  have hskip : ¬ (Nat.gcd a b > 2 ∨ Nat.gcd a c > 2 ∨ Nat.gcd b c > 2) := by
    omega
  unfold finiteResidueCensusBool at hcensus
  have houter := List.all_eq_true.mp hcensus a haMem
  have hmiddle := List.all_eq_true.mp houter b hbMem
  have hinner := List.all_eq_true.mp hmiddle c hcMem
  rw [if_neg hskip] at hinner
  have hlast := List.all_eq_true.mp hinner d hdMem
  simpa [helig] using hlast

/-- Generic soundness for every sorted admissible quartet in a verified
census range. Its conclusion is exactly the Source05 disjunction. -/
theorem source05_of_finiteResidueCensus {bound a b c d : ℕ}
    (ha : 0 < a) (hab : a < b) (hbc : b < c) (hcd : c < d)
    (hsum : a+b+c+d ≤ bound)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u ∈ finiteQuartetSpeeds a b c d,
      ∀ v ∈ finiteQuartetSpeeds a b c d, u ≠ v → Nat.gcd u v ≤ 2)
    (hcensus : finiteResidueCensusBool bound = true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hp : Positive (finiteQuartetSpeeds a b c d) := by
    intro v hv
    simp only [finiteQuartetSpeeds, Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl <;> omega
  have hc := finite_quartet_card hab hbc hcd
  have helig := finitePairGcdBool_of_admissible hab hbc hcd hprim hpair
  have hcert := finiteResidueCensusBool_certificate ha hab hbc hcd hsum helig hcensus
  exact finiteQuartetCertificateBool_sound hp hc hprim hpair hcert




















end Math15.LonelyRunner
end 
