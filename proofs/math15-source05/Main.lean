/- Section: SharedMaskChunkComposition -/
section


/-!
Abstract composition of numerical certificate chunks. These proofs use
accepted chunk facts and do not evaluate the rational/gcd masks or row
coverage again. The generator also checks the small index-list partition
equations in the ordinary kernel, so every required entry remains covered.
-/

namespace Math15.LonelyRunner

theorem shared_all_append_verified {α : Type*} {f : α → Bool} {xs ys : List α}
    (hx : xs.all f=true) (hy : ys.all f=true) : (xs++ys).all f=true := by
  rw [List.all_append,Bool.and_eq_true]
  exact ⟨hx,hy⟩

/-- One outer-index block of the actual full triple census. -/
def sharedCensusAtA (S bound size : ℕ) (pool : ℕ → SharedQuarterMask)
    (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow) (a : ℕ) : Bool :=
  (List.range' (a+1) (((S-a-3)/3+1)-(a+1))).all fun b =>
    (List.range' (b+1) (((S-a-b-1)/2+1)-(b+1))).all fun c =>
      if Nat.testBit (compat a) b && Nat.testBit (compat a) c &&
        Nat.testBit (compat b) c then
        sharedMaskRowCheck S bound size pool compat prefixCache oddBits a b c (rows a b c)
      else true

theorem sharedMaskCensusCheck_eq_outer (S bound size : ℕ)
    (pool : ℕ → SharedQuarterMask) (compat prefixCache : ℕ → ℕ) (oddBits : ℕ)
    (rows : ℕ → ℕ → ℕ → SharedMaskRow) :
    sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows=
      (List.range' 1 ((S-6)/4)).all
        (sharedCensusAtA S bound size pool compat prefixCache oddBits rows) := rfl

theorem sharedFullCensusCheck_of_checks
    {S bound size oddBits : ℕ} {pool : ℕ → SharedQuarterMask}
    {compat prefixCache : ℕ → ℕ} {rows : ℕ → ℕ → ℕ → SharedMaskRow}
    (hpool : sharedQuarterPoolCheck bound size pool=true)
    (hcomp : sharedCompatibilityCheck bound compat=true)
    (hpref : sharedPrefixCheck bound prefixCache=true)
    (hodd : oddBits=oddSpeedMask bound)
    (hrows : sharedMaskCensusCheck S bound size pool compat prefixCache oddBits rows=true) :
    sharedFullCensusCheck S bound size pool compat prefixCache oddBits rows=true := by
  simp only [sharedFullCensusCheck,Bool.and_eq_true,decide_eq_true_eq]
  exact ⟨⟨⟨⟨hpool,hcomp⟩,hpref⟩,hodd⟩,hrows⟩





end Math15.LonelyRunner
end 

/- Section: ClosedKnownFamilyMask -/
section



/-!
Closed family masks for the same actual four-speed set.

For a sorted positive quartet a<b<c<d, containing 1,2 means a=1,b=2.
Containing 2,4 either has that first tag, or a=2 and b=4 or c=4. These tags
settle the entire fourth-speed row by the checked unrestricted OneTwo and
TwoFour branch theorems.

In a positive U2 representation {A,B,A+B,A+2B}, the last two expressions are
strictly larger than A and B. Consequently A,B are a,b in either order, c=a+b,
and d=c+a or c+b. The two orientations are both retained. Thus the remaining
family mask consists of just these two bits and the exceptional bit14 for the
row 1,3,4. No finite family table is assumed.

Every soundness conclusion concerns exactly finiteQuartetSpeeds a b c d.
-/

namespace Math15.LonelyRunner

/-- A tag that proves the target for every admissible fourth speed. -/
def closedKnownWholeRowBool (a b c : ℕ) : Bool :=
  decide ((a=1 ∧ b=2) ∨ (a=2 ∧ (b=4 ∨ c=4)))

/-- A whole tagged row, two U2 bits, or the exceptional fourteen bit.
Sparse bits outside bound are harmless: actual allowed masks supply bounds. -/
def closedKnownFourthMask (bound a b c : ℕ) : ℕ :=
  if closedKnownWholeRowBool a b c=true then 2^bound-1 else
    (if c=a+b then listBits [c+a,c+b] else 0) |||
      (if a=1 ∧ b=3 ∧ c=4 then 2^14 else 0)

theorem closedKnownFourthMask_testBit_iff (bound a b c d : ℕ) :
    Nat.testBit (closedKnownFourthMask bound a b c) d=true ↔
      (closedKnownWholeRowBool a b c=true ∧ d<bound) ∨
      (closedKnownWholeRowBool a b c≠true ∧
        ((c=a+b ∧ (d=c+a ∨ d=c+b)) ∨ (a=1 ∧ b=3 ∧ c=4 ∧ d=14))) := by
  by_cases hw : closedKnownWholeRowBool a b c=true
  · have hb : Nat.testBit (closedKnownFourthMask bound a b c) d=true ↔ d<bound := by
      rw [closedKnownFourthMask,if_pos hw,Nat.testBit_two_pow_sub_one]
      simp only [decide_eq_true_eq]
    constructor
    · intro h
      exact Or.inl ⟨hw,hb.mp h⟩
    · rintro (⟨_,hd⟩ | ⟨hn,_⟩)
      · exact hb.mpr hd
      · exact False.elim (hn hw)
  · have hU : Nat.testBit (if c=a+b then listBits [c+a,c+b] else 0) d=true ↔
        c=a+b ∧ (d=c+a ∨ d=c+b) := by
      by_cases hs : c=a+b
      · rw [if_pos hs,listBits_testBit_iff]
        have hm : d∈[c+a,c+b] ↔ d=c+a ∨ d=c+b := by
          simp only [List.mem_cons,List.not_mem_nil,or_false]
        rw [hm]
        exact ⟨fun h => ⟨hs,h⟩,fun h => h.2⟩
      · rw [if_neg hs,Nat.zero_testBit]
        exact ⟨fun h => False.elim (Bool.false_ne_true h),
          fun h => False.elim (hs h.1)⟩
    have hE : Nat.testBit (if a=1 ∧ b=3 ∧ c=4 then 2^14 else 0) d=true ↔
        a=1 ∧ b=3 ∧ c=4 ∧ d=14 := by
      by_cases he : a=1 ∧ b=3 ∧ c=4
      · rw [if_pos he,Nat.testBit_two_pow,decide_eq_true_eq]
        exact ⟨fun h => ⟨he.1,he.2.1,he.2.2,h.symm⟩,
          fun h => h.2.2.2.symm⟩
      · rw [if_neg he,Nat.zero_testBit]
        exact ⟨fun h => False.elim (Bool.false_ne_true h),
          fun h => False.elim (he ⟨h.1,h.2.1,h.2.2.1⟩)⟩
    have hb : Nat.testBit (closedKnownFourthMask bound a b c) d=true ↔
        (c=a+b ∧ (d=c+a ∨ d=c+b)) ∨ (a=1 ∧ b=3 ∧ c=4 ∧ d=14) := by
      rw [closedKnownFourthMask,if_neg hw,Nat.testBit_or,Bool.or_eq_true,hU,hE]
    constructor
    · intro h
      exact Or.inr ⟨hw,hb.mp h⟩
    · rintro (⟨hy,_⟩ | ⟨_,hs⟩)
      · exact False.elim (hw hy)
      · exact hb.mpr hs

/-- The sorted positive U2 criterion retains both choices of B. -/
theorem sorted_positiveU2Bool_iff {a b c d : ℕ} (ha : 0<a)
    (hab : a<b) (hbc : b<c) (hcd : c<d) :
    positiveU2Bool a b c d=true ↔ c=a+b ∧ (d=c+a ∨ d=c+b) := by
  constructor
  · intro hcert
    have hh : ∃ A ∈ [a,b,c,d], ∃ B ∈ [a,b,c,d],
        A≠B ∧ A+B ∈ [a,b,c,d] ∧ A+2*B ∈ [a,b,c,d] := by
      simpa only [positiveU2Bool,List.any_eq_true,Bool.and_eq_true,
        decide_eq_true_eq,List.contains_iff_mem,and_assoc] using hcert
    obtain ⟨A,hA,B,hB,hAB,hC,hD⟩ := hh
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hA hB hC hD
    rcases hA with rfl | rfl | rfl | rfl <;>
      rcases hB with rfl | rfl | rfl | rfl <;> omega
  · rintro ⟨hs,hd⟩
    have hh : ∃ A ∈ [a,b,c,d], ∃ B ∈ [a,b,c,d],
        A≠B ∧ A+B ∈ [a,b,c,d] ∧ A+2*B ∈ [a,b,c,d] := by
      rcases hd with hd | hd
      · refine ⟨b,by simp,a,by simp,ne_of_gt hab,?_,?_⟩
        · simp only [List.mem_cons,List.not_mem_nil,or_false]
          omega
        · simp only [List.mem_cons,List.not_mem_nil,or_false]
          omega
      · refine ⟨a,by simp,b,by simp,ne_of_lt hab,?_,?_⟩
        · simp only [List.mem_cons,List.not_mem_nil,or_false]
          omega
        · simp only [List.mem_cons,List.not_mem_nil,or_false]
          omega
    simpa only [positiveU2Bool,List.any_eq_true,Bool.and_eq_true,
      decide_eq_true_eq,List.contains_iff_mem,and_assoc] using hh

/-- Exact structural equivalence to the old family predicate, with no
enumeration of speeds or reliance on a checked finite family table. -/
theorem sorted_finiteKnownFamilyBool_iff {a b c d : ℕ} (ha : 0<a)
    (hab : a<b) (hbc : b<c) (hcd : c<d) :
    finiteKnownFamilyBool a b c d=true ↔
      closedKnownWholeRowBool a b c=true ∨
      (c=a+b ∧ (d=c+a ∨ d=c+b)) ∨ (a=1 ∧ b=3 ∧ c=4 ∧ d=14) := by
  have hparse : finiteKnownFamilyBool a b c d=true ↔
      (1 ∈ [a,b,c,d] ∧ 2 ∈ [a,b,c,d]) ∨
      (2 ∈ [a,b,c,d] ∧ 4 ∈ [a,b,c,d]) ∨
      positiveU2Bool a b c d=true ∨ (a=1 ∧ b=3 ∧ c=4 ∧ d=14) := by
    simp only [finiteKnownFamilyBool,Bool.or_eq_true,Bool.and_eq_true,
      List.contains_iff_mem,decide_eq_true_eq,or_assoc]
  rw [hparse,sorted_positiveU2Bool_iff ha hab hbc hcd]
  simp only [closedKnownWholeRowBool,decide_eq_true_eq,List.mem_cons,
    List.not_mem_nil,or_false]
  omega

/-- For the actual bounded sorted fourth speed the closed mask recognizes
exactly the structural family predicate. -/
theorem closedKnownFourthMask_sorted_testBit_iff {bound a b c d : ℕ}
    (ha : 0<a) (hab : a<b) (hbc : b<c) (hcd : c<d) (hd : d<bound) :
    Nat.testBit (closedKnownFourthMask bound a b c) d=true ↔
      finiteKnownFamilyBool a b c d=true := by
  rw [closedKnownFourthMask_testBit_iff,
    sorted_finiteKnownFamilyBool_iff ha hab hbc hcd]
  by_cases hw : closedKnownWholeRowBool a b c=true <;> simp [hw,hd]

end Math15.LonelyRunner

