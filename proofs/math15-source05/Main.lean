/- Section: TorusExceptionalTransfer -/
section




/-!
The six exceptional normalized planes contain a tight triple on every positive
integer line. The pair-gcd condition makes its common scale 1 or 2, so the
existing unbounded 1,2 and 2,4 branches discharge the exact target. The line
is required to lie in the actual real span of the stated generators. This is
an exceptional-family consumer, not a universal plane classification.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem source05_of_tight_triple {V : Finset ℕ} {a : ℕ}
    (hp : Positive V) (hc : V.card=4)
    (hpair : ∀ u∈V, ∀ v∈V, u≠v → Nat.gcd u v≤2)
    (ha : 0<a) (h1 : a∈V) (h2 : 2*a∈V) (h3 : 3*a∈V) :
    (1/4 : ℝ)≤ML V ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML V=(s : ℝ)/(4*(s : ℝ)+k) := by
  have hne : a≠2*a := by omega
  have hle := hpair a h1 (2*a) h2 hne
  have hdiv : a ∣ Nat.gcd a (2*a) :=
    Nat.dvd_gcd (dvd_refl a) (dvd_mul_left a 2)
  have hap : a≤2 := (Nat.le_of_dvd (Nat.gcd_pos_of_pos_left (2*a) ha) hdiv).trans hle
  have hcases : a=1 ∨ a=2 := by omega
  rcases hcases with rfl | rfl
  · exact source05_of_one_two hp hc hpair h1 (by simpa using h2)
  · exact source05_of_two_four hp hc hpair h1 (by simpa using h2)

def positiveLineSpeeds (z : Fin 4 → ℕ) : Finset ℕ := Finset.univ.image z

theorem line_speed_mem (z : Fin 4 → ℕ) (i : Fin 4) : z i∈positiveLineSpeeds z :=
  Finset.mem_image.mpr ⟨i,by simp,rfl⟩

theorem source05_of_line_tight_relations {z : Fin 4 → ℕ} {i j k : Fin 4}
    (hp : Positive (positiveLineSpeeds z)) (hc : (positiveLineSpeeds z).card=4)
    (hpair : ∀ u∈positiveLineSpeeds z, ∀ v∈positiveLineSpeeds z,
      u≠v → Nat.gcd u v≤2)
    (h2 : (z j : ℝ)=2*(z i : ℝ)) (h3 : (z k : ℝ)=3*(z i : ℝ)) :
    (1/4 : ℝ)≤ML (positiveLineSpeeds z) ∨
      ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (positiveLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  have h2n : z j=2*z i := by exact_mod_cast h2
  have h3n : z k=3*z i := by exact_mod_cast h3
  exact source05_of_tight_triple hp hc hpair (hp (z i) (line_speed_mem z i))
    (line_speed_mem z i) (by rw [←h2n]; exact line_speed_mem z j)
    (by rw [←h3n]; exact line_speed_mem z k)

/-- All six exceptions are consumed by actual equalities of the same line. -/
theorem source05_of_torus72_exceptional_line {u v : Fin 4 → ℤ} {z : Fin 4 → ℕ}
    (he : Torus72ExceptionalPair u v)
    (hspan : ∃ x y : ℝ, ∀ i, (z i : ℝ)=(u i : ℝ)*x+(v i : ℝ)*y)
    (hp : Positive (positiveLineSpeeds z)) (hc : (positiveLineSpeeds z).card=4)
    (hpair : ∀ a∈positiveLineSpeeds z, ∀ b∈positiveLineSpeeds z,
      a≠b → Nat.gcd a b≤2) :
    (1/4 : ℝ)≤ML (positiveLineSpeeds z) ∨
      ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (positiveLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨x,y,hz⟩ := hspan
  have h0 := hz 0
  have h1 := hz 1
  have h2 := hz 2
  have h3 := hz 3
  rcases he with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ |
    ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=1) (j:=2) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=0) (j:=2) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=2) (j:=1) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=2) (j:=0) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=2) (j:=3) (k:=1)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_line_tight_relations (i:=2) (j:=3) (k:=0)
      hp hc hpair (by linarith) (by linarith)






/-- The signed line version is needed after coordinate normalization.
Its three actual integer coordinates have the same ratios, so their
absolute values have the same positive tight-triple scale. -/
theorem source05_of_signed_line_tight_relations {z : Fin 4 → ℤ} {i j k : Fin 4}
    (hp : Positive (torusLineSpeeds z)) (hc : (torusLineSpeeds z).card=4)
    (hpair : ∀ u∈torusLineSpeeds z, ∀ v∈torusLineSpeeds z,
      u≠v → Nat.gcd u v≤2)
    (h2 : (z j : ℝ)=2*(z i : ℝ)) (h3 : (z k : ℝ)=3*(z i : ℝ)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨
      ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  have hmem : ∀ q, (z q).natAbs∈torusLineSpeeds z := fun q =>
    Finset.mem_image.mpr ⟨q,by simp,rfl⟩
  have h2z : z j=2*z i := by exact_mod_cast h2
  have h3z : z k=3*z i := by exact_mod_cast h3
  have h2a : (z j).natAbs=2*(z i).natAbs := by
    rw [h2z,Int.natAbs_mul]
    norm_num
  have h3a : (z k).natAbs=3*(z i).natAbs := by
    rw [h3z,Int.natAbs_mul]
    norm_num
  exact source05_of_tight_triple hp hc hpair (hp _ (hmem i)) (hmem i)
    (by rw [←h2a]; exact hmem j) (by rw [←h3a]; exact hmem k)

theorem source05_of_torus72_exceptional_signed_line {u v z : Fin 4 → ℤ}
    (he : Torus72ExceptionalPair u v)
    (hspan : ∃ x y : ℝ, ∀ i, (z i : ℝ)=(u i : ℝ)*x+(v i : ℝ)*y)
    (hp : Positive (torusLineSpeeds z)) (hc : (torusLineSpeeds z).card=4)
    (hpair : ∀ a∈torusLineSpeeds z, ∀ b∈torusLineSpeeds z,
      a≠b → Nat.gcd a b≤2) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨
      ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨x,y,hz⟩ := hspan
  have h0 := hz 0
  have h1 := hz 1
  have h2 := hz 2
  have h3 := hz 3
  rcases he with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ |
    ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=1) (j:=2) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=0) (j:=2) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=2) (j:=1) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=2) (j:=0) (k:=3)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=2) (j:=3) (k:=1)
      hp hc hpair (by linarith) (by linarith)
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    exact source05_of_signed_line_tight_relations (i:=2) (j:=3) (k:=0)
      hp hc hpair (by linarith) (by linarith)




end Math15.LonelyRunner
end 
end 

/- Section: TorusNoZeroAssembly -/
section



/-!
The unbounded everywhere-nonzero collision branch. Normalization is proved
from the actual four-coordinate generators, with arbitrary integer scales. The
72-case classification either supplies a common two-sevenths point or an
actual axis. Its exceptions resolve the source05 conclusion for the same
original signed integer line because normalization transports that line and
preserves its absolute speeds.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torus_no_zero_collision_good_of_no_axis {u v : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hvn : ∀ i,v i≠0)
    (hu01 : u 0=u 1) (hv0 : v 0=u 0) (hv1 : v 1= -u 0)
    (hnoaxis : TorusNoAxis u v) : TorusGood u v (2/7) := by
  by_contra hbad
  obtain ⟨a,b,c,d,e,f,hbc,hU,hV,hgood,hLines,hAxis⟩ :=
    torus_bad_no_zero_collision_normalizes72_with_lines_and_axis hun hvn hu01 hv0 hv1 hbad
  rcases torus72_normalized_classification hbc hU hV with hpoint | hexception
  · exact hbad ((hgood (2/7)).mpr hpoint)
  · exact hnoaxis (hAxis.mpr (torus72_exceptional_has_axis hexception))

theorem torus_no_zero_collision_source05_signed_line {u v z : Fin 4 → ℤ}
    (hun : ∀ i,u i≠0) (hvn : ∀ i,v i≠0)
    (hu01 : u 0=u 1) (hv0 : v 0=u 0) (hv1 : v 1= -u 0)
    (hspan : TorusIntegerLineInSpan u v z)
    (hp : Positive (torusLineSpeeds z)) (hc : (torusLineSpeeds z).card=4)
    (hpair : ∀ a∈torusLineSpeeds z, ∀ b∈torusLineSpeeds z,
      a≠b → Nat.gcd a b≤2) :
    TorusGood u v (2/7) ∨ ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨
      ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
        ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  by_cases hpoint : TorusGood u v (2/7)
  · exact Or.inl hpoint
  · obtain ⟨a,b,c,d,e,f,hbc,hU,hV,hgood,hLines,hAxis⟩ :=
      torus_bad_no_zero_collision_normalizes72_with_lines_and_axis
        hun hvn hu01 hv0 hv1 hpoint
    rcases torus72_normalized_classification hbc hU hV with hnormalized | hexception
    · exact False.elim (hpoint ((hgood (2/7)).mpr hnormalized))
    · obtain ⟨w,hw,hspanw⟩ := hLines z hspan
      have hpw : Positive (torusLineSpeeds w) := by simpa only [hw] using hp
      have hcw : (torusLineSpeeds w).card=4 := by simpa only [hw] using hc
      have hpairw : ∀ a∈torusLineSpeeds w, ∀ b∈torusLineSpeeds w,
          a≠b → Nat.gcd a b≤2 := by simpa only [hw] using hpair
      have hsource := source05_of_torus72_exceptional_signed_line
        hexception hspanw hpw hcw hpairw
      exact Or.inr (by simpa only [hw] using hsource)




end Math15.LonelyRunner
end 
end 

/- Section: TorusOneZeroReduction -/
section


/-!
An actual one-zero low plane forces one of two exact ratio equations. The
generator change has determinant 2ce, and its last two coordinates are (ce,ce)
and (ce,-ce). If every coordinate of both changed generators were nonzero, the
unbounded no-axis/nozero theorem would produce a common two-sevenths point.
Hence one of their first coordinates vanishes, which is exactly cd=a|e+f| or
cd=a|e-f|. The signed f is arbitrary.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem positive_mul_eq_natAbs_of_signed_eq {a C b : ℤ}
    (ha : 0≤a) (hC : 0≤C) (he : C=a*b ∨ C= -(a*b)) :
    C=a*(b.natAbs : ℤ) := by
  have habs : C.natAbs=a.natAbs*b.natAbs := by
    rcases he with he | he
    · rw [he,Int.natAbs_mul]
    · rw [he,Int.natAbs_neg,Int.natAbs_mul]
  have hcast : (C.natAbs : ℤ)=(a.natAbs : ℤ)*(b.natAbs : ℤ) := by exact_mod_cast habs
  rwa [Int.natAbs_of_nonneg hC,Int.natAbs_of_nonneg ha] at hcast

theorem torus_one_zero_low_forces_ratio {a c d e f : ℤ}
    (ha : 0<a) (hc : 0<c) (hd : 0<d) (he : 0<e)
    (hbad : ¬TorusGood (![a,a,0,c]) (![d,-d,e,f]) (2/7)) :
    c*d=a*((e+f).natAbs : ℤ) ∨ c*d=a*((e-f).natAbs : ℤ) := by
  let u : Fin 4 → ℤ := ![a,a,0,c]
  let v : Fin 4 → ℤ := ![d,-d,e,f]
  let g1 := torusIntegerCombination (e-f) c u v
  let g2 := torusIntegerCombination (-(e+f)) c u v
  have hg1 : g1=(![c*d+a*(e-f),-c*d+a*(e-f),c*e,c*e]) := by
    funext i
    fin_cases i <;> simp [g1,u,v,torusIntegerCombination] <;> ring
  have hg2 : g2=(![c*d-a*(e+f),-c*d-a*(e+f),c*e,-(c*e)]) := by
    funext i
    fin_cases i <;> simp [g2,u,v,torusIntegerCombination] <;> ring
  have hdet : (e-f)*c-c*(-(e+f))≠0 := by
    have heq : (e-f)*c-c*(-(e+f))=2*c*e := by ring
    rw [heq]
    exact mul_ne_zero (mul_ne_zero (by norm_num) (ne_of_gt hc)) (ne_of_gt he)
  have hchange (L : ℝ) : TorusGood g1 g2 L ↔ TorusGood u v L :=
    torus_good_integer_change_iff (e-f) c (-(e+f)) c hdet
  have hAxisChange : TorusHasAxis g1 g2 ↔ TorusHasAxis u v :=
    torus_has_axis_integer_change_iff (e-f) c (-(e+f)) c hdet
  have hnoaxis : TorusNoAxis u v :=
    torus_one_zero_no_axis (ne_of_gt ha) (ne_of_gt hc) (ne_of_gt hd) (ne_of_gt he)
  let σ : Equiv.Perm (Fin 4) :=
    { toFun := ![2,3,0,1]
      invFun := ![2,3,0,1]
      left_inv := by intro i; fin_cases i <;> rfl
      right_inv := by intro i; fin_cases i <;> rfl }
  have hσ0 : σ 0=2 := rfl
  have hσ1 : σ 1=3 := rfl
  let U := torusCoordinatePermute σ g1
  let V := torusCoordinatePermute σ g2
  have hU01 : U 0=U 1 := by
    change g1 (σ 0)=g1 (σ 1)
    rw [hσ0,hσ1,hg1] <;> rfl
  have hV0 : V 0=U 0 := by
    change g2 (σ 0)=g1 (σ 0)
    rw [hσ0,hg1,hg2] <;> rfl
  have hV1 : V 1= -U 0 := by
    change g2 (σ 1)= -g1 (σ 0)
    rw [hσ1,hσ0,hg1,hg2] <;> rfl
  have hnoaxisUV : TorusNoAxis U V := by
    intro haxis
    exact hnoaxis (hAxisChange.mp ((torus_has_axis_coordinate_permutation_iff σ).mp haxis))
  have hbadUV : ¬TorusGood U V (2/7) := by
    intro hpoint
    exact hbad ((hchange (2/7)).mp ((torus_good_coordinate_permutation_iff σ).mp hpoint))
  have hce : c*e≠0 := mul_ne_zero (ne_of_gt hc) (ne_of_gt he)
  have hzero : g1 0=0 ∨ g1 1=0 ∨ g2 0=0 ∨ g2 1=0 := by
    by_contra hnone
    push_neg at hnone
    have hg1n : ∀ i,g1 i≠0 := by
      intro i
      fin_cases i
      · simpa using hnone.1
      · simpa using hnone.2.1
      · simpa [hg1] using hce
      · simpa [hg1] using hce
    have hg2n : ∀ i,g2 i≠0 := by
      intro i
      fin_cases i
      · simpa using hnone.2.2.1
      · simpa using hnone.2.2.2
      · simpa [hg2] using hce
      · simpa [hg2] using hce
    exact hbadUV (torus_no_zero_collision_good_of_no_axis
      (fun i => hg1n (σ i)) (fun i => hg2n (σ i)) hU01 hV0 hV1 hnoaxisUV)
  have hcd : 0≤c*d := (mul_pos hc hd).le
  rcases hzero with h0 | h1 | h0 | h1
  · have hz : c*d+a*(e-f)=0 := by simpa [hg1] using h0
    exact Or.inr (positive_mul_eq_natAbs_of_signed_eq ha.le hcd
      (Or.inr (by linear_combination hz)))
  · have hz : -c*d+a*(e-f)=0 := by simpa [hg1] using h1
    exact Or.inr (positive_mul_eq_natAbs_of_signed_eq ha.le hcd
      (Or.inl (by linear_combination -hz)))
  · have hz : c*d-a*(e+f)=0 := by simpa [hg2] using h0
    exact Or.inl (positive_mul_eq_natAbs_of_signed_eq ha.le hcd
      (Or.inl (by linear_combination hz)))
  · have hz : -c*d-a*(e+f)=0 := by simpa [hg2] using h1
    exact Or.inl (positive_mul_eq_natAbs_of_signed_eq ha.le hcd
      (Or.inr (by linear_combination -hz)))




end Math15.LonelyRunner
end 
end 

/- Section: SignedU2 -/
section


/-!
# Every proper signed U2 chamber reduces to the positive family

For B>0 and A,A+B,A+2B nonzero, divide into the four sign chambers of
A,A+B,A+2B. Taking a=-A in the negative chambers, the positive parameters are
respectively (A,B), (a,B-a), (2B-a,a-B), and (a-2B,B). Their four positive
speeds are exactly the absolute values of A,B,A+B,A+2B, as an actual finite
set.

When B<0 flip both parameters. Positivity of the actual speed set excludes all
four zero coordinates. Primitivity then supplies the coprimality hypothesis
after normalization through U2Assembly.

The final theorem has only the original Positive/Primitive conditions and an
explicit signed U2 representation of the same V.
-/

noncomputable section
namespace Math15.LonelyRunner

def SignedU2Speeds (A B : ℤ) : Finset ℕ :=
  {A.natAbs, B.natAbs, (A + B).natAbs, (A + 2 * B).natAbs}

theorem SignedU2Speeds_global_neg (A B : ℤ) :
    SignedU2Speeds (-A) (-B) = SignedU2Speeds A B := by
  have hC : -A + -B = -(A + B) := by ring
  have hD : -A + 2 * -B = -(A + 2 * B) := by ring
  simp only [SignedU2Speeds, hC, hD, Int.natAbs_neg]

/-- Exact finite-set normalization in all four B-positive sign chambers. -/
theorem signed_U2_normalize_of_B_pos {A B : ℤ} (hB : 0 < B)
    (hA : A ≠ 0) (hC : A + B ≠ 0) (hD : A + 2 * B ≠ 0) :
    ∃ P Q : ℕ, 0 < P ∧ 0 < Q ∧ SignedU2Speeds A B = U2Speeds P Q := by
  have hBcast : (B.natAbs : ℤ) = B := Int.natAbs_of_nonneg hB.le
  by_cases haPos : 0 < A
  · let P : ℕ := A.natAbs
    let Q : ℕ := B.natAbs
    have hAcast : (A.natAbs : ℤ) = A := Int.natAbs_of_nonneg haPos.le
    have hCcast : ((A + B).natAbs : ℤ) = A + B :=
      Int.natAbs_of_nonneg (by omega)
    have hDcast : ((A + 2 * B).natAbs : ℤ) = A + 2 * B :=
      Int.natAbs_of_nonneg (by omega)
    have hCNat : (A + B).natAbs = P + Q := by dsimp [P, Q]; omega
    have hDNat : (A + 2 * B).natAbs = P + 2 * Q := by dsimp [P, Q]; omega
    refine ⟨P, Q, Int.natAbs_pos.mpr hA, Int.natAbs_pos.mpr (ne_of_gt hB), ?_⟩
    simp only [SignedU2Speeds, U2Speeds, hCNat, hDNat]
    rfl
  have haNeg : A < 0 := by omega
  have hAcast : (A.natAbs : ℤ) = -A := Int.ofNat_natAbs_of_nonpos haNeg.le
  by_cases hcPos : 0 < A + B
  · let P : ℕ := A.natAbs
    let Q : ℕ := (A + B).natAbs
    have hCcast : ((A + B).natAbs : ℤ) = A + B :=
      Int.natAbs_of_nonneg hcPos.le
    have hDcast : ((A + 2 * B).natAbs : ℤ) = A + 2 * B :=
      Int.natAbs_of_nonneg (by omega)
    have hBNat : B.natAbs = P + Q := by dsimp [P, Q]; omega
    have hDNat : (A + 2 * B).natAbs = P + 2 * Q := by dsimp [P, Q]; omega
    refine ⟨P, Q, Int.natAbs_pos.mpr hA, Int.natAbs_pos.mpr hC, ?_⟩
    ext v
    simp only [SignedU2Speeds, U2Speeds, Finset.mem_insert, Finset.mem_singleton,
      hBNat, hDNat]
    dsimp [P, Q]
    tauto
  have hcNeg : A + B < 0 := by omega
  have hCcast : ((A + B).natAbs : ℤ) = -(A + B) :=
    Int.ofNat_natAbs_of_nonpos hcNeg.le
  by_cases hdPos : 0 < A + 2 * B
  · let P : ℕ := (A + 2 * B).natAbs
    let Q : ℕ := (A + B).natAbs
    have hDcast : ((A + 2 * B).natAbs : ℤ) = A + 2 * B :=
      Int.natAbs_of_nonneg hdPos.le
    have hANat : A.natAbs = P + 2 * Q := by dsimp [P, Q]; omega
    have hBNat : B.natAbs = P + Q := by dsimp [P, Q]; omega
    refine ⟨P, Q, Int.natAbs_pos.mpr hD, Int.natAbs_pos.mpr hC, ?_⟩
    ext v
    simp only [SignedU2Speeds, U2Speeds, Finset.mem_insert, Finset.mem_singleton,
      hANat, hBNat]
    dsimp [P, Q]
    tauto
  have hdNeg : A + 2 * B < 0 := by omega
  have hDcast : ((A + 2 * B).natAbs : ℤ) = -(A + 2 * B) :=
    Int.ofNat_natAbs_of_nonpos hdNeg.le
  let P : ℕ := (A + 2 * B).natAbs
  let Q : ℕ := B.natAbs
  have hANat : A.natAbs = P + 2 * Q := by dsimp [P, Q]; omega
  have hCNat : (A + B).natAbs = P + Q := by dsimp [P, Q]; omega
  refine ⟨P, Q, Int.natAbs_pos.mpr hD, Int.natAbs_pos.mpr (ne_of_gt hB), ?_⟩
  ext v
  simp only [SignedU2Speeds, U2Speeds, Finset.mem_insert, Finset.mem_singleton,
    hANat, hCNat]
  dsimp [P, Q]
  tauto

theorem signed_U2_normalize {A B : ℤ}
    (hA : A ≠ 0) (hB : B ≠ 0) (hC : A + B ≠ 0) (hD : A + 2 * B ≠ 0) :
    ∃ P Q : ℕ, 0 < P ∧ 0 < Q ∧ SignedU2Speeds A B = U2Speeds P Q := by
  by_cases hbPos : 0 < B
  · exact signed_U2_normalize_of_B_pos hbPos hA hC hD
  have hbNeg : B < 0 := by omega
  have hCeq : -A + -B = -(A + B) := by ring
  have hDeq : -A + 2 * -B = -(A + 2 * B) := by ring
  have hCneg : -A + -B ≠ 0 := by rw [hCeq]; exact neg_ne_zero.mpr hC
  have hDneg : -A + 2 * -B ≠ 0 := by rw [hDeq]; exact neg_ne_zero.mpr hD
  obtain ⟨P, Q, hP, hQ, he⟩ := signed_U2_normalize_of_B_pos
    (by omega : 0 < -B) (neg_ne_zero.mpr hA) hCneg hDneg
  exact ⟨P, Q, hP, hQ, (SignedU2Speeds_global_neg A B).symm.trans he⟩

theorem signed_U2_nonzero_of_positive {A B : ℤ}
    (hp : Positive (SignedU2Speeds A B)) :
    A ≠ 0 ∧ B ≠ 0 ∧ A + B ≠ 0 ∧ A + 2 * B ≠ 0 := by
  exact ⟨Int.natAbs_pos.mp (hp A.natAbs (by simp [SignedU2Speeds])),
    Int.natAbs_pos.mp (hp B.natAbs (by simp [SignedU2Speeds])),
    Int.natAbs_pos.mp (hp (A + B).natAbs (by simp [SignedU2Speeds])),
    Int.natAbs_pos.mp (hp (A + 2 * B).natAbs (by simp [SignedU2Speeds]))⟩

/-- Exact original conclusion for every positive primitive signed U2
representation, including every permitted sign chamber. -/
theorem source05_of_signed_U2_representation {V : Finset ℕ} {A B : ℤ}
    (hp : Positive V) (hprim : Primitive V) (hV : V = SignedU2Speeds A B) :
    (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML V = (s : ℝ) / (4 * (s : ℝ) + k) := by
  have hpSigned : Positive (SignedU2Speeds A B) := by rwa [hV] at hp
  obtain ⟨hA, hB, hC, hD⟩ := signed_U2_nonzero_of_positive hpSigned
  obtain ⟨P, Q, hP, hQ, he⟩ := signed_U2_normalize hA hB hC hD
  exact source05_of_primitive_U2_representation hp hprim (hV.trans he)







end Math15.LonelyRunner
end 
end 

/- Section: TorusCrossTwoZero -/
section



/-!
The second actual change of generators in the cross two-zero case. For
positive a,c, a plane generated by (a,a,0,c),(a,-a,c,0) below two-sevenths
forces c=a or c=2a. In those two cases every integer line in the same real
span has a literal SignedU2Speeds representation.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torus_cross_two_zero_low_first_relation {a c d e : ℤ}
    (ha : 0<a) (hc : 0<c) (hd : 0<d) (he : 0<e)
    (hbad : ¬TorusGood (![a,a,0,c]) (![d,-d,e,0]) (2/7)) : c*d=a*e := by
  have hratio := torus_one_zero_low_forces_ratio ha hc hd he hbad
  simpa only [add_zero,sub_zero,Int.natAbs_of_nonneg he.le,or_self] using hratio

theorem torus_cross_two_zero_low_second_relation {a c : ℤ}
    (ha : 0<a) (hc : 0<c)
    (hbad : ¬TorusGood (![a,a,0,c]) (![a,-a,c,0]) (2/7)) : c=a ∨ c=2*a := by
  by_contra hnone
  push_neg at hnone
  let u : Fin 4 → ℤ := ![a,a,0,c]
  let v : Fin 4 → ℤ := ![a,-a,c,0]
  let g1 := torusIntegerCombination (c-a) a u v
  let g2 := torusIntegerCombination (c+a) (-a) u v
  have hg1 : g1=(![a*c,a*(c-2*a),a*c,c*(c-a)]) := by
    funext i
    fin_cases i <;> simp [g1,u,v,torusIntegerCombination] <;> ring
  have hg2 : g2=(![a*c,a*(c+2*a),-(a*c),c*(c+a)]) := by
    funext i
    fin_cases i <;> simp [g2,u,v,torusIntegerCombination] <;> ring
  have hdet : (c-a)*(-a)-a*(c+a)≠0 := by
    have heq : (c-a)*(-a)-a*(c+a)=(-2)*a*c := by ring
    rw [heq]
    exact mul_ne_zero (mul_ne_zero (by norm_num) (ne_of_gt ha)) (ne_of_gt hc)
  have hchange (L : ℝ) : TorusGood g1 g2 L ↔ TorusGood u v L :=
    torus_good_integer_change_iff (c-a) a (c+a) (-a) hdet
  have hAxisChange : TorusHasAxis g1 g2 ↔ TorusHasAxis u v :=
    torus_has_axis_integer_change_iff (c-a) a (c+a) (-a) hdet
  have hnoaxis : TorusNoAxis u v := torus_cross_two_zero_no_axis
    (ne_of_gt ha) (ne_of_gt hc) (ne_of_gt ha) (ne_of_gt hc)
  let σ : Equiv.Perm (Fin 4) := Equiv.swap 1 2
  have hσ0 : σ 0=0 := by decide
  have hσ1 : σ 1=2 := by decide
  let U := torusCoordinatePermute σ g1
  let V := torusCoordinatePermute σ g2
  have hU01 : U 0=U 1 := by
    change g1 (σ 0)=g1 (σ 1)
    rw [hσ0,hσ1,hg1] <;> rfl
  have hV0 : V 0=U 0 := by
    change g2 (σ 0)=g1 (σ 0)
    rw [hσ0,hg1,hg2] <;> rfl
  have hV1 : V 1= -U 0 := by
    change g2 (σ 1)= -g1 (σ 0)
    rw [hσ1,hσ0,hg1,hg2] <;> rfl
  have hnoaxisUV : TorusNoAxis U V := by
    intro haxis
    exact hnoaxis (hAxisChange.mp ((torus_has_axis_coordinate_permutation_iff σ).mp haxis))
  have hac : a*c≠0 := mul_ne_zero (ne_of_gt ha) (ne_of_gt hc)
  have hca : c-a≠0 := sub_ne_zero.mpr hnone.1
  have hctwo : c-2*a≠0 := sub_ne_zero.mpr hnone.2
  have hcap : 0<c+a := add_pos hc ha
  have hctwop : 0<c+2*a := by omega
  have hg1n : ∀ i,g1 i≠0 := by
    intro i
    fin_cases i
    · simpa [hg1,Matrix.cons_val_two,Matrix.cons_val_three] using hac
    · simpa [hg1,Matrix.cons_val_two,Matrix.cons_val_three] using mul_ne_zero (ne_of_gt ha) hctwo
    · simpa [hg1,Matrix.cons_val_two,Matrix.cons_val_three] using hac
    · simpa [hg1,Matrix.cons_val_two,Matrix.cons_val_three] using mul_ne_zero (ne_of_gt hc) hca
  have hg2n : ∀ i,g2 i≠0 := by
    intro i
    fin_cases i
    · simpa [hg2,Matrix.cons_val_two,Matrix.cons_val_three] using hac
    · simpa [hg2,Matrix.cons_val_two,Matrix.cons_val_three] using
        mul_ne_zero (ne_of_gt ha) (ne_of_gt hctwop)
    · simpa [hg2,Matrix.cons_val_two,Matrix.cons_val_three] using hac
    · simpa [hg2,Matrix.cons_val_two,Matrix.cons_val_three] using
        mul_ne_zero (ne_of_gt hc) (ne_of_gt hcap)
  have hgood := torus_no_zero_collision_good_of_no_axis
    (fun i => hg1n (σ i)) (fun i => hg2n (σ i)) hU01 hV0 hV1 hnoaxisUV
  exact hbad ((hchange (2/7)).mp ((torus_good_coordinate_permutation_iff σ).mp hgood))

theorem torus_line_speeds_four_coordinates (z : Fin 4 → ℤ) :
    torusLineSpeeds z=({(z 0).natAbs,(z 1).natAbs,(z 2).natAbs,(z 3).natAbs} : Finset ℕ) := by
  classical
  ext n
  constructor
  · intro hn
    obtain ⟨i,hi,hz⟩ := Finset.mem_image.mp hn
    simp only [Finset.mem_insert,Finset.mem_singleton]
    fin_cases i
    · exact Or.inl hz.symm
    · exact Or.inr (Or.inl hz.symm)
    · exact Or.inr (Or.inr (Or.inl hz.symm))
    · exact Or.inr (Or.inr (Or.inr hz.symm))
  · intro hn
    simp only [Finset.mem_insert,Finset.mem_singleton] at hn
    rcases hn with hz | hz | hz | hz
    · exact Finset.mem_image.mpr ⟨0,by simp,hz.symm⟩
    · exact Finset.mem_image.mpr ⟨1,by simp,hz.symm⟩
    · exact Finset.mem_image.mpr ⟨2,by simp,hz.symm⟩
    · exact Finset.mem_image.mpr ⟨3,by simp,hz.symm⟩

theorem torus_cross_two_zero_signed_line_U2 {a c : ℤ} {z : Fin 4 → ℤ}
    (hcase : c=a ∨ c=2*a)
    (hspan : TorusIntegerLineInSpan (![a,a,0,c]) (![a,-a,c,0]) z) :
    ∃ P Q : ℤ, torusLineSpeeds z=SignedU2Speeds P Q := by
  obtain ⟨x,y,hz⟩ := hspan
  have h0 := hz 0
  have h1 := hz 1
  have h2 := hz 2
  have h3 := hz 3
  rcases hcase with rfl | rfl
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    have h0z : z 0=z 1+2*z 2 := by
      exact_mod_cast (show (z 0 : ℝ)=(z 1 : ℝ)+2*(z 2 : ℝ) by linarith)
    have h3z : z 3=z 1+z 2 := by
      exact_mod_cast (show (z 3 : ℝ)=(z 1 : ℝ)+(z 2 : ℝ) by linarith)
    refine ⟨z 1,z 2,?_⟩
    rw [torus_line_speeds_four_coordinates,h0z,h3z]
    ext n
    simp only [SignedU2Speeds,Finset.mem_insert,Finset.mem_singleton]
    tauto
  · norm_num [Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail] at h0 h1 h2 h3
    have h0z : z 0=z 2+z 1 := by
      exact_mod_cast (show (z 0 : ℝ)=(z 2 : ℝ)+(z 1 : ℝ) by linarith)
    have h3z : z 3=z 2+2*z 1 := by
      exact_mod_cast (show (z 3 : ℝ)=(z 2 : ℝ)+2*(z 1 : ℝ) by linarith)
    refine ⟨z 2,z 1,?_⟩
    rw [torus_line_speeds_four_coordinates,h0z,h3z]
    ext n
    simp only [SignedU2Speeds,Finset.mem_insert,Finset.mem_singleton]
    tauto

theorem torus_cross_two_zero_low_source05_signed_line {a c : ℤ} {z : Fin 4 → ℤ}
    (ha : 0<a) (hc : 0<c)
    (hbad : ¬TorusGood (![a,a,0,c]) (![a,-a,c,0]) (2/7))
    (hspan : TorusIntegerLineInSpan (![a,a,0,c]) (![a,-a,c,0]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z)) :
    (1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k) := by
  obtain ⟨P,Q,hU2⟩ := torus_cross_two_zero_signed_line_U2
    (torus_cross_two_zero_low_second_relation ha hc hbad) hspan
  exact source05_of_signed_U2_representation hp hprim hU2







