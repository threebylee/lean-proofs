/- Section: TorusTargetAssembly -/
section


/-!
Target-specific unbounded rank-two-plane assembly. Any actual matched
collision pair is consumed by the proved zero and nonzero branches. An
independent pair has a nonzero coordinate minor; two actual swaps move that
coordinate pair to the first two positions, and the invertible collision
change produces the matched pair. Generator changes leave the integer line
itself unchanged; the shared permutation preserves its exact absolute-speed
set. No duplicate-coordinate or proper-torus classification assumption is
needed for this target-specific conclusion.

The conclusion is a common plane point OR the source05 conclusion for the same
line. A common plane point is not itself a lower witness for that line.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem torus_matched_collision_source05_signed_line {a b c e f : ℤ}
    {z : Fin 4 → ℤ} (ha : a≠0)
    (hspan : TorusIntegerLineInSpan (![a,a,b,c]) (![a,-a,e,f]) z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z))
    (hcard : (torusLineSpeeds z).card=4)
    (hpair : ∀ r∈torusLineSpeeds z, ∀ s∈torusLineSpeeds z,
      r≠s → Nat.gcd r s≤2) :
    TorusGood (![a,a,b,c]) (![a,-a,e,f]) (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  by_cases hzero : b=0 ∨ c=0 ∨ e=0 ∨ f=0
  · exact torus_zero_collision_source05_signed_line ha ha hzero hspan hp hprim
  · push_neg at hzero
    have hun : ∀ i,(![a,a,b,c] : Fin 4 → ℤ) i≠0 := by
      intro i
      fin_cases i <;> simp [ha,hzero.1,hzero.2.1,Matrix.cons_val_two,Matrix.cons_val_three]
    have hvn : ∀ i,(![a,-a,e,f] : Fin 4 → ℤ) i≠0 := by
      intro i
      fin_cases i <;> simp [ha,hzero.2.2.1,hzero.2.2.2,
        Matrix.cons_val_two,Matrix.cons_val_three]
    exact torus_no_zero_collision_source05_signed_line hun hvn rfl rfl rfl
      hspan hp hcard hpair

/-- Two actual swaps extend any distinct coordinate pair to a permutation. -/
theorem fin4_exists_pair_permutation {i j : Fin 4} (hne : i≠j) :
    ∃ σ : Equiv.Perm (Fin 4), σ 0=i ∧ σ 1=j := by
  let τ : Equiv.Perm (Fin 4) := Equiv.swap 0 i
  have hτ0 : τ 0=i := Equiv.swap_apply_left 0 i
  let k : Fin 4 := τ 1
  have hki : k≠i := by
    intro he
    have h10 : (1 : Fin 4)=0 := τ.injective (he.trans hτ0.symm)
    norm_num at h10
  let σ : Equiv.Perm (Fin 4) := τ.trans (Equiv.swap k j)
  refine ⟨σ,?_,?_⟩
  · change Equiv.swap k j (τ 0)=i
    rw [hτ0,Equiv.swap_apply_of_ne_of_ne hki.symm hne]
  · change Equiv.swap k j k=j
    exact Equiv.swap_apply_left k j

/-- Every independent actual integer plane has the target-specific gap
alternative, for the same original primitive four-speed line. -/
theorem torus_independent_plane_source05_signed_line {u v z : Fin 4 → ℤ}
    (hind : TorusRealIndependent u v) (hspan : TorusIntegerLineInSpan u v z)
    (hp : Positive (torusLineSpeeds z)) (hprim : Primitive (torusLineSpeeds z))
    (hcard : (torusLineSpeeds z).card=4)
    (hpair : ∀ r∈torusLineSpeeds z, ∀ s∈torusLineSpeeds z,
      r≠s → Nat.gcd r s≤2) :
    TorusGood u v (2/7) ∨
    ((1/4 : ℝ)≤ML (torusLineSpeeds z) ∨ ∃ s k : ℕ, 1≤k ∧ k≤4 ∧ k≤s ∧
      ML (torusLineSpeeds z)=(s : ℝ)/(4*(s : ℝ)+k)) := by
  obtain ⟨i,j,hminor⟩ := torus_independent_has_nonzero_minor hind
  obtain ⟨σ,hσ0,hσ1⟩ := fin4_exists_pair_permutation (torus_nonzero_minor_distinct hminor)
  let U := torusCoordinatePermute σ u
  let V := torusCoordinatePermute σ v
  have hminorPerm : torusCoordinateMinor U V 0 1=torusCoordinateMinor u v i j := by
    dsimp [torusCoordinateMinor,U,V,torusCoordinatePermute]
    rw [hσ0,hσ1]
  have hminorUV : torusCoordinateMinor U V 0 1≠0 := by rwa [hminorPerm]
  let a : ℤ := torusCoordinateMinor U V 0 1
  let G := torusCollisionPlus U V 0 1
  let H := torusCollisionMinus U V 0 1
  obtain ⟨hG0,hG1,hH0,hH1⟩ := torus_collision_coordinate_identities U V 0 1
  have hG : G=(![a,a,G 2,G 3]) := by
    funext k
    fin_cases k
    · exact hG0
    · exact hG1
    · rfl
    · rfl
  have hH : H=(![a,-a,H 2,H 3]) := by
    funext k
    fin_cases k
    · exact hH0
    · exact hH1
    · rfl
    · rfl
  have hdet : (V 1-V 0)*(-(U 0+U 1))-(U 0-U 1)*(V 1+V 0)≠0 := by
    rw [torus_collision_coefficient_determinant]
    exact mul_ne_zero (by norm_num) hminorUV
  obtain ⟨w,hw,hspanw⟩ := (torus_absolute_line_transfer_permute u v σ) z hspan
  have hspanGH : TorusIntegerLineInSpan G H w :=
    (torus_integer_line_span_integer_change_iff (V 1-V 0) (U 0-U 1)
      (V 1+V 0) (-(U 0+U 1)) hdet).mpr hspanw
  rw [hG,hH] at hspanGH
  have hpw : Positive (torusLineSpeeds w) := by simpa only [hw] using hp
  have hprimw : Primitive (torusLineSpeeds w) := by simpa only [hw] using hprim
  have hcardw : (torusLineSpeeds w).card=4 := by simpa only [hw] using hcard
  have hpairw : ∀ r∈torusLineSpeeds w, ∀ s∈torusLineSpeeds w,
      r≠s → Nat.gcd r s≤2 := by simpa only [hw] using hpair
  rcases torus_matched_collision_source05_signed_line hminorUV hspanGH hpw hprimw
    hcardw hpairw with hpoint | hsource
  · left
    rw [←hG,←hH] at hpoint
    have hpointUV := (torus_good_collision_normal_form_iff 0 1 hminorUV).mp hpoint
    exact (torus_good_coordinate_permutation_iff σ).mp hpointUV
  · exact Or.inr (by simpa only [hw] using hsource)





end Math15.LonelyRunner
end 
