/- Section: QuotientLattice4 -/
section



/-!
Actual integer quotient of Z^4 by a primitive integer vector.

The ambient basis is constructed from Bezout and the accepted PID split-basis
theorem. No unimodular completion is an input. The quotient is the last three
rows of the integral dual basis. Explicit adjugate identities supply
surjectivity, the integer and real kernels, and the transpose annihilator. The
signed maximal minors are the primitive vector up to its basis orientation,
not a nontrivial integral multiple of that vector.
-/

noncomputable section
namespace Math15.Source05Review.QuotientLattice4

open Module Math15.LonelyRunner.Covolume4

abbrev Z4 := Fin 4 → ℤ
abbrev Z3 := Fin 3 → ℤ
abbrev R4 := Fin 4 → ℝ
abbrev R3 := Fin 3 → ℝ

/-- Ambient primitivity constructs an actual four-element integer basis
beginning with the specified vector. -/
theorem primitive_ambient_basis4 (v : Z4)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ b : Basis (Fin 4) ℤ Z4, b 0 = v := by
  obtain ⟨z, hz⟩ := primitive_integer_bezout v hv
  have hphi : integerDotLinear z v = 1 := by
    change intDot z v = 1
    simpa only [intDot, mul_comm] using hz
  obtain ⟨k, b, hb⟩ := basis_starts_at_split_vector
    (Pi.basisFun ℤ (Fin 4)) (integerDotLinear z) v hphi
  have hk : k = 3 := by
    have hc := Module.finrank_eq_card_basis b
    simp only [Module.finrank_fin_fun, Fintype.card_fin] at hc
    omega
  subst k
  exact ⟨b, hb⟩

section CofactorAlgebra

variable {R : Type*} [CommRing R]

/-- Unnormalized integral dual rows, in the determinant convention of
`Covolume4.cross4`. -/
def rawDualRows4 (u v w z : Vec4 R) : Fin 4 → Vec4 R := ![
  (fun i => -cross4 v w z i),
  cross4 u w z,
  (fun i => -cross4 u v z i),
  cross4 u v w]

/-- Multiplication by the orientation gives the genuine dual basis when
the basis determinant has square one. -/
def normalizedDualRows4 (u v w z : Vec4 R) : Fin 4 → Vec4 R :=
  fun j i => det4 u v w z * rawDualRows4 u v w z j i

theorem dot4_scale_left (a : R) (u v : Vec4 R) :
    dot4 (fun i => a * u i) v = a * dot4 u v := by
  simp only [dot4]
  ring

theorem dot4_three_columns (a b c : R) (u v w x : Vec4 R) :
    dot4 x (fun i => a*u i+b*v i+c*w i) =
      a*dot4 x u+b*dot4 x v+c*dot4 x w := by
  simp only [dot4]
  ring

theorem rawDualRows4_pairings (u v w z : Vec4 R) (i j : Fin 4) :
    dot4 (rawDualRows4 u v w z i) (![u,v,w,z] j) =
      if i = j then det4 u v w z else 0 := by
  fin_cases i <;> fin_cases j
  all_goals simp [rawDualRows4, det4, dot4, cross4, det3]
  all_goals ring

theorem normalizedDualRows4_pairings (u v w z : Vec4 R)
    (hdet : (det4 u v w z)^2 = 1) (i j : Fin 4) :
    dot4 (normalizedDualRows4 u v w z i) (![u,v,w,z] j) =
      if i = j then 1 else 0 := by
  unfold normalizedDualRows4
  rw [dot4_scale_left, rawDualRows4_pairings]
  split_ifs
  · simpa only [← pow_two] using hdet
  · exact mul_zero _

/-- Adjugate reconstruction with the original columns on the right. -/
theorem rawDualRows4_primal_reconstruct (u v w z x : Vec4 R) (i : Fin 4) :
    det4 u v w z * x i =
      dot4 (rawDualRows4 u v w z 0) x * u i +
      dot4 (rawDualRows4 u v w z 1) x * v i +
      dot4 (rawDualRows4 u v w z 2) x * w i +
      dot4 (rawDualRows4 u v w z 3) x * z i := by
  fin_cases i
  all_goals simp [rawDualRows4, det4, dot4, cross4, det3]
  all_goals ring

theorem normalizedDualRows4_primal_reconstruct (u v w z x : Vec4 R)
    (hdet : (det4 u v w z)^2 = 1) (i : Fin 4) :
    x i =
      dot4 (normalizedDualRows4 u v w z 0) x * u i +
      dot4 (normalizedDualRows4 u v w z 1) x * v i +
      dot4 (normalizedDualRows4 u v w z 2) x * w i +
      dot4 (normalizedDualRows4 u v w z 3) x * z i := by
  have hscale (j : Fin 4) : dot4 (normalizedDualRows4 u v w z j) x =
      det4 u v w z * dot4 (rawDualRows4 u v w z j) x :=
    dot4_scale_left (det4 u v w z) (rawDualRows4 u v w z j) x
  rw [hscale 0,hscale 1,hscale 2,hscale 3]
  have hraw := rawDualRows4_primal_reconstruct u v w z x i
  linear_combination (det4 u v w z)*hraw-(x i)*hdet

/-- Reconstruction in the dual columns.  This gives the entire integral
annihilator, so there is no finite-index ambiguity in the transpose image. -/
theorem normalizedDualRows4_dual_reconstruct (u v w z x : Vec4 R)
    (hdet : (det4 u v w z)^2 = 1) (i : Fin 4) :
    x i = dot4 x u * normalizedDualRows4 u v w z 0 i +
      dot4 x v * normalizedDualRows4 u v w z 1 i +
      dot4 x w * normalizedDualRows4 u v w z 2 i +
      dot4 x z * normalizedDualRows4 u v w z 3 i := by
  have h := cofactor_reconstruct u v w z x i
  calc
    x i = det4 u v w z * (det4 u v w z * x i) := by
      rw [← mul_assoc, ← pow_two, hdet, one_mul]
    _ = _ := by
      rw [h]
      simp [normalizedDualRows4, rawDualRows4,
        complementLeft, complementRight]
      ring

theorem cross4_self_pairings (u v w : Vec4 R) :
    dot4 (cross4 u v w) u = 0 ∧
    dot4 (cross4 u v w) v = 0 ∧
    dot4 (cross4 u v w) w = 0 := by
  repeat' constructor
  all_goals simp [dot4, cross4, det3]
  all_goals ring

theorem det4_cyclic_last (u v w z : Vec4 R) :
    det4 v w z u = -det4 u v w z := by
  simp [det4, dot4, cross4, det3]
  ring

end CofactorAlgebra

/-- All four integral coordinate rows of the constructed ambient basis. -/
def basisDualRows4 (b : Basis (Fin 4) ℤ Z4) : Fin 4 → Z4 :=
  normalizedDualRows4 (b 0) (b 1) (b 2) (b 3)

/-- The actual three-by-four quotient matrix, using the last three rows. -/
def quotientRows4 (b : Basis (Fin 4) ℤ Z4) : Matrix (Fin 3) (Fin 4) ℤ :=
  fun j i => basisDualRows4 b j.succ i

def integerQuotient4 (b : Basis (Fin 4) ℤ Z4) : Z4 →ₗ[ℤ] Z3 where
  toFun x j := dot4 (quotientRows4 b j) x
  map_add' := by
    intro x y
    funext j
    simp [dot4]
    ring
  map_smul' := by
    intro a x
    funext j
    simp [dot4]
    ring

/-- Literal transpose of the quotient matrix as an integral linear map. -/
def transposeQuotient4 (b : Basis (Fin 4) ℤ Z4) : Z3 →ₗ[ℤ] Z4 where
  toFun y i := y 0*quotientRows4 b 0 i +
    y 1*quotientRows4 b 1 i+y 2*quotientRows4 b 2 i
  map_add' := by
    intro x y
    funext i
    simp
    ring
  map_smul' := by
    intro a x
    funext i
    simp
    ring

/-- The same quotient matrix, extended to real coordinates. -/
def realQuotient4 (b : Basis (Fin 4) ℤ Z4) : R4 →ₗ[ℝ] R3 where
  toFun x j := dot4 (realCast (quotientRows4 b j)) x
  map_add' := by
    intro x y
    funext j
    simp [dot4]
    ring
  map_smul' := by
    intro a x
    funext j
    simp [dot4]
    ring

theorem basisDualRows4_pairings (b : Basis (Fin 4) ℤ Z4) (i j : Fin 4) :
    dot4 (basisDualRows4 b i) (b j) = if i = j then 1 else 0 := by
  have h := normalizedDualRows4_pairings (b 0) (b 1) (b 2) (b 3)
    (det4_basis_sq_one b) i j
  fin_cases j <;> simpa [basisDualRows4] using h

theorem basisDualRows4_primal_reconstruct (b : Basis (Fin 4) ℤ Z4)
    (x : Z4) (i : Fin 4) :
    x i = dot4 (basisDualRows4 b 0) x*b 0 i +
      dot4 (basisDualRows4 b 1) x*b 1 i +
      dot4 (basisDualRows4 b 2) x*b 2 i +
      dot4 (basisDualRows4 b 3) x*b 3 i :=
  normalizedDualRows4_primal_reconstruct (b 0) (b 1) (b 2) (b 3)
    x (det4_basis_sq_one b) i

theorem basisDualRows4_dual_reconstruct (b : Basis (Fin 4) ℤ Z4)
    (x : Z4) (i : Fin 4) :
    x i = dot4 x (b 0)*basisDualRows4 b 0 i +
      dot4 x (b 1)*basisDualRows4 b 1 i +
      dot4 x (b 2)*basisDualRows4 b 2 i +
      dot4 x (b 3)*basisDualRows4 b 3 i :=
  normalizedDualRows4_dual_reconstruct (b 0) (b 1) (b 2) (b 3)
    x (det4_basis_sq_one b) i

theorem integerQuotient4_basis_zero (b : Basis (Fin 4) ℤ Z4) :
    integerQuotient4 b (b 0) = 0 := by
  funext j
  change dot4 (basisDualRows4 b j.succ) (b 0) = 0
  rw [basisDualRows4_pairings]
  simp

theorem integerQuotient4_surjective (b : Basis (Fin 4) ℤ Z4) :
    Function.Surjective (integerQuotient4 b) := by
  intro y
  refine ⟨fun i => y 0*b 1 i+y 1*b 2 i+y 2*b 3 i, ?_⟩
  funext j
  change dot4 (basisDualRows4 b j.succ)
    (fun i => y 0*b 1 i+y 1*b 2 i+y 2*b 3 i) = y j
  rw [dot4_three_columns]
  simp only [basisDualRows4_pairings]
  fin_cases j <;> norm_num [Fin.ext_iff] <;> rfl

theorem integerQuotient4_kernel (b : Basis (Fin 4) ℤ Z4) (x : Z4) :
    integerQuotient4 b x = 0 ↔ ∃ k : ℤ, x = k • b 0 := by
  constructor
  · intro hx
    have h1 : dot4 (basisDualRows4 b 1) x = 0 := congrFun hx 0
    have h2 : dot4 (basisDualRows4 b 2) x = 0 := congrFun hx 1
    have h3 : dot4 (basisDualRows4 b 3) x = 0 := congrFun hx 2
    refine ⟨dot4 (basisDualRows4 b 0) x, ?_⟩
    funext i
    have h := basisDualRows4_primal_reconstruct b x i
    simpa only [h1, h2, h3, zero_mul, add_zero, Pi.smul_apply,
      smul_eq_mul] using h
  · rintro ⟨k, rfl⟩
    rw [map_smul, integerQuotient4_basis_zero, smul_zero]

theorem dot4_eq_intDot (x y : Z4) : dot4 x y = intDot x y := by
  simp only [dot4, intDot, Fin.sum_univ_four]

theorem transposeQuotient4_annihilator (b : Basis (Fin 4) ℤ Z4) (m : Z4) :
    (∃ n : Z3, transposeQuotient4 b n = m) ↔ intDot m (b 0) = 0 := by
  rw [← dot4_eq_intDot]
  constructor
  · rintro ⟨n, rfl⟩
    change dot4 (fun i => n 0*basisDualRows4 b 1 i+
      n 1*basisDualRows4 b 2 i+n 2*basisDualRows4 b 3 i) (b 0) = 0
    rw [dot4_symm, dot4_three_columns]
    simp only [dot4_symm (b 0), basisDualRows4_pairings]
    norm_num [Fin.ext_iff]
  · intro hm
    refine ⟨![dot4 m (b 1), dot4 m (b 2), dot4 m (b 3)], ?_⟩
    funext i
    have h := basisDualRows4_dual_reconstruct b m i
    simp only [hm, zero_mul, zero_add] at h
    exact h.symm

theorem det4_realCast (u v w z : Z4) :
    det4 (realCast u) (realCast v) (realCast w) (realCast z) =
      ((det4 u v w z : ℤ) : ℝ) := by
  simp [det4, dot4, cross4, det3, realCast]

theorem normalizedDualRows4_realCast (u v w z : Z4) (j : Fin 4) :
    normalizedDualRows4 (realCast u) (realCast v) (realCast w) (realCast z) j =
      realCast (normalizedDualRows4 u v w z j) := by
  funext i
  fin_cases j <;> fin_cases i
  all_goals simp [normalizedDualRows4, rawDualRows4, det4,
    dot4, cross4, det3, realCast]

theorem realQuotient4_kernel (b : Basis (Fin 4) ℤ Z4) (x : R4) :
    realQuotient4 b x = 0 ↔ ∃ t : ℝ, x = t • realCast (b 0) := by
  let u := realCast (b 0)
  let v := realCast (b 1)
  let w := realCast (b 2)
  let z := realCast (b 3)
  have hd : (det4 u v w z)^2 = 1 := by
    change (det4 (realCast (b 0)) (realCast (b 1))
      (realCast (b 2)) (realCast (b 3)))^2 = 1
    rw [det4_realCast]
    exact_mod_cast det4_basis_sq_one b
  have hrows (j : Fin 4) : normalizedDualRows4 u v w z j =
      realCast (basisDualRows4 b j) :=
    normalizedDualRows4_realCast (b 0) (b 1) (b 2) (b 3) j
  constructor
  · intro hx
    have h1 : dot4 (normalizedDualRows4 u v w z 1) x = 0 := by
      rw [hrows]
      exact congrFun hx 0
    have h2 : dot4 (normalizedDualRows4 u v w z 2) x = 0 := by
      rw [hrows]
      exact congrFun hx 1
    have h3 : dot4 (normalizedDualRows4 u v w z 3) x = 0 := by
      rw [hrows]
      exact congrFun hx 2
    refine ⟨dot4 (normalizedDualRows4 u v w z 0) x, ?_⟩
    funext i
    have h := normalizedDualRows4_primal_reconstruct u v w z x hd i
    simpa only [h1, h2, h3, zero_mul, add_zero, Pi.smul_apply,
      smul_eq_mul] using h
  · rintro ⟨t, rfl⟩
    funext j
    change dot4 (realCast (basisDualRows4 b j.succ))
      (t • realCast (b 0)) = 0
    rw [← hrows]
    have hp := normalizedDualRows4_pairings u v w z hd j.succ 0
    have hpu : dot4 (normalizedDualRows4 u v w z j.succ) u = 0 := by
      simpa using hp
    calc
      dot4 (normalizedDualRows4 u v w z j.succ)
          (t • realCast (b 0)) =
        t * dot4 (normalizedDualRows4 u v w z j.succ) u := by
          simp [dot4, u]
          ring
      _ = 0 := by rw [hpu, mul_zero]

/-- Literal signed three-by-three maximal minors.  The four signs are
`+,-,+,-`, by deletion of columns `0,1,2,3` respectively. -/
def signedMaximalMinors4 (U : Matrix (Fin 3) (Fin 4) ℤ) : Z4 :=
  fun i => -cross4 (U 0) (U 1) (U 2) i

theorem signedMaximalMinors4_literal (U : Matrix (Fin 3) (Fin 4) ℤ) :
    signedMaximalMinors4 U = ![
      det3 (U 0 1) (U 1 1) (U 2 1)
        (U 0 2) (U 1 2) (U 2 2) (U 0 3) (U 1 3) (U 2 3),
      -det3 (U 0 0) (U 1 0) (U 2 0)
        (U 0 2) (U 1 2) (U 2 2) (U 0 3) (U 1 3) (U 2 3),
      det3 (U 0 0) (U 1 0) (U 2 0)
        (U 0 1) (U 1 1) (U 2 1) (U 0 3) (U 1 3) (U 2 3),
      -det3 (U 0 0) (U 1 0) (U 2 0)
        (U 0 1) (U 1 1) (U 2 1) (U 0 2) (U 1 2) (U 2 2)] := by
  funext i
  fin_cases i <;> simp [signedMaximalMinors4, cross4]

/-- The determinant of the actual integral dual basis equals the
orientation of the original basis. -/
theorem basisDualRows4_det (b : Basis (Fin 4) ℤ Z4) :
    det4 (basisDualRows4 b 0) (basisDualRows4 b 1)
      (basisDualRows4 b 2) (basisDualRows4 b 3) =
        det4 (b 0) (b 1) (b 2) (b 3) := by
  let D : Matrix (Fin 4) (Fin 4) ℤ := fun i j => basisDualRows4 b i j
  let C : Matrix (Fin 4) (Fin 4) ℤ := columns4 (b 0) (b 1) (b 2) (b 3)
  have hmul : D*C = 1 := by
    ext i j
    have h := basisDualRows4_pairings b i j
    fin_cases j
    all_goals simpa [Matrix.mul_apply, Matrix.one_apply, D, C,
      columns4, Fin.sum_univ_four, dot4] using h
  have hm := congrArg Matrix.det hmul
  rw [Matrix.det_mul, Matrix.det_one] at hm
  have hC : Matrix.det C = det4 (b 0) (b 1) (b 2) (b 3) :=
    (det4_eq_columns_det (b 0) (b 1) (b 2) (b 3)).symm
  rw [hC] at hm
  have hD : Matrix.det D = det4 (b 0) (b 1) (b 2) (b 3) := by
    calc
      Matrix.det D = Matrix.det D*
          ((det4 (b 0) (b 1) (b 2) (b 3))^2) := by
        rw [det4_basis_sq_one, mul_one]
      _ = (Matrix.det D*det4 (b 0) (b 1) (b 2) (b 3))*
          det4 (b 0) (b 1) (b 2) (b 3) := by ring
      _ = _ := by rw [hm, one_mul]
  rw [det4_eq_columns_det]
  have hcol : columns4 (basisDualRows4 b 0) (basisDualRows4 b 1)
      (basisDualRows4 b 2) (basisDualRows4 b 3) = D.transpose := by
    ext i j
    fin_cases j <;> rfl
  rw [hcol, Matrix.det_transpose, hD]

/-- Signed maximal minors are exactly the primitive kernel generator
times a unit; there is no unproved saturation or index hypothesis. -/
theorem quotientRows4_signed_minors (b : Basis (Fin 4) ℤ Z4) :
    signedMaximalMinors4 (quotientRows4 b) =
      det4 (b 0) (b 1) (b 2) (b 3) • b 0 := by
  let q : Z4 := cross4 (basisDualRows4 b 1)
    (basisDualRows4 b 2) (basisDualRows4 b 3)
  have ht := cross4_self_pairings (basisDualRows4 b 1)
    (basisDualRows4 b 2) (basisDualRows4 b 3)
  have h0 : dot4 (basisDualRows4 b 0) q =
      -det4 (b 0) (b 1) (b 2) (b 3) := by
    rw [dot4_symm]
    change det4 (basisDualRows4 b 1) (basisDualRows4 b 2)
      (basisDualRows4 b 3) (basisDualRows4 b 0) = _
    rw [det4_cyclic_last, basisDualRows4_det]
  have h1 : dot4 (basisDualRows4 b 1) q = 0 := by
    exact (dot4_symm _ _).trans ht.1
  have h2 : dot4 (basisDualRows4 b 2) q = 0 := by
    exact (dot4_symm _ _).trans ht.2.1
  have h3 : dot4 (basisDualRows4 b 3) q = 0 := by
    exact (dot4_symm _ _).trans ht.2.2
  funext i
  have h := basisDualRows4_primal_reconstruct b q i
  simp only [h0, h1, h2, h3, zero_mul, add_zero] at h
  change -q i = det4 (b 0) (b 1) (b 2) (b 3)*b 0 i
  rw [h]
  ring

/-- Complete quotient package for an actual primitive integer speed
vector.  Every algebraic map and minor is defined above; the only input
is the original ambient gcd-one condition. -/
theorem primitive_integer_quotient4 (v : Z4)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ b : Basis (Fin 4) ℤ Z4, b 0 = v ∧
      Function.Surjective (integerQuotient4 b) ∧
      (∀ x : Z4, integerQuotient4 b x = 0 ↔ ∃ k : ℤ, x = k • v) ∧
      (∀ x : R4, realQuotient4 b x = 0 ↔ ∃ t : ℝ, x = t • realCast v) ∧
      (∀ m : Z4, (∃ n : Z3, transposeQuotient4 b n = m) ↔ intDot m v = 0) ∧
      ∃ ε : ℤ, ε^2 = 1 ∧ signedMaximalMinors4 (quotientRows4 b) = ε • v := by
  obtain ⟨b, hb⟩ := primitive_ambient_basis4 v hv
  refine ⟨b, hb, integerQuotient4_surjective b, ?_, ?_, ?_, ?_⟩
  · intro x
    simpa only [hb] using integerQuotient4_kernel b x
  · intro x
    simpa only [hb] using realQuotient4_kernel b x
  · intro m
    simpa only [hb] using transposeQuotient4_annihilator b m
  · refine ⟨det4 (b 0) (b 1) (b 2) (b 3), det4_basis_sq_one b, ?_⟩
    simpa only [hb] using quotientRows4_signed_minors b




























end Math15.Source05Review.QuotientLattice4
end 
end 

/- Section: SubmissionShear -/
section


/-!
An explicit shear using the canonical header's basic linear algebra. This
adapts the elementary construction in Mathlib's
LinearAlgebra/Transvection/Basic.lean without its characteristic-polynomial or
base-change imports.
-/

namespace Math15.LonelyRunner.Covolume4

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

def submissionShearMap (f : M →ₗ[R] R) (v : M) : M →ₗ[R] M where
  toFun x := x + f x • v
  map_add' x y := by simp [add_add_add_comm, add_smul]
  map_smul' r x := by simp [smul_eq_mul, smul_add, mul_smul]

def submissionShearEquiv {f : M →ₗ[R] R} {v : M} (h : f v = 0) :
    M ≃ₗ[R] M where
  toFun := submissionShearMap f v
  invFun := submissionShearMap f (-v)
  map_add' x y := by simp [map_add]
  map_smul' r x := by simp
  left_inv x := by
    change (x + f x • v) + f (x + f x • v) • (-v) = x
    simp [map_add, map_smul, h]
  right_inv x := by
    change (x + f x • (-v)) + f (x + f x • (-v)) • v = x
    simp [map_add, map_smul, h]

theorem submissionShearEquiv_apply {f : M →ₗ[R] R} {v : M}
    (h : f v = 0) (x : M) :
    submissionShearEquiv h x = x + f x • v := rfl

end Math15.LonelyRunner.Covolume4
end 

/- Section: Rank3BasisMinimum -/
section





/-!
Actual integral basis operations and a least positive Gram-prefix potential
among all ambient bases beginning with a fixed primitive vector. The
minimization is in N; no existence of a real minimizer or discreteness
assertion about projected real vectors is assumed.

All shears and swaps below return genuine bases, preserve the first vector
under their stated index conditions, and may therefore be fed directly to the
global minimum inequality.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Module

/-- Add q times vector i to vector j by a genuine integral transvection. -/
def basisShear (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) : Basis (Fin 4) ℤ (Vec4 ℤ) :=
  b.map (submissionShearEquiv
    (f := b.coord j) (v := q • b i) (by
      rw [map_smul]
      simp only [Basis.coord_apply, Basis.repr_self,
        Finsupp.single_apply, if_neg hij, if_neg (Ne.symm hij), smul_zero]))

theorem basisShear_apply (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) (k : Fin 4) :
    basisShear b i j hij q k = b k + (if k = j then q else 0) • b i := by
  change b k + (b.coord j (b k)) • (q • b i) =
    b k + (if k = j then q else 0) • b i
  by_cases hkj : k = j
  · subst k
    simp [Basis.coord_apply, Basis.repr_self, Finsupp.single_apply]
  · simp only [Basis.coord_apply, Basis.repr_self, Finsupp.single_apply,
      if_neg hkj, if_neg (Ne.symm hkj), zero_smul, add_zero]

theorem basisShear_apply_target (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) :
    basisShear b i j hij q j = b j + q • b i := by
  rw [basisShear_apply, if_pos rfl]

theorem basisShear_apply_of_ne (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) (k : Fin 4) (hkj : k ≠ j) :
    basisShear b i j hij q k = b k := by
  rw [basisShear_apply, if_neg hkj, zero_smul, add_zero]

theorem basisShear_zero (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) (hj : j ≠ 0) :
    basisShear b i j hij q 0 = b 0 :=
  basisShear_apply_of_ne b i j hij q 0 (Ne.symm hj)

/-- Exchange any two basis vectors by reindexing. -/
def basisSwap (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (i j : Fin 4) :
    Basis (Fin 4) ℤ (Vec4 ℤ) :=
  b.reindex (Equiv.swap i j)

theorem basisSwap_apply (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j k : Fin 4) : basisSwap b i j k = b (Equiv.swap i j k) := by
  simp only [basisSwap, Basis.reindex_apply, Equiv.symm_swap]

theorem basisSwap_apply_left (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) : basisSwap b i j i = b j := by
  rw [basisSwap_apply, Equiv.swap_apply_left]

theorem basisSwap_apply_right (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) : basisSwap b i j j = b i := by
  rw [basisSwap_apply, Equiv.swap_apply_right]

theorem basisSwap_apply_of_ne (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j k : Fin 4) (hki : k ≠ i) (hkj : k ≠ j) :
    basisSwap b i j k = b k := by
  rw [basisSwap_apply, Equiv.swap_apply_of_ne_of_ne hki hkj]

theorem basisSwap_zero (b : Basis (Fin 4) ℤ (Vec4 ℤ))
    (i j : Fin 4) (hi : i ≠ 0) (hj : j ≠ 0) :
    basisSwap b i j 0 = b 0 :=
  basisSwap_apply_of_ne b i j 0 (Ne.symm hi) (Ne.symm hj)

/-- A supplied ambient basis makes the collection nonempty. Well-ordering
selects a genuine basis whose natural-valued potential is least. -/
theorem exists_basis_potential_minimum (v : Vec4 ℤ)
    (initial : Basis (Fin 4) ℤ (Vec4 ℤ)) (hfirst : initial 0 = v) :
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧
      ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
        basisPotential b ≤ basisPotential B := by
  classical
  let P : ℕ → Prop := fun n =>
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧ basisPotential b = n
  have hex : ∃ n, P n := ⟨basisPotential initial, initial, hfirst, rfl⟩
  obtain ⟨b, hb, hvalue⟩ := Nat.find_spec hex
  refine ⟨b, hb, ?_⟩
  intro B hB
  rw [hvalue]
  exact Nat.find_min' hex ⟨B, hB, rfl⟩

/-- The selected basis minimizes the actual integer Gram-prefix product,
using positivity to identify that product with its natural potential. -/
theorem exists_basis_product_minimum (v : Vec4 ℤ)
    (initial : Basis (Fin 4) ℤ (Vec4 ℤ)) (hfirst : initial 0 = v) :
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧
      ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
        basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B := by
  obtain ⟨b, hb, hmin⟩ := exists_basis_potential_minimum v initial hfirst
  refine ⟨b, hb, ?_⟩
  intro B hB
  have hnat := hmin B hB
  have hint : (basisPotential b : ℤ) ≤ (basisPotential B : ℤ) := by
    exact_mod_cast hnat
  simpa only [basisPotential_cast] using hint

/-- Ambient primitivity supplies the initial basis, so neither basis
completion nor existence of a minimum is left as an input. -/
theorem primitive_basis_product_minimum (v : Vec4 ℤ)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧
      ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
        basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B := by
  obtain ⟨initial, hfirst⟩ :=
    Math15.Source05Review.QuotientLattice4.primitive_ambient_basis4 v hv
  exact exists_basis_product_minimum v initial hfirst

/-- Every shear away from position zero is an admissible competitor. -/
theorem basis_minimum_compares_shear (v : Vec4 ℤ)
    (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (hb : b 0 = v)
    (hmin : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B)
    (i j : Fin 4) (hij : i ≠ j) (q : ℤ) (hj : j ≠ 0) :
    basisD1 b * basisD2 b ≤
      basisD1 (basisShear b i j hij q) * basisD2 (basisShear b i j hij q) := by
  exact hmin _ ((basisShear_zero b i j hij q hj).trans hb)

/-- Every swap away from position zero is an admissible competitor. -/
theorem basis_minimum_compares_swap (v : Vec4 ℤ)
    (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (hb : b 0 = v)
    (hmin : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B)
    (i j : Fin 4) (hi : i ≠ 0) (hj : j ≠ 0) :
    basisD1 b * basisD2 b ≤
      basisD1 (basisSwap b i j) * basisD2 (basisSwap b i j) := by
  exact hmin _ ((basisSwap_zero b i j hi hj).trans hb)
















end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: Rank3GramAlgebra -/
section


/-!
Algebraic identities for actual prefix minors and elementary shears.
-/

namespace Math15.LonelyRunner.Covolume4
variable {R : Type*} [CommRing R]

def gram3Cross (v u w z : Vec4 R) : R :=
  dot4 (cross4 v u w) (cross4 v u z)

theorem cross4_third_add_smul (v u w z : Vec4 R) (q : R) :
    cross4 v u (fun i => w i+q*z i)=
      (fun i => cross4 v u w i+q*cross4 v u z i) := by
  funext i
  fin_cases i <;> simp [cross4,det3] <;> ring

theorem cross4_third_self (v u : Vec4 R) : cross4 v u u=0 := by
  funext i
  fin_cases i <;> simp [cross4,det3] <;> ring

theorem cross4_swap_tail (v u w : Vec4 R) :
    cross4 v w u = fun i => -cross4 v u w i := by
  funext i
  fin_cases i <;> simp [cross4,det3] <;> ring

theorem gram3Sq_shear (v u w : Vec4 R) (q : R) :
    gram3Sq v u (fun i => w i+q*u i)=gram3Sq v u w := by
  simp [gram3Sq,cross4_third_add_smul,cross4_third_self]

theorem gram3Sq_swap_tail (v u w : Vec4 R) :
    gram3Sq v w u=gram3Sq v u w := by
  simp only [gram3Sq, cross4_swap_tail v u w, dot4]
  ring

theorem projectedCrossGram_shear (v u w : Vec4 R) (q : R) :
    projectedCrossGram v u (fun i => w i+q*u i)=
      projectedCrossGram v u w+q*areaSq4 v u := by
  rw [lagrange_area_identity]
  simp [projectedCrossGram,dot4]
  ring

theorem gram3Cross_shear_last (v u w z : Vec4 R) (q : R) :
    gram3Cross v u w (fun i => z i+q*w i)=
      gram3Cross v u w z+q*gram3Sq v u w := by
  simp only [gram3Cross,gram3Sq,cross4_third_add_smul,dot4]
  ring

theorem gram3Cross_expansion (v u w z : Vec4 R) :
    gram3Cross v u w z =
      areaSq4 v u*dot4 w z-dot4 u u*dot4 v w*dot4 v z+
      dot4 v u*(dot4 v w*dot4 u z+dot4 v z*dot4 u w)-
      dot4 v v*dot4 u w*dot4 u z := by
  rw [lagrange_area_identity]
  simp [gram3Cross,dot4,cross4,det3]
  ring

/-- Complementary minors give the last Gram-Schmidt determinant without
expanding a degree-twelve polynomial in the original coordinates. -/
theorem gram3_pair_determinant (v u w z : Vec4 R) :
    gram3Sq v u w*gram3Sq v u z-(gram3Cross v u w z)^2=
      areaSq4 v u*(det4 v u w z)^2 := by
  have h := areaSq_complementary v u w z
  rw [lagrange_area_identity] at h
  dsimp [complementLeft,complementRight,dot4] at h
  dsimp [gram3Sq,gram3Cross,dot4]
  linear_combination h











end Math15.LonelyRunner.Covolume4
end 

/- Section: Rank3ReducedBasis -/
section




/-!
An actual integral basis with centered adjacent Gram coefficients. Two
elementary shears preserve both positive prefix minors, hence the global
minimum of their product. The two adjacent swaps then give the inequalities
needed for the three-dimensional covering estimate.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Module

def basisB (b : Basis (Fin 4) ℤ (Vec4 ℤ)) : ℤ :=
  projectedCrossGram (b 0) (b 1) (b 2)

def basisC (b : Basis (Fin 4) ℤ (Vec4 ℤ)) : ℤ :=
  gram3Cross (b 0) (b 1) (b 2) (b 3)

/-- Shear basis vector 2 by an integral multiple of basis vector 1. -/
def basisShear12 (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    Basis (Fin 4) ℤ (Vec4 ℤ) := basisShear b 1 2 (by decide) q

/-- Shear basis vector 3 by an integral multiple of basis vector 2. -/
def basisShear23 (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    Basis (Fin 4) ℤ (Vec4 ℤ) := basisShear b 2 3 (by decide) q

theorem basisShear12_vectors (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    basisShear12 b q 0 = b 0 ∧ basisShear12 b q 1 = b 1 ∧
      basisShear12 b q 2 = (fun i => b 2 i + q * b 1 i) ∧
      basisShear12 b q 3 = b 3 := by
  refine ⟨basisShear_apply_of_ne b 1 2 (by decide) q 0 (by decide),
    basisShear_apply_of_ne b 1 2 (by decide) q 1 (by decide), ?_,
    basisShear_apply_of_ne b 1 2 (by decide) q 3 (by decide)⟩
  change basisShear b 1 2 (by decide) q 2 = _
  rw [basisShear_apply_target]
  funext i
  simp [smul_eq_mul]

theorem basisShear12_data (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    basisD1 (basisShear12 b q) = basisD1 b ∧
      basisD2 (basisShear12 b q) = basisD2 b ∧
      basisB (basisShear12 b q) = basisB b + q * basisD1 b := by
  obtain ⟨h0, h1, h2, _⟩ := basisShear12_vectors b q
  refine ⟨?_, ?_, ?_⟩
  · simp only [basisD1, h0, h1]
  · simp only [basisD2, h0, h1, h2, gram3Sq_shear]
  · simp only [basisB, basisD1, h0, h1, h2, projectedCrossGram_shear]

theorem basisShear23_vectors (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    basisShear23 b q 0 = b 0 ∧ basisShear23 b q 1 = b 1 ∧
      basisShear23 b q 2 = b 2 ∧
      basisShear23 b q 3 = (fun i => b 3 i + q * b 2 i) := by
  refine ⟨basisShear_apply_of_ne b 2 3 (by decide) q 0 (by decide),
    basisShear_apply_of_ne b 2 3 (by decide) q 1 (by decide),
    basisShear_apply_of_ne b 2 3 (by decide) q 2 (by decide), ?_⟩
  change basisShear b 2 3 (by decide) q 3 = _
  rw [basisShear_apply_target]
  funext i
  simp [smul_eq_mul]

theorem basisShear23_data (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (q : ℤ) :
    basisD1 (basisShear23 b q) = basisD1 b ∧
      basisD2 (basisShear23 b q) = basisD2 b ∧
      basisB (basisShear23 b q) = basisB b ∧
      basisC (basisShear23 b q) = basisC b + q * basisD2 b := by
  obtain ⟨h0, h1, h2, h3⟩ := basisShear23_vectors b q
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [basisD1, h0, h1]
  · simp only [basisD2, h0, h1, h2]
  · simp only [basisB, h0, h1, h2]
  · simp only [basisC, basisD2, h0, h1, h2, h3, gram3Cross_shear_last]

/-- The two shears center the adjacent Gram coefficients while retaining
the same first vector and the same global product minimum. -/
theorem primitive_rank3_centered_minimum (v : Vec4 ℤ)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧
      (∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
        basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B) ∧
      |2 * basisB b| ≤ basisD1 b ∧ |2 * basisC b| ≤ basisD2 b := by
  obtain ⟨b, hb, hmin⟩ := primitive_basis_product_minimum v hv
  obtain ⟨q, hq⟩ := exists_integer_nearest_multiple
    (basisD1 b) (basisB b) (basisD1_positive b)
  let b1 := basisShear12 b (-q)
  obtain ⟨hA1, hT1, hB1⟩ := basisShear12_data b (-q)
  have hb1 : b1 0 = v := (basisShear12_vectors b (-q)).1.trans hb
  have hmin1 : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b1 * basisD2 b1 ≤ basisD1 B * basisD2 B := by
    intro B hB
    change basisD1 (basisShear12 b (-q)) * basisD2 (basisShear12 b (-q)) ≤ _
    rw [hA1, hT1]
    exact hmin B hB
  have hcenterB1 : |2 * basisB b1| ≤ basisD1 b1 := by
    change |2 * basisB (basisShear12 b (-q))| ≤ basisD1 (basisShear12 b (-q))
    rw [hB1, hA1]
    simpa only [neg_mul, sub_eq_add_neg] using hq
  obtain ⟨r, hr⟩ := exists_integer_nearest_multiple
    (basisD2 b1) (basisC b1) (basisD2_positive b1)
  let b2 := basisShear23 b1 (-r)
  obtain ⟨hA2, hT2, hB2, hC2⟩ := basisShear23_data b1 (-r)
  have hb2 : b2 0 = v := (basisShear23_vectors b1 (-r)).1.trans hb1
  have hmin2 : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b2 * basisD2 b2 ≤ basisD1 B * basisD2 B := by
    intro B hB
    change basisD1 (basisShear23 b1 (-r)) * basisD2 (basisShear23 b1 (-r)) ≤ _
    rw [hA2, hT2]
    exact hmin1 B hB
  have hcenterB2 : |2 * basisB b2| ≤ basisD1 b2 := by
    change |2 * basisB (basisShear23 b1 (-r))| ≤ basisD1 (basisShear23 b1 (-r))
    rw [hB2, hA2]
    exact hcenterB1
  have hcenterC2 : |2 * basisC b2| ≤ basisD2 b2 := by
    change |2 * basisC (basisShear23 b1 (-r))| ≤ basisD2 (basisShear23 b1 (-r))
    rw [hC2, hT2]
    simpa only [neg_mul, sub_eq_add_neg] using hr
  exact ⟨b2, hb2, hmin2, hcenterB2, hcenterC2⟩

/-- Adjacent swaps of a minimum basis compare the two neighboring
prefix minors. Both swaps are actual unimodular basis operations. -/
theorem basis_minimum_prefix_comparisons (v : Vec4 ℤ)
    (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (hb : b 0 = v)
    (hmin : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B) :
    basisD1 b ≤ areaSq4 (b 0) (b 2) ∧
      basisD2 b ≤ gram3Sq (b 0) (b 1) (b 3) := by
  have h12 := basis_minimum_compares_swap v b hb hmin 1 2 (by decide) (by decide)
  have hA12 : basisD1 (basisSwap b 1 2) = areaSq4 (b 0) (b 2) := by
    change areaSq4 (basisSwap b 1 2 0) (basisSwap b 1 2 1) = _
    rw [basisSwap_apply_of_ne b 1 2 0 (by decide) (by decide),
      basisSwap_apply_left]
  have hT12 : basisD2 (basisSwap b 1 2) = basisD2 b := by
    calc
      basisD2 (basisSwap b 1 2) = gram3Sq (b 0) (b 2) (b 1) := by
        change gram3Sq (basisSwap b 1 2 0) (basisSwap b 1 2 1)
          (basisSwap b 1 2 2) = _
        rw [basisSwap_apply_of_ne b 1 2 0 (by decide) (by decide),
          basisSwap_apply_left, basisSwap_apply_right]
      _ = basisD2 b := gram3Sq_swap_tail (b 0) (b 1) (b 2)
  rw [hA12, hT12] at h12
  have hAcomp : basisD1 b ≤ areaSq4 (b 0) (b 2) :=
    (mul_le_mul_iff_of_pos_right (basisD2_positive b)).mp h12
  have h23 := basis_minimum_compares_swap v b hb hmin 2 3 (by decide) (by decide)
  have hA23 : basisD1 (basisSwap b 2 3) = basisD1 b := by
    change areaSq4 (basisSwap b 2 3 0) (basisSwap b 2 3 1) = _
    rw [basisSwap_apply_of_ne b 2 3 0 (by decide) (by decide),
      basisSwap_apply_of_ne b 2 3 1 (by decide) (by decide)]
    rfl
  have hT23 : basisD2 (basisSwap b 2 3) = gram3Sq (b 0) (b 1) (b 3) := by
    change gram3Sq (basisSwap b 2 3 0) (basisSwap b 2 3 1)
      (basisSwap b 2 3 2) = _
    rw [basisSwap_apply_of_ne b 2 3 0 (by decide) (by decide),
      basisSwap_apply_of_ne b 2 3 1 (by decide) (by decide),
      basisSwap_apply_left]
  rw [hA23, hT23] at h23
  exact ⟨hAcomp, (mul_le_mul_iff_of_pos_left (basisD1_positive b)).mp h23⟩

/-- The adjacent centered bounds and the exact minor identities yield
the two integral reduction inequalities. -/
theorem rank3_reduction_inequalities (v : Vec4 ℤ)
    (b : Basis (Fin 4) ℤ (Vec4 ℤ)) (hb : b 0 = v)
    (hmin : ∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
      basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B)
    (hB : |2 * basisB b| ≤ basisD1 b)
    (hC : |2 * basisC b| ≤ basisD2 b) :
    3 * (basisD1 b)^2 ≤ 4 * dot4 v v * basisD2 b ∧
      3 * (basisD2 b)^2 ≤ 4 * basisD1 b := by
  obtain ⟨hAcomp, hTcomp⟩ := basis_minimum_prefix_comparisons v b hb hmin
  have hAA := mul_le_mul_of_nonneg_left hAcomp (basisD1_positive b).le
  have hTT := mul_le_mul_of_nonneg_left hTcomp (basisD2_positive b).le
  have hBabs := abs_le.mp hB
  have hCabs := abs_le.mp hC
  have hBsq := sq_le_sq' hBabs.1 hBabs.2
  have hCsq := sq_le_sq' hCabs.1 hCabs.2
  have hproj := gram3Sq_projection_identity (b 0) (b 1) (b 2)
  change basisD1 b * areaSq4 (b 0) (b 2) - (basisB b)^2 =
    dot4 (b 0) (b 0) * basisD2 b at hproj
  rw [hb] at hproj
  rw [hb] at hAA
  have hlast := gram3_pair_determinant (b 0) (b 1) (b 2) (b 3)
  rw [det4_basis_sq_one b, mul_one] at hlast
  change basisD2 b * gram3Sq (b 0) (b 1) (b 3) - (basisC b)^2 =
    basisD1 b at hlast
  constructor <;> nlinarith

/-- An actual reduced basis exists for every primitive speed vector.
Its complete global minimum and centered-coefficient data remain
available, along with both integral reduction inequalities. -/
theorem primitive_rank3_reduced_basis (v : Vec4 ℤ)
    (hv : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ b : Basis (Fin 4) ℤ (Vec4 ℤ), b 0 = v ∧
      (∀ B : Basis (Fin 4) ℤ (Vec4 ℤ), B 0 = v →
        basisD1 b * basisD2 b ≤ basisD1 B * basisD2 B) ∧
      |2 * basisB b| ≤ basisD1 b ∧ |2 * basisC b| ≤ basisD2 b ∧
      3 * (basisD1 b)^2 ≤ 4 * dot4 v v * basisD2 b ∧
      3 * (basisD2 b)^2 ≤ 4 * basisD1 b := by
  obtain ⟨b, hb, hmin, hB, hC⟩ := primitive_rank3_centered_minimum v hv
  obtain ⟨hA, hT⟩ := rank3_reduction_inequalities v b hb hmin hB hC
  exact ⟨b, hb, hmin, hB, hC, hA, hT⟩










end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: Rank3GramSchmidt -/
section


/-!
Exact Gram--Schmidt decomposition of the actual projected norm in R^4. The
three scalar weights are A/V, T/A, delta^2/T, and the three shear coefficients
are B/A, E/A, C/T. The determinant-one specialization is the exact quadratic
expression consumed by Rank3Babai.
-/

namespace Math15.LonelyRunner.Covolume4

/-- The mixed analogue of gram3Sq_projection_identity. -/
theorem gram3Cross_projection_identity {R : Type*} [CommRing R]
    (v u w z : Vec4 R) :
    areaSq4 v u * projectedCrossGram v w z -
      projectedCrossGram v u w * projectedCrossGram v u z =
        dot4 v v * gram3Cross v u w z := by
  rw [gram3Cross_expansion]
  simp only [lagrange_area_identity, projectedCrossGram]
  ring

/-- A scalar completion using the four exact minor identities. The
intermediate polynomial equality avoids expanding ambient coordinates. -/
theorem rank3_scalar_gram_completion
    (V A B E D G F T S C delta X Y Z : ℝ)
    (hV : V ≠ 0) (hA : A ≠ 0) (hT : T ≠ 0)
    (hAD : A*D-B^2=V*T) (hAF : A*F-E^2=V*S)
    (hAG : A*G-B*E=V*C) (hTS : T*S-C^2=A*delta^2) :
    (A*X^2+2*B*X*Y+2*E*X*Z+D*Y^2+2*G*Y*Z+F*Z^2)/V =
      (A/V)*(X+(B/A)*Y+(E/A)*Z)^2 +
      (T/A)*(Y+(C/T)*Z)^2 + (delta^2/T)*Z^2 := by
  have hpoly :
      A*T*(A*X^2+2*B*X*Y+2*E*X*Z+D*Y^2+2*G*Y*Z+F*Z^2) =
        T*(A*X+B*Y+E*Z)^2+V*(T*Y+C*Z)^2+V*A*delta^2*Z^2 := by
    linear_combination T*Y^2*hAD + T*Z^2*hAF +
      (2*T*Y*Z)*hAG + V*Z^2*hTS
  calc
    (A*X^2+2*B*X*Y+2*E*X*Z+D*Y^2+2*G*Y*Z+F*Z^2)/V =
        (A*T*(A*X^2+2*B*X*Y+2*E*X*Z+D*Y^2+2*G*Y*Z+F*Z^2))/(V*A*T) := by
      field_simp [hV, hA, hT] <;> ring
    _ = (T*(A*X+B*Y+E*Z)^2+V*(T*Y+C*Z)^2+V*A*delta^2*Z^2)/(V*A*T) := by
      rw [hpoly]
    _ = (A/V)*(X+(B/A)*Y+(E/A)*Z)^2 +
        (T/A)*(Y+(C/T)*Z)^2 + (delta^2/T)*Z^2 := by
      field_simp [hV, hA, hT] <;> ring

/-- Expansion of the actual projected vector norm before completing
the three squares. This uses literal ambient vectors, not a Gram model. -/
theorem projected_rank3_norm_expansion (v u w z : Vec4 ℝ) (X Y Z : ℝ)
    (hV : dot4 v v ≠ 0) :
    dot4 (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i))
      (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i)) =
        (areaSq4 v u*X^2+2*projectedCrossGram v u w*X*Y+
          2*projectedCrossGram v u z*X*Z+areaSq4 v w*Y^2+
          2*projectedCrossGram v w z*Y*Z+areaSq4 v z*Z^2)/dot4 v v := by
  rw [perpendicularProjection4_normSq _ _ hV]
  congr 1
  simp only [lagrange_area_identity, projectedCrossGram, dot4]
  ring

/-- General exact decomposition, retaining the actual determinant square. -/
theorem projected_rank3_quadratic_decomposition_general
    (v u w z : Vec4 ℝ) (X Y Z : ℝ)
    (hV : dot4 v v ≠ 0) (hA : areaSq4 v u ≠ 0)
    (hT : gram3Sq v u w ≠ 0) :
    dot4 (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i))
      (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i)) =
        (areaSq4 v u/dot4 v v)*
          (X+(projectedCrossGram v u w/areaSq4 v u)*Y+
            (projectedCrossGram v u z/areaSq4 v u)*Z)^2 +
        (gram3Sq v u w/areaSq4 v u)*
          (Y+(gram3Cross v u w z/gram3Sq v u w)*Z)^2 +
        ((det4 v u w z)^2/gram3Sq v u w)*Z^2 := by
  rw [projected_rank3_norm_expansion v u w z X Y Z hV]
  exact rank3_scalar_gram_completion
    (dot4 v v) (areaSq4 v u) (projectedCrossGram v u w)
    (projectedCrossGram v u z) (areaSq4 v w) (projectedCrossGram v w z)
    (areaSq4 v z) (gram3Sq v u w) (gram3Sq v u z)
    (gram3Cross v u w z) (det4 v u w z) X Y Z hV hA hT
    (gram3Sq_projection_identity v u w) (gram3Sq_projection_identity v u z)
    (gram3Cross_projection_identity v u w z) (gram3_pair_determinant v u w z)

/-- Exact native identity requested by the rank-three Babai consumer.
Its hypotheses concern only the displayed actual vectors and determinants. -/
theorem projected_rank3_quadratic_decomposition
    (v u w z : Vec4 ℝ) (X Y Z : ℝ)
    (hV : 0 < dot4 v v) (hA : 0 < areaSq4 v u)
    (hT : 0 < gram3Sq v u w) (hdet : (det4 v u w z)^2=1) :
    dot4 (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i))
      (perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i)) =
        (areaSq4 v u/dot4 v v)*
          (X+(projectedCrossGram v u w/areaSq4 v u)*Y+
            (projectedCrossGram v u z/areaSq4 v u)*Z)^2 +
        (gram3Sq v u w/areaSq4 v u)*
          (Y+(gram3Cross v u w z/gram3Sq v u w)*Z)^2 +
        (1/gram3Sq v u w)*Z^2 := by
  have h := projected_rank3_quadratic_decomposition_general v u w z X Y Z
    (ne_of_gt hV) (ne_of_gt hA) (ne_of_gt hT)
  simpa only [hdet] using h







end Math15.LonelyRunner.Covolume4
end 

/- Section: Rank3Babai -/
section



/-!
Actual nearest-plane rounding in three Gram--Schmidt coordinates.

First round Z, then Y + mu32*(Z-k3), then X + mu21*(Y-k2) + mu31*(Z-k3). The
resulting three orthogonal errors all have absolute value at most 1/2. This
supplies actual common integer coefficients for every real coordinate point,
without assuming a covering-radius theorem or any bounds on the shear
coefficients.
-/

noncomputable section
namespace Math15.LonelyRunner

def rank3BabaiError (H1 H2 H3 mu21 mu31 mu32 X Y Z : ℝ)
    (k1 k2 k3 : ℤ) : ℝ :=
  H1 * (X-(k1 : ℝ)+mu21*(Y-(k2 : ℝ))+mu31*(Z-(k3 : ℝ)))^2 +
  H2 * (Y-(k2 : ℝ)+mu32*(Z-(k3 : ℝ)))^2 +
  H3 * (Z-(k3 : ℝ))^2

theorem rank3_round_error_sq (x : ℝ) :
    (x-(round x : ℝ))^2 ≤ (1/4 : ℝ) := by
  have hb := abs_le.mp (abs_sub_round x)
  have hp : (0 : ℝ) ≤ (1/2+(x-(round x : ℝ))) *
      (1/2-(x-(round x : ℝ))) := by
    apply mul_nonneg <;> linarith
  nlinarith

/-- Nonnegative squared lengths suffice for the basic weighted estimate.
The three integers are produced by successive nearest-integer rounding. -/
theorem exists_rank3_babai_nearest
    (H1 H2 H3 mu21 mu31 mu32 X Y Z : ℝ)
    (hH1 : 0 ≤ H1) (hH2 : 0 ≤ H2) (hH3 : 0 ≤ H3) :
    ∃ k1 k2 k3 : ℤ,
      rank3BabaiError H1 H2 H3 mu21 mu31 mu32 X Y Z k1 k2 k3 ≤
        (H1+H2+H3)/4 := by
  let k3 : ℤ := round Z
  let Ynext : ℝ := Y+mu32*(Z-(k3 : ℝ))
  let k2 : ℤ := round Ynext
  let Xnext : ℝ := X+mu21*(Y-(k2 : ℝ))+mu31*(Z-(k3 : ℝ))
  let k1 : ℤ := round Xnext
  have h3 : (Z-(k3 : ℝ))^2 ≤ (1/4 : ℝ) := rank3_round_error_sq Z
  have h2 : (Y-(k2 : ℝ)+mu32*(Z-(k3 : ℝ)))^2 ≤ (1/4 : ℝ) := by
    have he : Y-(k2 : ℝ)+mu32*(Z-(k3 : ℝ)) = Ynext-(k2 : ℝ) := by
      dsimp [Ynext]
      ring
    rw [he]
    exact rank3_round_error_sq Ynext
  have h1 : (X-(k1 : ℝ)+mu21*(Y-(k2 : ℝ))+mu31*(Z-(k3 : ℝ)))^2 ≤
      (1/4 : ℝ) := by
    have he : X-(k1 : ℝ)+mu21*(Y-(k2 : ℝ))+mu31*(Z-(k3 : ℝ)) =
        Xnext-(k1 : ℝ) := by
      dsimp [Xnext]
      ring
    rw [he]
    exact rank3_round_error_sq Xnext
  refine ⟨k1, k2, k3, ?_⟩
  calc
    rank3BabaiError H1 H2 H3 mu21 mu31 mu32 X Y Z k1 k2 k3 ≤
        H1*(1/4)+H2*(1/4)+H3*(1/4) :=
      add_le_add (add_le_add (mul_le_mul_of_nonneg_left h1 hH1)
        (mul_le_mul_of_nonneg_left h2 hH2)) (mul_le_mul_of_nonneg_left h3 hH3)
    _ = (H1+H2+H3)/4 := by ring

/-- The two adjacent reduction inequalities give the stated constant.
No additional positivity assumption is used in this scalar implication. -/
theorem rank3_reduced_sum_bound (H1 H2 H3 : ℝ)
    (h12 : 3*H1 ≤ 4*H2) (h23 : 3*H2 ≤ 4*H3) :
    (H1+H2+H3)/4 ≤ (37/36 : ℝ)*H3 := by
  linarith

theorem exists_rank3_reduced_babai_nearest
    (H1 H2 H3 mu21 mu31 mu32 X Y Z : ℝ)
    (hH1 : 0 ≤ H1) (hH2 : 0 ≤ H2) (hH3 : 0 ≤ H3)
    (h12 : 3*H1 ≤ 4*H2) (h23 : 3*H2 ≤ 4*H3) :
    ∃ k1 k2 k3 : ℤ,
      rank3BabaiError H1 H2 H3 mu21 mu31 mu32 X Y Z k1 k2 k3 ≤
        (37/36 : ℝ)*H3 := by
  obtain ⟨k1, k2, k3, hk⟩ :=
    exists_rank3_babai_nearest H1 H2 H3 mu21 mu31 mu32 X Y Z hH1 hH2 hH3
  exact ⟨k1, k2, k3, hk.trans (rank3_reduced_sum_bound H1 H2 H3 h12 h23)⟩

/-- A single point missing EVERY integer coefficient triple strictly
forces this upper bound on its squared miss distance. -/
theorem rank3_babai_bound_of_strict_miss
    (H1 H2 H3 mu21 mu31 mu32 X Y Z eta : ℝ)
    (hH1 : 0 ≤ H1) (hH2 : 0 ≤ H2) (hH3 : 0 ≤ H3)
    (h12 : 3*H1 ≤ 4*H2) (h23 : 3*H2 ≤ 4*H3)
    (hmiss : ∀ k1 k2 k3 : ℤ,
      eta^2 < rank3BabaiError H1 H2 H3 mu21 mu31 mu32 X Y Z k1 k2 k3) :
    eta^2 < (37/36 : ℝ)*H3 := by
  obtain ⟨k1, k2, k3, hk⟩ := exists_rank3_reduced_babai_nearest
    H1 H2 H3 mu21 mu31 mu32 X Y Z hH1 hH2 hH3 h12 h23
  exact (hmiss k1 k2 k3).trans_le hk







end Math15.LonelyRunner
end 
end 

/- Section: Rank3NativeSpan -/
section



/-!
Full real spanning from the actual unimodular ambient basis, followed by
literal orthogonal projection.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review.QuotientLattice4

theorem ambient_basis_real_span4 (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ))
    (x : Vec4 ℝ) :
    ∃ a X Y Z : ℝ, x=fun i => a*(b 0 i : ℝ)+X*(b 1 i : ℝ)+
      Y*(b 2 i : ℝ)+Z*(b 3 i : ℝ) := by
  let v := realVec4 (b 0)
  let u := realVec4 (b 1)
  let w := realVec4 (b 2)
  let z := realVec4 (b 3)
  have hd : (det4 v u w z)^2=1 := by
    have he : det4 v u w z=((det4 (b 0) (b 1) (b 2) (b 3) : ℤ) : ℝ) := by
      simp [v,u,w,z,det4,dot4,cross4,det3,realVec4]
    rw [he]
    exact_mod_cast det4_basis_sq_one b
  refine ⟨dot4 (normalizedDualRows4 v u w z 0) x,
    dot4 (normalizedDualRows4 v u w z 1) x,
    dot4 (normalizedDualRows4 v u w z 2) x,
    dot4 (normalizedDualRows4 v u w z 3) x, ?_⟩
  funext i
  exact normalizedDualRows4_primal_reconstruct v u w z x hd i

theorem perpendicularProjection4_add_line (v r : Vec4 ℝ) (a : ℝ)
    (hv : dot4 v v≠0) :
    perpendicularProjection4 v (fun i => a*v i+r i)=perpendicularProjection4 v r := by
  have hd : dot4 v (fun i => a*v i+r i)=a*dot4 v v+dot4 v r := by
    simp only [dot4]
    ring
  funext i
  change a*v i+r i-(dot4 v (fun j => a*v j+r j)/dot4 v v)*v i=
    r i-(dot4 v r/dot4 v v)*v i
  rw [hd]
  field_simp [hv]
  ring

theorem ambient_basis_projected_real_span3 (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ))
    (x : Vec4 ℝ) :
    ∃ X Y Z : ℝ, perpendicularProjection4 (realVec4 (b 0)) x=
      perpendicularProjection4 (realVec4 (b 0))
        (fun i => X*(b 1 i : ℝ)+Y*(b 2 i : ℝ)+Z*(b 3 i : ℝ)) := by
  obtain ⟨a,X,Y,Z,hx⟩ := ambient_basis_real_span4 b x
  have hV : 0<dot4 (realVec4 (b 0)) (realVec4 (b 0)) := by
    rw [realVec4_dot4]
    exact_mod_cast integer_dot_self_positive (b 0) (b.linearIndependent.ne_zero 0)
  refine ⟨X,Y,Z,?_⟩
  rw [hx]
  have he : (fun i => a*(b 0 i : ℝ)+X*(b 1 i : ℝ)+
      Y*(b 2 i : ℝ)+Z*(b 3 i : ℝ)) =
      (fun i => a*realVec4 (b 0) i+
        (X*(b 1 i : ℝ)+Y*(b 2 i : ℝ)+Z*(b 3 i : ℝ))) := by
    funext i
    simp only [realVec4]
    ring
  rw [he]
  exact perpendicularProjection4_add_line _ _ a (ne_of_gt hV)

theorem projected_three_residual (v u w z : Vec4 ℝ) (X Y Z a b c : ℝ) :
    perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*z i)-
      perpendicularProjection4 v (fun i => a*u i+b*w i+c*z i)=
    perpendicularProjection4 v (fun i => (X-a)*u i+(Y-b)*w i+(Z-c)*z i) := by
  funext i
  simp [perpendicularProjection4,dot4]
  ring






end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: Rank3NativeCover -/
section





/-!
Actual projected covering from an actual ambient integer basis. The two
integer reduction inequalities supply the Gram--Schmidt length ratios, real
spanning supplies the coordinates of any point, and Babai rounding supplies
one common integer vector approximating that point.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

/-- Integer minor reduction becomes the adjacent orthogonal-length
inequalities after division by the actual positive Gram determinants. -/
theorem rank3_gram_ratio_conditions (V A T : ℝ)
    (hV : 0 < V) (hA : 0 < A) (hT : 0 < T)
    (h12 : 3*A^2 ≤ 4*V*T) (h23 : 3*T^2 ≤ 4*A) :
    3*(A/V) ≤ 4*(T/A) ∧ 3*(T/A) ≤ 4*(1/T) := by
  constructor
  · simp only [← mul_div_assoc]
    apply (div_le_div_iff₀ hV hA).2
    nlinarith
  · simp only [← mul_div_assoc, mul_one]
    apply (div_le_div_iff₀ hA hT).2
    nlinarith

/-- Every real point has an actual integer approximant in the projected
lattice of this basis. No real-span or coefficient-miss premise is assumed. -/
theorem ambient_basis_reduced_projection_cover
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ))
    (h12 : 3*(basisD1 b)^2 ≤ 4*dot4 (b 0) (b 0)*basisD2 b)
    (h23 : 3*(basisD2 b)^2 ≤ 4*basisD1 b) (x : Vec4 ℝ) :
    ∃ z : Vec4 ℤ,
      dot4 (perpendicularProjection4 (realVec4 (b 0)) x-
          perpendicularProjection4 (realVec4 (b 0)) (realVec4 z))
        (perpendicularProjection4 (realVec4 (b 0)) x-
          perpendicularProjection4 (realVec4 (b 0)) (realVec4 z)) ≤
        37/(36*(basisD2 b : ℝ)) := by
  let v := realVec4 (b 0)
  let u := realVec4 (b 1)
  let w := realVec4 (b 2)
  let q := realVec4 (b 3)
  let V := dot4 v v
  let A := areaSq4 v u
  let T := gram3Sq v u w
  let B := projectedCrossGram v u w
  let E := projectedCrossGram v u q
  let C := gram3Cross v u w q
  have hVcast : V = ((dot4 (b 0) (b 0) : ℤ) : ℝ) :=
    realVec4_dot4 (b 0) (b 0)
  have hAcast : A = (basisD1 b : ℝ) :=
    Math15.Source05Review.areaSq4_realCast (b 0) (b 1)
  have hTcast : T = (basisD2 b : ℝ) :=
    gram3Sq_realVec4 (b 0) (b 1) (b 2)
  have hV : 0 < V := by
    rw [hVcast]
    exact_mod_cast integer_dot_self_positive (b 0) (b.linearIndependent.ne_zero 0)
  have hA : 0 < A := by
    rw [hAcast]
    exact_mod_cast basisD1_positive b
  have hT : 0 < T := by
    rw [hTcast]
    exact_mod_cast basisD2_positive b
  have h12R : 3*A^2 ≤ 4*V*T := by
    rw [hAcast, hVcast, hTcast]
    exact_mod_cast h12
  have h23R : 3*T^2 ≤ 4*A := by
    rw [hTcast, hAcast]
    exact_mod_cast h23
  obtain ⟨hr12, hr23⟩ := rank3_gram_ratio_conditions V A T hV hA hT h12R h23R
  have hdet : (det4 v u w q)^2 = 1 := by
    have he : det4 v u w q =
        ((det4 (b 0) (b 1) (b 2) (b 3) : ℤ) : ℝ) := by
      simp [v, u, w, q, det4, dot4, cross4, det3, realVec4]
    rw [he]
    exact_mod_cast det4_basis_sq_one b
  obtain ⟨X, Y, Z, hx⟩ := ambient_basis_projected_real_span3 b x
  have hx' : perpendicularProjection4 v x =
      perpendicularProjection4 v (fun i => X*u i+Y*w i+Z*q i) := hx
  obtain ⟨k1, k2, k3, hk⟩ := exists_rank3_reduced_babai_nearest
    (A/V) (T/A) (1/T) (B/A) (E/A) (C/T) X Y Z
    (le_of_lt (div_pos hA hV)) (le_of_lt (div_pos hT hA))
    (le_of_lt (one_div_pos.mpr hT)) hr12 hr23
  let z : Vec4 ℤ := fun i => k1*b 1 i+k2*b 2 i+k3*b 3 i
  have hz : realVec4 z =
      (fun i => (k1 : ℝ)*u i+(k2 : ℝ)*w i+(k3 : ℝ)*q i) := by
    funext i
    simp [z, realVec4, u, w, q]
  have hres : perpendicularProjection4 v x-perpendicularProjection4 v (realVec4 z) =
      perpendicularProjection4 v
        (fun i => (X-(k1 : ℝ))*u i+(Y-(k2 : ℝ))*w i+(Z-(k3 : ℝ))*q i) := by
    rw [hx', hz]
    exact projected_three_residual v u w q X Y Z (k1 : ℝ) (k2 : ℝ) (k3 : ℝ)
  have herr :
      dot4 (perpendicularProjection4 v x-perpendicularProjection4 v (realVec4 z))
        (perpendicularProjection4 v x-perpendicularProjection4 v (realVec4 z)) =
      rank3BabaiError (A/V) (T/A) (1/T) (B/A) (E/A) (C/T) X Y Z k1 k2 k3 := by
    rw [hres]
    exact projected_rank3_quadratic_decomposition v u w q
      (X-(k1 : ℝ)) (Y-(k2 : ℝ)) (Z-(k3 : ℝ)) hV hA hT hdet
  refine ⟨z, ?_⟩
  change dot4 (perpendicularProjection4 v x-perpendicularProjection4 v (realVec4 z))
    (perpendicularProjection4 v x-perpendicularProjection4 v (realVec4 z)) ≤ _
  rw [herr]
  calc
    rank3BabaiError (A/V) (T/A) (1/T) (B/A) (E/A) (C/T) X Y Z k1 k2 k3 ≤
        (37/36 : ℝ)*(1/T) := hk
    _ = 37/(36*T) := by field_simp [ne_of_gt hT] <;> ring
    _ = 37/(36*(basisD2 b : ℝ)) := by rw [hTcast]




end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: Rank3Cofactor -/
section



/-!
The rank-three prefix of an actual ambient integer basis gives a primitive
integer normal. Unimodularity is derived from the basis; it is not an extra
dual-lattice or finite-index premise.
-/

namespace Math15.Source05Review

/-- The natural gcd of the integer coordinates divides every integer
linear combination of those coordinates. -/
theorem coordinate_gcd_dvd_intDot {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m z : ι → ℤ) :
    ((Finset.univ.gcd (fun i => (m i).natAbs) : ℕ) : ℤ) ∣ intDot m z := by
  unfold intDot
  apply Finset.dvd_sum
  intro i hi
  apply dvd_mul_of_dvd_left
  exact Int.natCast_dvd.mpr (Finset.gcd_dvd (f := fun i => (m i).natAbs) hi)

/-- Reusable converse to the existing finite-coordinate integer Bézout
theorem, with exactly the same ambient gcd convention. -/
theorem primitive_of_integer_bezout {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m z : ι → ℤ) (hz : intDot m z = 1) :
    Finset.univ.gcd (fun i => (m i).natAbs) = 1 := by
  have hd := coordinate_gcd_dvd_intDot m z
  rw [hz] at hd
  apply Nat.dvd_one.mp
  simpa using Int.natCast_dvd.mp hd




end Math15.Source05Review

namespace Math15.LonelyRunner.Covolume4
open Math15.Source05Review

noncomputable def basisCofactorNormal (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) : Vec4 ℤ :=
  cross4 (b 0) (b 1) (b 2)

theorem basisCofactorNormal_pairings
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    dot4 (basisCofactorNormal b) (b 0) = 0 ∧
      dot4 (basisCofactorNormal b) (b 1) = 0 ∧
      dot4 (basisCofactorNormal b) (b 2) = 0 := by
  repeat' constructor
  all_goals simp [basisCofactorNormal, dot4, cross4, det3]
  all_goals ring

theorem basisCofactorNormal_first_intDot_zero
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    intDot (basisCofactorNormal b) (b 0) = 0 := by
  simpa only [intDot, Fin.sum_univ_four, dot4] using
    (basisCofactorNormal_pairings b).1

/-- The oriented last basis vector is a literal integer Bézout witness
for the cofactor normal. Its dot product is the squared basis determinant. -/
theorem basisCofactorNormal_bezout
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    intDot (basisCofactorNormal b)
      (fun i => det4 (b 0) (b 1) (b 2) (b 3) * b 3 i) = 1 := by
  calc
    intDot (basisCofactorNormal b)
        (fun i => det4 (b 0) (b 1) (b 2) (b 3) * b 3 i) =
        (det4 (b 0) (b 1) (b 2) (b 3))^2 := by
      simp only [intDot, Fin.sum_univ_four, dot4, det4, basisCofactorNormal]
      ring
    _ = 1 := det4_basis_sq_one b

theorem basisCofactorNormal_primitive
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    Finset.univ.gcd (fun i => (basisCofactorNormal b i).natAbs) = 1 := by
  exact primitive_of_integer_bezout (basisCofactorNormal b)
    (fun i => det4 (b 0) (b 1) (b 2) (b 3) * b 3 i)
    (basisCofactorNormal_bezout b)

theorem basisCofactorNormal_normSq
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    dot4 (basisCofactorNormal b) (basisCofactorNormal b) = basisD2 b := rfl

/-- The exact native relation package supplied by this actual basis.
Its length is the same prefix Gram quantity minimized in the rank-three
argument, and its primitivity has no separate index hypothesis. -/
theorem basisCofactorNormal_relation_package
    (b : Module.Basis (Fin 4) ℤ (Vec4 ℤ)) :
    Finset.univ.gcd (fun i => (basisCofactorNormal b i).natAbs) = 1 ∧
      intDot (basisCofactorNormal b) (b 0) = 0 ∧
      dot4 (basisCofactorNormal b) (basisCofactorNormal b) = basisD2 b := by
  exact ⟨basisCofactorNormal_primitive b,
    basisCofactorNormal_first_intDot_zero b, basisCofactorNormal_normSq b⟩








end Math15.LonelyRunner.Covolume4
end 

/- Section: Rank3FallbackConstants -/
section


/-!
Exact arithmetic consumers for the rank-three fallback. They assert no
short-relation existence, no torus gap, and no low-loneliness classification.
-/

namespace Math15.LonelyRunner.Covolume4

theorem integer_below_148_over_nine_le_sixteen
    (T : ℤ) (hT : (T : ℝ) < 148 / 9) : T ≤ 16 := by
  by_contra hn
  have hlarge : 17 ≤ T := by omega
  have hlargeR : (17 : ℝ) ≤ (T : ℝ) := by exact_mod_cast hlarge
  linarith

