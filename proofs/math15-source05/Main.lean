/- Section: BitMaskSoundness -/
section



/-!
Exact natural-number bit masks for compressed rational-time certificates.

The bit at position v is present precisely when speed v occurs in the
represented list. Intersection equations therefore give literal coverage, and
a union of computed time masks supplies an actual listed time for each covered
fourth speed. The three fixed speeds are checked at every listed time, so that
the selected time is common to all four speeds.

The speed masks below are defined from the actual modular inequalities; there
is no assumed correctness premise for externally supplied masks. This source
performs no finite census or native evaluation.
-/

namespace Math15.LonelyRunner

/-- A list represents a set of bit positions; repeated entries are harmless. -/
def listBits : List ℕ → ℕ
  | [] => 0
  | v :: vs => (2 ^ v) ||| listBits vs

/-- Union of already constructed masks. -/
def maskUnion : List ℕ → ℕ
  | [] => 0
  | M :: Ms => M ||| maskUnion Ms

theorem listBits_testBit_iff (vs : List ℕ) (i : ℕ) :
    Nat.testBit (listBits vs) i = true ↔ i ∈ vs := by
  induction vs with
  | nil => simp [listBits]
  | cons v vs ih =>
      simp only [listBits, Nat.testBit_or, Nat.testBit_two_pow,
        Bool.or_eq_true, decide_eq_true_eq, ih, List.mem_cons]
      constructor
      · rintro (h | h)
        · exact Or.inl h.symm
        · exact Or.inr h
      · rintro (h | h)
        · exact Or.inl h.symm
        · exact Or.inr h

theorem listBits_append (vs ws : List ℕ) :
    listBits (vs ++ ws) = listBits vs ||| listBits ws := by
  induction vs with
  | nil => simp [listBits]
  | cons v vs ih =>
      simp only [List.cons_append, listBits, ih, Nat.or_assoc]

theorem mask_intersection_testBit_iff (A B i : ℕ) :
    Nat.testBit (A &&& B) i = true ↔
      Nat.testBit A i = true ∧ Nat.testBit B i = true := by
  rw [Nat.testBit_and, Bool.and_eq_true]

theorem mask_union_testBit_iff (A B i : ℕ) :
    Nat.testBit (A ||| B) i = true ↔
      Nat.testBit A i = true ∨ Nat.testBit B i = true := by
  rw [Nat.testBit_or, Bool.or_eq_true]

/-- An intersection equation is exactly containment of all set bits. -/
theorem mask_coverage_iff (A B : ℕ) :
    A &&& B = A ↔
      ∀ i : ℕ, Nat.testBit A i = true → Nat.testBit B i = true := by
  constructor
  · intro h i hi
    have hb := congrArg (fun M : ℕ => Nat.testBit M i) h
    change Nat.testBit (A &&& B) i = Nat.testBit A i at hb
    rw [Nat.testBit_and, hi] at hb
    simpa only [Bool.true_and] using hb
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_and]
    cases hi : Nat.testBit A i with
    | false => simp only [Bool.false_and]
    | true => simp only [Bool.true_and, h i hi]

theorem listBits_coverage_iff (vs ws : List ℕ) :
    listBits vs &&& listBits ws = listBits vs ↔
      ∀ i ∈ vs, i ∈ ws := by
  rw [mask_coverage_iff]
  simp only [listBits_testBit_iff]

theorem maskUnion_testBit_iff (Ms : List ℕ) (i : ℕ) :
    Nat.testBit (maskUnion Ms) i = true ↔
      ∃ M ∈ Ms, Nat.testBit M i = true := by
  induction Ms with
  | nil => simp [maskUnion]
  | cons M Ms ih =>
      simp [maskUnion, Nat.testBit_or, Bool.or_eq_true, ih]

theorem maskUnion_map_testBit_iff {α : Type*}
    (f : α → ℕ) (xs : List α) (i : ℕ) :
    Nat.testBit (maskUnion (xs.map f)) i = true ↔
      ∃ x ∈ xs, Nat.testBit (f x) i = true := by
  rw [maskUnion_testBit_iff]
  constructor
  · rintro ⟨M, hM, hi⟩
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hM
    exact ⟨x, hx, hi⟩
  · rintro ⟨x, hx, hi⟩
    exact ⟨f x, List.mem_map_of_mem hx, hi⟩

/-- The exact integer inequality for a quarter-distance witness at m/n. -/
def quarterResidue (v m n : ℕ) : Prop :=
  n ≤ 4 * min ((v * m) % n) (n - (v * m) % n)

/-- Computable quarter decision, with no registered instance declaration. -/
def quarterResidueDecidable (v m n : ℕ) : Decidable (quarterResidue v m n) :=
  inferInstanceAs (Decidable
    (n≤4*min ((v*m)%n) (n-(v*m)%n)))

/-- Explicit decision for all four literal Nat inequalities. -/
def tripleQuarterDecidable (a b c m n : ℕ) :
    Decidable (0<n ∧ quarterResidue a m n ∧
      quarterResidue b m n ∧ quarterResidue c m n) :=
  inferInstanceAs (Decidable
    (0<n ∧ n≤4*min ((a*m)%n) (n-(a*m)%n) ∧
      n≤4*min ((b*m)%n) (n-(b*m)%n) ∧
      n≤4*min ((c*m)%n) (n-(c*m)%n)))

/-- Bit v is computed from the actual quarter inequality, for v < bound. -/
def rationalSpeedMask (bound m n : ℕ) : ℕ :=
  listBits ((List.range bound).filter fun v =>
    @decide (quarterResidue v m n) (quarterResidueDecidable v m n))

theorem rationalSpeedMask_testBit_iff (bound m n v : ℕ) :
    Nat.testBit (rationalSpeedMask bound m n) v = true ↔
      v < bound ∧ quarterResidue v m n := by
  simp only [rationalSpeedMask, listBits_testBit_iff, List.mem_filter,
    List.mem_range, decide_eq_true_eq]

/-- The union uses the masks recomputed from the listed rational times. -/
def rationalTimesMask (bound : ℕ) (times : List (ℕ × ℕ)) : ℕ :=
  maskUnion (times.map fun t => rationalSpeedMask bound t.1 t.2)

/-- Closed table entries check the three fixed speeds at every listed time. -/
def tripleTimesQuarterBool (a b c : ℕ) (times : List (ℕ × ℕ)) : Bool :=
  times.all fun t =>
    @decide (0<t.2 ∧ quarterResidue a t.1 t.2 ∧
      quarterResidue b t.1 t.2 ∧ quarterResidue c t.1 t.2)
      (tripleQuarterDecidable a b c t.1 t.2)

theorem rationalTimesMask_testBit_iff (bound v : ℕ)
    (times : List (ℕ × ℕ)) :
    Nat.testBit (rationalTimesMask bound times) v = true ↔
      ∃ t ∈ times, v < bound ∧ quarterResidue v t.1 t.2 := by
  simp only [rationalTimesMask, maskUnion_map_testBit_iff,
    rationalSpeedMask_testBit_iff]

/-- Coverage supplies an actual selected time, rather than independent
times for the three fixed speeds and the fourth speed. -/
theorem rationalTimesMask_coverage_witness {A bound v : ℕ}
    {times : List (ℕ × ℕ)}
    (hcover : A &&& rationalTimesMask bound times = A)
    (hv : Nat.testBit A v = true) :
    ∃ t ∈ times, v < bound ∧ quarterResidue v t.1 t.2 := by
  apply (rationalTimesMask_testBit_iff bound v times).mp
  exact (mask_coverage_iff A (rationalTimesMask bound times)).mp hcover v hv

end Math15.LonelyRunner

noncomputable section
namespace Math15.LonelyRunner

/-- Positive denominator is essential: the zero-denominator mask is not
used to infer a distance inequality. -/
theorem distance_ge_quarter_of_quarterResidue {v m n : ℕ}
    (hn : 0 < n) (hq : quarterResidue v m n) :
    (1 / 4 : ℝ) ≤ distance (v • (((m : ℝ) / (n : ℝ)) : Time)) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hN : n ≤ 4 * min ((v * m) % n) (n - (v * m) % n) := hq
  have hR : (n : ℝ) ≤ 4 * (min ((v * m) % n) (n - (v * m) % n) : ℕ) := by
    exact_mod_cast hN
  rw [distance_at_rational]
  apply (le_div_iff₀ hnR).2
  nlinarith

theorem rationalSpeedMask_distance_sound {bound v m n : ℕ}
    (hn : 0 < n)
    (hbit : Nat.testBit (rationalSpeedMask bound m n) v = true) :
    (1 / 4 : ℝ) ≤ distance (v • (((m : ℝ) / (n : ℝ)) : Time)) := by
  exact distance_ge_quarter_of_quarterResidue hn
    ((rationalSpeedMask_testBit_iff bound m n v).mp hbit).2

theorem rationalTimesMask_distance_witness {A bound v : ℕ}
    {times : List (ℕ × ℕ)}
    (hcover : A &&& rationalTimesMask bound times = A)
    (hv : Nat.testBit A v = true)
    (hn : ∀ t ∈ times, 0 < t.2) :
    ∃ t ∈ times,
      (1 / 4 : ℝ) ≤ distance (v • (((t.1 : ℝ) / (t.2 : ℝ)) : Time)) := by
  obtain ⟨t, ht, hlt, hq⟩ := rationalTimesMask_coverage_witness hcover hv
  exact ⟨t, ht, distance_ge_quarter_of_quarterResidue (hn t ht) hq⟩

/-- A covered fourth speed and the three fixed speeds share one actual
rational time.  All modular facts are literal hypotheses for the listed
times, while fourth-speed membership is recovered from computed masks. -/
theorem ML_ge_quarter_of_compressed_time_cover {a b c d A bound : ℕ}
    {times : List (ℕ × ℕ)}
    (hcover : A &&& rationalTimesMask bound times = A)
    (hd : Nat.testBit A d = true)
    (htimes : ∀ t ∈ times, 0 < t.2 ∧
      quarterResidue a t.1 t.2 ∧ quarterResidue b t.1 t.2 ∧
      quarterResidue c t.1 t.2) :
    (1 / 4 : ℝ) ≤ ML ({a, b, c, d} : Finset ℕ) := by
  obtain ⟨t, ht, hlt, hdq⟩ := rationalTimesMask_coverage_witness hcover hd
  obtain ⟨hn, haq, hbq, hcq⟩ := htimes t ht
  apply ML_lower_of_witness ⟨a, by simp⟩
    (((t.1 : ℝ) / (t.2 : ℝ)) : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · exact distance_ge_quarter_of_quarterResidue hn haq
  · exact distance_ge_quarter_of_quarterResidue hn hbq
  · exact distance_ge_quarter_of_quarterResidue hn hcq
  · exact distance_ge_quarter_of_quarterResidue hn hdq

/-- Both table obligations can be discharged by closed kernel arithmetic:
the mask intersection equation and the fixed-triple Boolean check. -/
theorem ML_ge_quarter_of_compressed_time_cover_bool {a b c d A bound : ℕ}
    {times : List (ℕ × ℕ)}
    (hcover : A &&& rationalTimesMask bound times = A)
    (hd : Nat.testBit A d = true)
    (htimes : tripleTimesQuarterBool a b c times = true) :
    (1 / 4 : ℝ) ≤ ML ({a, b, c, d} : Finset ℕ) := by
  apply ML_ge_quarter_of_compressed_time_cover hcover hd
  simpa only [tripleTimesQuarterBool, List.all_eq_true, decide_eq_true_eq]
    using htimes




















end Math15.LonelyRunner
end 
end 

/- Section: FiniteResidueCheck -/
section


/-!
Kernel-computable finite certificate search.

Each accepted eligible tuple either belongs to an established exceptional
branch or has one actual common rational quarter witness. The soundness and
coverage lemmas below transfer these checks to the spectrum conclusion.
-/

namespace Math15.LonelyRunner

def rationalQuarterBool (a b c d m n : ℕ) : Bool :=
  decide (0 < n) && ([a,b,c,d].all fun v =>
    decide (n ≤ 4 * min ((v*m)%n) (n-(v*m)%n)))

def positiveU2Bool (a b c d : ℕ) : Bool :=
  let V := [a,b,c,d]
  V.any fun A => V.any fun B =>
    decide (A ≠ B) && V.contains (A+B) && V.contains (A+2*B)

def finiteKnownFamilyBool (a b c d : ℕ) : Bool :=
  let V := [a,b,c,d]
  (V.contains 1 && V.contains 2) ||
    (V.contains 2 && V.contains 4) || positiveU2Bool a b c d ||
    decide (a=1 ∧ b=3 ∧ c=4 ∧ d=14)

def finiteQuartetCertificateBool (a b c d : ℕ) : Bool :=
  rationalQuarterBool a b c d 1 4 || finiteKnownFamilyBool a b c d ||
    ([a+b,a+c,a+d,b+c,b+d,c+d].any fun n =>
      (List.range (n/2+1)).any fun m => rationalQuarterBool a b c d m n)

def finitePairGcdBool (a b c d : ℕ) : Bool :=
  decide (Nat.gcd a b ≤ 2 ∧ Nat.gcd a c ≤ 2 ∧ Nat.gcd b c ≤ 2 ∧
    Nat.gcd a d ≤ 2 ∧ Nat.gcd b d ≤ 2 ∧ Nat.gcd c d ≤ 2 ∧
    Nat.gcd (Nat.gcd a b) (Nat.gcd c d) = 1)

def finiteResidueCensusBool (bound : ℕ) : Bool :=
  (List.range' 1 ((bound-6)/4)).all fun a =>
    (List.range' (a+1) (((bound-a-3)/3+1)-(a+1))).all fun b =>
      (List.range' (b+1) (((bound-a-b-1)/2+1)-(b+1))).all fun c =>
        if Nat.gcd a b > 2 ∨ Nat.gcd a c > 2 ∨ Nat.gcd b c > 2 then true
        else (List.range' (c+1) ((bound-a-b-c+1)-(c+1))).all fun d =>
          if finitePairGcdBool a b c d then finiteQuartetCertificateBool a b c d
          else true














end Math15.LonelyRunner
end 

/- Section: CriticalTime -/
section


/-!
# Opposing active speeds at a strict sub-half maximum

Paper argument: choose a real lift x of an attained maximum M and write
z_v=v*x-round(v*x). Then the circle distance is |z_v|. If there is no negative
active residual -M, every active residual equals M. Give each active speed the
positive perturbation bound (1/2-M)/(2v), and each inactive speed the bound
(distance-M)/(2v). Half the finite infimum of these bounds is positive. At
that perturbation, active distances increase by v*epsilon and remain below one
half. Inactive distances stay above M by the quotient-norm triangle
inequality. This contradicts maximality. Reflecting x and the chosen integer
representatives proves that a positive active residual also exists. The two
active equations add to (u+v)*x=j_u+j_v, and M>0 makes u and v distinct.

The grid formulas and spectrum assembly are treated in later sections.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem critical_distance_center (v : ℕ) (x : ℝ) :
    distance (v • (x : Time)) =
      |(v : ℝ) * x - (round ((v : ℝ) * x) : ℝ)| := by
  unfold distance
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  simpa only [inv_one, one_mul, mul_one] using
    (AddCircle.norm_eq (1 : ℝ) (x := (v : ℝ) * x))

theorem critical_distance_eq_abs_int {y : ℝ} (j : ℤ)
    (hb : |y - (j : ℝ)| ≤ (1 / 2 : ℝ)) :
    distance (y : Time) = |y - (j : ℝ)| := by
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  have hcoe : ((y - (j : ℝ) : ℝ) : Time) = (y : Time) := by
    rw [AddCircle.coe_sub, hz, sub_zero]
  unfold distance
  rw [← hcoe]
  exact (AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
    (by simpa only [abs_one] using hb)

/-- Moving real time by a nonnegative delta loses at most v*delta in distance. -/
theorem critical_distance_shift_lower (v : ℕ) (x δ : ℝ) (hδ : 0 ≤ δ) :
    distance (v • (x : Time)) ≤
      distance (v • ((x + δ : ℝ) : Time)) + (v : ℝ) * δ := by
  have hinc : ‖v • (δ : Time)‖ ≤ (v : ℝ) * δ := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    calc
      ‖(((v : ℝ) * δ : ℝ) : Time)‖ ≤ ‖(v : ℝ) * δ‖ :=
        QuotientAddGroup.norm_mk_le_norm
      _ = (v : ℝ) * δ := by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Nat.cast_nonneg _) hδ)]
  have hadd : v • ((x + δ : ℝ) : Time) = v • (x : Time) + v • (δ : Time) := by
    rw [AddCircle.coe_add, nsmul_add]
  unfold distance
  calc
    ‖v • (x : Time)‖ =
        ‖v • ((x + δ : ℝ) : Time) - v • (δ : Time)‖ := by rw [hadd]; simp
    _ ≤ ‖v • ((x + δ : ℝ) : Time)‖ + ‖v • (δ : Time)‖ := norm_sub_le _ _
    _ ≤ ‖v • ((x + δ : ℝ) : Time)‖ + (v : ℝ) * δ := add_le_add_right hinc _

/-- A finite collection with no negative active residual can be improved by
one common positive time perturbation. Integer representatives are explicit
so the lemma can also be applied after reflecting the time. -/
theorem critical_one_sided_improvement (V : Finset ℕ) (hV : V.Nonempty)
    (hpositive : Positive V) (x M : ℝ) (j : ℕ → ℤ)
    (hMpos : 0 < M) (hMhalf : M < (1 / 2 : ℝ))
    (hcenter : ∀ v ∈ V, distance (v • (x : Time)) = |(v : ℝ) * x - (j v : ℝ)|)
    (hlower : ∀ v ∈ V, M ≤ distance (v • (x : Time)))
    (hnoneg : ∀ v ∈ V, (v : ℝ) * x - (j v : ℝ) ≠ -M) :
    ∃ δ : ℝ, 0 < δ ∧ M < score V ((x + δ : ℝ) : Time) := by
  classical
  let b : ℕ → ℝ := fun v =>
    if distance (v • (x : Time)) = M then
      (1 / 2 - M) / (2 * (v : ℝ)) else
      (distance (v • (x : Time)) - M) / (2 * (v : ℝ))
  have hbpos : ∀ v ∈ V, 0 < b v := by
    intro v hv
    have hvR : (0 : ℝ) < v := by exact_mod_cast hpositive v hv
    by_cases ha : distance (v • (x : Time)) = M
    · simp only [b, if_pos ha]
      exact div_pos (by linarith) (by positivity)
    · simp only [b, if_neg ha]
      have hl := hlower v hv
      have hold : M < distance (v • (x : Time)) := lt_of_le_of_ne hl (Ne.symm ha)
      exact div_pos (by linarith [hold]) (by positivity)
  have hminpos : (0 : ℝ) < V.inf' hV b := by
    rw [Finset.lt_inf'_iff]
    exact hbpos
  let δ : ℝ := V.inf' hV b / 2
  have hδpos : 0 < δ := by dsimp [δ]; positivity
  have hδmin : δ < V.inf' hV b := by dsimp [δ]; linarith
  have hnew : ∀ v ∈ V, M < distance (v • ((x + δ : ℝ) : Time)) := by
    intro v hv
    have hvR : (0 : ℝ) < v := by exact_mod_cast hpositive v hv
    have hδb : δ < b v := hδmin.trans_le (Finset.inf'_le b hv)
    by_cases ha : distance (v • (x : Time)) = M
    · have habs : |(v : ℝ) * x - (j v : ℝ)| = M := (hcenter v hv).symm.trans ha
      have hz : (v : ℝ) * x - (j v : ℝ) = M := by
        by_cases hz0 : 0 ≤ (v : ℝ) * x - (j v : ℝ)
        · simpa only [abs_of_nonneg hz0] using habs
        · have hzn : (v : ℝ) * x - (j v : ℝ) < 0 := lt_of_not_ge hz0
          rw [abs_of_neg hzn] at habs
          have hbad : (v : ℝ) * x - (j v : ℝ) = -M := by linarith
          exact False.elim (hnoneg v hv hbad)
      have hδbound : δ < (1 / 2 - M) / (2 * (v : ℝ)) := by
        simpa only [b, if_pos ha] using hδb
      have hδmul : (v : ℝ) * δ < (1 / 2 - M) / 2 := by
        have hm := (lt_div_iff₀ (by positivity : (0 : ℝ) < 2 * (v : ℝ))).mp hδbound
        nlinarith [hm]
      have hprodpos : (0 : ℝ) < (v : ℝ) * δ := mul_pos hvR hδpos
      have hform : (v : ℝ) * (x + δ) - (j v : ℝ) = M + (v : ℝ) * δ := by
        nlinarith [hz]
      have hsumpos : 0 < M + (v : ℝ) * δ := by linarith
      have hsumhalf : M + (v : ℝ) * δ < (1 / 2 : ℝ) := by linarith
      have hnorm : distance (v • ((x + δ : ℝ) : Time)) = M + (v : ℝ) * δ := by
        rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
        calc
          distance (((v : ℝ) * (x + δ) : ℝ) : Time) =
              |(v : ℝ) * (x + δ) - (j v : ℝ)| :=
            critical_distance_eq_abs_int (j v) (by rw [hform, abs_of_pos hsumpos]; exact hsumhalf.le)
          _ = M + (v : ℝ) * δ := by rw [hform, abs_of_pos hsumpos]
      rw [hnorm]
      linarith
    · have hold : M < distance (v • (x : Time)) := lt_of_le_of_ne (hlower v hv) (Ne.symm ha)
      have hδbound : δ < (distance (v • (x : Time)) - M) / (2 * (v : ℝ)) := by
        simpa only [b, if_neg ha] using hδb
      have hδmul : (v : ℝ) * δ < (distance (v • (x : Time)) - M) / 2 := by
        have hm := (lt_div_iff₀ (by positivity : (0 : ℝ) < 2 * (v : ℝ))).mp hδbound
        nlinarith [hm]
      have hloss := critical_distance_shift_lower v x δ hδpos.le
      linarith
  refine ⟨δ, hδpos, ?_⟩
  simp only [score, dif_pos hV]
  rw [Finset.lt_inf'_iff]
  exact hnew

/-- Every attained positive maximum below one half occurs at an integer
multiple of the reciprocal of a sum of two distinct speeds. -/
theorem ML_critical_time {V : Finset ℕ} (hV : V.Nonempty)
    (hpositive : Positive V) (hMpos : 0 < ML V) (hMhalf : ML V < (1 / 2 : ℝ))
    {t : Time} (hattained : score V t = ML V) :
    ∃ u ∈ V, ∃ v ∈ V, u ≠ v ∧ ∃ m : ℤ,
      t = (((m : ℝ) / ((u + v : ℕ) : ℝ) : ℝ) : Time) := by
  classical
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  obtain ⟨x, hx, rfl⟩ := AddCircle.eq_coe_Ico t
  let j : ℕ → ℤ := fun v => round ((v : ℝ) * x)
  have hcenter : ∀ v ∈ V, distance (v • (x : Time)) = |(v : ℝ) * x - (j v : ℝ)| := by
    intro v hv
    exact critical_distance_center v x
  have hlower : ∀ v ∈ V, ML V ≤ distance (v • (x : Time)) := by
    intro v hv
    rw [← hattained]
    simp only [score, dif_pos hV]
    exact Finset.inf'_le (fun w => distance (w • (x : Time))) hv
  have hnegative : ∃ v ∈ V, (v : ℝ) * x - (j v : ℝ) = -ML V := by
    by_contra hn
    have hnone : ∀ v ∈ V, (v : ℝ) * x - (j v : ℝ) ≠ -ML V := by
      intro v hv he
      exact hn ⟨v, hv, he⟩
    obtain ⟨δ, hδ, hbetter⟩ := critical_one_sided_improvement
      V hV hpositive x (ML V) j hMpos hMhalf hcenter hlower hnone
    have hupper := score_le_ML V ((x + δ : ℝ) : Time)
    linarith
  have hpositiveActive : ∃ u ∈ V, (u : ℝ) * x - (j u : ℝ) = ML V := by
    by_contra hn
    let jneg : ℕ → ℤ := fun v => -(j v)
    have hdistneg : ∀ v : ℕ, distance (v • ((-x : ℝ) : Time)) = distance (v • (x : Time)) := by
      intro v
      unfold distance
      rw [AddCircle.coe_neg, smul_neg, norm_neg]
    have hformneg : ∀ v : ℕ,
        (v : ℝ) * (-x) - (jneg v : ℝ) = -((v : ℝ) * x - (j v : ℝ)) := by
      intro v
      dsimp [jneg]
      push_cast
      ring
    have hcenterneg : ∀ v ∈ V,
        distance (v • ((-x : ℝ) : Time)) = |(v : ℝ) * (-x) - (jneg v : ℝ)| := by
      intro v hv
      rw [hdistneg, hformneg, abs_neg]
      exact hcenter v hv
    have hlowerneg : ∀ v ∈ V, ML V ≤ distance (v • ((-x : ℝ) : Time)) := by
      intro v hv
      rw [hdistneg]
      exact hlower v hv
    have hnone : ∀ v ∈ V, (v : ℝ) * (-x) - (jneg v : ℝ) ≠ -ML V := by
      intro v hv he
      rw [hformneg] at he
      have hgood : (v : ℝ) * x - (j v : ℝ) = ML V := by linarith
      exact hn ⟨v, hv, hgood⟩
    obtain ⟨δ, hδ, hbetter⟩ := critical_one_sided_improvement
      V hV hpositive (-x) (ML V) jneg hMpos hMhalf hcenterneg hlowerneg hnone
    have hupper := score_le_ML V ((-x + δ : ℝ) : Time)
    linarith
  obtain ⟨u, hu, hup⟩ := hpositiveActive
  obtain ⟨v, hv, hvn⟩ := hnegative
  have huv : u ≠ v := by
    intro he
    subst v
    linarith
  have hsum : ((u + v : ℕ) : ℝ) * x = ((j u + j v : ℤ) : ℝ) := by
    push_cast
    nlinarith [hup, hvn]
  have hden : ((u + v : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast (show u + v ≠ 0 by have hu0 := hpositive u hu; omega)
  have hxrat : x = ((j u + j v : ℤ) : ℝ) / ((u + v : ℕ) : ℝ) := by
    apply (eq_div_iff hden).2
    nlinarith [hsum]
  exact ⟨u, hu, v, hv, huv, j u + j v, congrArg (fun y : ℝ => (y : Time)) hxrat⟩

/-- A pair-sum grid contains an attained global maximum. -/
theorem ML_pair_sum_grid_attained {V : Finset ℕ} (hV : V.Nonempty)
    (hpositive : Positive V) (hMpos : 0 < ML V) (hMhalf : ML V < (1 / 2 : ℝ)) :
    ∃ u ∈ V, ∃ v ∈ V, u ≠ v ∧ ∃ m : ℤ,
      score V ((((m : ℝ) / ((u + v : ℕ) : ℝ)) : ℝ) : Time) = ML V := by
  obtain ⟨t, ht⟩ := ML_attained V
  obtain ⟨u, hu, v, hv, huv, m, hm⟩ := ML_critical_time hV hpositive hMpos hMhalf ht
  refine ⟨u, hu, v, hv, huv, m, ?_⟩
  rw [← hm]
  exact ht








end Math15.LonelyRunner
end 
end 

/- Section: IntervalCertificate -/
section


noncomputable section
namespace Math15.LonelyRunner

/-- The quotient norm is bounded by distance to any chosen integer. -/
theorem distance_coe_le_integer (x : ℝ) (j : ℤ) :
    distance (x : Time) ≤ |x - (j : ℝ)| := by
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  have he : ((x - (j : ℝ) : ℝ) : Time) = (x : Time) := by
    rw [AddCircle.coe_sub, hz, sub_zero]
  unfold distance
  rw [← he]
  have hn : ‖((x - (j : ℝ) : ℝ) : Time)‖ ≤ ‖x - (j : ℝ)‖ :=
    QuotientAddGroup.norm_mk_le_norm
  simpa only [Real.norm_eq_abs] using hn

theorem distance_le_of_interval {v : ℕ} {j : ℤ} {x L : ℝ}
    (hl : (j : ℝ) - L ≤ (v : ℝ) * x)
    (hu : (v : ℝ) * x ≤ (j : ℝ) + L) :
    distance (v • (x : Time)) ≤ L := by
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  exact (distance_coe_le_integer ((v : ℝ) * x) j).trans
    (abs_le.mpr ⟨by linarith, by linarith⟩)

theorem score_le_distance {V : Finset ℕ} {v : ℕ} (hv : v ∈ V) (t : Time) :
    score V t ≤ distance (v • t) := by
  have hV : V.Nonempty := ⟨v, hv⟩
  simp only [score, dif_pos hV]
  exact Finset.inf'_le (fun w => distance (w • t)) hv

theorem ML_upper_of_all_times {V : Finset ℕ} {L : ℝ}
    (h : ∀ t : Time, score V t ≤ L) : ML V ≤ L := by
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨t, rfl⟩
  exact h t






end Math15.LonelyRunner
end 
end 

/- Section: TripleGrid -/
section


/-!
Exact triple-grid bounds used in the U2 family.
-/

noncomputable section
namespace Math15.LonelyRunner

def tripleSpeeds : Finset ℕ := {1, 2, 3}

theorem tripleSpeeds_nonempty : tripleSpeeds.Nonempty := by
  exact ⟨1, by simp [tripleSpeeds]⟩

/-- The continuous triple (1,2,3) never exceeds the quarter gap. -/
theorem triple_score_le_quarter (t : Time) :
    score tripleSpeeds t ≤ (1 / 4 : ℝ) := by
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  obtain ⟨x, hx, rfl⟩ := AddCircle.eq_coe_Ico t
  rcases hx with ⟨hx0, hx1⟩
  by_cases h1 : x ≤ (1 / 4 : ℝ)
  · apply (score_le_distance (V := tripleSpeeds) (v := 1)
      (by simp [tripleSpeeds]) (x : Time)).trans
    apply distance_le_of_interval (v := 1) (j := 0) (x := x)
    · norm_num
      linarith
    · norm_num
      exact h1
  by_cases h2 : (3 / 4 : ℝ) ≤ x
  · apply (score_le_distance (V := tripleSpeeds) (v := 1)
      (by simp [tripleSpeeds]) (x : Time)).trans
    apply distance_le_of_interval (v := 1) (j := 1) (x := x)
    · norm_num
      exact h2
    · norm_num
      linarith
  by_cases h3 : x ≤ (3 / 8 : ℝ)
  · apply (score_le_distance (V := tripleSpeeds) (v := 3)
      (by simp [tripleSpeeds]) (x : Time)).trans
    apply distance_le_of_interval (v := 3) (j := 1) (x := x)
    · norm_num
      linarith
    · norm_num
      linarith
  by_cases h4 : (5 / 8 : ℝ) ≤ x
  · apply (score_le_distance (V := tripleSpeeds) (v := 3)
      (by simp [tripleSpeeds]) (x : Time)).trans
    apply distance_le_of_interval (v := 3) (j := 2) (x := x)
    · norm_num
      linarith
    · norm_num
      linarith
  · apply (score_le_distance (V := tripleSpeeds) (v := 2)
      (by simp [tripleSpeeds]) (x : Time)).trans
    apply distance_le_of_interval (v := 2) (j := 1) (x := x)
    · norm_num
      linarith
    · norm_num
      linarith

theorem triple_ML_eq_quarter : ML tripleSpeeds = (1 / 4 : ℝ) := by
  apply le_antisymm
  · exact ML_upper_of_all_times triple_score_le_quarter
  · apply ML_ge_quarter_of_no_four tripleSpeeds_nonempty
    intro v hv
    have hv' : v = 1 ∨ v = 2 ∨ v = 3 := by
      simpa only [tripleSpeeds, Finset.mem_insert, Finset.mem_singleton] using hv
    rcases hv' with rfl | rfl | rfl <;> norm_num

/-- At a rational time, any nonempty finite score is an integer grid multiple. -/
theorem rational_score_integer_multiple (V : Finset ℕ) (hV : V.Nonempty)
    (m n : ℕ) :
    ∃ k : ℕ, score V (((m : ℝ) / (n : ℝ)) : Time) =
      (k : ℝ) / (n : ℝ) := by
  obtain ⟨v, _, hmin⟩ := Finset.exists_mem_eq_inf' hV
    (fun v => distance (v • (((m : ℝ) / (n : ℝ)) : Time)))
  refine ⟨min ((v * m) % n) (n - (v * m) % n), ?_⟩
  simp only [score, dif_pos hV]
  exact hmin.trans (distance_at_rational v m n)

/-- The continuous quarter bound rounds down to the exact n-grid bound. -/
theorem triple_score_grid_upper (m n : ℕ) (hn : 0 < n) :
    score tripleSpeeds (((m : ℝ) / (n : ℝ)) : Time) ≤
      ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  obtain ⟨k, hk⟩ := rational_score_integer_multiple
    tripleSpeeds tripleSpeeds_nonempty m n
  have hq := triple_score_le_quarter (((m : ℝ) / (n : ℝ)) : Time)
  rw [hk] at hq
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hkR : (k : ℝ) ≤ (1 / 4 : ℝ) * (n : ℝ) :=
    (div_le_iff₀ hnR).mp hq
  have h4R : (4 : ℝ) * (k : ℝ) ≤ (n : ℝ) := by linarith
  have h4 : 4 * k ≤ n := by exact_mod_cast h4R
  have hkfloor : k ≤ n / 4 := by omega
  rw [hk]
  exact (div_le_div_iff_of_pos_right hnR).2 (by exact_mod_cast hkfloor)

/-- Four m <= n prevents wraparound of the three grid numerators. -/
theorem triple_grid_lower_numerator {m n v : ℕ} (hn : 0 < n)
    (hm : 4 * m ≤ n) (hv : v ∈ tripleSpeeds) :
    m ≤ min ((v * m) % n) (n - (v * m) % n) := by
  have hv' : v = 1 ∨ v = 2 ∨ v = 3 := by
    simpa only [tripleSpeeds, Finset.mem_insert, Finset.mem_singleton] using hv
  rcases hv' with rfl | rfl | rfl
  · have hlt : 1 * m < n := by omega
    rw [Nat.mod_eq_of_lt hlt]
    omega
  · have hlt : 2 * m < n := by omega
    rw [Nat.mod_eq_of_lt hlt]
    omega
  · have hlt : 3 * m < n := by omega
    rw [Nat.mod_eq_of_lt hlt]
    omega

/-- A grid point with four m <= n attains a score at least m/n. -/
theorem triple_score_grid_lower (m n : ℕ) (hn : 0 < n) (hm : 4 * m ≤ n) :
    (m : ℝ) / (n : ℝ) ≤
      score tripleSpeeds (((m : ℝ) / (n : ℝ)) : Time) := by
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  simp only [score, dif_pos tripleSpeeds_nonempty]
  apply Finset.le_inf' tripleSpeeds_nonempty
  intro v hv
  rw [distance_at_rational]
  have hnum := triple_grid_lower_numerator hn hm hv
  exact (div_le_div_iff_of_pos_right hnR).2 (by exact_mod_cast hnum)

/-- The exact grid maximum is attained at the numerator floor(n/4). -/
theorem triple_score_grid_floor (n : ℕ) (hn : 0 < n) :
    score tripleSpeeds ((((n / 4 : ℕ) : ℝ) / (n : ℝ)) : Time) =
      ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  apply le_antisymm
  · exact triple_score_grid_upper (n / 4) n hn
  · apply triple_score_grid_lower (n / 4) n hn
    omega

/-- An explicit maximum certificate covering every integer numerator. -/
theorem triple_grid_maximum (n : ℕ) (hn : 0 < n) :
    (∀ m : ℕ, score tripleSpeeds (((m : ℝ) / (n : ℝ)) : Time) ≤
      ((n / 4 : ℕ) : ℝ) / (n : ℝ)) ∧
    score tripleSpeeds ((((n / 4 : ℕ) : ℝ) / (n : ℝ)) : Time) =
      ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  exact ⟨fun m => triple_score_grid_upper m n hn, triple_score_grid_floor n hn⟩











end Math15.LonelyRunner
end 
end 

/- Section: RationalMaximum -/
section



/-!
Rationality at the original objects. This does not bound the reduced
denominator deficit and therefore does not settle Target05.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem ML_pos_of_positive {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) : 0 < ML V := by
  let n : ℕ := V.sup id + 1
  have hn : 0 < n := by dsimp [n]; omega
  have hbound : (1 / (n : ℝ)) ≤ ML V := by
    apply ML_ge_inv_of_nonzero_mod hV hn
    intro v hv
    have hvle : v ≤ V.sup id := Finset.le_sup (f := id) hv
    have hvlt : v < n := by dsimp [n]; omega
    rw [Nat.mod_eq_of_lt hvlt]
    exact ne_of_gt (hp v hv)
  have hsmall : (0 : ℝ) < 1 / (n : ℝ) := by positivity
  exact hsmall.trans_le hbound

theorem score_neg (V : Finset ℕ) (t : Time) : score V (-t) = score V t := by
  simp [score, distance, smul_neg]

theorem ML_rational_pair_grid {V : Finset ℕ} (hV : V.Nonempty)
    (hp : Positive V) (hh : ML V < (1 / 2 : ℝ)) :
    ∃ u ∈ V, ∃ v ∈ V, u ≠ v ∧ ∃ m k : ℕ,
      0 < k ∧
      score V (((m : ℝ) / ((u + v : ℕ) : ℝ)) : Time) = ML V ∧
      ML V = (k : ℝ) / ((u + v : ℕ) : ℝ) := by
  have hpos := ML_pos_of_positive hV hp
  obtain ⟨u, hu, v, hv, huv, z, hz⟩ := ML_pair_sum_grid_attained hV hp hpos hh
  have hsum : 0 < u + v := by have hu0 := hp u hu; omega
  have hm : ∃ m : ℕ,
      score V (((m : ℝ) / ((u + v : ℕ) : ℝ)) : Time) = ML V := by
    cases z with
    | ofNat n => exact ⟨n, by simpa only [Int.cast_natCast] using hz⟩
    | negSucc n =>
      refine ⟨n + 1, ?_⟩
      have htime : (((Int.negSucc n : ℤ) : ℝ) / ((u + v : ℕ) : ℝ) : Time) =
          -((((n + 1 : ℕ) : ℝ) / ((u + v : ℕ) : ℝ)) : Time) := by
        rw [← AddCircle.coe_neg]
        congr 1
        simp only [Int.cast_negSucc, Nat.cast_add, Nat.cast_one, Nat.cast_add]
        ring
      rw [htime, score_neg] at hz
      exact hz
  obtain ⟨m, hm⟩ := hm
  obtain ⟨k, hk⟩ := rational_score_integer_multiple V hV m (u + v)
  have heq : ML V = (k : ℝ) / ((u + v : ℕ) : ℝ) := hm.symm.trans hk
  have hkpos : 0 < k := by
    by_contra hn
    have hk0 : k = 0 := by omega
    rw [hk0] at heq
    norm_num at heq
    linarith
  exact ⟨u, hu, v, hv, huv, m, k, hkpos, hm, heq⟩





end Math15.LonelyRunner
end 
end 

/- Section: IntervalHitting -/
section


/-!
Constructive quarter-distance interval hitting and an unbounded Source05
subfamily. The later one-two lemmas assemble these interval constructions into
the branch containing speeds 1 and 2.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- The circle norm is at least one quarter throughout each translated
closed middle half of a unit interval. The proof uses the triangle inequality
from the antipodal point, so it does not need a rounding case split. -/
theorem distance_coe_ge_quarter_of_interval {x : ℝ} {j : ℤ}
    (hl : (j : ℝ) + 1 / 4 ≤ x)
    (hu : x ≤ (j : ℝ) + 3 / 4) :
    (1 / 4 : ℝ) ≤ distance (x : Time) := by
  let y : ℝ := x - (j : ℝ)
  have hylo : (1 / 4 : ℝ) ≤ y := by dsimp [y]; linarith
  have hyhi : y ≤ (3 / 4 : ℝ) := by dsimp [y]; linarith
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  have he : (y : Time) = (x : Time) := by
    dsimp [y]
    rw [hz, sub_zero]
  have hd : distance (((1 / 2 : ℝ) - y) : Time) ≤ (1 / 4 : ℝ) := by
    apply (distance_coe_le_integer ((1 / 2 : ℝ) - y) 0).trans
    simp only [Int.cast_zero, sub_zero]
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have hh : ‖(((1 / 2 : ℝ)) : Time)‖ = (1 / 2 : ℝ) := by
    simpa using AddCircle.norm_half_period_eq (1 : ℝ)
  have ht : (1 / 2 : ℝ) ≤
      distance (y : Time) + distance (((1 / 2 : ℝ) - y) : Time) := by
    have hn := norm_add_le (y : Time) ((((1 / 2 : ℝ) - y) : ℝ) : Time)
    rw [← AddCircle.coe_add] at hn
    have hs : y + ((1 / 2 : ℝ) - y) = 1 / 2 := by ring
    rw [hs, hh] at hn
    exact hn
  have hq : (1 / 4 : ℝ) ≤ distance (y : Time) := by linarith
  rwa [he] at hq

theorem distance_ge_quarter_of_interval {v : ℕ} {j : ℤ} {x : ℝ}
    (hl : (j : ℝ) + 1 / 4 ≤ (v : ℝ) * x)
    (hu : (v : ℝ) * x ≤ (j : ℝ) + 3 / 4) :
    (1 / 4 : ℝ) ≤ distance (v • (x : Time)) := by
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  exact distance_coe_ge_quarter_of_interval hl hu

/-- Every closed interval of length one half contains a point at circle
distance at least one quarter. The three cases provide explicit witnesses. -/
theorem exists_quarter_distance_in_half_interval (x : ℝ) :
    ∃ y : ℝ, x ≤ y ∧ y ≤ x + 1 / 2 ∧
      (1 / 4 : ℝ) ≤ distance (y : Time) := by
  let j : ℤ := Int.floor x
  have hlo : (j : ℝ) ≤ x := Int.floor_le x
  have hhi : x < (j : ℝ) + 1 := Int.lt_floor_add_one x
  by_cases hleft : x < (j : ℝ) + 1 / 4
  · refine ⟨(j : ℝ) + 1 / 4, le_of_lt hleft, by linarith, ?_⟩
    exact distance_coe_ge_quarter_of_interval (j := j) (by linarith) (by linarith)
  by_cases hmiddle : x ≤ (j : ℝ) + 3 / 4
  · refine ⟨x, le_rfl, by linarith, ?_⟩
    exact distance_coe_ge_quarter_of_interval (le_of_not_gt hleft) hmiddle
  · refine ⟨(j : ℝ) + 5 / 4, by linarith, by linarith, ?_⟩
    apply distance_coe_ge_quarter_of_interval (j := j + 1)
    · push_cast
      linarith
    · push_cast
      linarith

/-- If the image of a real time interval under a positive speed has length
at least one half, that runner is at least one quarter away somewhere inside
the interval. Neither endpoint is required to be positive. -/
theorem exists_quarter_witness_in_interval {A B : ℝ} {d : ℕ}
    (hd : 0 < d) (hwidth : (1 / 2 : ℝ) ≤ (d : ℝ) * (B - A)) :
    ∃ x : ℝ, A ≤ x ∧ x ≤ B ∧
      (1 / 4 : ℝ) ≤ distance (d • (x : Time)) := by
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  obtain ⟨y, hylo, hyhi, hyq⟩ :=
    exists_quarter_distance_in_half_interval ((d : ℝ) * A)
  refine ⟨y / (d : ℝ), ?_, ?_, ?_⟩
  · apply (le_div_iff₀ hdr).2
    simpa only [mul_comm] using hylo
  · apply (div_le_iff₀ hdr).2
    nlinarith
  · rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    have he : (d : ℝ) * (y / (d : ℝ)) = y := by
      field_simp [ne_of_gt hdr]
    simpa only [he] using hyq

/-- A fourth speed can be added to a triple's quarter-distance interval
whenever it traverses a half circle across that interval. -/
theorem ML_ge_quarter_of_interval {V : Finset ℕ} {A B : ℝ} {d : ℕ}
    (hd : 0 < d) (hwidth : (1 / 2 : ℝ) ≤ (d : ℝ) * (B - A))
    (hbase : ∀ x : ℝ, A ≤ x → x ≤ B →
      ∀ v ∈ V, (1 / 4 : ℝ) ≤ distance (v • (x : Time))) :
    (1 / 4 : ℝ) ≤ ML (insert d V) := by
  obtain ⟨x, hxlo, hxhi, hxd⟩ := exists_quarter_witness_in_interval hd hwidth
  apply ML_lower_of_witness (by simp) (x : Time)
  intro v hv
  rcases Finset.mem_insert.mp hv with rfl | hv
  · exact hxd
  · exact hbase x hxlo hxhi v hv

/-- Every fourth speed at least five extends {1,2,4} to loneliness at least
one quarter. This is an unbounded sufficient subcase, with no gcd premise. -/
theorem ML_ge_quarter_one_two_four (d : ℕ) (hd : 5 ≤ d) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, 4, d} : Finset ℕ) := by
  by_cases hlarge : 8 ≤ d
  · have hdr : (8 : ℝ) ≤ d := by exact_mod_cast hlarge
    obtain ⟨x, hxlo, hxhi, hxd⟩ :=
      exists_quarter_witness_in_interval (d := d) (A := 5 / 16) (B := 3 / 8)
        (by omega) (by nlinarith)
    apply ML_lower_of_witness (by simp) (x : Time)
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_interval (j := 0) (by norm_num; linarith) (by norm_num; linarith)
    · exact distance_ge_quarter_of_interval (j := 0) (by norm_num; linarith) (by norm_num; linarith)
    · exact distance_ge_quarter_of_interval (j := 1) (by norm_num; linarith) (by norm_num; linarith)
    · exact hxd
  · have hcases : d = 5 ∨ d = 6 ∨ d = 7 := by omega
    rcases hcases with rfl | rfl | rfl
    · apply ML_lower_of_witness (by simp) (((5 : ℝ) / (16 : ℝ)) : Time)
      intro v hv
      have he := distance_at_rational v 5 16
      simp only [Nat.cast_ofNat] at he
      rw [he]
      simp only [Finset.mem_insert, Finset.mem_singleton] at hv
      rcases hv with rfl | rfl | rfl | rfl <;> norm_num
    · apply ML_lower_of_witness (by simp) (((3 : ℝ) / (8 : ℝ)) : Time)
      intro v hv
      have he := distance_at_rational v 3 8
      simp only [Nat.cast_ofNat] at he
      rw [he]
      simp only [Finset.mem_insert, Finset.mem_singleton] at hv
      rcases hv with rfl | rfl | rfl | rfl <;> norm_num
    · apply ML_lower_of_witness (by simp) (((1 : ℝ) / (3 : ℝ)) : Time)
      intro v hv
      have he := distance_at_rational v 1 3
      simp only [Nat.cast_one, Nat.cast_ofNat] at he
      rw [he]
      simp only [Finset.mem_insert, Finset.mem_singleton] at hv
      rcases hv with rfl | rfl | rfl | rfl <;> norm_num








end Math15.LonelyRunner
end 
end 

/- Section: TightTripleFamily -/
section



/-!
Exact construction and assembly for the branch containing speeds 1 and 2. For
V={1,2,3,4s}, s>=1, the lower time is s/(4s+1). Critical pair sums are
3,4,5,4s+1,4s+2,4s+3. The first two give zero; denominator5 gives at most1/5;
each remaining triple grid gives at most s/(4s+1).
-/

noncomputable section
namespace Math15.LonelyRunner

theorem score_le_score_of_subset {V W : Finset ℕ} (hV : V.Nonempty)
    (hsub : V ⊆ W) (t : Time) : score W t ≤ score V t := by
  simp only [score, dif_pos hV]
  apply Finset.le_inf' hV
  intro v hv
  exact score_le_distance (hsub hv) t

def tightFour (s : ℕ) : Finset ℕ := {1, 2, 3, 4 * s}

theorem tightFour_triple_subset (s : ℕ) : tripleSpeeds ⊆ tightFour s := by
  intro v hv
  simp only [tripleSpeeds, Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl <;> simp [tightFour]

theorem tightFour_nonempty (s : ℕ) : (tightFour s).Nonempty := by
  exact ⟨1, by simp [tightFour]⟩

theorem tightFour_positive {s : ℕ} (hs : 1 ≤ s) : Positive (tightFour s) := by
  intro v hv
  simp only [tightFour, Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl <;> omega

theorem tightFour_lower (s : ℕ) (hs : 1 ≤ s) :
    (s : ℝ) / (4 * (s : ℝ) + 1) ≤ ML (tightFour s) := by
  let x : ℝ := (s : ℝ) / (4 * (s : ℝ) + 1)
  have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
  have hden : (0 : ℝ) < 4 * (s : ℝ) + 1 := by positivity
  have hxpos : 0 < x := by dsimp [x]; positivity
  have hxquarter : x ≤ (1 / 4 : ℝ) := by
    dsimp [x]
    apply (div_le_iff₀ hden).2
    linarith
  have hspeed : (4 * s : ℕ) • (x : Time) = (-x : ℝ) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    have heq : ((4 * s : ℕ) : ℝ) * x = (s : ℝ) - x := by
      dsimp [x]
      push_cast
      field_simp
      ring
    rw [heq, AddCircle.coe_sub]
    have hz : ((s : ℝ) : Time) = 0 := by
      apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
      exact ⟨s, by simp [zsmul_eq_mul]⟩
    rw [hz, zero_sub, AddCircle.coe_neg]
  apply ML_lower_of_witness (tightFour_nonempty s) (x : Time)
  intro v hv
  simp only [tightFour, Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · unfold distance
    simp only [one_nsmul]
    rw [(AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
      (by rw [abs_of_pos hxpos, abs_one]; linarith), abs_of_pos hxpos]
  · unfold distance
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    simp only [Nat.cast_ofNat]
    have h2 : 0 ≤ (2 : ℝ) * x := by positivity
    rw [(AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
      (by rw [abs_of_nonneg h2, abs_one]; linarith), abs_of_nonneg h2]
    change x ≤ 2 * x
    linarith
  · have ht := distance_ge_quarter_of_interval (v := 3) (j := 0) (x := x)
    have hxlower : (1 / 5 : ℝ) ≤ x := by
      dsimp [x]
      apply (le_div_iff₀ hden).2
      linarith
    exact hxquarter.trans (ht (by norm_num; linarith) (by norm_num; linarith))
  · rw [hspeed]
    unfold distance
    rw [AddCircle.coe_neg, norm_neg]
    rw [(AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
      (by rw [abs_of_pos hxpos, abs_one]; linarith), abs_of_pos hxpos]

theorem tightFour_pair_sum {s u v : ℕ} (hu : u ∈ tightFour s)
    (hv : v ∈ tightFour s) (hne : u ≠ v) :
    u + v = 3 ∨ u + v = 4 ∨ u + v = 5 ∨
    u + v = 4 * s + 1 ∨ u + v = 4 * s + 2 ∨ u + v = 4 * s + 3 := by
  simp only [tightFour, Finset.mem_insert, Finset.mem_singleton] at hu hv
  rcases hu with rfl | rfl | rfl | rfl <;>
    rcases hv with rfl | rfl | rfl | rfl <;> omega

theorem tightFour_grid_upper (s : ℕ) (hs : 1 ≤ s) (m n : ℕ)
    (hn : n = 3 ∨ n = 4 ∨ n = 5 ∨
      n = 4 * s + 1 ∨ n = 4 * s + 2 ∨ n = 4 * s + 3) :
    score (tightFour s) (((m : ℝ) / (n : ℝ)) : Time) ≤
      (s : ℝ) / (4 * (s : ℝ) + 1) := by
  have hsR : (1 : ℝ) ≤ s := by exact_mod_cast hs
  have hden : (0 : ℝ) < 4 * (s : ℝ) + 1 := by positivity
  have hnonneg : (0 : ℝ) ≤ (s : ℝ) / (4 * (s : ℝ) + 1) := by positivity
  rcases hn with rfl | rfl | rfl | rfl | rfl | rfl
  · apply (score_le_distance (V := tightFour s) (v := 3)
      (by simp [tightFour]) _).trans
    rw [distance_at_rational]
    simpa using hnonneg
  · apply (score_le_distance (V := tightFour s) (v := 4 * s)
      (by simp [tightFour]) _).trans
    rw [distance_at_rational]
    have hz : (4 * s * m) % 4 = 0 := by simp [Nat.mul_mod]
    simpa [hz] using hnonneg
  · apply (score_le_score_of_subset tripleSpeeds_nonempty (tightFour_triple_subset s) _).trans
    apply (triple_score_grid_upper m 5 (by norm_num)).trans
    norm_num
    apply (le_div_iff₀ hden).2
    linarith
  · apply (score_le_score_of_subset tripleSpeeds_nonempty (tightFour_triple_subset s) _).trans
    apply (triple_score_grid_upper m (4 * s + 1) (by omega)).trans
    have hfloor : (4 * s + 1) / 4 = s := by omega
    simp only [hfloor, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one]
    exact le_rfl
  · apply (score_le_score_of_subset tripleSpeeds_nonempty (tightFour_triple_subset s) _).trans
    apply (triple_score_grid_upper m (4 * s + 2) (by omega)).trans
    have hfloor : (4 * s + 2) / 4 = s := by omega
    simp only [hfloor, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
    exact div_le_div_of_nonneg_left (Nat.cast_nonneg s) hden (by linarith)
  · apply (score_le_score_of_subset tripleSpeeds_nonempty (tightFour_triple_subset s) _).trans
    apply (triple_score_grid_upper m (4 * s + 3) (by omega)).trans
    have hfloor : (4 * s + 3) / 4 = s := by omega
    simp only [hfloor, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
    exact div_le_div_of_nonneg_left (Nat.cast_nonneg s) hden (by linarith)

theorem tightFour_exact (s : ℕ) (hs : 1 ≤ s) :
    ML (tightFour s) = (s : ℝ) / (4 * (s : ℝ) + 1) := by
  apply le_antisymm _ (tightFour_lower s hs)
  have hquarter : ML (tightFour s) ≤ (1 / 4 : ℝ) := by
    apply ML_upper_of_all_times
    intro t
    exact (score_le_score_of_subset tripleSpeeds_nonempty (tightFour_triple_subset s) t).trans
      (triple_score_le_quarter t)
  have hhalf : ML (tightFour s) < (1 / 2 : ℝ) := by linarith
  obtain ⟨u, hu, v, hv, hne, m, k, _, hm, _⟩ :=
    ML_rational_pair_grid (tightFour_nonempty s) (tightFour_positive hs) hhalf
  rw [← hm]
  exact tightFour_grid_upper s hs m (u + v) (tightFour_pair_sum hu hv hne)






end Math15.LonelyRunner
end 
end 

/- Section: ContainsOneTwo -/
section


/-!
Structural Source05 subcase: a low-loneliness quartet containing 1 and 2 must
contain 3. The proof uses the interval-hitting lemmas above.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem one_two_quarter_at {x : ℝ}
    (hlo : (1 / 4 : ℝ) ≤ x) (hhi : x ≤ (3 / 8 : ℝ)) :
    (1 / 4 : ℝ) ≤ distance (1 • (x : Time)) ∧
    (1 / 4 : ℝ) ≤ distance (2 • (x : Time)) := by
  constructor
  · exact distance_ge_quarter_of_interval (j := 0)
      (by norm_num; linarith) (by norm_num; linarith)
  · exact distance_ge_quarter_of_interval (j := 0)
      (by norm_num; linarith) (by norm_num; linarith)

theorem quarter_shift_product (d : ℕ) (hd : 0 < d) (c : ℝ) :
    (d : ℝ) * (1 / 4 + c / (d : ℝ)) =
      (d / 4 : ℕ) + (d % 4 : ℕ) / (4 : ℝ) + c := by
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  have hnat : d = 4 * (d / 4) + d % 4 := by
    have hm := Nat.mod_add_div d 4
    omega
  have hreal : (d : ℝ) = 4 * (d / 4 : ℕ) + (d % 4 : ℕ) := by
    exact_mod_cast hnat
  calc
    (d : ℝ) * (1 / 4 + c / (d : ℝ)) = (d : ℝ) / 4 + c := by
      field_simp [ne_of_gt hdr] <;> ring
    _ = (d / 4 : ℕ) + (d % 4 : ℕ) / (4 : ℝ) + c := by linarith

theorem one_two_window_lift (a b : ℕ) {A B : ℝ} (hb : 0 < b)
    (hlo : (1 / 4 : ℝ) ≤ A) (hhi : B ≤ (3 / 8 : ℝ))
    (hwidth : (1 / 2 : ℝ) ≤ (b : ℝ) * (B - A))
    (ha : ∀ x : ℝ, A ≤ x → x ≤ B →
      (1 / 4 : ℝ) ≤ distance (a • (x : Time))) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, b} : Finset ℕ) := by
  obtain ⟨x, hxlo, hxhi, hxb⟩ := exists_quarter_witness_in_interval hb hwidth
  obtain ⟨hx1, hx2⟩ := one_two_quarter_at (hlo.trans hxlo) (hxhi.trans hhi)
  apply ML_lower_of_witness (by simp) (x : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · exact hx1
  · exact hx2
  · exact ha x hxlo hxhi
  · exact hxb

theorem one_two_large_four_window (a b : ℕ) (ha : 8 ≤ a)
    (hmod : a % 4 = 0) (hab : a ≤ b) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, b} : Finset ℕ) := by
  have har : (8 : ℝ) ≤ a := by exact_mod_cast ha
  have hapos : (0 : ℝ) < a := by linarith
  have habr : (a : ℝ) ≤ b := by exact_mod_cast hab
  have htail : (3 / 4 : ℝ) / (a : ℝ) ≤ 1 / 8 := by
    apply (div_le_iff₀ hapos).2
    nlinarith
  apply one_two_window_lift a b (A := 1 / 4 + (1 / 4) / (a : ℝ))
    (B := 1 / 4 + (3 / 4) / (a : ℝ)) (by omega)
  · have hn : (0 : ℝ) ≤ (1 / 4 : ℝ) / (a : ℝ) := by positivity
    linarith
  · linarith
  · have he : (b : ℝ) * ((1 / 4 + (3 / 4) / (a : ℝ)) -
        (1 / 4 + (1 / 4) / (a : ℝ))) = (b : ℝ) / (2 * (a : ℝ)) := by
      field_simp [ne_of_gt hapos] <;> ring
    rw [he]
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2 * (a : ℝ))).2
    nlinarith
  · intro x hxlo hxhi
    have hpl := quarter_shift_product a (by omega) (1 / 4)
    have hpu := quarter_shift_product a (by omega) (3 / 4)
    simp only [hmod, Nat.cast_zero, zero_div, add_zero] at hpl hpu
    have hl := mul_le_mul_of_nonneg_left hxlo hapos.le
    have hu := mul_le_mul_of_nonneg_left hxhi hapos.le
    rw [hpl] at hl
    rw [hpu] at hu
    apply distance_ge_quarter_of_interval (j := ((a / 4 : ℕ) : ℤ))
    · simpa only [Int.cast_natCast] using hl
    · simpa only [Int.cast_natCast] using hu

theorem one_two_small_residue (a b : ℕ) (ha : 4 ≤ a) (hb : b ≤ a)
    (hmoda : a % 4 = 0) (hmodb : b % 4 = 1 ∨ b % 4 = 2) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, b} : Finset ℕ) := by
  have har : (4 : ℝ) ≤ a := by exact_mod_cast ha
  have hapos : (0 : ℝ) < a := by linarith
  have hbr : (b : ℝ) ≤ a := by exact_mod_cast hb
  let x : ℝ := 1 / 4 + (1 / 4) / (a : ℝ)
  have htail : (1 / 4 : ℝ) / (a : ℝ) ≤ 1 / 8 := by
    apply (div_le_iff₀ hapos).2
    nlinarith
  have hxlo : (1 / 4 : ℝ) ≤ x := by
    have hn : (0 : ℝ) ≤ (1 / 4 : ℝ) / (a : ℝ) := by positivity
    dsimp [x]
    linarith
  have hxhi : x ≤ (3 / 8 : ℝ) := by dsimp [x]; linarith
  obtain ⟨hx1, hx2⟩ := one_two_quarter_at hxlo hxhi
  have hxa : (1 / 4 : ℝ) ≤ distance (a • (x : Time)) := by
    have hp := quarter_shift_product a (by omega) (1 / 4)
    simp only [hmoda, Nat.cast_zero, zero_div, add_zero] at hp
    apply distance_ge_quarter_of_interval (j := ((a / 4 : ℕ) : ℤ))
    · simpa only [Int.cast_natCast] using le_of_eq hp.symm
    · have hu : (a : ℝ) * (1 / 4 + (1 / 4) / (a : ℝ)) ≤
          (a / 4 : ℕ) + (3 / 4 : ℝ) := by
        rw [hp]
        linarith
      simpa only [Int.cast_natCast] using hu
  have hxb : (1 / 4 : ℝ) ≤ distance (b • (x : Time)) := by
    have hnat : b = 4 * (b / 4) + b % 4 := by
      have hm := Nat.mod_add_div b 4
      omega
    have hreal : (b : ℝ) = 4 * (b / 4 : ℕ) + (b % 4 : ℕ) := by
      exact_mod_cast hnat
    have hprod : (b : ℝ) * x =
        (b / 4 : ℕ) + (b % 4 : ℕ) / (4 : ℝ) +
          ((b : ℝ) / (a : ℝ)) / 4 := by
      dsimp [x]
      calc
        (b : ℝ) * (1 / 4 + (1 / 4) / (a : ℝ)) =
            (b : ℝ) / 4 + ((b : ℝ) / (a : ℝ)) / 4 := by ring
        _ = _ := by linarith
    have hfraclo : (0 : ℝ) ≤ (b : ℝ) / (a : ℝ) := by positivity
    have hfrach : (b : ℝ) / (a : ℝ) ≤ 1 := by
      apply (div_le_iff₀ hapos).2
      simpa using hbr
    apply distance_ge_quarter_of_interval (j := ((b / 4 : ℕ) : ℤ))
    · rw [hprod]
      simp only [Int.cast_natCast]
      rcases hmodb with hm | hm <;> simp only [hm, Nat.cast_ofNat] <;> linarith
    · rw [hprod]
      simp only [Int.cast_natCast]
      rcases hmodb with hm | hm <;> simp only [hm, Nat.cast_ofNat] <;> linarith
  apply ML_lower_of_witness (by simp) (x : Time)
  intro v hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · exact hx1
  · exact hx2
  · exact hxa
  · exact hxb

theorem one_two_residue_three_window (a b : ℕ) (hb : 11 ≤ b)
    (hmodb : b % 4 = 3) (hba : b ≤ a) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, b} : Finset ℕ) := by
  have hbr : (11 : ℝ) ≤ b := by exact_mod_cast hb
  have hbpos : (0 : ℝ) < b := by linarith
  have hbar : (b : ℝ) ≤ a := by exact_mod_cast hba
  have htail : (1 : ℝ) / (b : ℝ) ≤ 1 / 8 := by
    apply (div_le_iff₀ hbpos).2
    nlinarith
  have hh : (1 / 4 : ℝ) ≤ ML ({1, 2, b, a} : Finset ℕ) := by
    apply one_two_window_lift b a (A := 1 / 4 + (1 / 2) / (b : ℝ))
      (B := 1 / 4 + 1 / (b : ℝ)) (by omega)
    · have hn : (0 : ℝ) ≤ (1 / 2 : ℝ) / (b : ℝ) := by positivity
      linarith
    · linarith
    · have he : (a : ℝ) * ((1 / 4 + 1 / (b : ℝ)) -
          (1 / 4 + (1 / 2) / (b : ℝ))) = (a : ℝ) / (2 * (b : ℝ)) := by
          field_simp [ne_of_gt hbpos] <;> ring
      rw [he]
      apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2 * (b : ℝ))).2
      nlinarith
    · intro x hxlo hxhi
      have hpl := quarter_shift_product b (by omega) (1 / 2)
      have hpu := quarter_shift_product b (by omega) 1
      simp only [hmodb, Nat.cast_ofNat] at hpl hpu
      have hl := mul_le_mul_of_nonneg_left hxlo hbpos.le
      have hu := mul_le_mul_of_nonneg_left hxhi hbpos.le
      rw [hpl] at hl
      rw [hpu] at hu
      apply distance_ge_quarter_of_interval (j := ((b / 4 : ℕ) : ℤ) + 1)
      · simp only [Int.cast_add, Int.cast_natCast, Int.cast_one]
        linarith
      · simp only [Int.cast_add, Int.cast_natCast, Int.cast_one]
        linarith
  have hset : ({1, 2, b, a} : Finset ℕ) = {1, 2, a, b} := by
    ext v
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
  rw [hset] at hh
  exact hh

theorem one_two_seven_window (a : ℕ) (ha : 12 ≤ a) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, 7} : Finset ℕ) := by
  have har : (12 : ℝ) ≤ a := by exact_mod_cast ha
  have hh : (1 / 4 : ℝ) ≤ ML ({1, 2, 7, a} : Finset ℕ) := by
    apply one_two_window_lift 7 a (A := 9 / 28) (B := 3 / 8) (by omega)
    · norm_num
    · exact le_rfl
    · nlinarith
    · intro x hxlo hxhi
      apply distance_ge_quarter_of_interval (j := 2) <;> norm_num <;> linarith
  have hset : ({1, 2, 7, a} : Finset ℕ) = {1, 2, a, 7} := by
    ext v
    simp only [Finset.mem_insert, Finset.mem_singleton]
    tauto
  rw [hset] at hh
  exact hh

theorem one_two_eight_seven :
    (1 / 4 : ℝ) ≤ ML ({1, 2, 8, 7} : Finset ℕ) := by
  apply ML_lower_of_witness (by simp) (((9 : ℝ) / (28 : ℝ)) : Time)
  intro v hv
  have he := distance_at_rational v 9 28
  simp only [Nat.cast_ofNat] at he
  rw [he]
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl <;> norm_num

/-- The complete quarter-distance construction unless the fourth speed is
three. This is uniform in both unrestricted integer speeds. -/
theorem one_two_fourth_not_three (a b : ℕ) (ha : 0 < a)
    (hb : 0 < b) (hmoda : a % 4 = 0) (hmodb : b % 4 ≠ 0)
    (hb3 : b ≠ 3) :
    (1 / 4 : ℝ) ≤ ML ({1, 2, a, b} : Finset ℕ) := by
  have ha4 : 4 ≤ a := by omega
  by_cases hsmall : b ≤ a
  · by_cases hmod : b % 4 = 1 ∨ b % 4 = 2
    · exact one_two_small_residue a b ha4 hsmall hmoda hmod
    · have hmod3 : b % 4 = 3 := by
        have ht := Nat.mod_lt b (by norm_num : 0 < 4)
        omega
      have hb7 : b = 7 ∨ 11 ≤ b := by omega
      rcases hb7 with rfl | hb11
      · by_cases ha8 : a = 8
        · subst a
          exact one_two_eight_seven
        · have ha12 : 12 ≤ a := by omega
          exact one_two_seven_window a ha12
      · exact one_two_residue_three_window a b hb11 hmod3 hsmall
  · by_cases haeq : a = 4
    · subst a
      exact ML_ge_quarter_one_two_four b (by omega)
    · have ha8 : 8 ≤ a := by omega
      exact one_two_large_four_window a b ha8 hmoda (by omega)

/-- Any low-loneliness set satisfying the source05 hypotheses and containing
speeds one and two must contain their sum, three. Primitivity is automatic
from membership of one, and is therefore not an additional premise. -/
theorem three_mem_of_one_two_low {V : Finset ℕ}
    (hpos : Positive V) (hcard : V.card = 4)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (h1 : 1 ∈ V) (h2 : 2 ∈ V) (hlow : ML V < (1 / 4 : ℝ)) :
    3 ∈ V := by
  classical
  obtain ⟨a, ha, huniq⟩ := unique_four_dvd_of_ML_lt_quarter ⟨1, h1⟩ hpair hlow
  have hap : 0 < a := hpos a ha.1
  have hamod : a % 4 = 0 := Nat.mod_eq_zero_of_dvd ha.2
  have ha1 : a ≠ 1 := by omega
  have ha2 : a ≠ 2 := by omega
  have htriple : ({1, 2, a} : Finset ℕ) ⊆ V := by
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl
    · exact h1
    · exact h2
    · exact ha.1
  have htriplecard : ({1, 2, a} : Finset ℕ).card = 3 := by
    simp [ha1, ha2, Ne.symm ha1, Ne.symm ha2]
  have hdiff : (V \ {1, 2, a}).Nonempty := by
    apply Finset.card_pos.mp
    rw [Finset.card_sdiff_of_subset htriple, hcard, htriplecard]
    norm_num
  obtain ⟨b, hb⟩ := hdiff
  have hbV : b ∈ V := (Finset.mem_sdiff.mp hb).1
  have hbn : b ∉ ({1, 2, a} : Finset ℕ) := (Finset.mem_sdiff.mp hb).2
  have hb1 : b ≠ 1 := by intro he; subst b; simp at hbn
  have hb2 : b ≠ 2 := by intro he; subst b; simp at hbn
  have hba : b ≠ a := by intro he; subst b; simp at hbn
  have hbpos : 0 < b := hpos b hbV
  have hquad : ({1, 2, a, b} : Finset ℕ) ⊆ V := by
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact h1
    · exact h2
    · exact ha.1
    · exact hbV
  have hquadcard : ({1, 2, a, b} : Finset ℕ).card = 4 := by
    simp [ha1, ha2, hb1, hb2, hba, Ne.symm ha1, Ne.symm ha2,
      Ne.symm hb1, Ne.symm hb2, Ne.symm hba]
  have heq : ({1, 2, a, b} : Finset ℕ) = V :=
    Finset.eq_of_subset_of_card_le hquad (by omega)
  have hbmod : b % 4 ≠ 0 := by
    intro hz
    have hb4 : 4 ∣ b := Nat.dvd_of_mod_eq_zero hz
    have he : b = a := huniq b ⟨hbV, hb4⟩
    exact hba he
  by_contra h3
  have hb3 : b ≠ 3 := by intro he; exact h3 (he ▸ hbV)
  have hge := one_two_fourth_not_three a b hap hbpos hamod hbmod hb3
  rw [heq] at hge
  exact (not_le_of_gt hlow) hge





end Math15.LonelyRunner
end 
end 

/- Section: OneTwoClosure -/
section



/-!
Exact original spectrum disjunction on the branch with 1,2 in V. The extra
branch restriction is explicit; this is not Target05 globally.
-/
noncomputable section
namespace Math15.LonelyRunner

theorem source05_of_one_two {V : Finset ℕ}
    (hp : Positive V) (hc : V.card = 4)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (h1 : 1 ∈ V) (h2 : 2 ∈ V) :
    (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML V = (s : ℝ) / (4 * (s : ℝ) + k) := by
  by_cases hq : (1 / 4 : ℝ) ≤ ML V
  · exact Or.inl hq
  have hlow : ML V < (1 / 4 : ℝ) := lt_of_not_ge hq
  have h3 := three_mem_of_one_two_low hp hc hpair h1 h2 hlow
  obtain ⟨a, ha, _⟩ := unique_four_dvd_of_ML_lt_quarter ⟨1, h1⟩ hpair hlow
  have hap := hp a ha.1
  obtain ⟨s, has⟩ := ha.2
  have hs : 1 ≤ s := by omega
  have hd1 : 4 * s ≠ 1 := by omega
  have hd2 : 4 * s ≠ 2 := by omega
  have hd3 : 4 * s ≠ 3 := by omega
  have hsub : tightFour s ⊆ V := by
    intro v hv
    simp only [tightFour, Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact h1
    · exact h2
    · exact h3
    · simpa only [has] using ha.1
  have hcard : (tightFour s).card = 4 := by
    simp [tightFour, hd1, hd2, hd3, Ne.symm hd1, Ne.symm hd2, Ne.symm hd3]
  have hset : tightFour s = V := Finset.eq_of_subset_of_card_le hsub (by omega)
  right
  refine ⟨s, 1, by norm_num, by norm_num, hs, ?_⟩
  rw [← hset]
  simpa only [Nat.cast_one] using tightFour_exact s hs


end Math15.LonelyRunner
end 
end 

/- Section: TwoFourMirror -/
section


/-!
The mirror argument for {2,4,b,c} with two odd speeds.
-/

noncomputable section
namespace Math15.LonelyRunner

/-- For an odd speed, the two half-reflected times have total circle
distance at least one half, by the triangle inequality. -/
theorem odd_half_mirror_distance_sum {v : ℕ} (hv : v % 2 = 1) (t : Time) :
    (1 / 2 : ℝ) ≤ distance (v • t) +
      distance (v • (((1 / 2 : ℝ) : Time) - t)) := by
  have hn : v = 2 * (v / 2) + 1 := by omega
  have hr : (v : ℝ) = 2 * (v / 2 : ℕ) + 1 := by exact_mod_cast hn
  have hz : (((v / 2 : ℕ) : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨(v / 2 : ℕ), by simp only [zsmul_eq_mul, Int.cast_natCast, mul_one]⟩
  have hhalf : v • ((1 / 2 : ℝ) : Time) = ((1 / 2 : ℝ) : Time) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    have he : (v : ℝ) * (1 / 2) = (v / 2 : ℕ) + 1 / 2 := by nlinarith
    rw [he, AddCircle.coe_add, hz, zero_add]
  have hs : v • t + v • (((1 / 2 : ℝ) : Time) - t) =
      v • ((1 / 2 : ℝ) : Time) := by
    rw [← nsmul_add]
    congr 1
    abel
  have htriangle := norm_add_le (v • t) (v • (((1 / 2 : ℝ) : Time) - t))
  rw [hs, hhalf] at htriangle
  have hh : ‖((1 / 2 : ℝ) : Time)‖ = (1 / 2 : ℝ) := by
    simpa using AddCircle.norm_half_period_eq (1 : ℝ)
  rw [hh] at htriangle
  exact htriangle

theorem distance_coe_quarter_translate (j : ℤ) :
    distance ((((j : ℝ) + 1 / 4 : ℝ)) : Time) = (1 / 4 : ℝ) := by
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  rw [AddCircle.coe_add, hz, zero_add]
  have hq := distance_quarter 1
  norm_num at hq
  exact hq

theorem distance_coe_three_quarter_translate (j : ℤ) :
    distance ((((j : ℝ) + 3 / 4 : ℝ)) : Time) = (1 / 4 : ℝ) := by
  have hz : ((j : ℝ) : Time) = 0 := by
    apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).2
    exact ⟨j, by simp [zsmul_eq_mul]⟩
  rw [AddCircle.coe_add, hz, zero_add]
  have hq := distance_at_rational 1 3 4
  norm_num at hq
  exact hq

/-- Quarter-level points alternate at gaps of exactly one half. -/
theorem exists_exact_quarter_in_half_interval (x : ℝ) :
    ∃ y : ℝ, x ≤ y ∧ y ≤ x + 1 / 2 ∧
      distance (y : Time) = (1 / 4 : ℝ) := by
  let j : ℤ := Int.floor x
  have hlo : (j : ℝ) ≤ x := Int.floor_le x
  have hhi : x < (j : ℝ) + 1 := Int.lt_floor_add_one x
  by_cases hleft : x ≤ (j : ℝ) + 1 / 4
  · exact ⟨(j : ℝ) + 1 / 4, hleft, by linarith,
      distance_coe_quarter_translate j⟩
  by_cases hmiddle : x ≤ (j : ℝ) + 3 / 4
  · exact ⟨(j : ℝ) + 3 / 4, hmiddle, by linarith,
      distance_coe_three_quarter_translate j⟩
  · refine ⟨(j : ℝ) + 5 / 4, by linarith, by linarith, ?_⟩
    have hq := distance_coe_quarter_translate (j + 1)
    push_cast at hq
    convert hq using 1 <;> congr 1 <;> ring

theorem exists_exact_quarter_witness_in_interval {A B : ℝ} {d : ℕ}
    (hd : 0 < d) (hwidth : (1 / 2 : ℝ) ≤ (d : ℝ) * (B - A)) :
    ∃ x : ℝ, A ≤ x ∧ x ≤ B ∧
      distance (d • (x : Time)) = (1 / 4 : ℝ) := by
  have hdr : (0 : ℝ) < d := by exact_mod_cast hd
  obtain ⟨y, hylo, hyhi, hyq⟩ := exists_exact_quarter_in_half_interval ((d : ℝ) * A)
  refine ⟨y / (d : ℝ), ?_, ?_, ?_⟩
  · apply (le_div_iff₀ hdr).2
    simpa only [mul_comm] using hylo
  · apply (div_le_iff₀ hdr).2
    nlinarith
  · rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    have he : (d : ℝ) * (y / (d : ℝ)) = y := by
      field_simp [ne_of_gt hdr]
    simpa only [he] using hyq

/-- Every odd speed at least five reaches exactly a quarter somewhere in
the common good interval of speeds two and four. -/
theorem odd_exact_quarter_in_two_four_interval {b : ℕ}
    (hb : 5 ≤ b) (hodd : b % 2 = 1) :
    ∃ x : ℝ, (1 / 8 : ℝ) ≤ x ∧ x ≤ (3 / 16 : ℝ) ∧
      distance (b • (x : Time)) = (1 / 4 : ℝ) := by
  by_cases hlarge : 8 ≤ b
  · apply exists_exact_quarter_witness_in_interval (d := b) (by omega)
    have hbr : (8 : ℝ) ≤ b := by exact_mod_cast hlarge
    nlinarith
  · have hcases : b = 5 ∨ b = 7 := by omega
    rcases hcases with rfl | rfl
    · refine ⟨3 / 20, by norm_num, by norm_num, ?_⟩
      have he := distance_at_rational 5 3 20
      norm_num at he
      exact he
    · refine ⟨5 / 28, by norm_num, by norm_num, ?_⟩
      have he := distance_at_rational 7 5 28
      norm_num at he
      exact he

/-- If {2,4} is accompanied by two odd speeds and one is at least five,
the quartet has loneliness at least one quarter. -/
theorem ML_ge_quarter_two_four_two_odd {b c : ℕ}
    (hb : 5 ≤ b) (hbo : b % 2 = 1) (hco : c % 2 = 1) :
    (1 / 4 : ℝ) ≤ ML ({2, 4, b, c} : Finset ℕ) := by
  obtain ⟨x, hxlo, hxhi, hxb⟩ := odd_exact_quarter_in_two_four_interval hb hbo
  have hbm := odd_half_mirror_distance_sum hbo (x : Time)
  have hcm := odd_half_mirror_distance_sum hco (x : Time)
  have hmirror : (((1 / 2 : ℝ) : Time) - (x : Time)) =
      (((1 / 2 - x : ℝ)) : Time) := by rw [AddCircle.coe_sub]
  by_cases hc : (1 / 4 : ℝ) ≤ distance (c • (x : Time))
  · apply ML_lower_of_witness (by simp) (x : Time)
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_interval (j := 0) (by norm_num; linarith)
        (by norm_num; linarith)
    · exact distance_ge_quarter_of_interval (j := 0) (by norm_num; linarith)
        (by norm_num; linarith)
    · exact le_of_eq hxb.symm
    · exact hc
  · apply ML_lower_of_witness (by simp) (((1 / 2 - x : ℝ)) : Time)
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · exact distance_ge_quarter_of_interval (j := 0) (by norm_num; linarith)
        (by norm_num; linarith)
    · exact distance_ge_quarter_of_interval (j := 1) (by norm_num; linarith)
        (by norm_num; linarith)
    · rw [hmirror, hxb] at hbm
      linarith
    · rw [hmirror] at hcm
      linarith









end Math15.LonelyRunner
end 
end 

/- Section: TwoFourEven -/
section


/-!
The residue-witness complement to the two-four mirror argument.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem distance_eighth_ge_quarter_of_residue {v m : ℕ}
    (hl : 2 ≤ (v * m) % 8) (hu : (v * m) % 8 ≤ 6) :
    (1 / 4 : ℝ) ≤ distance (v • ((((m : ℝ) / (8 : ℝ)) : ℝ) : Time)) := by
  have hd := distance_at_rational v m 8
  norm_num only [Nat.cast_ofNat] at hd
  rw [hd]
  have hm : 2 ≤ min ((v * m) % 8) (8 - (v * m) % 8) := by omega
  have hmr : (2 : ℝ) ≤ (min ((v * m) % 8) (8 - (v * m) % 8) : ℕ) := by
    exact_mod_cast hm
  norm_num only [Nat.cast_ofNat]
  linarith

/-- If one extra speed is two modulo four and the other avoids zero modulo
four, either one eighth or three eighths is a common quarter witness. -/
theorem ML_ge_quarter_two_four_even_other {b c : ℕ}
    (hb : b % 4 = 2) (hc : c % 4 ≠ 0) :
    (1 / 4 : ℝ) ≤ ML ({2, 4, b, c} : Finset ℕ) := by
  have hquarter1 (v : ℕ) (hl : 2 ≤ v % 8) (hu : v % 8 ≤ 6) :
      (1 / 4 : ℝ) ≤ distance (v • (((1 : ℝ) / (8 : ℝ)) : Time)) := by
    simpa only [Nat.cast_one, Nat.mul_one] using
      distance_eighth_ge_quarter_of_residue (v := v) (m := 1)
        (by simpa only [Nat.mul_one] using hl)
        (by simpa only [Nat.mul_one] using hu)
  have hquarter3 (v : ℕ) (hl : 2 ≤ (v * 3) % 8) (hu : (v * 3) % 8 ≤ 6) :
      (1 / 4 : ℝ) ≤ distance (v • (((3 : ℝ) / (8 : ℝ)) : Time)) := by
    simpa only [Nat.cast_ofNat] using
      distance_eighth_ge_quarter_of_residue (v := v) (m := 3) hl hu
  have hbm := Nat.mod_mod_of_dvd b (by norm_num : 4 ∣ 8)
  have hcm := Nat.mod_mod_of_dvd c (by norm_num : 4 ∣ 8)
  have hb8lt := Nat.mod_lt b (by norm_num : 0 < 8)
  have hc8lt := Nat.mod_lt c (by norm_num : 0 < 8)
  have hb8 : b % 8 = 2 ∨ b % 8 = 6 := by omega
  have hc8 : c % 8 = 1 ∨ c % 8 = 2 ∨ c % 8 = 3 ∨
      c % 8 = 5 ∨ c % 8 = 6 ∨ c % 8 = 7 := by omega
  by_cases hcg : 2 ≤ c % 8 ∧ c % 8 ≤ 6
  · apply ML_lower_of_witness (by simp) ((((1 : ℝ) / (8 : ℝ)) : ℝ) : Time)
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · apply hquarter1 <;> norm_num
    · apply hquarter1 <;> norm_num
    · apply hquarter1 <;> omega
    · apply hquarter1 <;> omega
  · have hcnot : c % 8 = 1 ∨ c % 8 = 7 := by omega
    have hbm3 : 2 ≤ (b * 3) % 8 ∧ (b * 3) % 8 ≤ 6 := by
      rw [Nat.mul_mod]
      rcases hb8 with h | h <;> rw [h] <;> norm_num
    have hcm3 : 2 ≤ (c * 3) % 8 ∧ (c * 3) % 8 ≤ 6 := by
      rw [Nat.mul_mod]
      rcases hcnot with h | h <;> rw [h] <;> norm_num
    apply ML_lower_of_witness (by simp) ((((3 : ℝ) / (8 : ℝ)) : ℝ) : Time)
    intro v hv
    simp only [Finset.mem_insert, Finset.mem_singleton] at hv
    rcases hv with rfl | rfl | rfl | rfl
    · apply hquarter3 <;> norm_num
    · apply hquarter3 <;> norm_num
    · exact hquarter3 _ hbm3.1 hbm3.2
    · exact hquarter3 _ hcm3.1 hcm3.2




end Math15.LonelyRunner
end 
end 

/- Section: TwoFourClosure -/
section




/-!
Exact Source05 disjunction on the explicitly restricted branch 2,4 in V.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem one_mem_of_two_four_low {V : Finset ℕ}
    (hp : Positive V) (hc : V.card = 4)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (h2 : 2 ∈ V) (h4 : 4 ∈ V) (hlow : ML V < (1 / 4 : ℝ)) :
    1 ∈ V := by
  let W : Finset ℕ := (V.erase 2).erase 4
  have h4e : 4 ∈ V.erase 2 := by simp [h4]
  have hWcard : W.card = 2 := by
    dsimp [W]
    rw [Finset.card_erase_of_mem h4e, Finset.card_erase_of_mem h2, hc]
  obtain ⟨b, c, hbc, hW⟩ := Finset.card_eq_two.mp hWcard
  have hbW : b ∈ W := by rw [hW]; simp
  have hcW : c ∈ W := by rw [hW]; simp
  have hbV : b ∈ V := Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hbW)
  have hcV : c ∈ V := Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hcW)
  have hb4 : b ≠ 4 := (Finset.mem_erase.mp hbW).1
  have hc4 : c ≠ 4 := (Finset.mem_erase.mp hcW).1
  have hset : V = ({2, 4, b, c} : Finset ℕ) := by
    have he : insert 2 (insert 4 W) = V := by
      dsimp [W]
      rw [Finset.insert_erase h4e, Finset.insert_erase h2]
    rw [hW] at he
    exact he.symm
  have hbm : b % 4 ≠ 0 := by
    intro hz
    exact hb4 (eq_of_four_dvd hpair hbV h4 (Nat.dvd_of_mod_eq_zero hz) (by norm_num))
  have hcm : c % 4 ≠ 0 := by
    intro hz
    exact hc4 (eq_of_four_dvd hpair hcV h4 (Nat.dvd_of_mod_eq_zero hz) (by norm_num))
  by_cases hb2 : b % 4 = 2
  · exfalso
    apply (not_le_of_gt hlow)
    rw [hset]
    exact ML_ge_quarter_two_four_even_other hb2 hcm
  by_cases hc2 : c % 4 = 2
  · exfalso
    apply (not_le_of_gt hlow)
    rw [hset]
    have hq := ML_ge_quarter_two_four_even_other hc2 hbm
    have hswap : ({2, 4, c, b} : Finset ℕ) = {2, 4, b, c} := by
      ext x
      simp only [Finset.mem_insert, Finset.mem_singleton]
      tauto
    rw [hswap] at hq
    exact hq
  have hbo : b % 2 = 1 := by
    have hm := Nat.mod_mod_of_dvd b (by norm_num : 2 ∣ 4)
    have hl := Nat.mod_lt b (by norm_num : 0 < 4)
    omega
  have hco : c % 2 = 1 := by
    have hm := Nat.mod_mod_of_dvd c (by norm_num : 2 ∣ 4)
    have hl := Nat.mod_lt c (by norm_num : 0 < 4)
    omega
  by_cases hb5 : 5 ≤ b
  · exfalso
    apply (not_le_of_gt hlow)
    rw [hset]
    exact ML_ge_quarter_two_four_two_odd hb5 hbo hco
  by_cases hc5 : 5 ≤ c
  · exfalso
    apply (not_le_of_gt hlow)
    rw [hset]
    have hq := ML_ge_quarter_two_four_two_odd hc5 hco hbo
    have hswap : ({2, 4, c, b} : Finset ℕ) = {2, 4, b, c} := by
      ext x
      simp only [Finset.mem_insert, Finset.mem_singleton]
      tauto
    rw [hswap] at hq
    exact hq
  have hbp := hp b hbV
  have hcp := hp c hcV
  have h1 : b = 1 ∨ c = 1 := by omega
  rcases h1 with h | h
  · simpa only [h] using hbV
  · simpa only [h] using hcV

theorem source05_of_two_four {V : Finset ℕ}
    (hp : Positive V) (hc : V.card = 4)
    (hpair : ∀ u ∈ V, ∀ v ∈ V, u ≠ v → Nat.gcd u v ≤ 2)
    (h2 : 2 ∈ V) (h4 : 4 ∈ V) :
    (1 / 4 : ℝ) ≤ ML V ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ s ∧
      ML V = (s : ℝ) / (4 * (s : ℝ) + k) := by
  by_cases hq : (1 / 4 : ℝ) ≤ ML V
  · exact Or.inl hq
  have hlow : ML V < (1 / 4 : ℝ) := lt_of_not_ge hq
  have h1 := one_mem_of_two_four_low hp hc hpair h2 h4 hlow
  exact source05_of_one_two hp hc hpair h1 h2




end Math15.LonelyRunner
end 
end 

/- Section: U2Core -/
section


/-!
# Continuous U2 core bounds

Paper argument for the quarter upper bound: lift x and y on the unit circle to
X,Y in [0,1). If either lift lies outside (1/4,3/4), its distance is at most
1/4. Otherwise, if 3/4 <= X+Y <= 5/4, the sum is within 1/4 of 1. If X+Y<3/4,
then Y<1/2 and 3/4<X+2Y<5/4. If X+Y>5/4, then Y>1/2 and 7/4<X+2Y<9/4. In the
latter two cases X+2Y is within 1/4 of 1 or 2. Apply this with x=A*t and
y=B*t.

Positivity holds for every nonempty finite positive speed set. Let D be its
largest speed and take time 1/(4D). Every circle distance is then v/(4D),
between 1/(4D) and 1/4, so the maximum is positive.

No equality with the U2 grid formula is asserted here.
-/

noncomputable section
namespace Math15.LonelyRunner

def U2Speeds (A B : ℕ) : Finset ℕ := {A, B, A + B, A + 2 * B}

theorem U2Speeds_nonempty (A B : ℕ) : (U2Speeds A B).Nonempty := by
  exact ⟨A, by simp [U2Speeds]⟩

theorem U2Speeds_positive {A B : ℕ} (hA : 0 < A) (hB : 0 < B) :
    Positive (U2Speeds A B) := by
  intro v hv
  have hv' : v = A ∨ v = B ∨ v = A + B ∨ v = A + 2 * B := by
    simpa only [U2Speeds, Finset.mem_insert, Finset.mem_singleton] using hv
  rcases hv' with rfl | rfl | rfl | rfl <;> omega

/-- Four actual distances on the same torus point cover the quarter barrier. -/
theorem U2_circle_quarter_cover (x y : Time) :
    distance x ≤ (1 / 4 : ℝ) ∨ distance y ≤ (1 / 4 : ℝ) ∨
      distance (x + y) ≤ (1 / 4 : ℝ) ∨ distance (x + 2 • y) ≤ (1 / 4 : ℝ) := by
  letI : Fact (0 < (1 : ℝ)) := ⟨by norm_num⟩
  obtain ⟨X, hX, rfl⟩ := AddCircle.eq_coe_Ico x
  obtain ⟨Y, hY, rfl⟩ := AddCircle.eq_coe_Ico y
  rcases hX with ⟨hX0, hX1⟩
  rcases hY with ⟨hY0, hY1⟩
  by_cases hXl : X ≤ (1 / 4 : ℝ)
  · left
    apply (distance_coe_le_integer X 0).trans
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  by_cases hXu : (3 / 4 : ℝ) ≤ X
  · left
    apply (distance_coe_le_integer X 1).trans
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  by_cases hYl : Y ≤ (1 / 4 : ℝ)
  · right; left
    apply (distance_coe_le_integer Y 0).trans
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  by_cases hYu : (3 / 4 : ℝ) ≤ Y
  · right; left
    apply (distance_coe_le_integer Y 1).trans
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  have hXquarter : (1 / 4 : ℝ) < X := lt_of_not_ge hXl
  have hYquarter : (1 / 4 : ℝ) < Y := lt_of_not_ge hYl
  have hXthree : X < (3 / 4 : ℝ) := lt_of_not_ge hXu
  have hYthree : Y < (3 / 4 : ℝ) := lt_of_not_ge hYu
  have hsum : (X : Time) + (Y : Time) = ((X + Y : ℝ) : Time) := by
    rw [AddCircle.coe_add]
  have hdouble : (X : Time) + 2 • (Y : Time) = ((X + 2 * Y : ℝ) : Time) := by
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul, AddCircle.coe_add]
    simp only [Nat.cast_ofNat]
  by_cases hlow : X + Y ≤ (3 / 4 : ℝ)
  · right; right; right
    rw [hdouble]
    apply (distance_coe_le_integer (X + 2 * Y) 1).trans
    have hYhalf : Y < (1 / 2 : ℝ) := by linarith
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  by_cases hhigh : (5 / 4 : ℝ) ≤ X + Y
  · right; right; right
    rw [hdouble]
    apply (distance_coe_le_integer (X + 2 * Y) 2).trans
    have hYhalf : (1 / 2 : ℝ) < Y := by linarith
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩
  · right; right; left
    rw [hsum]
    apply (distance_coe_le_integer (X + Y) 1).trans
    exact abs_le.mpr ⟨by norm_num; linarith, by norm_num; linarith⟩

theorem U2_score_le_quarter (A B : ℕ) (t : Time) :
    score (U2Speeds A B) t ≤ (1 / 4 : ℝ) := by
  have hC : (A + B) • t = A • t + B • t := by rw [add_nsmul]
  have hD : (A + 2 * B) • t = A • t + 2 • (B • t) := by
    rw [Nat.mul_comm 2 B, add_nsmul, mul_nsmul]
  rcases U2_circle_quarter_cover (A • t) (B • t) with ha | hb | hc | hd
  · exact (score_le_distance (V := U2Speeds A B) (v := A)
      (by simp [U2Speeds]) t).trans ha
  · exact (score_le_distance (V := U2Speeds A B) (v := B)
      (by simp [U2Speeds]) t).trans hb
  · apply (score_le_distance (V := U2Speeds A B) (v := A + B)
      (by simp [U2Speeds]) t).trans
    simpa only [hC] using hc
  · apply (score_le_distance (V := U2Speeds A B) (v := A + 2 * B)
      (by simp [U2Speeds]) t).trans
    simpa only [hD] using hd

theorem U2_ML_le_quarter (A B : ℕ) : ML (U2Speeds A B) ≤ (1 / 4 : ℝ) := by
  exact ML_upper_of_all_times (U2_score_le_quarter A B)

/-- A concrete uniform positive witness for every nonempty positive finite set. -/
theorem ML_lower_small_time {V : Finset ℕ} (hV : V.Nonempty) (hpositive : Positive V) :
    (1 : ℝ) / (4 * ((V.sup id : ℕ) : ℝ)) ≤ ML V := by
  let D : ℕ := V.sup id
  have hDpos : 0 < D := by
    obtain ⟨v, hv⟩ := hV
    have hvD : v ≤ D := Finset.le_sup (f := id) hv
    have hvpos := hpositive v hv
    omega
  have hDR : (0 : ℝ) < D := by exact_mod_cast hDpos
  let x : ℝ := 1 / (4 * (D : ℝ))
  have hxpos : 0 < x := by dsimp [x]; positivity
  apply ML_lower_of_witness hV (x : Time)
  intro v hv
  have hvpos : 0 < v := hpositive v hv
  have hv1R : (1 : ℝ) ≤ v := by exact_mod_cast (show 1 ≤ v by omega)
  have hvD : v ≤ D := Finset.le_sup (f := id) hv
  have hvDR : (v : ℝ) ≤ D := by exact_mod_cast hvD
  have hzpos : 0 ≤ (v : ℝ) * x := mul_nonneg (Nat.cast_nonneg _) hxpos.le
  have hzquarter : (v : ℝ) * x ≤ (1 / 4 : ℝ) := by
    dsimp [x]
    rw [← mul_div_assoc, mul_one]
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 4 * (D : ℝ))).2
    nlinarith [hvDR]
  have hdist : distance (v • (x : Time)) = (v : ℝ) * x := by
    unfold distance
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
    calc
      ‖(((v : ℝ) * x : ℝ) : Time)‖ = |(v : ℝ) * x| :=
        (AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).2
          (by rw [abs_of_nonneg hzpos, abs_one]; linarith)
      _ = (v : ℝ) * x := abs_of_nonneg hzpos
  rw [hdist]
  have hmul := mul_le_mul_of_nonneg_right hv1R hxpos.le
  simpa only [one_mul] using hmul

theorem ML_pos_of_nonempty_positive {V : Finset ℕ}
    (hV : V.Nonempty) (hpositive : Positive V) : 0 < ML V := by
  have hDpos : 0 < V.sup id := by
    obtain ⟨v, hv⟩ := hV
    have hvD : v ≤ V.sup id := Finset.le_sup (f := id) hv
    have hvpos := hpositive v hv
    omega
  have hDR : (0 : ℝ) < ((V.sup id : ℕ) : ℝ) := by exact_mod_cast hDpos
  exact lt_of_lt_of_le (by positivity : (0 : ℝ) < 1 / (4 * ((V.sup id : ℕ) : ℝ)))
    (ML_lower_small_time hV hpositive)

theorem U2_ML_pos {A B : ℕ} (hA : 0 < A) (hB : 0 < B) :
    0 < ML (U2Speeds A B) := by
  exact ML_pos_of_nonempty_positive (U2Speeds_nonempty A B) (U2Speeds_positive hA hB)

theorem U2_ML_lt_half (A B : ℕ) : ML (U2Speeds A B) < (1 / 2 : ℝ) := by
  have h := U2_ML_le_quarter A B
  linarith








end Math15.LonelyRunner
end 
end 

/- Section: WeightedTripleGrid -/
section



/-!
# Coprime multiplication preserves the exact triple-grid maximum

Paper argument: multiplication by a is a permutation of the residues modulo n
when gcd(a,n)=1. The upper bound holds because a*m is itself an integer
numerator on the n-grid. For attainment, choose m with a*m congruent to
floor(n/4) modulo n. Multiplying that congruence by each of 1,2,3 preserves
all three actual circle distances, so the exact floor(n/4)/n maximum is
attained at that common m.

This common-witness step is used by the Q, R, and S grid computations below.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem nsmul_rational_time_nat (a m n : ℕ) :
    a • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time) =
      ((((a * m : ℕ) : ℝ) / (n : ℝ)) : Time) := by
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  congr 1
  push_cast
  ring

/-- Multiplication congruence preserves every triple distance at the same
time; no separate witnesses for the three runners are combined. -/
theorem triple_score_eq_of_mul_mod {a m k n : ℕ}
    (hmod : (a * m) % n = k % n) :
    score tripleSpeeds (((((a * m : ℕ) : ℝ) / (n : ℝ)) : ℝ) : Time) =
      score tripleSpeeds ((((k : ℝ) / (n : ℝ)) : ℝ) : Time) := by
  simp only [score, dif_pos tripleSpeeds_nonempty]
  apply Finset.inf'_congr tripleSpeeds_nonempty rfl
  intro v hv
  have hnum : (v * (a * m)) % n = (v * k) % n := by
    calc
      _ = ((v % n) * ((a * m) % n)) % n := Nat.mul_mod _ _ _
      _ = ((v % n) * (k % n)) % n := by rw [hmod]
      _ = (v * k) % n := (Nat.mul_mod _ _ _).symm
  simp only [distance_at_rational, hnum]

theorem weighted_triple_grid_upper (a m n : ℕ) (hn : 0 < n) :
    score tripleSpeeds (a • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)) ≤
      ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  rw [nsmul_rational_time_nat]
  exact triple_score_grid_upper (a * m) n hn

theorem weighted_triple_grid_attained (a n : ℕ)
    (hn : 0 < n) (hcop : Nat.Coprime a n) :
    ∃ m : ℕ, m < n ∧
      score tripleSpeeds (a • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)) =
        ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  obtain ⟨m, hm, hmod⟩ := Nat.exists_mul_mod_eq_of_coprime
    (n / 4) hcop (Nat.ne_of_gt hn)
  refine ⟨m, hm, ?_⟩
  rw [nsmul_rational_time_nat, triple_score_eq_of_mul_mod hmod]
  exact triple_score_grid_floor n hn

/-- The full exact maximum certificate includes both all-grid coverage and
one attaining numerator supplied by the same coprime modular permutation. -/
theorem weighted_triple_grid_maximum (a n : ℕ)
    (hn : 0 < n) (hcop : Nat.Coprime a n) :
    (∀ m : ℕ, score tripleSpeeds (a • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)) ≤
      ((n / 4 : ℕ) : ℝ) / (n : ℝ)) ∧
    ∃ m : ℕ, m < n ∧
      score tripleSpeeds (a • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time)) =
        ((n / 4 : ℕ) : ℝ) / (n : ℝ) := by
  exact ⟨fun m => weighted_triple_grid_upper a m n hn,
    weighted_triple_grid_attained a n hn hcop⟩







end Math15.LonelyRunner
end 
end 

/- Section: U2TripleClasses -/
section



/-!
# Three exact U2 pair-sum grid classes

Write C=A+B and D=A+2B. At Q=2A+B=A+C, the equation Q*t=0 identifies the four
actual positions with x,-2x,-x,-3x, where x=A*t. At R=2A+3B=C+D they are
3x,-2x,x,-x, where x=C*t. At S=A+3B=B+D they are -3x,x,-2x,-x, where x=B*t.
Circle norm is even, so each score is exactly the (1,2,3) score at its
specified common x. Coprimality makes each resulting multiplication a
permutation of the denominator grid, giving the exact floor(n/4)/n maximum and
one attaining numerator.

These lemmas evaluate the Q, R, and S grids. The 2C grid and critical-time
assembly are treated in later sections.
-/

noncomputable section
namespace Math15.LonelyRunner

theorem rational_time_annihilated (m n : ℕ) (hn : 0 < n) :
    n • ((((m : ℝ) / (n : ℝ)) : ℝ) : Time) = 0 := by
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hn)
  rw [← AddCircle.coe_nsmul, nsmul_eq_mul]
  have he : (n : ℝ) * ((m : ℝ) / (n : ℝ)) = (m : ℝ) := by
    field_simp
  rw [he]
  apply (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr
  refine ⟨(m : ℤ), ?_⟩
  simp [zsmul_eq_mul]

theorem U2_score_eq_min (A B : ℕ) (t : Time) :
    score (U2Speeds A B) t =
      min (distance (A • t)) (min (distance (B • t))
        (min (distance ((A + B) • t)) (distance ((A + 2 * B) • t)))) := by
  rw [score, dif_pos (U2Speeds_nonempty A B)]
  unfold U2Speeds
  rw [Finset.inf'_insert (by simp)]
  rw [Finset.inf'_insert (by simp)]
  rw [Finset.inf'_insert (Finset.singleton_nonempty _)]
  rw [Finset.inf'_singleton]
  try rfl

theorem triple_score_eq_min (t : Time) :
    score tripleSpeeds t =
      min (distance t) (min (distance (2 • t)) (distance (3 • t))) := by
  rw [score, dif_pos tripleSpeeds_nonempty]
  unfold tripleSpeeds
  rw [Finset.inf'_insert (by simp)]
  rw [Finset.inf'_insert (Finset.singleton_nonempty _)]
  rw [Finset.inf'_singleton]
  simp only [one_nsmul]
  try rfl

theorem distance_neg_eq (x : Time) : distance (-x) = distance x := by
  exact norm_neg x

theorem U2_min_left_repeat (a b : ℝ) : min a (min a b) = min a b := by
  rw [← min_assoc, min_self]

/-- The Q relations hold at one actual torus time, not just for norms. -/
theorem U2_Q_positions (A B : ℕ) (t : Time) (hQ : (2 * A + B) • t = 0) :
    B • t = -(2 • (A • t)) ∧
      (A + B) • t = -(A • t) ∧
      (A + 2 * B) • t = -(3 • (A • t)) := by
  have hQ' : 2 • (A • t) + B • t = 0 := by
    rw [Nat.mul_comm 2 A, add_nsmul, mul_nsmul] at hQ
    exact hQ
  have hB : B • t = -(2 • (A • t)) := by
    apply add_left_cancel (a := 2 • (A • t))
    simpa only [add_neg_cancel] using hQ'
  refine ⟨hB, ?_, ?_⟩
  · rw [add_nsmul, hB]
    abel
  · rw [Nat.mul_comm 2 B, add_nsmul, mul_nsmul, hB]
    abel

/-- The R relations use C*t as the common triple point. -/
theorem U2_R_positions (A B : ℕ) (t : Time) (hR : (2 * A + 3 * B) • t = 0) :
    A • t = 3 • ((A + B) • t) ∧
      B • t = -(2 • ((A + B) • t)) ∧
      (A + 2 * B) • t = -((A + B) • t) := by
  have hCD : (A + 2 * B) • t = (A + B) • t + B • t := by
    rw [← add_nsmul]
    congr 1
    omega
  have hR' : (A + B) • t + (A + 2 * B) • t = 0 := by
    have hn : (A + B) + (A + 2 * B) = 2 * A + 3 * B := by omega
    rw [← add_nsmul, hn]
    exact hR
  have hD : (A + 2 * B) • t = -((A + B) • t) := by
    apply add_left_cancel (a := (A + B) • t)
    simpa only [add_neg_cancel] using hR'
  have hzero : 2 • ((A + B) • t) + B • t = 0 := by
    rw [two_nsmul, add_assoc, ← hCD, hD, add_neg_cancel]
  have hB : B • t = -(2 • ((A + B) • t)) := by
    apply add_left_cancel (a := 2 • ((A + B) • t))
    simpa only [add_neg_cancel] using hzero
  refine ⟨?_, hB, hD⟩
  calc
    A • t = (A + B) • t - B • t := by rw [add_nsmul]; abel
    _ = 3 • ((A + B) • t) := by rw [hB]; abel

/-- The S relations use B*t as the common triple point. -/
theorem U2_S_positions (A B : ℕ) (t : Time) (hS : (A + 3 * B) • t = 0) :
    A • t = -(3 • (B • t)) ∧
      (A + B) • t = -(2 • (B • t)) ∧
      (A + 2 * B) • t = -(B • t) := by
  have hS' : B • t + (A + 2 * B) • t = 0 := by
    have hn : B + (A + 2 * B) = A + 3 * B := by omega
    rw [← add_nsmul, hn]
    exact hS
  have hD : (A + 2 * B) • t = -(B • t) := by
    apply add_left_cancel (a := B • t)
    simpa only [add_neg_cancel] using hS'
  have hAD : (A + 2 * B) • t = A • t + 2 • (B • t) := by
    rw [Nat.mul_comm 2 B, add_nsmul, mul_nsmul]
  have hA : A • t = -(3 • (B • t)) := by
    calc
      A • t = (A + 2 * B) • t - 2 • (B • t) := by rw [hAD]; abel
      _ = -(3 • (B • t)) := by rw [hD]; abel
  refine ⟨hA, ?_, hD⟩
  rw [add_nsmul, hA]
  abel

theorem U2_Q_score_eq_triple (A B : ℕ) (t : Time) (hQ : (2 * A + B) • t = 0) :
    score (U2Speeds A B) t = score tripleSpeeds (A • t) := by
  obtain ⟨hB, hC, hD⟩ := U2_Q_positions A B t hQ
  rw [U2_score_eq_min, triple_score_eq_min, hB, hC, hD]
  simp only [distance_neg_eq]
  simp only [min_assoc, min_left_comm, min_comm, min_self, U2_min_left_repeat]

theorem U2_R_score_eq_triple (A B : ℕ) (t : Time) (hR : (2 * A + 3 * B) • t = 0) :
    score (U2Speeds A B) t = score tripleSpeeds ((A + B) • t) := by
  obtain ⟨hA, hB, hD⟩ := U2_R_positions A B t hR
  rw [U2_score_eq_min, triple_score_eq_min, hA, hB, hD]
  simp only [distance_neg_eq]
  simp only [min_assoc, min_left_comm, min_comm, min_self, U2_min_left_repeat]

theorem U2_S_score_eq_triple (A B : ℕ) (t : Time) (hS : (A + 3 * B) • t = 0) :
    score (U2Speeds A B) t = score tripleSpeeds (B • t) := by
  obtain ⟨hA, hC, hD⟩ := U2_S_positions A B t hS
  rw [U2_score_eq_min, triple_score_eq_min, hA, hC, hD]
  simp only [distance_neg_eq]
  simp only [min_assoc, min_left_comm, min_comm, min_self, U2_min_left_repeat]

theorem U2_Q_score_at_grid (A B m : ℕ) (hn : 0 < 2 * A + B) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * A + B : ℕ)) : ℝ) : Time) =
      score tripleSpeeds (A • ((((m : ℝ) / (2 * A + B : ℕ)) : ℝ) : Time)) := by
  exact U2_Q_score_eq_triple A B _ (rational_time_annihilated m _ hn)

theorem U2_R_score_at_grid (A B m : ℕ) (hn : 0 < 2 * A + 3 * B) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * A + 3 * B : ℕ)) : ℝ) : Time) =
      score tripleSpeeds ((A + B) • ((((m : ℝ) / (2 * A + 3 * B : ℕ)) : ℝ) : Time)) := by
  exact U2_R_score_eq_triple A B _ (rational_time_annihilated m _ hn)

theorem U2_S_score_at_grid (A B m : ℕ) (hn : 0 < A + 3 * B) :
    score (U2Speeds A B) ((((m : ℝ) / (A + 3 * B : ℕ)) : ℝ) : Time) =
      score tripleSpeeds (B • ((((m : ℝ) / (A + 3 * B : ℕ)) : ℝ) : Time)) := by
  exact U2_S_score_eq_triple A B _ (rational_time_annihilated m _ hn)

theorem U2_Q_grid_upper (A B m : ℕ) (hn : 0 < 2 * A + B) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * A + B : ℕ)) : ℝ) : Time) ≤
      (((2 * A + B) / 4 : ℕ) : ℝ) / (2 * A + B : ℕ) := by
  rw [U2_Q_score_at_grid A B m hn]
  exact weighted_triple_grid_upper A m _ hn

theorem U2_R_grid_upper (A B m : ℕ) (hn : 0 < 2 * A + 3 * B) :
    score (U2Speeds A B) ((((m : ℝ) / (2 * A + 3 * B : ℕ)) : ℝ) : Time) ≤
      (((2 * A + 3 * B) / 4 : ℕ) : ℝ) / (2 * A + 3 * B : ℕ) := by
  rw [U2_R_score_at_grid A B m hn]
  exact weighted_triple_grid_upper (A + B) m _ hn

theorem U2_S_grid_upper (A B m : ℕ) (hn : 0 < A + 3 * B) :
    score (U2Speeds A B) ((((m : ℝ) / (A + 3 * B : ℕ)) : ℝ) : Time) ≤
      (((A + 3 * B) / 4 : ℕ) : ℝ) / (A + 3 * B : ℕ) := by
  rw [U2_S_score_at_grid A B m hn]
  exact weighted_triple_grid_upper B m _ hn

theorem U2_Q_grid_attained (A B : ℕ) (hn : 0 < 2 * A + B)
    (hcop : Nat.Coprime A (2 * A + B)) :
    ∃ m : ℕ, m < 2 * A + B ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * A + B : ℕ)) : ℝ) : Time) =
        (((2 * A + B) / 4 : ℕ) : ℝ) / (2 * A + B : ℕ) := by
  obtain ⟨m, hm, he⟩ := weighted_triple_grid_attained A _ hn hcop
  refine ⟨m, hm, ?_⟩
  rw [U2_Q_score_at_grid A B m hn]
  exact he

theorem U2_R_grid_attained (A B : ℕ) (hn : 0 < 2 * A + 3 * B)
    (hcop : Nat.Coprime (A + B) (2 * A + 3 * B)) :
    ∃ m : ℕ, m < 2 * A + 3 * B ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * A + 3 * B : ℕ)) : ℝ) : Time) =
        (((2 * A + 3 * B) / 4 : ℕ) : ℝ) / (2 * A + 3 * B : ℕ) := by
  obtain ⟨m, hm, he⟩ := weighted_triple_grid_attained (A + B) _ hn hcop
  refine ⟨m, hm, ?_⟩
  rw [U2_R_score_at_grid A B m hn]
  exact he

theorem U2_S_grid_attained (A B : ℕ) (hn : 0 < A + 3 * B)
    (hcop : Nat.Coprime B (A + 3 * B)) :
    ∃ m : ℕ, m < A + 3 * B ∧
      score (U2Speeds A B) ((((m : ℝ) / (A + 3 * B : ℕ)) : ℝ) : Time) =
        (((A + 3 * B) / 4 : ℕ) : ℝ) / (A + 3 * B : ℕ) := by
  obtain ⟨m, hm, he⟩ := weighted_triple_grid_attained B _ hn hcop
  refine ⟨m, hm, ?_⟩
  rw [U2_S_score_at_grid A B m hn]
  exact he

theorem U2_triple_class_coprime {A B : ℕ} (hcop : Nat.Coprime A B) :
    Nat.Coprime A (2 * A + B) ∧
      Nat.Coprime (A + B) (2 * A + 3 * B) ∧ Nat.Coprime B (A + 3 * B) := by
  refine ⟨(Nat.coprime_mul_right_add_right A B 2).mpr hcop, ?_,
    (Nat.coprime_add_mul_right_right B A 3).mpr hcop.symm⟩
  have hCB : Nat.Coprime (A + B) B := Nat.coprime_add_self_left.mpr hcop
  have hCR : Nat.Coprime (A + B) (2 * (A + B) + B) :=
    (Nat.coprime_mul_right_add_right (A + B) B 2).mpr hCB
  have hn : 2 * (A + B) + B = 2 * A + 3 * B := by omega
  rw [hn] at hCR
  exact hCR

/-- Three exact maximum certificates from the original coprimality hypothesis. -/
theorem U2_three_grid_maxima {A B : ℕ} (hA : 0 < A) (hB : 0 < B)
    (hcop : Nat.Coprime A B) :
    (∃ m : ℕ, m < 2 * A + B ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * A + B : ℕ)) : ℝ) : Time) =
        (((2 * A + B) / 4 : ℕ) : ℝ) / (2 * A + B : ℕ)) ∧
    (∃ m : ℕ, m < 2 * A + 3 * B ∧
      score (U2Speeds A B) ((((m : ℝ) / (2 * A + 3 * B : ℕ)) : ℝ) : Time) =
        (((2 * A + 3 * B) / 4 : ℕ) : ℝ) / (2 * A + 3 * B : ℕ)) ∧
    (∃ m : ℕ, m < A + 3 * B ∧
      score (U2Speeds A B) ((((m : ℝ) / (A + 3 * B : ℕ)) : ℝ) : Time) =
        (((A + 3 * B) / 4 : ℕ) : ℝ) / (A + 3 * B : ℕ)) := by
  obtain ⟨hQ, hR, hS⟩ := U2_triple_class_coprime hcop
  exact ⟨U2_Q_grid_attained A B (by omega) hQ,
    U2_R_grid_attained A B (by omega) hR,
    U2_S_grid_attained A B (by omega) hS⟩













end Math15.LonelyRunner
end 
end 

/- Section: U2Arithmetic -/
section


/-!
# Arithmetic of the U2 critical-grid formula

Put C=A+B, Q=2A+B, R=2A+3B, S=A+3B. The formula investigated here is
F=max(max(g(Q),g(R)),max(g(S),h(C))), where g(q)=floor(q/4)/q and h(C)=1/4 for
C=2 mod 4, (C-2)/(4C) for C=0 mod 4, and (C-1)/(4C) otherwise. This section
establishes only the numerical spectrum of that formula. It does not identify
F with maximum loneliness.

Paper argument: g(q)=1/4-(q mod 4)/(4q), so g(q)<=g(d) precisely when (d mod
4)*q <= (q mod 4)*d. Coprimality excludes the four residue pairs where A and B
are both even. In the other twelve rows, the winner is: (0,1):Q; (0,3):R;
(1,0):S; (1,1):quarter; (1,2):quarter; (1,3):Q if B<=3A and S otherwise;
(2,1):max(Q,S); (2,3):R; (3,0):R; (3,1):R; (3,2):quarter; (3,3):quarter. Every
non-quarter winner has denominator residue 1, or residue 2 with floor(q/4)>=2.
Taking s=floor(q/4), k=q mod 4 gives the claim.
-/

noncomputable section
namespace Math15.LonelyRunner

def U2GridGap (q : ℕ) : ℝ := (q / 4 : ℕ) / (q : ℝ)

def U2PairGap (C : ℕ) : ℝ :=
  if C % 4 = 2 then 1 / 4 else
    if C % 4 = 0 then (C - 2 : ℕ) / (4 * (C : ℝ))
      else (C - 1 : ℕ) / (4 * (C : ℝ))

def U2ArithmeticValue (A B : ℕ) : ℝ :=
  max (max (U2GridGap (2 * A + B)) (U2GridGap (2 * A + 3 * B)))
    (max (U2GridGap (A + 3 * B)) (U2PairGap (A + B)))

def U2DiscreteAtMostTwo (L : ℝ) : Prop :=
  L = 1 / 4 ∨ ∃ s k : ℕ, 1 ≤ k ∧ k ≤ 2 ∧ k ≤ s ∧
    L = (s : ℝ) / (4 * (s : ℝ) + k)

theorem U2GridGap_le_quarter {q : ℕ} (hq : 0 < q) :
    U2GridGap q ≤ 1 / 4 := by
  unfold U2GridGap
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  apply (div_le_iff₀ hqR).2
  have hnat : 4 * (q / 4) ≤ q := by omega
  have hreal : (4 : ℝ) * (q / 4 : ℕ) ≤ (q : ℝ) := by exact_mod_cast hnat
  nlinarith

theorem U2PairRaw_le_quarter {C : ℕ} (hC : 0 < C) (r : ℕ) :
    ((C - r : ℕ) : ℝ) / (4 * (C : ℝ)) ≤ 1 / 4 := by
  have hCR : (0 : ℝ) < C := by exact_mod_cast hC
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < 4 * (C : ℝ))).2
  have hs : ((C - r : ℕ) : ℝ) ≤ C := by exact_mod_cast (Nat.sub_le C r)
  nlinarith

theorem U2PairGap_le_quarter {C : ℕ} (hC : 0 < C) :
    U2PairGap C ≤ 1 / 4 := by
  unfold U2PairGap
  split_ifs
  · exact le_rfl
  · exact U2PairRaw_le_quarter hC 2
  · exact U2PairRaw_le_quarter hC 1

/-- Exact denominator-residue comparison; the displayed integer inequality
is sufficient and does not involve rounding errors. -/
theorem U2GridGap_le_of_cross {q d : ℕ} (hq : 0 < q) (hd : 0 < d)
    (hcross : (d % 4) * q ≤ (q % 4) * d) :
    U2GridGap q ≤ U2GridGap d := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hqeq : (q : ℝ) = 4 * (q / 4 : ℕ) + (q % 4 : ℕ) := by
    exact_mod_cast (show q = 4 * (q / 4) + q % 4 by omega)
  have hdeq : (d : ℝ) = 4 * (d / 4 : ℕ) + (d % 4 : ℕ) := by
    exact_mod_cast (show d = 4 * (d / 4) + d % 4 by omega)
  have hbalance :
      4 * (d / 4 : ℕ) * (q : ℝ) + (d % 4 : ℕ) * (q : ℝ) =
        4 * (q / 4 : ℕ) * (d : ℝ) + (q % 4 : ℕ) * (d : ℝ) := by
    rw [hqeq, hdeq]
    ring
  have hcrossR : (d % 4 : ℕ) * (q : ℝ) ≤ (q % 4 : ℕ) * (d : ℝ) := by
    exact_mod_cast hcross
  unfold U2GridGap
  apply (div_le_div_iff₀ hqR hdR).2
  nlinarith [hbalance, hcrossR]

/-- Compare the pair-grid expression with a denominator grid. -/
theorem U2PairRaw_le_grid_of_cross {C q r : ℕ}
    (hC : 0 < C) (hq : 0 < q) (hr : r ≤ C)
    (hcross : (q % 4) * C ≤ r * q) :
    ((C - r : ℕ) : ℝ) / (4 * (C : ℝ)) ≤ U2GridGap q := by
  have hCR : (0 : ℝ) < C := by exact_mod_cast hC
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hqsum : 4 * (q / 4) * C + (q % 4) * C = q * C := by
    calc
      _ = (4 * (q / 4) + q % 4) * C := by ring
      _ = q * C := by congr 1 <;> omega
  have hCsum : (C - r) * q + r * q = C * q := by
    calc
      _ = ((C - r) + r) * q := by ring
      _ = C * q := by rw [Nat.sub_add_cancel hr]
  have hqsumR : 4 * (q / 4 : ℕ) * (C : ℝ) + (q % 4 : ℕ) * (C : ℝ) =
      (q : ℝ) * C := by exact_mod_cast hqsum
  have hCsumR : (C - r : ℕ) * (q : ℝ) + (r : ℝ) * q =
      (C : ℝ) * q := by exact_mod_cast hCsum
  have hcrossR : (q % 4 : ℕ) * (C : ℝ) ≤ (r : ℝ) * q := by
    exact_mod_cast hcross
  unfold U2GridGap
  apply (div_le_div_iff₀ (by positivity : (0 : ℝ) < 4 * (C : ℝ)) hqR).2
  nlinarith [hqsumR, hCsumR, hcrossR]

theorem U2GridGap_eq_quarter {q : ℕ} (hq : 0 < q) (hr : q % 4 = 0) :
    U2GridGap q = 1 / 4 := by
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hq)
  unfold U2GridGap
  apply (div_eq_iff hq0).2
  have hnat : 4 * (q / 4) = q := by omega
  have hreal : (4 : ℝ) * (q / 4 : ℕ) = (q : ℝ) := by exact_mod_cast hnat
  nlinarith

theorem U2GridGap_spectrum_of_mod_one {q : ℕ} (hq : 5 ≤ q)
    (hr : q % 4 = 1) : U2DiscreteAtMostTwo (U2GridGap q) := by
  right
  refine ⟨q / 4, 1, by omega, by omega, by omega, ?_⟩
  have hden : 4 * ((q / 4 : ℕ) : ℝ) + (1 : ℝ) = (q : ℝ) := by
    exact_mod_cast (show 4 * (q / 4) + 1 = q by omega)
  unfold U2GridGap
  simp only [Nat.cast_one]
  rw [hden]

theorem U2GridGap_spectrum_of_mod_two {q : ℕ} (hq : 10 ≤ q)
    (hr : q % 4 = 2) : U2DiscreteAtMostTwo (U2GridGap q) := by
  right
  refine ⟨q / 4, 2, by omega, by omega, by omega, ?_⟩
  have hden : 4 * ((q / 4 : ℕ) : ℝ) + (2 : ℝ) = (q : ℝ) := by
    exact_mod_cast (show 4 * (q / 4) + 2 = q by omega)
  unfold U2GridGap
  simp only [Nat.cast_ofNat]
  rw [hden]

theorem U2DiscreteAtMostTwo_max {L M : ℝ}
    (hL : U2DiscreteAtMostTwo L) (hM : U2DiscreteAtMostTwo M) :
    U2DiscreteAtMostTwo (max L M) := by
  by_cases h : L ≤ M
  · rw [max_eq_right h]
    exact hM
  · rw [max_eq_left (le_of_not_ge h)]
    exact hL

theorem U2ArithmeticValue_le_quarter {A B : ℕ} (hA : 0 < A) (hB : 0 < B) :
    U2ArithmeticValue A B ≤ 1 / 4 := by
  unfold U2ArithmeticValue
  exact max_le (max_le (U2GridGap_le_quarter (by omega))
    (U2GridGap_le_quarter (by omega)))
    (max_le (U2GridGap_le_quarter (by omega)) (U2PairGap_le_quarter (by omega)))

theorem U2ArithmeticValue_eq_quarter_of_C {A B : ℕ}
    (hA : 0 < A) (hB : 0 < B) (hC : (A + B) % 4 = 2) :
    U2ArithmeticValue A B = 1 / 4 := by
  apply le_antisymm (U2ArithmeticValue_le_quarter hA hB)
  have hh : U2PairGap (A + B) = (1 / 4 : ℝ) := by simp [U2PairGap, hC]
  rw [← hh]
  exact (le_max_right _ _).trans (le_max_right _ _)

theorem U2ArithmeticValue_eq_quarter_of_Q {A B : ℕ}
    (hA : 0 < A) (hB : 0 < B) (hQ : (2 * A + B) % 4 = 0) :
    U2ArithmeticValue A B = 1 / 4 := by
  apply le_antisymm (U2ArithmeticValue_le_quarter hA hB)
  rw [← U2GridGap_eq_quarter (by omega : 0 < 2 * A + B) hQ]
  exact (le_max_left _ _).trans (le_max_left _ _)

theorem U2ArithmeticValue_eq_Q {A B : ℕ}
    (hR : U2GridGap (2 * A + 3 * B) ≤ U2GridGap (2 * A + B))
    (hS : U2GridGap (A + 3 * B) ≤ U2GridGap (2 * A + B))
    (hC : U2PairGap (A + B) ≤ U2GridGap (2 * A + B)) :
    U2ArithmeticValue A B = U2GridGap (2 * A + B) := by
  unfold U2ArithmeticValue
  rw [max_eq_left hR]
  exact max_eq_left (max_le hS hC)

theorem U2ArithmeticValue_eq_R {A B : ℕ}
    (hQ : U2GridGap (2 * A + B) ≤ U2GridGap (2 * A + 3 * B))
    (hS : U2GridGap (A + 3 * B) ≤ U2GridGap (2 * A + 3 * B))
    (hC : U2PairGap (A + B) ≤ U2GridGap (2 * A + 3 * B)) :
    U2ArithmeticValue A B = U2GridGap (2 * A + 3 * B) := by
  unfold U2ArithmeticValue
  rw [max_eq_right hQ]
  exact max_eq_left (max_le hS hC)

theorem U2ArithmeticValue_eq_S {A B : ℕ}
    (hQ : U2GridGap (2 * A + B) ≤ U2GridGap (A + 3 * B))
    (hR : U2GridGap (2 * A + 3 * B) ≤ U2GridGap (A + 3 * B))
    (hC : U2PairGap (A + B) ≤ U2GridGap (A + 3 * B)) :
    U2ArithmeticValue A B = U2GridGap (A + 3 * B) := by
  unfold U2ArithmeticValue
  rw [max_eq_left hC]
  exact max_eq_right (max_le hQ hR)

theorem U2ArithmeticValue_eq_max_Q_S {A B : ℕ}
    (hR : U2GridGap (2 * A + 3 * B) ≤ U2GridGap (2 * A + B))
    (hC : U2PairGap (A + B) ≤ U2GridGap (2 * A + B)) :
    U2ArithmeticValue A B = max (U2GridGap (2 * A + B)) (U2GridGap (A + 3 * B)) := by
  unfold U2ArithmeticValue
  rw [max_eq_left hR]
  apply le_antisymm
  · exact max_le (le_max_left _ _)
      (max_le (le_max_right _ _) (hC.trans (le_max_left _ _)))
  · exact max_le (le_max_left _ _) ((le_max_left _ _).trans (le_max_right _ _))

/-- The complete numerical U2 formula has amended-spectrum parameter at most
two. Distinctness of A and B is unnecessary for this numerical assertion. -/
theorem U2ArithmeticValue_spectrum {A B : ℕ}
    (hA : 0 < A) (hB : 0 < B) (hcop : Nat.Coprime A B) :
    U2DiscreteAtMostTwo (U2ArithmeticValue A B) := by
  have hnot2 : ¬ (2 ∣ A ∧ 2 ∣ B) := by
    rintro ⟨ha, hb⟩
    have hg : 2 ∣ Nat.gcd A B := Nat.dvd_gcd ha hb
    have hc : Nat.gcd A B = 1 := hcop
    rw [hc] at hg
    norm_num at hg
  have ha4 : A % 4 = 0 ∨ A % 4 = 1 ∨ A % 4 = 2 ∨ A % 4 = 3 := by omega
  have hb4 : B % 4 = 0 ∨ B % 4 = 1 ∨ B % 4 = 2 ∨ B % 4 = 3 := by omega
  have hQpos : 0 < 2 * A + B := by omega
  have hRpos : 0 < 2 * A + 3 * B := by omega
  have hSpos : 0 < A + 3 * B := by omega
  have hCpos : 0 < A + B := by omega
  rcases ha4 with ha | ha | ha | ha
  · rcases hb4 with hb | hb | hb | hb
    · exact False.elim (hnot2 ⟨Nat.dvd_of_mod_eq_zero (by omega), Nat.dvd_of_mod_eq_zero (by omega)⟩)
    · have hQ : (2 * A + B) % 4 = 1 := by omega
      have hR : (2 * A + 3 * B) % 4 = 3 := by omega
      have hS : (A + 3 * B) % 4 = 3 := by omega
      have hC : (A + B) % 4 = 1 := by omega
      have hRQ := U2GridGap_le_of_cross hRpos hQpos (by rw [hQ, hR]; omega)
      have hSQ := U2GridGap_le_of_cross hSpos hQpos (by rw [hQ, hS]; omega)
      have hCQ : U2PairGap (A + B) ≤ U2GridGap (2 * A + B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hQpos (by omega)
        rw [hQ]
        omega
      rw [U2ArithmeticValue_eq_Q hRQ hSQ hCQ]
      exact U2GridGap_spectrum_of_mod_one (by omega) hQ
    · exact False.elim (hnot2 ⟨Nat.dvd_of_mod_eq_zero (by omega), Nat.dvd_of_mod_eq_zero (by omega)⟩)
    · have hQ : (2 * A + B) % 4 = 3 := by omega
      have hR : (2 * A + 3 * B) % 4 = 1 := by omega
      have hS : (A + 3 * B) % 4 = 1 := by omega
      have hC : (A + B) % 4 = 3 := by omega
      have hQR := U2GridGap_le_of_cross hQpos hRpos (by rw [hR, hQ]; omega)
      have hSR := U2GridGap_le_of_cross hSpos hRpos (by rw [hR, hS]; omega)
      have hCR : U2PairGap (A + B) ≤ U2GridGap (2 * A + 3 * B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hRpos (by omega)
        rw [hR]
        omega
      rw [U2ArithmeticValue_eq_R hQR hSR hCR]
      exact U2GridGap_spectrum_of_mod_one (by omega) hR
  · rcases hb4 with hb | hb | hb | hb
    · have hQ : (2 * A + B) % 4 = 2 := by omega
      have hR : (2 * A + 3 * B) % 4 = 2 := by omega
      have hS : (A + 3 * B) % 4 = 1 := by omega
      have hC : (A + B) % 4 = 1 := by omega
      have hQS := U2GridGap_le_of_cross hQpos hSpos (by rw [hS, hQ]; omega)
      have hRS := U2GridGap_le_of_cross hRpos hSpos (by rw [hS, hR]; omega)
      have hCS : U2PairGap (A + B) ≤ U2GridGap (A + 3 * B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hSpos (by omega)
        rw [hS]
        omega
      rw [U2ArithmeticValue_eq_S hQS hRS hCS]
      exact U2GridGap_spectrum_of_mod_one (by omega) hS
    · exact Or.inl (U2ArithmeticValue_eq_quarter_of_C hA hB (by omega))
    · exact Or.inl (U2ArithmeticValue_eq_quarter_of_Q hA hB (by omega))
    · have hQ : (2 * A + B) % 4 = 1 := by omega
      have hR : (2 * A + 3 * B) % 4 = 3 := by omega
      have hS : (A + 3 * B) % 4 = 2 := by omega
      have hC : (A + B) % 4 = 0 := by omega
      by_cases hBA : B ≤ 3 * A
      · have hRQ := U2GridGap_le_of_cross hRpos hQpos (by rw [hQ, hR]; omega)
        have hSQ := U2GridGap_le_of_cross hSpos hQpos (by rw [hQ, hS]; omega)
        have hCQ : U2PairGap (A + B) ≤ U2GridGap (2 * A + B) := by
          rw [U2PairGap, if_neg (by omega), if_pos hC]
          apply U2PairRaw_le_grid_of_cross (r := 2) hCpos hQpos (by omega)
          rw [hQ]
          omega
        rw [U2ArithmeticValue_eq_Q hRQ hSQ hCQ]
        exact U2GridGap_spectrum_of_mod_one (by omega) hQ
      · have hQS := U2GridGap_le_of_cross hQpos hSpos (by rw [hS, hQ]; omega)
        have hRS := U2GridGap_le_of_cross hRpos hSpos (by rw [hS, hR]; omega)
        have hCS : U2PairGap (A + B) ≤ U2GridGap (A + 3 * B) := by
          rw [U2PairGap, if_neg (by omega), if_pos hC]
          apply U2PairRaw_le_grid_of_cross (r := 2) hCpos hSpos (by omega)
          rw [hS]
          omega
        rw [U2ArithmeticValue_eq_S hQS hRS hCS]
        exact U2GridGap_spectrum_of_mod_two (by omega) hS
  · rcases hb4 with hb | hb | hb | hb
    · exact False.elim (hnot2 ⟨Nat.dvd_of_mod_eq_zero (by omega), Nat.dvd_of_mod_eq_zero (by omega)⟩)
    · have hQ : (2 * A + B) % 4 = 1 := by omega
      have hR : (2 * A + 3 * B) % 4 = 3 := by omega
      have hS : (A + 3 * B) % 4 = 1 := by omega
      have hC : (A + B) % 4 = 3 := by omega
      have hRQ := U2GridGap_le_of_cross hRpos hQpos (by rw [hQ, hR]; omega)
      have hCQ : U2PairGap (A + B) ≤ U2GridGap (2 * A + B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hQpos (by omega)
        rw [hQ]
        omega
      rw [U2ArithmeticValue_eq_max_Q_S hRQ hCQ]
      exact U2DiscreteAtMostTwo_max
        (U2GridGap_spectrum_of_mod_one (by omega) hQ)
        (U2GridGap_spectrum_of_mod_one (by omega) hS)
    · exact False.elim (hnot2 ⟨Nat.dvd_of_mod_eq_zero (by omega), Nat.dvd_of_mod_eq_zero (by omega)⟩)
    · have hQ : (2 * A + B) % 4 = 3 := by omega
      have hR : (2 * A + 3 * B) % 4 = 1 := by omega
      have hS : (A + 3 * B) % 4 = 3 := by omega
      have hC : (A + B) % 4 = 1 := by omega
      have hQR := U2GridGap_le_of_cross hQpos hRpos (by rw [hR, hQ]; omega)
      have hSR := U2GridGap_le_of_cross hSpos hRpos (by rw [hR, hS]; omega)
      have hCR : U2PairGap (A + B) ≤ U2GridGap (2 * A + 3 * B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hRpos (by omega)
        rw [hR]
        omega
      rw [U2ArithmeticValue_eq_R hQR hSR hCR]
      exact U2GridGap_spectrum_of_mod_one (by omega) hR
  · rcases hb4 with hb | hb | hb | hb
    · have hQ : (2 * A + B) % 4 = 2 := by omega
      have hR : (2 * A + 3 * B) % 4 = 2 := by omega
      have hS : (A + 3 * B) % 4 = 3 := by omega
      have hC : (A + B) % 4 = 3 := by omega
      have hQR := U2GridGap_le_of_cross hQpos hRpos (by rw [hR, hQ]; omega)
      have hSR := U2GridGap_le_of_cross hSpos hRpos (by rw [hR, hS]; omega)
      have hCR : U2PairGap (A + B) ≤ U2GridGap (2 * A + 3 * B) := by
        rw [U2PairGap, if_neg (by omega), if_neg (by omega)]
        apply U2PairRaw_le_grid_of_cross (r := 1) hCpos hRpos (by omega)
        rw [hR]
        omega
      rw [U2ArithmeticValue_eq_R hQR hSR hCR]
      exact U2GridGap_spectrum_of_mod_two (by omega) hR
    · have hQ : (2 * A + B) % 4 = 3 := by omega
      have hR : (2 * A + 3 * B) % 4 = 1 := by omega
      have hS : (A + 3 * B) % 4 = 2 := by omega
      have hC : (A + B) % 4 = 0 := by omega
      have hQR := U2GridGap_le_of_cross hQpos hRpos (by rw [hR, hQ]; omega)
      have hSR := U2GridGap_le_of_cross hSpos hRpos (by rw [hR, hS]; omega)
      have hCR : U2PairGap (A + B) ≤ U2GridGap (2 * A + 3 * B) := by
        rw [U2PairGap, if_neg (by omega), if_pos hC]
        apply U2PairRaw_le_grid_of_cross (r := 2) hCpos hRpos (by omega)
        rw [hR]
        omega
      rw [U2ArithmeticValue_eq_R hQR hSR hCR]
      exact U2GridGap_spectrum_of_mod_one (by omega) hR
    · exact Or.inl (U2ArithmeticValue_eq_quarter_of_Q hA hB (by omega))
    · exact Or.inl (U2ArithmeticValue_eq_quarter_of_C hA hB (by omega))







end Math15.LonelyRunner
