/-- Actual bounded-core reduction. It proves the target disjunction
outright on both analytic branches and on the tight-core branch. Its other
alternative is a literal finite range; it does not assume a lower core gap. -/
theorem source05_small_pair_or_bounded {q c d : ℕ} (hq : q=1 ∨ q=2)
    (hp : Positive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hcard : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hpair : ∀u∈finiteQuartetSpeeds (2*q) (3*q) c d,
      ∀v∈finiteQuartetSpeeds (2*q) (3*q) c d,u≠v → Nat.gcd u v≤2)
    (hcd : c<d) :
    FiniteSource05Conclusion (finiteQuartetSpeeds (2*q) (3*q) c d) ∨
      (0<c ∧ c<24 ∧ d<161) := by
  have hqp : 0<q := by omega
  have hcp : 0<c := hp c (by simp [finiteQuartetSpeeds])
  by_cases hclarge : 12*q≤c
  · exact Or.inl (Or.inl (ML_ge_quarter_small_pair_two_late hqp hclarge hcd.le))
  have hc24 : c<24 := by omega
  by_cases ht : ∃a : ℕ,0<a ∧ ({2*q,3*q,c} : Finset ℕ)={a,2*a,3*a}
  · exact Or.inl (source05_small_pair_tight_core hq hp hcard hpair ht)
  by_cases hdlarge : 161≤d
  · exact Or.inl (Or.inl (ML_ge_quarter_small_pair_large_last hq hp hcard hc24 ht hdlarge))
  · exact Or.inr ⟨hcp,hc24,by omega⟩

/-- Removing the specified pair leaves two actual remaining speeds.
Their ordering is obtained without placing the fixed pair first. -/
theorem positive_quartet_with_pair_remaining {V : Finset ℕ} {a b : ℕ}
    (hp : Positive V) (hc : V.card=4) (ha : a∈V) (hb : b∈V) (hab : a≠b) :
    ∃c d : ℕ,0<c ∧ c<d ∧ V=finiteQuartetSpeeds a b c d := by
  let W := (V.erase a).erase b
  have hbe : b∈V.erase a := by simp only [Finset.mem_erase]; exact ⟨Ne.symm hab,hb⟩
  have hWcard : W.card=2 := by
    dsimp [W]
    rw [Finset.card_erase_of_mem hbe,Finset.card_erase_of_mem ha,hc]
  obtain ⟨c,d,hne,hW⟩ := Finset.card_eq_two.mp hWcard
  have hcW : c∈W := by rw [hW]; simp
  have hdW : d∈W := by rw [hW]; simp
  have hcV : c∈V := Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hcW)
  have hdV : d∈V := Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hdW)
  have hset : V=finiteQuartetSpeeds a b c d := by
    have he : insert a (insert b W)=V := by
      dsimp [W]
      rw [Finset.insert_erase hbe,Finset.insert_erase ha]
    rw [hW] at he
    exact he.symm
  rcases lt_or_gt_of_ne hne with hlt|hgt
  · exact ⟨c,d,hp c hcV,hlt,hset⟩
  · refine ⟨d,c,hp d hdV,hgt,?_⟩
    rw [hset]
    ext v
    simp only [finiteQuartetSpeeds,Finset.mem_insert,Finset.mem_singleton]
    tauto




















