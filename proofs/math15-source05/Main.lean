namespace Math15.LonelyRunner

theorem closedKnownWholeRowBool_sound {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hpair : ∀ u∈finiteQuartetSpeeds a b c d,
      ∀ v∈finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (htag : closedKnownWholeRowBool a b c=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  have hh : (a=1 ∧ b=2) ∨ (a=2 ∧ (b=4 ∨ c=4)) :=
    decide_eq_true_eq.mp htag
  rcases hh with ⟨rfl,rfl⟩ | ⟨rfl,hfour⟩
  · exact source05_of_one_two hp hc hpair
      (by simp [finiteQuartetSpeeds]) (by simp [finiteQuartetSpeeds])
  · apply source05_of_two_four hp hc hpair (by simp [finiteQuartetSpeeds])
    rcases hfour with rfl | rfl <;> simp [finiteQuartetSpeeds]

/-- Sufficient U2 criterion without any order assumption or Bool search. -/
theorem source05_of_closed_U2_shape {a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hshape : c=a+b ∧ (d=c+a ∨ d=c+b)) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  rcases hshape with ⟨hs,hd⟩
  rcases hd with hd | hd
  · have hset : finiteQuartetSpeeds a b c d=U2Speeds b a := by
      ext x
      simp only [finiteQuartetSpeeds,U2Speeds,Finset.mem_insert,Finset.mem_singleton]
      omega
    exact source05_of_primitive_U2_representation hp hprim hset
  · have hset : finiteQuartetSpeeds a b c d=U2Speeds a b := by
      ext x
      simp only [finiteQuartetSpeeds,U2Speeds,Finset.mem_insert,Finset.mem_singleton]
      omega
    exact source05_of_primitive_U2_representation hp hprim hset

/-- Every actual set bit proves Target05 for the same actual quartet.
This theorem consumes no precomputed family list or finite-table fact. -/
theorem closedKnownFourthMask_sound {bound a b c d : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u∈finiteQuartetSpeeds a b c d,
      ∀ v∈finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (hbit : Nat.testBit (closedKnownFourthMask bound a b c) d=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) := by
  rcases (closedKnownFourthMask_testBit_iff bound a b c d).mp hbit with
    ⟨htag,_⟩ | ⟨_,hshape⟩
  · exact closedKnownWholeRowBool_sound hp hc hpair htag
  · rcases hshape with hU | ⟨rfl,rfl,rfl,rfl⟩
    · exact source05_of_closed_U2_shape hp hprim hU
    · exact Or.inr exceptionalFourteen_discrete

/-- A closed family mask may be used directly in a fourth-speed cover. -/
theorem source05_of_closed_known_mask_coverage {bound a b c d A : ℕ}
    (hp : Positive (finiteQuartetSpeeds a b c d))
    (hc : (finiteQuartetSpeeds a b c d).card=4)
    (hprim : Primitive (finiteQuartetSpeeds a b c d))
    (hpair : ∀ u∈finiteQuartetSpeeds a b c d,
      ∀ v∈finiteQuartetSpeeds a b c d,u≠v → Nat.gcd u v≤2)
    (hcover : A &&& closedKnownFourthMask bound a b c=A)
    (hd : Nat.testBit A d=true) :
    FiniteSource05Conclusion (finiteQuartetSpeeds a b c d) :=
  closedKnownFourthMask_sound hp hc hprim hpair
    ((mask_coverage_iff A (closedKnownFourthMask bound a b c)).mp hcover d hd)










