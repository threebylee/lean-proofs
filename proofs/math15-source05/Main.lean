/- Section: IntegerDualLift -/
section




/-!
An explicit integral lift for the dual of a primitive integer hyperplane.

If m dot b = 1, the integer vectors e_i - m_i b belong to ker(m). An integral
functional y on that kernel therefore has integer values c_i on these vectors.
The identity c_i = y_i - m_i (y dot b) proves the lift without assuming a
general lattice-duality theorem.
-/

noncomputable section
namespace Math15.Source05Review
open Finset

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def intDot (a b : ι → ℤ) : ℤ := ∑ i, a i * b i
def realDot (a b : ι → ℝ) : ℝ := ∑ i, a i * b i
def realCast (a : ι → ℤ) : ι → ℝ := fun i => (a i : ℝ)

theorem finset_integer_bezout (s : Finset ι) (m : ι → ℤ) :
    ∃ b : ι → ℤ, (∑ i ∈ s, m i * b i) =
      ((s.gcd fun i => (m i).natAbs : ℕ) : ℤ) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨fun _ => 0, by simp⟩
  | @insert a s ha ih =>
    obtain ⟨b, hb⟩ := ih
    let g : ℕ := s.gcd fun i => (m i).natAbs
    let A : ℤ := Int.gcdA (m a) g
    let B : ℤ := Int.gcdB (m a) g
    refine ⟨fun i => if i = a then A else b i * B, ?_⟩
    rw [Finset.sum_insert ha]
    simp only [ite_true]
    have hs : (∑ i ∈ s, m i * (if i = a then A else b i * B)) =
        (∑ i ∈ s, m i * b i) * B := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi
      have hia : i ≠ a := by rintro rfl; exact ha hi
      simp [hia, mul_assoc]
    rw [hs, hb, Finset.gcd_insert]
    have h := Int.gcd_eq_gcd_ab (m a) (g : ℤ)
    simpa [Int.gcd_def, g, A, B] using h.symm

/-- Primitivity supplies the Bezout vector used by the explicit lift. -/
theorem primitive_integer_bezout (m : ι → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1) :
    ∃ b : ι → ℤ, intDot m b = 1 := by
  obtain ⟨b, hb⟩ := finset_integer_bezout Finset.univ m
  refine ⟨b, ?_⟩
  simpa [intDot, hm] using hb

def kernelGenerator (m b : ι → ℤ) (i : ι) : ι → ℤ :=
  fun j => (if j = i then 1 else 0) - m i * b j

theorem kernelGenerator_in_kernel (m b : ι → ℤ)
    (hb : intDot m b = 1) (i : ι) :
    intDot m (kernelGenerator m b i) = 0 := by
  unfold intDot kernelGenerator at *
  simp_rw [mul_sub, mul_ite, mul_one, mul_zero]
  rw [sum_sub_distrib]
  simp only [sum_ite_eq', mem_univ, if_true]
  calc
    m i - ∑ j, m j * (m i * b j) = m i - m i * ∑ j, m j * b j := by
      congr 1
      rw [mul_sum]
      apply sum_congr rfl
      intro j _
      ring
    _ = 0 := by rw [hb]; ring

theorem kernelGenerator_pairing (m b : ι → ℤ) (y : ι → ℝ) (i : ι) :
    realDot y (realCast (kernelGenerator m b i)) =
      y i - (m i : ℝ) * realDot y (realCast b) := by
  unfold realDot realCast kernelGenerator
  simp_rw [Int.cast_sub, Int.cast_mul, Int.cast_ite, Int.cast_one,
    Int.cast_zero, mul_sub, mul_ite, mul_one, mul_zero]
  rw [sum_sub_distrib]
  simp only [sum_ite_eq', mem_univ, if_true]
  congr 1
  rw [mul_sum]
  apply sum_congr rfl
  intro j _
  ring

/-- Integral functionals on the integer kernel lift to integer coordinates
up to a real multiple of the primitive normal. -/
theorem integer_dual_lift (m b : ι → ℤ) (hb : intDot m b = 1)
    (y : ι → ℝ)
    (hy : ∀ z : ι → ℤ, intDot m z = 0 →
      ∃ k : ℤ, realDot y (realCast z) = (k : ℝ)) :
    ∃ c : ι → ℤ, ∀ i,
      y i = (c i : ℝ) + realDot y (realCast b) * (m i : ℝ) := by
  have hi : ∀ i, ∃ k : ℤ,
      realDot y (realCast (kernelGenerator m b i)) = (k : ℝ) := by
    intro i
    exact hy _ (kernelGenerator_in_kernel m b hb i)
  choose c hc using hi
  refine ⟨c, ?_⟩
  intro i
  have h := hc i
  rw [kernelGenerator_pairing] at h
  linarith

theorem realDot_realCast (a b : ι → ℤ) :
    realDot (realCast a) (realCast b) = (intDot a b : ℝ) := by
  simp [realDot, realCast, intDot]

theorem realDot_of_coordinate_lift (m c : ι → ℤ) (y v : ι → ℝ) (s : ℝ)
    (h : ∀ i, y i = (c i : ℝ) + s * (m i : ℝ)) :
    realDot y v = realDot (realCast c) v + s * realDot (realCast m) v := by
  unfold realDot realCast
  simp_rw [h, add_mul]
  rw [sum_add_distrib, mul_sum]
  congr 1
  apply sum_congr rfl
  intro i _
  ring

/-- The lift preserves the actual relation to the same integer speed vector. -/
theorem integer_dual_lift_relation (m b v : ι → ℤ)
    (hb : intDot m b = 1) (hmv : intDot m v = 0) (y : ι → ℝ)
    (hyv : realDot y (realCast v) = 0)
    (hy : ∀ z : ι → ℤ, intDot m z = 0 →
      ∃ k : ℤ, realDot y (realCast z) = (k : ℝ)) :
    ∃ c : ι → ℤ, intDot c v = 0 ∧
      ∀ i, y i = (c i : ℝ) + realDot y (realCast b) * (m i : ℝ) := by
  obtain ⟨c, hc⟩ := integer_dual_lift m b hb y hy
  refine ⟨c, ?_, hc⟩
  have h := realDot_of_coordinate_lift m c y (realCast v)
    (realDot y (realCast b)) hc
  rw [realDot_realCast, realDot_realCast, hmv, Int.cast_zero, mul_zero,
    add_zero, hyv] at h
  exact_mod_cast h.symm

/-- A nonzero orthogonal dual vector produces a relation independent of m. -/
theorem lifted_relation_not_parallel (m b c : ι → ℤ)
    (hb : intDot m b = 1) (y : ι → ℝ) (s : ℝ)
    (hc : ∀ i, y i = (c i : ℝ) + s * (m i : ℝ))
    (hym : realDot y (realCast m) = 0) (hyne : y ≠ 0) :
    ¬ ∃ t : ℝ, ∀ i, (c i : ℝ) = t * (m i : ℝ) := by
  rintro ⟨t, ht⟩
  have hmne : ∃ i, m i ≠ 0 := by
    by_contra h
    push_neg at h
    have hzero : intDot m b = 0 := by simp [intDot, h]
    omega
  obtain ⟨i, hi⟩ := hmne
  have hipos : 0 < (m i : ℝ) ^ 2 := sq_pos_of_ne_zero (by exact_mod_cast hi)
  have hsumpos : 0 < ∑ j, (m j : ℝ) ^ 2 := by
    exact hipos.trans_le (single_le_sum (fun j _ => sq_nonneg (m j : ℝ)) (mem_univ i))
  have hyform : ∀ j, y j = (t+s) * (m j : ℝ) := by
    intro j
    rw [hc j, ht j]
    ring
  have hmul : (t+s) * (∑ j, (m j : ℝ) ^ 2) = 0 := by
    rw [mul_sum]
    calc
      ∑ j, (t+s) * (m j : ℝ) ^ 2 = realDot y (realCast m) := by
        unfold realDot realCast
        apply sum_congr rfl
        intro j _
        rw [hyform j]
        ring
      _ = 0 := hym
  have hts : t+s = 0 := (mul_eq_zero.mp hmul).resolve_right (ne_of_gt hsumpos)
  apply hyne
  funext j
  simp [hyform j, hts]

theorem realDot_comm (x y : ι → ℝ) : realDot x y = realDot y x := by
  simp [realDot, mul_comm]

/-- Exact squared exterior area; the parallel correction in the integer
lift costs nothing. This is the covolume bound's numerical consumer. -/
theorem lifted_gram_determinant (m c : ι → ℤ) (y : ι → ℝ) (s : ℝ)
    (hc : ∀ i, y i = (c i : ℝ) + s * (m i : ℝ))
    (hym : realDot y (realCast m) = 0) :
    realDot (realCast m) (realCast m) * realDot (realCast c) (realCast c) -
      realDot (realCast c) (realCast m) ^ 2 =
        realDot (realCast m) (realCast m) * realDot y y := by
  have hm := realDot_of_coordinate_lift m c y (realCast m) s hc
  have hc' := realDot_of_coordinate_lift m c y (realCast c) s hc
  have hy := realDot_of_coordinate_lift m c y y s hc
  rw [realDot_comm (realCast m) y, hym, mul_zero, add_zero] at hy
  rw [realDot_comm (realCast c) y, hc',
    realDot_comm (realCast m) (realCast c)] at hy
  rw [hym] at hm
  linear_combination realDot (realCast c) (realCast m) * hm -
    realDot (realCast m) (realCast m) * hy

/-- Full primitive-hyperplane statement: no separately assumed Bezout
witness or independence hypothesis remains. The integrality hypothesis
is exactly membership in the dual of the integer kernel. -/
theorem primitive_dual_relation (m v : ι → ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (hmv : intDot m v = 0) (y : ι → ℝ)
    (hym : realDot y (realCast m) = 0)
    (hyv : realDot y (realCast v) = 0) (hyne : y ≠ 0)
    (hy : ∀ z : ι → ℤ, intDot m z = 0 →
      ∃ k : ℤ, realDot y (realCast z) = (k : ℝ)) :
    ∃ c : ι → ℤ, intDot c v = 0 ∧
      (¬ ∃ t : ℝ, ∀ i, (c i : ℝ) = t * (m i : ℝ)) ∧
      realDot (realCast m) (realCast m) * realDot (realCast c) (realCast c) -
        realDot (realCast c) (realCast m) ^ 2 =
          realDot (realCast m) (realCast m) * realDot y y := by
  obtain ⟨b, hb⟩ := primitive_integer_bezout m hm
  obtain ⟨c, hcv, hc⟩ := integer_dual_lift_relation m b v hb hmv y hyv hy
  exact ⟨c, hcv, lifted_relation_not_parallel m b c hb y
    (realDot y (realCast b)) hc hym hyne,
    lifted_gram_determinant m c y _ hc hym⟩














end Math15.Source05Review
end 
end 

/- Section: SaturatedBasis -/
section




/-!
Saturated integer submodules have bases that extend to ambient integer bases.
The statement uses Mathlib's Smith normal form; saturation forces each nonzero
Smith coefficient to be a unit, after which basis rescaling removes all
coefficients. This is the primitive-basis completion needed by Source05.
-/

noncomputable section
namespace Math15.Source05Review
open Module

variable {ι M R : Type*} [Finite ι] [CommRing R] [IsDomain R]
  [IsPrincipalIdealRing R] [AddCommGroup M] [Module R M]

def ScalarSaturated (N : Submodule R M) : Prop :=
  ∀ (a : R), a ≠ 0 → ∀ x : M, a • x ∈ N → x ∈ N

theorem saturated_smith_coefficient_isUnit (N : Submodule R M)
    (hsat : ScalarSaturated N) {k : ℕ}
    (S : Basis.SmithNormalForm N ι k) (i : Fin k) : IsUnit (S.a i) := by
  have hne : S.a i ≠ 0 := by
    intro hzero
    have hv : (S.bN i : M) = 0 := by rw [S.snf i, hzero, zero_smul]
    exact S.bN.ne_zero i (Subtype.ext hv)
  have hm : S.bM (S.f i) ∈ N := by
    apply hsat (S.a i) hne
    rw [← S.snf i]
    exact (S.bN i).property
  let x : N := ⟨S.bM (S.f i), hm⟩
  have heq := S.repr_apply_embedding_eq_repr_smul x (i := i)
  simp only [map_smul, Finsupp.smul_apply, smul_eq_mul] at heq
  have hone : (1 : R) = S.a i * S.bN.repr x i := by
    change S.bM.repr (S.bM (S.f i)) (S.f i) = _ at heq
    simpa only [Basis.repr_self, Finsupp.single_eq_same] using heq
  exact isUnit_iff_dvd_one.mpr ⟨S.bN.repr x i, hone⟩

/-- A saturated submodule admits an actual embedded subbasis, with no
Smith coefficients left in the conclusion. -/
theorem saturated_submodule_basis_extends (b : Basis ι R M)
    (N : Submodule R M) (hsat : ScalarSaturated N) :
    ∃ (k : ℕ) (bM : Basis ι R M) (bN : Basis (Fin k) R N)
      (f : Fin k ↪ ι), ∀ i, (bN i : M) = bM (f i) := by
  classical
  let S := (N.smithNormalForm b).2
  have hu : ∀ i, IsUnit (S.a i) := saturated_smith_coefficient_isUnit N hsat S
  let u : Fin (N.smithNormalForm b).1 → Rˣ := fun i => (hu i).unit
  refine ⟨_, S.bM, S.bN.unitsSMul (fun i => (u i)⁻¹), S.f, ?_⟩
  intro i
  rw [Basis.unitsSMul_apply]
  change (((u i)⁻¹ : Rˣ) : R) • (S.bN i : M) = S.bM (S.f i)
  rw [S.snf i, ← mul_smul]
  have hui : (u i : R) = S.a i := (hu i).unit_spec
  rw [← hui]
  simp

/-- A vector having an integral coordinate functional of value one is the
first vector of some integer basis. Applied inside a relation lattice,
this gives the primitive speed-vector completion used by projection. -/
theorem basis_starts_at_split_vector (b : Basis ι R M)
    (phi : M →ₗ[R] R) (v : M) (hv : phi v = 1) :
    ∃ (k : ℕ) (b' : Basis (Fin (k+1)) R M), b' 0 = v := by
  classical
  obtain ⟨k, ⟨bK⟩⟩ := Submodule.nonempty_basis_of_pid b (LinearMap.ker phi)
  have hli : ∀ (c : R) (x : M), x ∈ LinearMap.ker phi →
      c • v + x = 0 → c = 0 := by
    intro c x hx he
    have hh := congrArg phi he
    simp only [map_add, map_smul, map_zero, hv,
      LinearMap.mem_ker.mp hx, smul_eq_mul, mul_one, add_zero] at hh
    exact hh
  have hsp : ∀ x : M, ∃ c : R, x + c • v ∈ LinearMap.ker phi := by
    intro x
    refine ⟨-phi x, ?_⟩
    simp [LinearMap.mem_ker, hv]
  refine ⟨k, Basis.mkFinCons v bK hli hsp, ?_⟩
  rw [Basis.coe_mkFinCons]
  rfl

variable {κ : Type*} [Fintype κ]

/-- Simultaneous homogeneous integer linear equations define a saturated
submodule. This includes both relation lattices used by Source05. -/
def integerEquationKernel (rows : κ → (ι → ℤ)) [Fintype ι] :
    Submodule ℤ (ι → ℤ) where
  carrier := {x | ∀ r, ∑ i, rows r i * x i = 0}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy r
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib, hx r, hy r, add_zero]
  smul_mem' := by
    intro a x hx r
    simp only [Pi.smul_apply, smul_eq_mul]
    calc
      ∑ i, rows r i * (a * x i) = a * ∑ i, rows r i * x i := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring
      _ = 0 := by rw [hx r, mul_zero]

theorem integerEquationKernel_saturated [Fintype ι] (rows : κ → (ι → ℤ)) :
    ScalarSaturated (integerEquationKernel rows) := by
  intro a ha x hx r
  have h := hx r
  have he : (∑ i, rows r i * (a * x i)) = a * ∑ i, rows r i * x i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  change (∑ i, rows r i * (a * x i)) = 0 at h
  rw [he] at h
  exact (mul_eq_zero.mp h).resolve_left ha

/-- Native integer equation kernels have a basis completed inside Z^ι. -/
theorem integerEquationKernel_basis_extends [Fintype ι] (rows : κ → (ι → ℤ)) :
    ∃ (k : ℕ) (bM : Basis ι ℤ (ι → ℤ))
      (bK : Basis (Fin k) ℤ (integerEquationKernel rows))
      (f : Fin k ↪ ι), ∀ i, (bK i : ι → ℤ) = bM (f i) := by
  exact saturated_submodule_basis_extends (Pi.basisFun ℤ ι)
    (integerEquationKernel rows) (integerEquationKernel_saturated rows)







end Math15.Source05Review
end 
end 

/- Section: PrimitiveKernelBasis -/
section



/-!
Native primitive speed vectors inside actual integer equation kernels. The gcd
is taken over the ambient integer coordinates. It supplies both a basis
starting with that vector and Bezout coordinates in any given lattice basis.
Neither conclusion assumes coordinate primitivity separately.
-/

noncomputable section
namespace Math15.Source05Review
open Module

variable {ι κ J : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]

def integerDotLinear (b : ι → ℤ) : (ι → ℤ) →ₗ[ℤ] ℤ where
  toFun := intDot b
  map_add' := by
    intro x y
    simp [intDot, mul_add, Finset.sum_add_distrib]
  map_smul' := by
    intro a x
    change (∑ i, b i * (a * x i)) = a * ∑ i, b i * x i
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring

theorem primitive_vector_starts_kernel_basis (rows : κ → (ι → ℤ))
    (v : ι → ℤ) (hv : v ∈ integerEquationKernel rows)
    (hprim : Finset.univ.gcd (fun i => (v i).natAbs) = 1) :
    ∃ (k : ℕ) (b : Basis (Fin (k+1)) ℤ (integerEquationKernel rows)),
      (b 0 : ι → ℤ) = v := by
  classical
  obtain ⟨z, hz⟩ := primitive_integer_bezout v hprim
  obtain ⟨n, _, bK, _, _⟩ := integerEquationKernel_basis_extends rows
  let phi := (integerDotLinear z).comp (integerEquationKernel rows).subtype
  have hphi : phi ⟨v, hv⟩ = 1 := by
    change intDot z v = 1
    simpa [intDot, mul_comm] using hz
  obtain ⟨k, b, hb⟩ := basis_starts_at_split_vector bK phi ⟨v, hv⟩ hphi
  refine ⟨k, b, ?_⟩
  exact congrArg Subtype.val hb

/-- A primitive ambient vector has Bezout coordinates in every integer
basis of any submodule containing it. In rank two this supplies exactly
the A*p+B*q=1 premise of the nearest-line Gram theorem. -/
theorem primitive_coordinates_have_bezout [Fintype J]
    (N : Submodule ℤ (ι → ℤ)) (b : Basis J ℤ N)
    (v : N) (hprim : Finset.univ.gcd (fun i => (v.val i).natAbs) = 1) :
    ∃ p : J → ℤ, ∑ j, b.repr v j * p j = 1 := by
  classical
  obtain ⟨z, hz⟩ := primitive_integer_bezout v.val hprim
  let phi := (integerDotLinear z).comp N.subtype
  have hphi : phi v = 1 := by
    change intDot z v.val = 1
    simpa [intDot, mul_comm] using hz
  refine ⟨fun j => phi (b j), ?_⟩
  have h := congrArg phi (b.sum_repr v)
  simpa only [map_sum, map_smul, smul_eq_mul, hphi] using h




end Math15.Source05Review
end 
end 

/- Section: ProjectedDualVector -/
section


/-!
The explicit dual vector for a projected Gram basis, including integral
pairings with EVERY vector of the original integer kernel after a
determinant-one change of the projected basis.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

theorem dot4_combine_right {R : Type*} [CommRing R]
    (x u w : Vec4 R) (A B : R) :
    dot4 x (combine4 A u B w) = A*dot4 x u+B*dot4 x w := by
  simp [dot4, combine4]
  ring

def gramDet4 (u w : Vec4 ℝ) : ℝ := dot4 u u*dot4 w w-(dot4 u w)^2

def gramDual4 (u w : Vec4 ℝ) : Vec4 ℝ :=
  combine4 (-(dot4 u w)/gramDet4 u w) u (dot4 u u/gramDet4 u w) w

theorem gramDual4_pairings (u w : Vec4 ℝ) (hD : gramDet4 u w ≠ 0) :
    dot4 (gramDual4 u w) u = 0 ∧ dot4 (gramDual4 u w) w = 1 := by
  constructor
  · rw [gramDual4, dot4_combine, dot4_symm w u]
    ring
  · rw [gramDual4, dot4_combine]
    field_simp [hD]
    unfold gramDet4
    ring

theorem gramDual4_normSq (u w : Vec4 ℝ) (hD : gramDet4 u w ≠ 0) :
    dot4 (gramDual4 u w) (gramDual4 u w) = dot4 u u/gramDet4 u w := by
  simp only [gramDual4, dot4_combine, dot4_combine_right]
  rw [dot4_symm w u]
  field_simp [hD]
  unfold gramDet4
  ring

theorem gramDual4_orthogonal (u w v : Vec4 ℝ)
    (hu : dot4 u v = 0) (hw : dot4 w v = 0) :
    dot4 (gramDual4 u w) v = 0 := by
  rw [gramDual4, dot4_combine, hu, hw]
  ring

theorem perpendicularProjection4_pairing (y v x : Vec4 ℝ) :
    dot4 y (perpendicularProjection4 v x) =
      dot4 y x-(dot4 v x/dot4 v v)*dot4 y v := by
  simp [perpendicularProjection4, dot4]
  ring

theorem perpendicularProjection4_orthogonal (v x : Vec4 ℝ)
    (hv : dot4 v v ≠ 0) : dot4 (perpendicularProjection4 v x) v = 0 := by
  rw [dot4_symm, perpendicularProjection4_pairing]
  field_simp [hv]
  ring

/-- Exact inverse-transpose pairings for a determinant-one integer change
of projected lattice basis. The resulting original pairings are integers. -/
theorem unimodular_dual_original_pairings (u w y : Vec4 ℝ)
    (p q r s : ℤ) (hdet : p*s-q*r=1)
    (hU : dot4 y (combine4 (p : ℝ) u (q : ℝ) w)=0)
    (hW : dot4 y (combine4 (r : ℝ) u (s : ℝ) w)=1) :
    dot4 y u=-(q : ℝ) ∧ dot4 y w=(p : ℝ) := by
  rw [dot4_combine_right] at hU hW
  have hd : (p : ℝ)*(s : ℝ)-(q : ℝ)*(r : ℝ)=1 := by exact_mod_cast hdet
  constructor
  · linear_combination (s : ℝ)*hU-(q : ℝ)*hW-dot4 y u*hd
  · linear_combination -(r : ℝ)*hU+(p : ℝ)*hW-dot4 y w*hd

def realPairingLinearMap (y : Vec4 ℝ) : Vec4 ℤ →ₗ[ℤ] ℝ where
  toFun x := dot4 y (realVec4 x)
  map_add' x z := by simp [dot4, realVec4]; ring
  map_smul' a x := by simp [dot4, realVec4, zsmul_eq_mul]; ring

/-- Integral values on the actual three-vector integer basis imply
integral values on the ENTIRE kernel, with an explicit coefficient. -/
theorem integer_pairings_on_full_basis (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (y : Vec4 ℝ) (A B : ℤ)
    (h0 : dot4 y (realVec4 (b 0))=0)
    (h1 : dot4 y (realVec4 (b 1))=(A : ℝ))
    (h2 : dot4 y (realVec4 (b 2))=(B : ℝ)) (x : N) :
    dot4 y (realVec4 x) = ((b.repr x 1*A+b.repr x 2*B : ℤ) : ℝ) := by
  let f : N →ₗ[ℤ] ℝ := (realPairingLinearMap y).comp N.subtype
  have hf0 : f (b 0)=0 := h0
  have hf1 : f (b 1)=(A : ℝ) := h1
  have hf2 : f (b 2)=(B : ℝ) := h2
  have h := congrArg f (b.sum_repr x)
  simp only [map_sum, map_smul] at h
  change dot4 y (realVec4 x) = _
  change (∑ i : Fin 3, b.repr x i • f (b i))=dot4 y (realVec4 x) at h
  rw [← h]
  simp [Fin.sum_univ_succ, hf0, hf1, hf2, zsmul_eq_mul]

def basisProjection (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (i : Fin 3) : Vec4 ℝ :=
  perpendicularProjection4 (realVec4 (b 0)) (realVec4 (b i))

theorem basisProjection_orthogonal (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (i : Fin 3) :
    dot4 (basisProjection N b i) (realVec4 (b 0))=0 := by
  apply perpendicularProjection4_orthogonal
  rw [realVec4_dot4]
  exact_mod_cast (ne_of_gt (basis_projection_first_norm_positive N b))

def changedProjectedDual (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) : Vec4 ℝ :=
  gramDual4 (combine4 (p : ℝ) (basisProjection N b 1) (q : ℝ) (basisProjection N b 2))
    (combine4 (r : ℝ) (basisProjection N b 1) (s : ℝ) (basisProjection N b 2))

/-- The concrete dual vector after Gauss reduction is orthogonal to v and
integral on every original integer-kernel vector. This is exactly the
universal premise needed by the explicit integer-dual-lift theorem. -/
theorem changedProjectedDual_integral (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1)
    (hD : gramDet4
      (combine4 (p : ℝ) (basisProjection N b 1) (q : ℝ) (basisProjection N b 2))
      (combine4 (r : ℝ) (basisProjection N b 1) (s : ℝ) (basisProjection N b 2)) ≠ 0) :
    dot4 (changedProjectedDual N b p q r s) (realVec4 (b 0))=0 ∧
      ∀ x : N, ∃ n : ℤ, dot4 (changedProjectedDual N b p q r s) (realVec4 x)=(n : ℝ) := by
  let u := basisProjection N b 1
  let w := basisProjection N b 2
  let U := combine4 (p : ℝ) u (q : ℝ) w
  let W := combine4 (r : ℝ) u (s : ℝ) w
  let y := changedProjectedDual N b p q r s
  have hu : dot4 u (realVec4 (b 0))=0 := basisProjection_orthogonal N b 1
  have hw : dot4 w (realVec4 (b 0))=0 := basisProjection_orthogonal N b 2
  have hU0 : dot4 U (realVec4 (b 0))=0 := by
    dsimp [U]
    rw [dot4_combine, hu, hw]
    ring
  have hW0 : dot4 W (realVec4 (b 0))=0 := by
    dsimp [W]
    rw [dot4_combine, hu, hw]
    ring
  have hy0 : dot4 y (realVec4 (b 0))=0 :=
    gramDual4_orthogonal U W _ hU0 hW0
  have hpairs : dot4 y U=0 ∧ dot4 y W=1 := gramDual4_pairings U W hD
  obtain ⟨hyu, hyw⟩ := unimodular_dual_original_pairings u w y p q r s hdet
    hpairs.1 hpairs.2
  have hy1 : dot4 y (realVec4 (b 1))=((-q : ℤ) : ℝ) := by
    dsimp [u, basisProjection] at hyu
    rw [perpendicularProjection4_pairing, hy0] at hyu
    simpa using hyu
  have hy2 : dot4 y (realVec4 (b 2))=(p : ℝ) := by
    dsimp [w, basisProjection] at hyw
    rw [perpendicularProjection4_pairing, hy0] at hyw
    simpa using hyw
  refine ⟨hy0, ?_⟩
  intro x
  exact ⟨b.repr x 1*(-q)+b.repr x 2*p,
    integer_pairings_on_full_basis N b y (-q) p hy0 hy1 hy2 x⟩

/-- The same vector is integral on the whole projected image of N,
parameterized by all its actual integer points. -/
theorem changedProjectedDual_projected_integral (N : Submodule ℤ (Vec4 ℤ))
    (b : Module.Basis (Fin 3) ℤ N) (p q r s : ℤ) (hdet : p*s-q*r=1)
    (hD : gramDet4
      (combine4 (p : ℝ) (basisProjection N b 1) (q : ℝ) (basisProjection N b 2))
      (combine4 (r : ℝ) (basisProjection N b 1) (s : ℝ) (basisProjection N b 2)) ≠ 0)
    (x : N) :
    ∃ n : ℤ, dot4 (changedProjectedDual N b p q r s)
      (perpendicularProjection4 (realVec4 (b 0)) (realVec4 x))=(n : ℝ) := by
  obtain ⟨hy0, hint⟩ := changedProjectedDual_integral N b p q r s hdet hD
  obtain ⟨n, hn⟩ := hint x
  refine ⟨n, ?_⟩
  rw [perpendicularProjection4_pairing, hy0, mul_zero, sub_zero, hn]














end Math15.LonelyRunner.Covolume4
end 
end 

/- Section: HyperplaneRealSpan -/
section



/-!
Real spanning from an ACTUAL integer hyperplane basis.

Choose e with m dot e = 1 and put g_i = standard_i - m_i e. Every g_i belongs
to the integer kernel. If m dot x = 0 for real x, then x = sum_i x_i
realCast(g_i). Expanding each g_i through the given integer basis proves real
spanning directly. This does not assume scalar extension preserves a basis,
nor an ambient real spanning certificate.
-/

noncomputable section
namespace Math15.LonelyRunner.Covolume4

open Math15.Source05Review

abbrev integerHyperplane4 (m : Vec4 ℤ) : Submodule ℤ (Vec4 ℤ) :=
  LinearMap.ker (integerDotLinear m)

def nativeHyperplaneGenerator (m e : Vec4 ℤ) (he : intDot m e = 1)
    (i : Fin 4) : integerHyperplane4 m :=
  ⟨kernelGenerator m e i, by
    change intDot m (kernelGenerator m e i) = 0
    exact kernelGenerator_in_kernel m e he i⟩

def realCoordinateLinearMap (k : Fin 4) : Vec4 ℤ →ₗ[ℤ] ℝ where
  toFun x := (x k : ℝ)
  map_add' x y := by simp
  map_smul' a x := by simp [zsmul_eq_mul]

/-- Casting the actual integer basis expansion commutes with coordinates. -/
theorem integer_basis_real_coordinate_expansion
    (N : Submodule ℤ (Vec4 ℤ)) (b : Module.Basis (Fin 3) ℤ N)
    (z : N) (k : Fin 4) :
    (∑ j : Fin 3, (b.repr z j : ℝ) * realVec4 (b j) k) = realVec4 z k := by
  let f : N →ₗ[ℤ] ℝ := (realCoordinateLinearMap k).comp N.subtype
  have h := congrArg f (b.sum_repr z)
  simp only [map_sum, map_smul] at h
  simpa [f, realCoordinateLinearMap, realVec4, zsmul_eq_mul] using h

/-- This is the explicit real spanning mechanism. The Bézout hypothesis
is needed to put g_i in the integer kernel, but not for this identity. -/
theorem real_hyperplane_generator_reconstruct (m e : Vec4 ℤ) (x : Vec4 ℝ)
    (hx : dot4 (realVec4 m) x = 0) (k : Fin 4) :
    (∑ i : Fin 4, x i * realVec4 (kernelGenerator m e i) k) = x k := by
  have hsum : (∑ i : Fin 4, x i * (m i : ℝ)) = 0 := by
    simpa only [Fin.sum_univ_four, dot4, realVec4, mul_comm] using hx
  calc
    (∑ i : Fin 4, x i * realVec4 (kernelGenerator m e i) k) =
        x k - ∑ i : Fin 4, (x i * (m i : ℝ)) * (e k : ℝ) := by
      simp [realVec4, kernelGenerator, mul_sub, mul_ite, mul_assoc,
        Finset.sum_sub_distrib]
    _ = x k - (∑ i : Fin 4, x i * (m i : ℝ)) * (e k : ℝ) := by
      rw [Finset.sum_mul]
    _ = x k := by rw [hsum]; ring

/-- Explicit real coordinates, obtained from the integer coordinates of
the four actual kernel generators. -/
def hyperplaneRealCoordinates (m e : Vec4 ℤ) (he : intDot m e = 1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (j : Fin 3) : ℝ :=
  ∑ i : Fin 4, x i * (b.repr (nativeHyperplaneGenerator m e he i) j : ℝ)

theorem hyperplaneRealCoordinates_reconstruct (m e : Vec4 ℤ)
    (he : intDot m e = 1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x = 0) (k : Fin 4) :
    (∑ j : Fin 3, hyperplaneRealCoordinates m e he b x j * realVec4 (b j) k)
      = x k := by
  calc
    (∑ j : Fin 3, hyperplaneRealCoordinates m e he b x j * realVec4 (b j) k) =
        ∑ j : Fin 3, ∑ i : Fin 4,
          (x i * (b.repr (nativeHyperplaneGenerator m e he i) j : ℝ)) *
            realVec4 (b j) k := by
      simp only [hyperplaneRealCoordinates, Finset.sum_mul]
    _ = ∑ i : Fin 4, ∑ j : Fin 3,
          (x i * (b.repr (nativeHyperplaneGenerator m e he i) j : ℝ)) *
            realVec4 (b j) k := Finset.sum_comm
    _ = ∑ i : Fin 4, x i * (∑ j : Fin 3,
          (b.repr (nativeHyperplaneGenerator m e he i) j : ℝ) *
            realVec4 (b j) k) := by
      simp only [Finset.mul_sum, mul_assoc]
    _ = ∑ i : Fin 4, x i * realVec4 (nativeHyperplaneGenerator m e he i) k := by
      apply Finset.sum_congr rfl
      intro i _
      rw [integer_basis_real_coordinate_expansion]
    _ = x k := real_hyperplane_generator_reconstruct m e x hx k

/-- Every real point in the hyperplane has real coordinates in the
given native integer basis. The normal's primitivity discharges Bézout. -/
theorem primitive_hyperplane_real_span (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x = 0) :
    ∃ A B C : ℝ, x = combine4 A (realVec4 (b 0)) 1
      (combine4 B (realVec4 (b 1)) C (realVec4 (b 2))) := by
  obtain ⟨e, he⟩ := primitive_integer_bezout m hm
  let a := hyperplaneRealCoordinates m e he b x
  refine ⟨a 0, a 1, a 2, ?_⟩
  funext k
  have h := hyperplaneRealCoordinates_reconstruct m e he b x hx k
  simpa only [Fin.sum_univ_three, a, combine4, one_mul, add_assoc] using h.symm

theorem perpendicularProjection4_combine (v u w : Vec4 ℝ) (A B : ℝ) :
    perpendicularProjection4 v (combine4 A u B w) =
      combine4 A (perpendicularProjection4 v u) B (perpendicularProjection4 v w) := by
  funext k
  simp [perpendicularProjection4, dot4, combine4]
  ring

theorem perpendicularProjection4_self (v : Vec4 ℝ) (hv : dot4 v v ≠ 0) :
    perpendicularProjection4 v v = 0 := by
  funext k
  simp [perpendicularProjection4, div_self hv]

/-- Every projected real hyperplane point lies in the real span of the
two actual projected lattice basis vectors. No real-span premise remains. -/
theorem primitive_hyperplane_projected_real_span (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x = 0) :
    ∃ B C : ℝ, perpendicularProjection4 (realVec4 (b 0)) x =
      combine4 B (basisProjection (integerHyperplane4 m) b 1)
        C (basisProjection (integerHyperplane4 m) b 2) := by
  obtain ⟨A, B, C, hrep⟩ := primitive_hyperplane_real_span m hm b x hx
  have hv : dot4 (realVec4 (b 0)) (realVec4 (b 0)) ≠ 0 := by
    rw [realVec4_dot4]
    exact_mod_cast (ne_of_gt
      (basis_projection_first_norm_positive (integerHyperplane4 m) b))
  refine ⟨B, C, ?_⟩
  rw [hrep, perpendicularProjection4_combine, perpendicularProjection4_combine,
    perpendicularProjection4_self _ hv]
  funext k
  simp [combine4, basisProjection]

/-- A determinant-one change of two real vectors preserves their real
span with an explicit inverse. This is consumed after integer Gauss reduction. -/
theorem unimodular_real_combination (u w : Vec4 ℝ)
    (p q r s : ℤ) (hdet : p*s-q*r=1) (B C : ℝ) :
    combine4 B u C w =
      combine4 ((s : ℝ)*B-(r : ℝ)*C)
        (combine4 (p : ℝ) u (q : ℝ) w)
        (-(q : ℝ)*B+(p : ℝ)*C)
        (combine4 (r : ℝ) u (s : ℝ) w) := by
  have hd : (p : ℝ)*(s : ℝ)-(q : ℝ)*(r : ℝ)=1 := by
    exact_mod_cast hdet
  funext k
  dsimp [combine4]
  linear_combination -(B*u k+C*w k)*hd

theorem primitive_hyperplane_changed_projected_real_span (m : Vec4 ℤ)
    (hm : Finset.univ.gcd (fun i => (m i).natAbs) = 1)
    (b : Module.Basis (Fin 3) ℤ (integerHyperplane4 m))
    (p q r s : ℤ) (hdet : p*s-q*r=1)
    (x : Vec4 ℝ) (hx : dot4 (realVec4 m) x = 0) :
    ∃ B C : ℝ, perpendicularProjection4 (realVec4 (b 0)) x =
      combine4 B
        (combine4 (p : ℝ) (basisProjection (integerHyperplane4 m) b 1)
          (q : ℝ) (basisProjection (integerHyperplane4 m) b 2)) C
        (combine4 (r : ℝ) (basisProjection (integerHyperplane4 m) b 1)
          (s : ℝ) (basisProjection (integerHyperplane4 m) b 2)) := by
  obtain ⟨B, C, hrep⟩ := primitive_hyperplane_projected_real_span m hm b x hx
  refine ⟨(s : ℝ)*B-(r : ℝ)*C, -(q : ℝ)*B+(p : ℝ)*C, ?_⟩
  rw [hrep]
  exact unimodular_real_combination _ _ p q r s hdet B C













end Math15.LonelyRunner.Covolume4
