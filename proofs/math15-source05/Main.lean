        ((areaSq4 r s : ℤ) : ℝ) := by exact_mod_cast harea
    exact Or.inr (by nlinarith)
  · exact Or.inl (by simpa only [hspeeds] using htarget)

theorem low_ML_additive_target_or_sum444
    (v : Fin 4 → ℕ) (hadd : v 0+v 1=v 2)
    (hp : Positive (Finset.univ.image v)) (hprim : Primitive (Finset.univ.image v))
    (hcard : (Finset.univ.image v).card=4)
    (hpair : ∀a∈Finset.univ.image v,∀b∈Finset.univ.image v,a≠b→Nat.gcd a b≤2)
    (hlow : ML (Finset.univ.image v)<(1/4 : ℝ)) :
