/-- SourceSix applies to the actual non-tight bounded core; its set
identity and core properties are supplied by the small literal helpers. -/
theorem ML_ge_quarter_small_pair_large_last {q c d : ℕ} (hq : q=1 ∨ q=2)
    (hp : Positive (finiteQuartetSpeeds (2*q) (3*q) c d))
    (hcard : (finiteQuartetSpeeds (2*q) (3*q) c d).card=4)
    (hc24 : c<24)
